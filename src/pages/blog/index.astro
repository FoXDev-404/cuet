---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { formatDate } from "../../lib/content";
import { getPageSeo, parseFaq } from "../../lib/seo";
import { estimateReadingMinutes } from "../../lib/blog";
import {
  getAllGuides,
  groupGuidesByCategory,
  guidePath,
  type GuidePost,
} from "../../lib/guides";
import { START_HERE_SLUGS } from "../../content/guides";

const guides = await getAllGuides();
const seo = await getPageSeo("/blog");
const title = seo?.title || "CUET UG Guides: Preparation, Strategy and Exam Day";
const description =
  seo?.description ||
  "Original CUET UG guides on preparation strategy, subject planning, mock-test review and exam-day logistics, written to turn reading into better practice.";
const noindex = (seo?.noindex ?? 0) === 1 || guides.length === 0;
const faqs = parseFaq(seo?.faq_json);

const groups = groupGuidesByCategory(guides);
const startHere = START_HERE_SLUGS.map((slug) => guides.find((guide) => guide.slug === slug)).filter(
  (guide): guide is GuidePost => Boolean(guide),
);
const totalReading = guides.reduce((total, guide) => total + estimateReadingMinutes(guide.body), 0);
const recent = guides
  .filter((guide) => !startHere.some((entry) => entry.slug === guide.slug))
  .slice(0, 3);
---

<BaseLayout title={title} description={description} noindex={noindex} canonical={seo?.canonical_url}>
  <PageHero
    eyebrow="Guides"
    title="CUET UG guides that change what you do next"
    intro="Long-form, original guides on preparation strategy, subject planning and exam literacy. Every guide is written for this site and avoids invented dates, weightage charts or copied coaching material."
  />

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <section class="grid gap-6 lg:grid-cols-[1.4fr_0.6fr]" aria-labelledby="library-intro">
      <div>
        <h2 id="library-intro" class="text-2xl font-black tracking-tight text-[var(--ink)]">
          Read less, practise better
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-[var(--muted)] sm:text-base">
          Most preparation advice adds more material. These guides subtract. Each one explains a
          decision you can make this week: which chapter to map first, how to review a timed paper,
          or what to do when a subject stops improving.
        </p>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-[var(--muted)] sm:text-base">
          Start with the three guides below if you are new. If you already have a paper score, go
          straight to <a class="font-semibold text-[var(--primary)] underline underline-offset-2" href={guidePath("cuet-ug-how-to-review-a-mock-test")}>the mock-review routine</a>
          and build an error log before taking another attempt.
        </p>
      </div>

      <aside class="self-start rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5">
        <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]">
          The library
        </p>
        <dl class="mt-3 grid grid-cols-2 gap-4">
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-wide text-[var(--muted)]">Guides</dt>
            <dd class="mt-1 text-2xl font-black tracking-tight text-[var(--ink)]">{guides.length}</dd>
          </div>
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-wide text-[var(--muted)]">Reading</dt>
            <dd class="mt-1 text-2xl font-black tracking-tight text-[var(--ink)]">{totalReading} min</dd>
          </div>
        </dl>
        <p class="mt-4 border-t border-[var(--border)] pt-3 text-xs leading-5 text-[var(--muted)]">
          Written for CUET UG practice. Scores and ranks on this site are practice indicators, not
          official NTA results.
        </p>
        <a
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-[var(--primary)] hover:underline"
          href="/mock-tests"
        >
          Browse timed papers
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
      </aside>
    </section>

    {
      startHere.length > 0 ? (
        <section class="mt-12" aria-labelledby="start-here">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 id="start-here" class="text-2xl font-black tracking-tight text-[var(--ink)]">
                Start here
              </h2>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">
                Three guides that make the rest of the library useful: one for orientation, one for
                review, and one for the morning of the exam.
              </p>
            </div>
            <span class="rounded-full border border-[var(--border)] bg-[var(--surface-2)] px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-[var(--muted)]">
              New to the site
            </span>
          </div>

          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {startHere.map((guide, index) => (
              <a
                href={guidePath(guide.slug)}
                class="group relative flex flex-col overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5 transition-colors hover:border-brand-300 dark:hover:border-brand-500/40"
              >
                <span
                  class="text-[11px] font-black uppercase tracking-[0.2em] text-brand-600 dark:text-brand-300"
                  aria-hidden="true"
                >
                  0{index + 1}
                </span>
                <h3 class="mt-8 text-lg font-black leading-snug tracking-tight text-[var(--ink)] group-hover:text-[var(--primary)]">
                  {guide.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{guide.description}</p>
                <span class="mt-auto pt-4 text-xs font-bold text-[var(--primary)]">
                  Read the guide →
                </span>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }

    {
      groups.length > 0 ? (
        <nav class="mt-12 flex flex-wrap gap-2" aria-label="Guide topics">
          {groups.map((group) => (
            <a
              href={`#${group.key}`}
              class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3.5 py-1.5 text-xs font-semibold text-[var(--ink-2)] transition-colors hover:border-brand-300 hover:text-[var(--primary)] dark:hover:border-brand-500/40"
            >
              {group.label}
              <span class="rounded-full bg-[var(--surface-2)] px-1.5 py-0.5 text-[10px] font-bold text-[var(--muted)]">
                {group.guides.length}
              </span>
            </a>
          ))}
        </nav>
      ) : null
    }

    {
      groups.map((group) => (
        <section id={group.key} class="mt-12 scroll-mt-24" aria-labelledby={`${group.key}-heading`}>
          <div class="max-w-3xl">
            <h2 id={`${group.key}-heading`} class="text-2xl font-black tracking-tight text-[var(--ink)]">
              {group.label}
            </h2>
            <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{group.blurb}</p>
          </div>

          <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {group.guides.map((guide) => (
              <article class="flex flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5 transition-colors hover:border-brand-300 dark:hover:border-brand-500/40">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-[var(--muted)]">
                  {formatDate(guide.publishedAt)} · {estimateReadingMinutes(guide.body)} min read
                </p>
                <h3 class="mt-2 text-lg font-bold leading-snug tracking-tight text-[var(--ink)]">
                  <a class="hover:text-[var(--primary)]" href={guidePath(guide.slug)}>
                    {guide.title}
                  </a>
                </h3>
                <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{guide.description}</p>
                <a
                  class="mt-auto pt-4 text-sm font-semibold text-[var(--primary)] hover:underline"
                  href={guidePath(guide.slug)}
                >
                  Read the guide →
                </a>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    {
      recent.length > 0 ? (
        <section class="mt-14 border-t border-[var(--border)] pt-8" aria-labelledby="recent-guides">
          <h2 id="recent-guides" class="text-xl font-black tracking-tight text-[var(--ink)]">
            Recently added
          </h2>
          <div class="mt-4 grid gap-3 md:grid-cols-3">
            {recent.map((guide) => (
              <a
                href={guidePath(guide.slug)}
                class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4 transition-colors hover:border-brand-300 dark:hover:border-brand-500/40"
              >
                <p class="text-[10px] font-bold uppercase tracking-wide text-[var(--muted)]">
                  {formatDate(guide.publishedAt)}
                </p>
                <p class="mt-1 text-sm font-bold leading-snug text-[var(--ink)]">{guide.title}</p>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }

    <section class="mt-14 overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--surface-2)]">
      <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand-600 dark:text-brand-300">
            Put a guide to work
          </p>
          <h2 class="mt-2 text-2xl font-black tracking-tight text-[var(--ink)] sm:text-3xl">
            Reading changes nothing until you attempt a paper.
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-[var(--muted)]">
            Pick a previous-year shift, sit it under the real clock, then use the review guide on
            the result. One attempt plus one honest review beats a week of passive reading.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 lg:justify-end">
          <a
            class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-700"
            href="/mock-tests"
          >
            Browse mock tests
          </a>
          <a
            class="inline-flex items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-sm font-bold text-[var(--ink)] transition-colors hover:border-brand-300 dark:hover:border-brand-500/40"
            href="/cuet-ug-syllabus"
          >
            Read the syllabus guide
          </a>
        </div>
      </div>
    </section>

    {
      faqs.length > 0 ? (
        <section class="mt-10 space-y-3" aria-label="Frequently asked questions">
          {faqs.map((faq) => (
            <details class="rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-4">
              <summary class="cursor-pointer font-bold text-[var(--ink)]">{faq.question}</summary>
              <p class="mt-2 text-sm leading-7 text-[var(--muted)]">{faq.answer}</p>
            </details>
          ))}
        </section>
      ) : null
    }
  </div>
</BaseLayout>
