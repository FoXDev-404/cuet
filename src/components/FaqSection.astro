---
import type { FaqItem } from "../lib/seo";

interface Props {
  faqs: FaqItem[];
  title?: string;
  intro?: string;
}

const { faqs, title = "Frequently asked questions", intro = "" } = Astro.props;
---

{faqs.length > 0 ? (
  <section class="mt-12" aria-labelledby="faq-heading">
    <h2 class="text-2xl font-bold tracking-tight" id="faq-heading">{title}</h2>
    {intro ? <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{intro}</p> : null}
    <div class="mt-5 space-y-3">
      {faqs.map((faq) => (
        <details class="group rounded-2xl border border-neutral-200 bg-white p-4 open:shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
          <summary class="cursor-pointer list-none font-semibold marker:hidden">
            <span class="flex items-start justify-between gap-4">
              {faq.question}
              <span class="mt-0.5 text-neutral-600 transition-transform group-open:rotate-45 dark:text-neutral-400" aria-hidden="true">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-7 text-neutral-600 dark:text-neutral-300">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
) : null}
