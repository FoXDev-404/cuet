---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Maintenance — CUET Free Mock Test" noindex>
  <section class="mx-auto max-w-lg px-4 py-20 text-center sm:px-6">
    <p class="text-sm font-bold uppercase tracking-widest text-brand-700 dark:text-brand-300">Short break</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight">We are improving the mock engine.</h1>
    <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-300">
      The site is temporarily in maintenance mode. Your saved attempts are safe. Please check back in a few minutes.
    </p>
  </section>
</BaseLayout>
