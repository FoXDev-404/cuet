---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { all } from "../../lib/db";
import { can } from "../../lib/auth/admin";
import { formatDateTime } from "../../lib/content";
import { findPyqPaper, listAdminPyq, listPyqMockOptions } from "../../lib/admin/pyq";

const admin = Astro.locals.admin!;
if (!can(admin.role, "mocks.write")) return Astro.redirect("/forbidden", 303);

const papers = await listAdminPyq();
const subjects = await all<{ id: number; name: string }>(
  `SELECT s.id, s.name FROM subjects s JOIN exams e ON e.id = s.exam_id
   WHERE e.slug = 'cuet-ug' AND e.is_active = 1 AND s.is_active = 1 ORDER BY s.name`,
);
const mockOptions = await listPyqMockOptions();

const requestedId = Number(Astro.url.searchParams.get("id") ?? "0");
const selected = Number.isInteger(requestedId) && requestedId > 0 ? await findPyqPaper(requestedId) : null;

const years = [...new Set(papers.map((paper) => paper.year))].sort((a, b) => b - a);
const selectedMockId = selected?.mock_id ?? null;
const nextYear = new Date().getFullYear();
---

<AdminLayout title="PYQ manager" active="pyq">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">PYQ manager</h1>
      <p class="mt-1 max-w-3xl text-sm text-neutral-600 dark:text-neutral-400">
        Record year, shift, subject, source and rights notes before a previous-year paper is published. Link the paper to a timed mock once its questions and solutions are ready.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href="/cuet-ug-previous-year-papers" target="_blank" rel="noopener">View public archive</a>
      <a class="rounded-lg bg-brand-600 px-3 py-2 text-sm font-bold text-white hover:bg-brand-700" href="/admin/pyq">New paper</a>
    </div>
  </div>

  <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-900 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-100">
    <p class="font-bold">No copied papers</p>
    <p class="mt-1">Do not upload a copyrighted PDF or paste a coaching answer key. Record where the paper came from and how it was adapted, then write original explanations for every question before publishing.</p>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[1fr_420px]">
    <section>
      <h2 class="text-lg font-bold">Papers by year</h2>
      {papers.length === 0 ? (
        <div class="mt-4 rounded-2xl border border-dashed border-neutral-300 p-10 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
          No PYQ paper records yet. Create one with the form on the right, then link a published PYQ mock.
        </div>
      ) : (
        <div class="mt-4 space-y-6">
          {years.map((year) => (
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">{year}</h3>
              <ul class="mt-2 space-y-2">
                {papers.filter((paper) => paper.year === year).map((paper) => (
                  <li class:list={[
                    "rounded-2xl border bg-white p-4 dark:bg-neutral-900",
                    selected?.id === paper.id ? "border-brand-400 ring-2 ring-brand-100 dark:border-brand-600 dark:ring-brand-950" : "border-neutral-200 dark:border-neutral-800",
                  ]}>
                    <div class="flex flex-wrap items-start justify-between gap-3">
                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2 text-xs">
                          <span class:list={[
                            "rounded-full px-2 py-0.5 font-semibold",
                            paper.status === "published"
                              ? "bg-brand-100 text-brand-900 dark:bg-brand-900/50 dark:text-brand-200"
                              : "bg-amber-100 text-amber-900 dark:bg-amber-950/50 dark:text-amber-200",
                          ]}>{paper.status}</span>
                          {paper.shift ? <span class="rounded-full bg-neutral-100 px-2 py-0.5 font-semibold dark:bg-neutral-800">{paper.shift}</span> : null}
                          {paper.subject_name ? <span class="rounded-full bg-neutral-100 px-2 py-0.5 font-semibold dark:bg-neutral-800">{paper.subject_name}</span> : null}
                        </div>
                        <p class="mt-2 font-bold">{paper.title}</p>
                        {paper.mock_id ? (
                          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                            Linked mock: <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href={`/admin/mocks/${paper.mock_id}`}>{paper.mock_title}</a>
                            {" "}· {paper.mock_status} · {paper.question_count ?? 0} questions
                          </p>
                        ) : (
                          <p class="mt-1 text-xs text-amber-700 dark:text-amber-300">No timed mock linked yet — this paper is hidden from the public archive.</p>
                        )}
                        {paper.source_url ? <p class="mt-1 truncate text-xs text-neutral-500 dark:text-neutral-400">Source: {paper.source_url}</p> : null}
                      </div>
                      <div class="flex shrink-0 gap-2">
                        <a class="rounded-lg border border-neutral-300 px-2.5 py-1 text-xs font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/admin/pyq?id=${paper.id}`}>Edit</a>
                        <button class="rounded-lg border border-red-200 px-2.5 py-1 text-xs font-semibold text-red-700 hover:bg-red-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950/30" type="button" data-delete-pyq={paper.id}>Delete</button>
                      </div>
                    </div>
                    {paper.updated_at ? <p class="mt-2 text-[11px] text-neutral-500 dark:text-neutral-400">Updated {formatDateTime(paper.updated_at)}</p> : null}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </section>

    <section class="h-fit rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
      <h2 class="text-lg font-bold">{selected ? `Edit paper #${selected.id}` : "New PYQ paper"}</h2>
      <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
        A paper is only listed publicly when it is published and linked to a published mock with questions.
      </p>

      <form id="pyq-form" class="mt-4 space-y-3" data-id={selected?.id ?? ""}>
        <p id="pyq-status" class="hidden rounded-lg px-3 py-2 text-sm" role="status"></p>

        <div class="grid grid-cols-2 gap-3">
          <label class="block text-sm font-semibold">Year
            <input class="field mt-1" name="year" type="number" min="2000" max="2100" required value={selected?.year ?? nextYear} />
          </label>
          <label class="block text-sm font-semibold">Shift
            <input class="field mt-1" name="shift" maxlength="60" placeholder="Shift 1" value={selected?.shift ?? ""} />
          </label>
        </div>

        <label class="block text-sm font-semibold">Subject
          <select class="field mt-1" name="subject_id">
            <option value="">Mixed / not subject-specific</option>
            {subjects.map((subject) => (
              <option value={subject.id} selected={selected?.subject_id === subject.id}>{subject.name}</option>
            ))}
          </select>
        </label>

        <label class="block text-sm font-semibold">Paper title
          <input class="field mt-1" name="title" maxlength="180" required value={selected?.title ?? ""} placeholder="CUET UG 2024 English — Shift 1" />
        </label>

        <label class="block text-sm font-semibold">Source URL
          <input class="field mt-1" name="source_url" type="url" maxlength="1000" value={selected?.source_url ?? ""} placeholder="https://cuet.nta.nic.in/…" />
          <span class="mt-1 block text-xs font-normal text-neutral-500 dark:text-neutral-400">Link to the official notice or paper source. Leave empty if this is an original practice set.</span>
        </label>

        <label class="block text-sm font-semibold">Rights / provenance note
          <textarea class="field mt-1" name="rights_note" rows="3" maxlength="2000" placeholder="Adapted from the official 2024 paper; all explanations rewritten. Diagrams redrawn.">{selected?.rights_note ?? ""}</textarea>
        </label>

        <label class="block text-sm font-semibold">Status
          <select class="field mt-1" name="status">
            <option value="draft" selected={selected?.status !== "published"}>Draft</option>
            <option value="published" selected={selected?.status === "published"}>Published</option>
          </select>
        </label>

        <label class="block text-sm font-semibold">Linked timed mock
          <select class="field mt-1" name="mock_id">
            <option value="">No mock linked</option>
            {mockOptions.map((mock) => (
              <option value={mock.id} selected={selectedMockId === mock.id}>{mock.title}{mock.pyq_year ? ` (${mock.pyq_year})` : ""}</option>
            ))}
          </select>
          <span class="mt-1 block text-xs font-normal text-neutral-500 dark:text-neutral-400">Only mocks with type “pyq” are listed. Create one in the mock builder first if needed.</span>
        </label>

        <div class="flex flex-wrap gap-2 pt-1">
          <button class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" type="submit">{selected ? "Save changes" : "Create paper"}</button>
          {selected ? <a class="rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href="/admin/pyq">Cancel</a> : null}
        </div>
      </form>
    </section>
  </div>

  <style>
    .field {
      width: 100%;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-input);
      background: var(--surface-2); color: var(--ink);
      padding: 0.55rem 0.7rem;
      font-size: 0.875rem;
    }

  </style>

  <script is:inline>
    const form = document.getElementById("pyq-form");
    const statusBox = document.getElementById("pyq-status");

    function showStatus(message, ok) {
      if (!statusBox) return;
      statusBox.textContent = message;
      statusBox.className = `rounded-lg px-3 py-2 text-sm ${ok ? "bg-brand-50 text-brand-900 dark:bg-brand-950/40 dark:text-brand-200" : "bg-red-50 text-red-800 dark:bg-red-950/50 dark:text-red-200"}`;
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector("button[type=submit]");
      if (!button) return;
      button.disabled = true;
      const data = new FormData(form);
      const id = form.dataset.id;
      const response = await fetch(id ? `/api/admin/pyq/${id}` : "/api/admin/pyq", {
        method: id ? "PATCH" : "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(Object.fromEntries(data.entries())),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        showStatus(result.error || "Could not save the paper.", false);
        button.disabled = false;
        return;
      }
      location.href = result.redirect || "/admin/pyq";
    });

    document.querySelectorAll("[data-delete-pyq]").forEach((button) => {
      button.addEventListener("click", async () => {
        if (!confirm("Delete this PYQ paper record? The linked mock is never deleted.")) return;
        button.disabled = true;
        const response = await fetch(`/api/admin/pyq/${button.dataset.deletePyq}`, { method: "DELETE" });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          alert(result.error || "Could not delete the paper.");
          button.disabled = false;
          return;
        }
        location.reload();
      });
    });
  </script>
</AdminLayout>
