---
import type { LocalPaperSummary } from "../lib/local-papers";
import {
  classifyPaper,
  getKeyStatus,
  formatMarking,
  formatShortTitle,
} from "../lib/paper-list";
import KeyStatusPill from "./KeyStatusPill.astro";
import PaperTypeTag from "./PaperTypeTag.astro";

interface Props {
  paper: LocalPaperSummary;
  class?: string;
}

const { paper, class: className = "" } = Astro.props;

const paperType = classifyPaper(paper);
const keyStatus = getKeyStatus(paper);
const shortTitle = formatShortTitle(paper);
const markingText = formatMarking(paper.markingScheme);
const startHref = `/mock/${paper.slug}/instructions`;
const detailsHref = paper.path;

const sublineParts: string[] = [
  `${paper.recoveredQuestionCount} question${paper.recoveredQuestionCount === 1 ? "" : "s"}`,
  `${paper.durationMinutes} min`,
  markingText,
];

if (paper.attemptCount >= 1) {
  sublineParts.push(
    `${paper.attemptCount.toLocaleString("en-IN")} attempt${paper.attemptCount === 1 ? "" : "s"}`
  );
}
---

<article
  class:list={[
    "group flex flex-col md:flex-row md:items-center justify-between gap-3 md:gap-4 rounded-xl border border-neutral-200 bg-white p-4 md:px-5 md:py-3.5 transition-colors hover:border-brand-300 hover:bg-neutral-50/60 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-brand-700/60 dark:hover:bg-neutral-800/40",
    className,
  ]}
>
  <!-- Left: Short Title, Type Tag, Subline -->
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="truncate text-base font-bold text-neutral-900 group-hover:text-brand-700 dark:text-neutral-100 dark:group-hover:text-brand-300">
        <a href={detailsHref} aria-label={paper.title} class="hover:underline">
          {shortTitle}
        </a>
      </h3>
      <PaperTypeTag type={paperType} />
    </div>
    <p class="mt-1 md:mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
      {sublineParts.join(" · ")}
    </p>
  </div>

  <!-- Middle & Right: Key Status and Actions -->
  <div class="flex items-center justify-between md:justify-end gap-3 pt-2 md:pt-0 border-t border-neutral-100 md:border-t-0 dark:border-neutral-800/60 shrink-0">
    <KeyStatusPill status={keyStatus} />

    <div class="flex items-center gap-2">
      <a
        href={startHref}
        class="inline-flex h-9 md:h-auto items-center justify-center rounded-lg md:rounded-none bg-brand-600 md:bg-transparent px-3.5 py-1.5 md:p-0 text-xs md:text-sm font-bold text-white md:text-brand-600 hover:bg-brand-700 md:hover:bg-transparent md:hover:text-brand-700 dark:text-white md:dark:text-brand-400 dark:hover:bg-brand-600 md:dark:hover:text-brand-300 md:hover:underline"
        aria-label={`Start ${paper.title}`}
      >
        <span>Start</span>
        <span class="hidden md:inline ml-0.5" aria-hidden="true">→</span>
      </a>
      <a
        href={detailsHref}
        class="inline-flex md:hidden h-9 items-center justify-center rounded-lg border border-neutral-200 px-3 py-1.5 text-xs font-semibold text-neutral-600 hover:bg-neutral-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
        aria-label={`Details for ${paper.title}`}
      >
        Details
      </a>
    </div>
  </div>
</article>
