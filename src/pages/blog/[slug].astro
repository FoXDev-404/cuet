---
import { siteUrl } from "../../lib/site-url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { dbUnavailableResponse } from "../../lib/db-resilient";
import { formatDate } from "../../lib/content";
import { articleJsonLd, breadcrumbJsonLd, getPageSeo } from "../../lib/seo";
import { articleHeadings, estimateReadingMinutes, renderArticleBody } from "../../lib/blog";
import {
  getAllGuides,
  getGuide,
  getRelatedGuides,
  guidePath,
  type GuidePost,
} from "../../lib/guides";
import { GUIDE_CATEGORY_META } from "../../content/guides";

const slug = Astro.params.slug ?? "";
let post: GuidePost | null = null;
try {
  post = await getGuide(slug);
} catch (error) {
  // D1 is unreachable (for example the daily row-read quota is spent) and this
  // slug is not a repository guide, so it may exist in the database. Answer 503
  // instead of pretending the guide is missing.
  console.error("Guide lookup failed", error);
  return dbUnavailableResponse();
}
if (!post) return new Response("Guide not found", { status: 404 });

const PATH = guidePath(post.slug);
const seo = await getPageSeo(PATH);
// The post title stands alone: a "— brand" suffix pushed editorial titles past
// the 70-char SERP window, and the brand is already in og:site_name and the
// visible header.
const title = seo?.title || post.title;
const description = seo?.description || post.description;
const noindex = (seo?.noindex ?? 0) === 1;
const site = siteUrl(Astro.url);
const category = GUIDE_CATEGORY_META[post.category];
const headings = articleHeadings(post.body);
const readingMinutes = estimateReadingMinutes(post.body);
const updatedAt = seo?.updated_at || post.updatedAt || post.publishedAt;
const allGuides = await getAllGuides();
const related = getRelatedGuides(post, allGuides, 3);

const structuredData = [
  breadcrumbJsonLd(site, [
    { name: "Home", path: "/" },
    { name: "Guides", path: "/blog" },
    { name: post.title, path: PATH },
  ]),
  articleJsonLd({
    site,
    title,
    description,
    path: PATH,
    published: post.publishedAt,
    updated: updatedAt,
  }),
].filter((item): item is Record<string, unknown> => Boolean(item));
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  canonical={seo?.canonical_url}
  structuredData={structuredData}
  ogType="article"
  ads={!noindex}
  endAdSlot={false}
>
  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <nav class="flex flex-wrap items-center gap-2 text-xs text-[var(--muted)]" aria-label="Breadcrumb">
      <a class="hover:text-[var(--primary)] hover:underline" href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a class="hover:text-[var(--primary)] hover:underline" href="/blog">Guides</a>
      <span aria-hidden="true">/</span>
      <span class="line-clamp-1 text-[var(--ink-2)]">{post.title}</span>
    </nav>

    <div class="mt-5 grid gap-10 xl:grid-cols-[minmax(0,1fr)_17rem]">
      <div class="min-w-0 max-w-3xl">
        <header class="border-b border-[var(--border)] pb-6">
          <div class="flex flex-wrap items-center gap-2">
            <a
              class="rounded-full border border-[var(--border)] bg-[var(--surface-2)] px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-[var(--ink-2)] hover:border-brand-300 hover:text-[var(--primary)] dark:hover:border-brand-500/40"
              href={`/blog#${post.category}`}
            >
              {category.label}
            </a>
            <p class="text-xs font-semibold text-[var(--muted)]">
              {formatDate(post.publishedAt)} · {readingMinutes} min read
            </p>
          </div>
          <h1 class="mt-3 text-3xl font-black leading-tight tracking-tight text-[var(--ink)] sm:text-4xl">
            {post.title}
          </h1>
          <p class="mt-3 text-lg leading-8 text-[var(--muted)]">{post.description}</p>
        </header>

        {seo?.intro_html ? (
          <div class="mt-6 rounded-2xl border border-brand-200 bg-brand-50 p-5 text-sm leading-7 text-brand-900 dark:border-brand-800 dark:bg-brand-950/40 dark:text-brand-100">
            {seo.intro_html}
          </div>
        ) : null}

        {
          headings.length >= 3 ? (
            <details class="mt-6 rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-4 xl:hidden">
              <summary class="cursor-pointer text-sm font-bold text-[var(--ink)]">
                On this page
              </summary>
              <ol class="mt-3 space-y-2 text-sm">
                {headings.map((heading) => (
                  <li class={heading.level === 3 ? "pl-4" : ""}>
                    <a class="text-[var(--ink-2)] hover:text-[var(--primary)] hover:underline" href={`#${heading.id}`}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          ) : null
        }

        <div class="article-body mt-8" set:html={renderArticleBody(post.body)} />

        {!noindex ? <AdSlot /> : null}

        <footer class="mt-10 rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-5 text-sm">
          <p class="font-bold text-[var(--ink)]">Put the guide into practice</p>
          <p class="mt-2 leading-6 text-[var(--muted)]">
            Reading changes nothing until you attempt a timed paper and review the errors.
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a
              class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-brand-700"
              href="/mock-tests"
            >
              Browse mock tests
            </a>
            <a
              class="rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-sm font-bold text-[var(--ink)] transition-colors hover:border-brand-300 dark:hover:border-brand-500/40"
              href="/blog"
            >
              All guides
            </a>
          </div>
        </footer>

        <div class="mt-6 rounded-xl border border-[var(--border)] p-4 text-xs leading-6 text-[var(--muted)]">
          <p>
            Written and reviewed by the CUET Free Mock Test editorial team. Last reviewed
            {formatDate(updatedAt)}. This is preparation guidance, not an official NTA
            publication. Practice scores and ranks on this site are indicators, not official
            results.
          </p>
        </div>

        {
          related.length > 0 ? (
            <section class="mt-12 border-t border-[var(--border)] pt-8" aria-labelledby="related-guides">
              <h2
                id="related-guides"
                class="text-xl font-black tracking-tight text-[var(--ink)]"
              >
                Read next
              </h2>
              <div class="mt-4 grid gap-3 sm:grid-cols-3">
                {related.map((guide) => (
                  <a
                    class="flex flex-col rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4 transition-colors hover:border-brand-300 dark:hover:border-brand-500/40"
                    href={guidePath(guide.slug)}
                  >
                    <p class="text-[10px] font-bold uppercase tracking-wide text-[var(--muted)]">
                      {GUIDE_CATEGORY_META[guide.category].label}
                    </p>
                    <p class="mt-1 text-sm font-bold leading-snug text-[var(--ink)]">
                      {guide.title}
                    </p>
                    <span class="mt-auto pt-3 text-xs font-bold text-[var(--primary)]">Read →</span>
                  </a>
                ))}
              </div>
            </section>
          ) : null
        }
      </div>

      {
        headings.length >= 3 ? (
          <aside class="hidden xl:block">
            <nav
              class="sticky top-24 rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] p-4"
              aria-label="On this page"
            >
              <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]">
                On this page
              </p>
              <ol class="mt-3 space-y-2 border-l border-[var(--border)] pl-3 text-sm">
                {headings.map((heading) => (
                  <li class={heading.level === 3 ? "pl-3" : ""}>
                    <a
                      class="text-[var(--ink-2)] hover:text-[var(--primary)] hover:underline"
                      href={`#${heading.id}`}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        ) : null
      }
    </div>
  </article>
</BaseLayout>

<style>
  .article-body :global(h2) {
    margin-top: 2.25rem;
    scroll-margin-top: 6rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .article-body :global(h3) {
    margin-top: 1.75rem;
    scroll-margin-top: 6rem;
    font-size: 1.2rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--ink);
  }
  .article-body :global(h4) {
    margin-top: 1.5rem;
    scroll-margin-top: 6rem;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .article-body :global(p) {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--ink-2);
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin-top: 1rem;
    padding-left: 1.4rem;
    line-height: 1.85;
  }
  .article-body :global(ul) { list-style: disc; }
  .article-body :global(ol) { list-style: decimal; }
  .article-body :global(li) { margin-top: 0.35rem; color: var(--ink-2); }
  .article-body :global(blockquote) {
    margin-top: 1.25rem;
    border-left: 3px solid var(--correct);
    padding: 0.25rem 0 0.25rem 1rem;
    color: var(--muted);
    font-style: italic;
  }
  .article-body :global(pre) {
    margin-top: 1.25rem;
    overflow-x: auto;
    border-radius: 0.75rem;
    background: var(--footer-bg);
    padding: 1rem;
    color: var(--footer-ink);
    font-size: 0.85rem;
  }
  .article-body :global(a) { text-decoration: underline; }
</style>
