---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { devResetLinkAllowed } from "../lib/email-config";
import { emailConfigured } from "../lib/email";

const mailReady = emailConfigured();
const devResetLink = devResetLinkAllowed(import.meta.env.PROD, env.DEV_SHOW_RESET_LINK);
const resetUnavailable = !mailReady && !devResetLink;
const resetMode = resetUnavailable ? "unavailable" : devResetLink ? "development" : "email";
---

<BaseLayout title="Reset your password — CUET Free Mock Test" noindex>
  <section class="mx-auto max-w-md px-4 py-16 sm:px-6" data-reset-mode={resetMode}>
    <h1 class="text-3xl font-black tracking-tight">Reset your password</h1>
    <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-300">
      Enter the email on your account. If it exists, we will create a one-hour reset link.
    </p>
    {resetUnavailable ? (
      <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
        Password reset by email is not available yet. Contact
        <a class="font-semibold underline" href="mailto:support@cuetfreemocktest.com">support@cuetfreemocktest.com</a>
        and we will help you regain access.
      </p>
    ) : devResetLink ? (
      <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
        Email delivery is not configured in this build. In development, the reset link is shown after you submit and is never added to a production response.
      </p>
    ) : (
      <p class="mt-3 rounded-lg border border-neutral-200 bg-neutral-50 p-3 text-xs text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300">
        We will email a one-hour reset link if the address has an account.
      </p>
    )}
    <p id="form-message" class="mt-4 hidden rounded-lg px-3 py-2 text-sm"></p>
    <form id="forgot-form" class="mt-5 space-y-4" data-disabled={resetUnavailable ? "true" : "false"}>
      <label class="block text-sm font-medium">
        Email
        <input name="email" type="email" autocomplete="email" required class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200 dark:border-neutral-700 dark:bg-neutral-950 dark:focus:ring-brand-900" />
      </label>
      <button class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60" type="submit" disabled={resetUnavailable}>Create reset link</button>
    </form>
    <p class="mt-4 text-sm"><a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/login">Back to login</a></p>
  </section>

  <script is:inline>
    const form = document.getElementById("forgot-form");
    const box = document.getElementById("form-message");
    if (form?.dataset.disabled !== "true") {
      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const button = form.querySelector("button[type=submit]");
        button.disabled = true;
        const data = Object.fromEntries(new FormData(form).entries());
        try {
          const response = await fetch("/api/auth/forgot", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await response.json();
          box.className = "mt-4 rounded-lg px-3 py-2 text-sm " + (response.ok
            ? "bg-brand-50 text-brand-900 dark:bg-brand-950/50 dark:text-brand-200"
            : "bg-red-50 text-red-800 dark:bg-red-950/50 dark:text-red-200");
          box.textContent = result.message || result.error;
          if (result.devResetUrl) {
            const link = document.createElement("a");
            link.href = result.devResetUrl;
            link.className = "mt-2 block font-semibold underline";
            link.textContent = "Open development reset link";
            box.append(link);
          }
        } catch {
          box.className = "mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800";
          box.textContent = "Could not create a reset link.";
        } finally {
          button.disabled = false;
          box.classList.remove("hidden");
        }
      });
    }
  </script>
</BaseLayout>
