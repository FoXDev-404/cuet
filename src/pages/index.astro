    icon: "chart",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  canonical={seo?.canonical_url}
  structuredData={structuredData}
>
  {announcements.length > 0 ? (
    <div class="border-b border-neutral-200 bg-neutral-50 dark:border-white/10 dark:bg-ink-900">
      <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-2.5 text-sm sm:px-6">
        {announcements.map((announcement) => (
          <p class="text-neutral-600 dark:text-white/65">
            <span class="mr-2 rounded-full bg-accent-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent-700 dark:bg-accent-500/15 dark:text-accent-300">Notice</span>
            {announcement.link ? (
              <a class="font-semibold text-neutral-800 underline decoration-neutral-300 underline-offset-2 hover:decoration-accent-600 dark:text-white/85 dark:decoration-white/20 dark:hover:decoration-accent-300" href={announcement.link}>
                {announcement.message}
              </a>
            ) : (
              announcement.message
            )}
          </p>
        ))}
      </div>
    </div>
  ) : null}

  <section class="hero-grid hero-fade relative overflow-hidden text-neutral-900 dark:text-white">
    <div class="relative z-10 mx-auto grid max-w-6xl gap-10 px-4 pb-20 pt-14 sm:px-6 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:pb-24 lg:pt-20">
      <div class="min-w-0">
        <p class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white/70 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-600 dark:border-white/10 dark:bg-white/[0.04] dark:text-white/55">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-500 shadow-[var(--shadow-brand)] dark:bg-accent-400" aria-hidden="true"></span>
          {localPapers.length} previous-year papers · {localYears.length} exam years
        </p>

        <h1 class="mt-6 max-w-2xl text-4xl font-black leading-[1.05] tracking-[-0.035em] sm:text-5xl lg:text-6xl">
          Practice <span class="text-accent-700 dark:text-accent-300">FREE</span> Online CUET 2027 Mock Tests for UG
        </h1>

        <p class="mt-5 max-w-xl text-base leading-7 text-neutral-600 sm:text-lg sm:leading-8 dark:text-white/55">
          NTA-pattern practice papers, previous-year questions (PYQs), and time-bound full-length test series for CUET UG. Start practising today.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/mock-tests"
            class="group inline-flex items-center gap-2 rounded-xl bg-brand-500 px-5 py-3 text-sm font-bold text-white shadow-[var(--shadow-brand)] transition-colors hover:bg-brand-600"
          >
            Start a Mock Test
