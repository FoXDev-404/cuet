---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Access denied — CUET Free Mock Test" noindex>
  <section class="mx-auto max-w-lg px-4 py-20 text-center sm:px-6">
    <p class="text-sm font-bold uppercase tracking-widest text-brand-700 dark:text-brand-300">403</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight">You do not have access to this page.</h1>
    <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-300">
      This area is limited to site staff. If you believe your account should have access, contact the administrator.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" href="/">Go home</a>
      <a class="rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-900" href="/dashboard">My dashboard</a>
    </div>
  </section>
</BaseLayout>
