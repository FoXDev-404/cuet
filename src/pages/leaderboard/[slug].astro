---
import { siteUrl } from "../../lib/site-url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allOr, first, firstOr } from "../../lib/db";
import { dbUnavailableResponse } from "../../lib/db-resilient";
import { getLocalMockFallback } from "../../lib/local-mock-fallback";
import { formatDuration } from "../../lib/content";
import { breadcrumbJsonLd } from "../../lib/seo";
import { percentileFor } from "../../lib/ranking";
import { isFixtureMock, isFixtureSlug, isProductionEnvironment } from "../../lib/fixtures";

const slug = Astro.params.slug ?? "";
if (isProductionEnvironment() && isFixtureSlug(slug)) {
  return new Response("Leaderboard not found", { status: 404 });
}
let mock: {
  id: number;
  title: string;
  slug: string;
  total_marks: number;
  duration_min: number;
  version_id: number;
  practice_paper_slug: string | null;
} | null = null;
try {
  mock = await first<{
    id: number;
    title: string;
    slug: string;
    total_marks: number;
    duration_min: number;
    version_id: number;
    practice_paper_slug: string | null;
  }>(
    `SELECT m.id, m.title, m.slug, v.total_marks, v.duration_min, v.id AS version_id,
            m.practice_paper_slug
     FROM mock_tests m JOIN mock_test_versions v ON v.id = m.current_version_id
     WHERE m.slug = ? AND m.status = 'published' AND m.deleted_at IS NULL`,
    slug,
  );
} catch (error) {
  // D1 is unreachable (for example the daily row-read quota is spent). Keep a
  // practice-paper board online with an empty ranking instead of a 404/500.
  console.error("Leaderboard paper lookup failed", error);
  const fallback = getLocalMockFallback(slug);
  mock = fallback
    ? {
        id: fallback.id,
        title: fallback.title,
        slug: fallback.slug,
        total_marks: fallback.total_marks,
        duration_min: fallback.duration_min,
        version_id: 0,
        practice_paper_slug: fallback.slug,
      }
    : null;
  if (!mock) return dbUnavailableResponse();
}
if (!mock || (isProductionEnvironment() && isFixtureMock(mock))) return new Response("Leaderboard not found", { status: 404 });

const [rows, summary, mine] = await Promise.all([
  allOr<{
    rank: number;
    user_id: number;
    username: string;
    score: number;
    correct: number;
    wrong: number;
    time_taken_sec: number;
    submitted_at: string;
  }>(
    `SELECT rank, user_id, username, score, correct, wrong, time_taken_sec, submitted_at FROM (
       SELECT a.user_id, u.username, a.score, a.correct, a.wrong, a.time_taken_sec, a.submitted_at,
              RANK() OVER (ORDER BY a.score DESC, a.time_taken_sec ASC, (CASE WHEN a.correct + a.wrong > 0 THEN a.correct * 1.0 / (a.correct + a.wrong) ELSE 0 END) DESC) AS rank
       FROM attempts a JOIN users u ON u.id = a.user_id
       WHERE a.version_id = ? AND a.status = 'submitted' AND a.is_first_attempt = 1 AND u.deleted_at IS NULL
     ) ORDER BY rank, submitted_at LIMIT 100`, [],
    mock.version_id,
  ),
  firstOr<{ eligible: number; average: number | null; best: number | null }>(
    `SELECT COUNT(*) AS eligible, AVG(a.score) AS average, MAX(a.score) AS best
     FROM attempts a JOIN users u ON u.id = a.user_id
     WHERE a.version_id = ? AND a.status = 'submitted' AND a.is_first_attempt = 1 AND u.deleted_at IS NULL`, null,
    mock.version_id,
  ),
  Astro.locals.user
    ? firstOr<{ rank: number; score: number; time_taken_sec: number; correct: number; wrong: number }>(
        `SELECT rank, score, time_taken_sec, correct, wrong FROM (
           SELECT a.user_id, a.score, a.time_taken_sec, a.correct, a.wrong,
                  RANK() OVER (ORDER BY a.score DESC, a.time_taken_sec ASC, (CASE WHEN a.correct + a.wrong > 0 THEN a.correct * 1.0 / (a.correct + a.wrong) ELSE 0 END) DESC) AS rank
           FROM attempts a JOIN users u ON u.id = a.user_id
           WHERE a.version_id = ? AND a.status = 'submitted' AND a.is_first_attempt = 1 AND u.deleted_at IS NULL
         ) WHERE user_id = ?`, null,
        mock.version_id,
        Astro.locals.user.id,
      )
    : null,
]);

const eligible = summary?.eligible ?? 0;
const average = summary?.average ?? null;
const startHref = mock.practice_paper_slug
  ? `/practice/${mock.practice_paper_slug}`
  : `/mock/${mock.slug}/instructions`;
const medals = ["🥇", "🥈", "🥉"];
const myRank = mine?.rank ?? null;
const myPercentile = myRank ? percentileFor(myRank, eligible) : null;
const site = siteUrl(Astro.url);
const structuredData = breadcrumbJsonLd(site, [
  { name: "Home", path: "/" },
  { name: "Leaderboard", path: "/leaderboard" },
  { name: mock.title, path: `/leaderboard/${mock.slug}` },
]);
---

<BaseLayout
  title={`${mock.title} Leaderboard — CUET Free Mock Test`}
  description={`First-attempt leaderboard for ${mock.title}. See top scores, accuracy and time among CUET UG mock test students.`}
  noindex={eligible === 0 || isFixtureSlug(mock.slug) || isFixtureMock(mock)}
  structuredData={structuredData}
>
  <section class="border-b border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900/40">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <nav class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
        <a class="hover:underline" href="/leaderboard">Leaderboard</a>
        <span aria-hidden="true">/</span>
        <span class="truncate">{mock.title}</span>
      </nav>
      <h1 class="mt-3 text-2xl font-black tracking-tight sm:text-4xl">{mock.title}</h1>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
        {eligible} ranked first attempt{eligible === 1 ? "" : "s"} · {mock.duration_min} minute paper · {mock.total_marks} marks
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        <a class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" href={startHref}>Take this paper</a>
        <a class="rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-900" href={`/mock/${mock.slug}/instructions`}>Instructions</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Ranked students</p>
        <p class="mt-1 text-3xl font-black">{eligible}</p>
      </div>
      <div class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Average score</p>
        <p class="mt-1 text-3xl font-black">{average !== null ? Math.round(average * 10) / 10 : "—"}</p>
      </div>
      <div class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Top score</p>
        <p class="mt-1 text-3xl font-black">{summary?.best ?? "—"}</p>
      </div>
    </div>

    {mine ? (
      <div class="mt-4 flex flex-wrap items-center gap-3 rounded-2xl border border-brand-200 bg-brand-50 p-4 dark:border-brand-800 dark:bg-brand-950/40">
        <p class="font-bold text-brand-900 dark:text-brand-200">Your rank: #{myRank}</p>
        <p class="text-sm text-brand-800 dark:text-brand-300">
          {mine.score} marks · {formatDuration(mine.time_taken_sec)} · {mine.correct} correct · {mine.wrong} wrong
          {myPercentile !== null ? ` · ${myPercentile} percentile` : ""}
        </p>
      </div>
    ) : Astro.locals.user ? (
      <p class="mt-4 rounded-2xl border border-neutral-200 bg-neutral-50 p-4 text-sm text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400">
        You are not on this board yet. Only your first submitted attempt is ranked, so take the mock once to enter.
      </p>
    ) : (
      <p class="mt-4 rounded-2xl border border-neutral-200 bg-neutral-50 p-4 text-sm text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400">
        <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href={`/login?next=${encodeURIComponent(`/leaderboard/${mock.slug}`)}`}>Log in</a>
        {" "}or take the mock as a guest; creating an account afterwards adds that attempt to the board.
      </p>
    )}

    <div class="mt-6 overflow-x-auto rounded-2xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900" role="region" aria-label={`${mock.title} leaderboard table`} tabindex="0">
      <table class="w-full min-w-[680px] text-left text-sm">
        <thead class="border-b border-neutral-200 bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-400">
          <tr>
            <th class="px-4 py-3">Rank</th>
            <th class="px-4 py-3">Student</th>
            <th class="px-4 py-3 text-right">Score</th>
            <th class="px-4 py-3 text-right">Accuracy</th>
            <th class="px-4 py-3 text-right">Time</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
          {rows.map((row) => {
            const attempts = row.correct + row.wrong;
            const accuracy = attempts > 0 ? Math.round((row.correct / attempts) * 1000) / 10 : 0;
            const isMe = Astro.locals.user?.id === row.user_id;
            return (
              <tr class:list={[isMe ? "bg-brand-50 dark:bg-brand-950/30" : ""]}>
                <td class="whitespace-nowrap px-4 py-3 font-bold">
                  {medals[row.rank - 1] ? <span class="mr-1" aria-hidden="true">{medals[row.rank - 1]}</span> : null}
                  #{row.rank}
                </td>
                <td class="max-w-[16rem] truncate px-4 py-3 font-medium">
                  {row.username}
                  {isMe ? <span class="ml-2 rounded-full bg-brand-600 px-2 py-0.5 text-[10px] font-bold uppercase text-white">You</span> : null}
                </td>
                <td class="px-4 py-3 text-right font-bold">{row.score}<span class="text-xs font-normal text-neutral-600 dark:text-neutral-400"> / {mock.total_marks}</span></td>
                <td class="px-4 py-3 text-right">{accuracy}%</td>
                <td class="px-4 py-3 text-right text-xs text-neutral-500 dark:text-neutral-400">{formatDuration(row.time_taken_sec)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      {rows.length === 0 ? (
        <div class="px-4 py-12 text-center text-sm text-neutral-500 dark:text-neutral-400">
          No ranked attempts yet. <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href={startHref}>Take the first attempt →</a>
        </div>
      ) : null}
    </div>
    <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">Showing up to 100 ranked students. Ties are broken by time taken, then by accuracy. Not an official NTA rank.</p>
  </section>
</BaseLayout>
