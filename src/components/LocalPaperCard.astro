---
import type { LocalPaperSummary } from "../lib/local-papers";

interface Props {
  paper: LocalPaperSummary;
}

const { paper } = Astro.props;
const scoredLabel = `${paper.scorableQuestionCount} of ${paper.recoveredQuestionCount}`;
const attemptLabel = `${paper.attemptCount.toLocaleString("en-IN")} attempt${paper.attemptCount === 1 ? "" : "s"}`;
---

<article class="flex h-full flex-col rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span class="rounded-full bg-brand-100 px-2.5 py-1 font-semibold text-brand-900 dark:bg-brand-900/50 dark:text-brand-200">{paper.year}</span>
    <a class="rounded-full bg-neutral-100 px-2.5 py-1 font-semibold text-neutral-600 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700" href={`/pyq/${paper.year}/${paper.subject.slug}`}>{paper.subject.name}</a>
    {paper.shift ? <span class="rounded-full bg-neutral-100 px-2.5 py-1 font-semibold text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">{paper.shift}</span> : null}
    <span class="rounded-full bg-emerald-100 px-2.5 py-1 font-semibold text-emerald-900 dark:bg-emerald-950/50 dark:text-emerald-200">{attemptLabel}</span>
  </div>

  <h3 class="mt-3 text-lg font-bold leading-snug">
    <a class="hover:text-brand-700 dark:hover:text-brand-300" href={paper.path}>{paper.title}</a>
  </h3>
  <p class="mt-2 text-xs leading-5 text-neutral-500 dark:text-neutral-400">
    {paper.recoveredQuestionCount} question{paper.recoveredQuestionCount === 1 ? "" : "s"} · {paper.durationMinutes} minutes · +{paper.markingScheme.correct}/{paper.markingScheme.wrong} marking.
  </p>

  <dl class="mt-4 grid grid-cols-3 gap-2 text-sm">
    <div class="rounded-lg bg-neutral-50 p-2 dark:bg-neutral-950">
      <dt class="text-[11px] uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Questions</dt>
      <dd class="font-bold">{paper.recoveredQuestionCount}</dd>
    </div>
    <div class="rounded-lg bg-neutral-50 p-2 dark:bg-neutral-950">
      <dt class="text-[11px] uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Minutes</dt>
      <dd class="font-bold">{paper.durationMinutes}</dd>
    </div>
    <div class="rounded-lg bg-neutral-50 p-2 dark:bg-neutral-950">
      <dt class="text-[11px] uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Scored</dt>
      <dd class="font-bold">{paper.scorableQuestionCount}</dd>
    </div>
  </dl>

  <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">
    +{paper.markingScheme.correct} correct · −{paper.markingScheme.wrong} wrong · {scoredLabel} scored
    {paper.pendingReviewCount > 0 ? ` · ${paper.pendingReviewCount} excluded (no printed key)` : ""}
  </p>

  <div class="mt-auto flex flex-wrap items-center gap-3 pt-4">
    <a class="inline-flex rounded-lg bg-brand-600 px-4 py-2 text-sm font-bold text-white hover:bg-brand-700" href={`/mock/${paper.slug}/instructions`}>Start ranked paper →</a>
    <a class="text-xs font-semibold text-neutral-600 hover:underline dark:text-neutral-300" href={paper.path}>View details</a>
  </div>
</article>
