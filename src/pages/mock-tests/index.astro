---
import { siteUrl } from "../../lib/site-url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperFilters from "../../components/PaperFilters.astro";
import PaperRow from "../../components/PaperRow.astro";
import StartHereCard from "../../components/StartHereCard.astro";
import FaqSection from "../../components/FaqSection.astro";
import type { FaqItem } from "../../lib/seo";
import {
  getLocalPapers,
  getLocalPaperYears,
  getLocalSubjectSummaries,
} from "../../lib/local-papers";
import {
  applyFilters,
  buildFilterUrl,
  isFiltered,
  paginate,
  recommendPapers,
  sanitizeParams,
  sortPapers,
} from "../../lib/paper-list";

const PATH = "/mock-tests";
const allPapers = getLocalPapers();
const yearEntries = getLocalPaperYears();
const availableYears = yearEntries.map((y) => y.year);
const subjectSummaries = getLocalSubjectSummaries();
const availableSubjectSlugs = subjectSummaries.map((s) => s.subject.slug);

// Parse and validate query params
const params = sanitizeParams(Astro.url.searchParams, availableYears, availableSubjectSlugs);
const hasActiveFilters = isFiltered(params);

// Filter, sort, and paginate
const filteredPapers = applyFilters(allPapers, params);
const sortedPapers = sortPapers(filteredPapers, params.sort);
const pagination = paginate(sortedPapers, params.page, 24);

// Recommended papers for "Start here" (shown on page 1 when not searching and subject is all)
const candidatesForRecommendation = params.year !== "all" ? filteredPapers : allPapers;
let recommendedPapers =
  params.page === 1 && !params.q && params.subject === "all" && params.type === "all"
    ? recommendPapers(candidatesForRecommendation, 2)
    : [];
if (recommendedPapers.length === 0 && params.page === 1 && !params.q && params.subject === "all" && params.type === "all") {
  recommendedPapers = recommendPapers(allPapers, 2);
}
const showStartHere = recommendedPapers.length > 0;

// Facts summary
const totalPapersCount = allPapers.length;
const subjectCount = subjectSummaries.length;
const minYear = Math.min(...availableYears);
const maxYear = Math.max(...availableYears);
const factsLine = `${totalPapersCount} papers · ${subjectCount} subjects · ${minYear} to ${maxYear}`;

// SEO & Canonical Rules
// Filter variants must be noindex, follow with canonical pointing to base hub /mock-tests
const isIndexedHub = !hasActiveFilters;
const site = siteUrl(Astro.url);
const canonicalUrl = new URL(PATH, site).toString();

const pageTitle = "CUET Mock Tests — Practice Previous-Year Papers";
const pageDescription =
  "Practice with previous-year CUET UG papers in an authentic exam interface with server timers, server grading, full answer keys, and first-attempt leaderboards.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", site).toString() },
      { "@type": "ListItem", position: 2, name: "Mock tests", item: canonicalUrl },
    ],
  },
];

const listHeading =
  params.year !== "all"
    ? `${params.year} papers`
    : params.subject !== "all"
      ? `${subjectSummaries.find((s) => s.subject.slug === params.subject)?.subject.name ?? "Subject"} papers`
      : "Previous-year papers";

const nextPageUrl = pagination.nextPage
  ? buildFilterUrl(PATH, params, { page: pagination.nextPage })
  : null;
const prevPageUrl = pagination.prevPage
  ? buildFilterUrl(PATH, params, { page: pagination.prevPage })
  : null;

const faqs: FaqItem[] = [
  {
    question: "How does leaderboard ranking work?",
    answer:
      "Every paper runs on a deterministic server grading engine. Your very first submitted attempt is the one that enters the public leaderboard for that paper. You can retake papers as many times as you like to practice, and retake scores are saved to your dashboard history, but only the initial attempt determines leaderboard rank.",
  },
  {
    question: "What is the difference between Full key and Key N of M?",
    answer:
      "A 'Full key' badge indicates that all questions in the paper have verified printed answer keys and contribute to your score. A 'Key N of M' badge indicates a paper where certain questions lacked a definitive printed key from the source booklet; those specific questions are excluded from scoring so your percentage and marks remain fair.",
  },
  {
    question: "What is the distinction between Full papers and Mini papers?",
    answer:
      "Full papers contain 40 or more questions matching complete CUET test sessions (typically 50 questions, 45 to 60 minutes). Mini papers are focused sets containing fewer than 40 questions, ideal for quick revision or targeted topic drills under realistic exam timing.",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  noindex={!isIndexedHub}
  structuredData={structuredData}
>
  <!-- Universal Hero Banner -->
  <section class="border-b border-neutral-200 bg-gradient-to-b from-brand-50 to-white dark:border-neutral-800 dark:from-brand-950/30 dark:to-neutral-950">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
      <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400">
        <a href="/" class="hover:underline">Home</a>
        <span aria-hidden="true">/</span>
        <span class="font-semibold text-neutral-900 dark:text-neutral-100">Mock tests</span>
      </nav>

      <p class="text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-300">
        CUET UG · Previous-Year Papers
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-5xl text-neutral-900 dark:text-white">
        Practice with previous-year CUET mock tests
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-neutral-600 sm:text-lg dark:text-neutral-300">
        Timed, server-graded attempts with authentic exam timing, hidden answer keys, and first-attempt leaderboards.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-2.5 text-xs">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-200 bg-white px-3 py-1 font-semibold text-brand-800 shadow-sm dark:border-brand-800 dark:bg-neutral-900 dark:text-brand-200">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500 dark:bg-brand-400" aria-hidden="true"></span>
          {factsLine}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1 font-semibold text-neutral-700 shadow-sm dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300">
          First attempt counts on leaderboard
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1 font-semibold text-neutral-700 shadow-sm dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300">
          Solutions revealed post-submit
        </span>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-10 pb-28 lg:pb-16 pb-[calc(6rem+env(safe-area-inset-bottom))]">
    <!-- Filter & Search Bar -->
    <PaperFilters
      basePath={PATH}
      params={params}
      years={availableYears}
      subjects={subjectSummaries}
      totalFiltered={pagination.total}
      startIndex={pagination.startIndex}
      endIndex={pagination.endIndex}
    />

    <!-- Start Here (Recommended Full Papers) -->
    {showStartHere && recommendedPapers.length > 0 && (
      <section class="mt-10 mb-12" aria-labelledby="start-here-heading">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 id="start-here-heading" class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
              Start here
            </h2>
            <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
              Recommended full-length papers with complete answer keys
            </p>
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {recommendedPapers.map((paper) => (
            <StartHereCard paper={paper} />
          ))}
        </div>
      </section>
    )}

    <!-- Main Paper List -->
    <main class="mt-8" id="papers-list-section">
      <!-- Section Header -->
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-neutral-200 pb-3 dark:border-neutral-800">
        <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          {listHeading}
        </h2>
        <div class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">
          Showing {pagination.startIndex} to {pagination.endIndex} of {pagination.total}
        </div>
      </div>

      <!-- Papers Container -->
      <div id="papers-container" class="mt-4 space-y-3">
        {pagination.items.map((paper) => (
          <PaperRow paper={paper} />
        ))}
      </div>

      <!-- Empty State -->
      {pagination.total === 0 && (
        <div class="mt-8 rounded-2xl border border-dashed border-neutral-300 p-12 text-center dark:border-neutral-700">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400 dark:bg-neutral-800">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="mt-4 text-base font-bold text-neutral-900 dark:text-white">No papers match your filters</h3>
          <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
            Try searching for a different subject, expanding the year filter, or switching between Full and Mini papers.
          </p>
          <div class="mt-6">
            <a
              href={PATH}
              class="inline-flex rounded-xl bg-brand-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-brand-700 transition-colors"
            >
              Clear all filters
            </a>
          </div>
        </div>
      )}

      <!-- Pagination & Show More Progressive Enhancement -->
      {pagination.totalPages > 1 && (
        <div id="pagination-controls" class="mt-10 flex flex-col items-center justify-center gap-3">
          <!-- JS Progressive Enhancement Button -->
          {nextPageUrl && (
            <button
              type="button"
              id="show-more-btn"
              data-next-url={nextPageUrl}
              class="inline-flex items-center justify-center rounded-xl border border-neutral-300 bg-white px-6 py-3 text-sm font-bold text-neutral-900 shadow-sm transition-colors hover:bg-neutral-50 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-900 dark:text-white dark:hover:bg-neutral-800"
            >
              Show {Math.min(pagination.pageSize, pagination.total - pagination.endIndex)} more
            </button>
          )}

          <!-- Fallback No-JS Pagination Links -->
          <noscript>
            <div class="flex items-center gap-3 text-sm font-semibold">
              {prevPageUrl ? (
                <a href={prevPageUrl} class="rounded-lg border border-neutral-300 px-3 py-1.5 hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-800">
                  ← Previous page
                </a>
              ) : null}
              <span class="text-xs text-neutral-500">
                Page {pagination.page} of {pagination.totalPages}
              </span>
              {nextPageUrl ? (
                <a href={nextPageUrl} class="rounded-lg border border-neutral-300 px-3 py-1.5 hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-800">
                  Next page →
                </a>
              ) : null}
            </div>
          </noscript>
        </div>
      )}
    </main>

    <!-- Explanatory Practice Guide -->
    <section class="mt-16 rounded-2xl border border-neutral-200 bg-white p-6 sm:p-8 shadow-sm dark:border-neutral-800 dark:bg-neutral-900" aria-labelledby="guide-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-neutral-100 pb-4 dark:border-neutral-800">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-300">Practice Guide</p>
          <h2 id="guide-heading" class="mt-1 text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
            How previous-year mock tests work
          </h2>
        </div>
        <div class="flex flex-wrap gap-3 text-xs font-semibold">
          <a href="/cuet-ug-syllabus" class="text-brand-600 hover:underline dark:text-brand-400">Syllabus →</a>
          <a href="/cuet-ug-marking-scheme" class="text-brand-600 hover:underline dark:text-brand-400">Marking scheme →</a>
          <a href="/cuet-ug-previous-year-papers" class="text-brand-600 hover:underline dark:text-brand-400">PYQ archive →</a>
        </div>
      </div>

      <div class="mt-6 grid gap-6 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300 md:grid-cols-3">
        <div class="rounded-xl border border-neutral-100 bg-neutral-50/60 p-4 dark:border-neutral-800/60 dark:bg-neutral-800/30">
          <div class="flex items-center gap-2 font-bold text-neutral-900 dark:text-neutral-100">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700 dark:bg-brand-900/60 dark:text-brand-300">1</span>
            Realistic exam timing
          </div>
          <p class="mt-2 text-xs leading-5">
            Each paper is calibrated to printed NTA exam durations. Answers remain strictly hidden while the timer runs, simulating real test day conditions.
          </p>
        </div>

        <div class="rounded-xl border border-neutral-100 bg-neutral-50/60 p-4 dark:border-neutral-800/60 dark:bg-neutral-800/30">
          <div class="flex items-center gap-2 font-bold text-neutral-900 dark:text-neutral-100">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700 dark:bg-brand-900/60 dark:text-brand-300">2</span>
            First-attempt leaderboard
          </div>
          <p class="mt-2 text-xs leading-5">
            Only your initial submitted attempt enters the public paper leaderboard for fair ranking. Retakes are saved to your dashboard for concept reinforcement.
          </p>
        </div>

        <div class="rounded-xl border border-neutral-100 bg-neutral-50/60 p-4 dark:border-neutral-800/60 dark:bg-neutral-800/30">
          <div class="flex items-center gap-2 font-bold text-neutral-900 dark:text-neutral-100">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700 dark:bg-brand-900/60 dark:text-brand-300">3</span>
            Scored vs unscored items
          </div>
          <p class="mt-2 text-xs leading-5">
            Papers labeled <strong>Full key</strong> score every question. Papers labeled <strong>Key N of M</strong> exclude questions with no printed key in original source booklets to protect scoring accuracy.
          </p>
        </div>
      </div>
    </section>

    <!-- Frequently Asked Questions using Universal FaqSection -->
    <FaqSection faqs={faqs} />
  </div>

  <script>
    // Progressive enhancement: "Show more" button loads next batch via fetch
    const showMoreBtn = document.getElementById("show-more-btn") as HTMLButtonElement | null;
    const papersContainer = document.getElementById("papers-container");

    if (showMoreBtn && papersContainer) {
      showMoreBtn.addEventListener("click", async () => {
        const nextUrl = showMoreBtn.getAttribute("data-next-url");
        if (!nextUrl) return;

        showMoreBtn.disabled = true;
        showMoreBtn.textContent = "Loading...";

        try {
          const res = await fetch(nextUrl);
          if (!res.ok) throw new Error("Failed to load");
          const text = await res.text();
          const doc = new DOMParser().parseFromString(text, "text/html");

          // Extract new rows
          const newRows = doc.querySelectorAll("#papers-container > article");
          newRows.forEach((row) => {
            papersContainer.appendChild(row);
          });

          // Check if there is another next page
          const nextBtn = doc.getElementById("show-more-btn");
          if (nextBtn) {
            const newNextUrl = nextBtn.getAttribute("data-next-url");
            if (newNextUrl) {
              showMoreBtn.setAttribute("data-next-url", newNextUrl);
              showMoreBtn.disabled = false;
              showMoreBtn.textContent = nextBtn.textContent || "Show more";
            } else {
              showMoreBtn.remove();
            }
          } else {
            showMoreBtn.remove();
          }
        } catch (err) {
          console.error("Show more failed:", err);
          // Fall back to normal navigation if fetch fails
          window.location.href = nextUrl;
        }
      });
    }
  </script>
</BaseLayout>
