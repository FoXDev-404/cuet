---
import { firstOr } from "../../../lib/db";
import { getLocalSubjectCards } from "../../../lib/local-subject-fallback";
import { getPyqSubjectPath } from "../../../lib/pyq-subject-path";

const subject = Astro.params.subject ?? "";
const dbSubject = await firstOr<{ slug: string; type: string }>(
  `SELECT s.slug, s.type
   FROM subjects s
   JOIN exams e ON e.id = s.exam_id
   WHERE s.slug = ? AND s.is_active = 1 AND e.slug = 'cuet-ug' AND e.is_active = 1`,
  null,
  subject,
);
const localSubject = getLocalSubjectCards().find((item) => item.slug === subject);
const subjectInfo = dbSubject ?? localSubject;

if (!subjectInfo) return new Response("Subject not found", { status: 404 });

return Astro.redirect(getPyqSubjectPath(subjectInfo.slug, subjectInfo.type), 301);
---
