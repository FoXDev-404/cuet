---
import { siteUrl } from "../../lib/site-url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import FaqSection from "../../components/FaqSection.astro";
import LocalPaperCard from "../../components/LocalPaperCard.astro";
import { getLocalPapersForYear } from "../../lib/local-papers";
import { listPyqPapers, pyqMarking } from "../../lib/pyq";
import { renderRichText } from "../../lib/content";
import {
  breadcrumbJsonLd,
  getPageSeo,
  itemListJsonLd,
  parseFaq,
  type FaqItem,
} from "../../lib/seo";

const year = Number(Astro.params.year);
if (!Number.isInteger(year) || year < 2000 || year > 2100) {
  return new Response("Year not found", { status: 404 });
}

const allPapers = await listPyqPapers({ year });
const papers = allPapers.filter((paper) => Boolean(paper.mock_slug));
const localPapers = getLocalPapersForYear(year);
if (papers.length === 0 && localPapers.length === 0) {
  return new Response("No papers for this year", { status: 404 });
}

const playable = papers.filter((paper) => paper.mock_slug);
const totalPapers = playable.length + localPapers.length;
const subjectNames = [
  ...new Set([
    ...papers.map((paper) => paper.subject_name).filter(Boolean),
    ...localPapers.map((paper) => paper.subject.name),
  ]),
] as string[];
const PATH = `/pyq/${year}`;
const seo = await getPageSeo(PATH);
// Thin Content & Rights Policy Gate (Fix R7): PYQ year list pages without cleared papers or 300+ words are noindex
const clearedPaperCount = allPapers.filter((p) => p.rights_status === "cleared").length;
const noindex = (seo?.noindex ?? 0) === 1 || clearedPaperCount === 0;

const DEFAULT_FAQ: FaqItem[] = [
  {
    question: `How many CUET UG ${year} papers are available here?`,
    answer: `${totalPapers} paper${totalPapers === 1 ? "" : "s"} from ${year} ${totalPapers === 1 ? "is" : "are"} available on this site right now. Every paper is ranked, saved to your account and counted on the first-attempt leaderboard.`,
  },
  {
    question: `Are these the official ${year} CUET UG question papers?`,
    answer:
      "These are practice reproductions of previous-year papers. Verify official papers, dates and marking rules against the current NTA bulletin.",
  },
  {
    question: `Can I retake a ${year} paper?`,
    answer:
      "Yes. Every retake is scored and saved in your dashboard, but only the first submitted attempt counts on the leaderboard. The same rule applies to previous-year papers and D1 mocks.",
  },
  {
    question: "Why is a paper missing?",
    answer:
      "Only papers with a complete question set and solutions are published. Incomplete entries stay out of the public archive and out of search.",
  },
];

const customFaq = parseFaq(seo?.faq_json);
const faqs = customFaq.length > 0 ? customFaq : DEFAULT_FAQ;
const title = seo?.title || `CUET UG ${year} Previous Year Papers — Timed Practice`;
const description =
  seo?.description ||
  `Practise ${totalPapers} CUET UG ${year} previous-year paper${totalPapers === 1 ? "" : "s"} as timed mocks with server scoring, detailed solutions and a post-submit review.`;
const site = siteUrl(Astro.url);

const structuredData = [
  breadcrumbJsonLd(site, [
    { name: "Home", path: "/" },
    { name: "Previous-year papers", path: "/cuet-ug-previous-year-papers" },
    { name: String(year), path: PATH },
  ]),
  itemListJsonLd(site, [
    ...playable.map((paper) => ({ name: paper.title, path: `/mock/${paper.mock_slug}` })),
    ...localPapers.map((paper) => ({ name: paper.title, path: paper.path })),
  ]),
].filter((item): item is Record<string, unknown> => Boolean(item));
---

<BaseLayout title={title} description={description} noindex={noindex} canonical={seo?.canonical_url} structuredData={structuredData}>
  <PageHero
    eyebrow={`PYQ · ${year}`}
    title={`CUET UG ${year} previous-year papers`}
    intro={`Rehearse the ${year} paper under a clock, then review the solution for every miss. Every paper is saved and ranked, with the first submitted attempt counting on the leaderboard.`}
  />

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    {seo?.intro_html ? (
      <div class="mb-8 rounded-2xl border border-brand-200 bg-brand-50 p-5 text-sm leading-7 text-brand-900 dark:border-brand-800 dark:bg-brand-950/40 dark:text-brand-100" set:html={renderRichText(seo.intro_html)}></div>
    ) : null}

    <nav class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400" aria-label="Breadcrumb">
      <a class="hover:underline" href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a class="hover:underline" href="/cuet-ug-previous-year-papers">Previous-year papers</a>
      <span aria-hidden="true">/</span>
      <span>{year}</span>
    </nav>

    <section class="mt-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-2xl font-bold tracking-tight">{year} paper library</h2>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            {totalPapers} paper{totalPapers === 1 ? "" : "s"} · {subjectNames.length > 0 ? subjectNames.join(", ") : "mixed subjects"}
          </p>
        </div>
        <a class="text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/cuet-ug-previous-year-papers">All years →</a>
      </div>

      {playable.length > 0 ? (
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {playable.map((paper) => {
            const marking = pyqMarking(paper);
            return (
              <article class="flex flex-col rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <span class="rounded-full bg-brand-100 px-2.5 py-1 font-semibold text-brand-900 dark:bg-brand-900/50 dark:text-brand-200">{paper.year}</span>
                  {paper.shift ? <span class="rounded-full bg-neutral-100 px-2.5 py-1 font-semibold text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">{paper.shift}</span> : null}
                  {paper.subject_name ? (
                    <a class="rounded-full bg-neutral-100 px-2.5 py-1 font-semibold text-neutral-600 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700" href={`/pyq/${paper.year}/${paper.subject_slug}`}>{paper.subject_name}</a>
                  ) : null}
                </div>
                <h3 class="mt-3 text-lg font-bold leading-snug">
                  <a class="hover:text-brand-700 dark:hover:text-brand-300" href={`/mock/${paper.mock_slug}`}>{paper.title}</a>
                </h3>
                <dl class="mt-4 grid grid-cols-3 gap-2 text-sm">
                  <div class="rounded-lg bg-neutral-50 p-2 dark:bg-neutral-950">
                    <dt class="text-[11px] uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Questions</dt>
                    <dd class="font-bold">{paper.question_count ?? 0}</dd>
                  </div>
                  <div class="rounded-lg bg-neutral-50 p-2 dark:bg-neutral-950">
                    <dt class="text-[11px] uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Minutes</dt>
                    <dd class="font-bold">{paper.duration_min ?? "—"}</dd>
                  </div>
                  <div class="rounded-lg bg-neutral-50 p-2 dark:bg-neutral-950">
                    <dt class="text-[11px] uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Marks</dt>
                    <dd class="font-bold">{paper.total_marks ?? "—"}</dd>
                  </div>
                </dl>
                <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">+{marking.correct} correct · {marking.wrong} wrong · {paper.attempt_count ?? 0} attempt{(paper.attempt_count ?? 0) === 1 ? "" : "s"}</p>
                {paper.rights_note ? <p class="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900 dark:bg-amber-950/30 dark:text-amber-200">{paper.rights_note}</p> : null}
                <div class="mt-auto flex flex-wrap items-center gap-3 pt-4">
                  <a class="inline-flex rounded-lg bg-brand-600 px-4 py-2 text-sm font-bold text-white hover:bg-brand-700" href={`/mock/${paper.mock_slug}/instructions`}>Start this paper →</a>
                  {paper.source_url ? (
                    <a class="text-xs font-semibold text-neutral-600 hover:underline dark:text-neutral-300" href={paper.source_url} rel="noopener noreferrer" target="_blank">Source note</a>
                  ) : null}
                </div>
              </article>
            );
          })}
        </div>
      ) : null}

      {localPapers.length > 0 ? (
        <div class={playable.length > 0 ? "mt-10" : "mt-5"}>
          <div class="grid gap-4 md:grid-cols-2">
            {localPapers.map((paper) => <LocalPaperCard paper={paper} />)}
          </div>
        </div>
      ) : null}
    </section>

    <FaqSection faqs={faqs} />

    <section class="mt-10 rounded-2xl bg-brand-600 p-6 text-white sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold">Looking for another year?</h2>
          <p class="mt-2 max-w-xl text-sm leading-6 text-brand-50">Open the full archive to compare papers across sessions, or take a subject mock if your year is not published yet.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a class="rounded-lg bg-white px-4 py-2.5 text-sm font-bold text-brand-800 hover:bg-brand-50" href="/cuet-ug-previous-year-papers">All PYQ papers</a>
          <a class="rounded-lg border border-white/40 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" href="/cuet-ug-mock-test">Mock tests</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
