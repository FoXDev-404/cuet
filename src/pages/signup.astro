---
// Email/password auth has been retired — Google sign-in is the only method.
// Old /signup links land here and continue to the login page.
import { safeNext } from "../lib/http";

const next = safeNext(Astro.url.searchParams.get("next"), "/dashboard");
return Astro.redirect(`/login?next=${encodeURIComponent(next)}`, 301);
---
