              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
          <a
            href="/cuet-ug-previous-year-papers"
            class="inline-flex items-center gap-2 rounded-xl border border-neutral-300 bg-white/70 px-5 py-3 text-sm font-bold text-neutral-700 transition-colors hover:bg-white hover:text-neutral-900 dark:border-white/15 dark:bg-white/[0.03] dark:text-white/80 dark:hover:bg-white/[0.08] dark:hover:text-white"
          >
            Browse Previous-Year Papers
          </a>
        </div>

        <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-xs text-neutral-600 dark:text-white/50">
          <li class="flex items-center gap-2">
            <span class="grid h-4 w-4 place-items-center rounded-full bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300" aria-hidden="true">
              <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7"></path></svg>
            </span>
            Learn at your own pace.
          </li>
          <li class="flex items-center gap-2">
            <span class="grid h-4 w-4 place-items-center rounded-full bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300" aria-hidden="true">
              <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7"></path></svg>
            </span>
            Pick up where you left off.
          </li>
        </ul>

        <p class="mt-5 text-[10px] font-semibold uppercase tracking-[0.18em] text-neutral-500 dark:text-white/50">
          {localPapers.length} papers · {localQuestionCount.toLocaleString("en-IN")} questions · {localScorableCount.toLocaleString("en-IN")} ready to score
          {localPendingCount > 0 ? ` · ${localPendingCount} marked pending review` : ""}
        </p>
      </div>

      <aside class="relative z-10 min-w-0" aria-labelledby="popular-heading">
        <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white/85 shadow-xl shadow-neutral-900/10 backdrop-blur dark:border-white/10 dark:bg-white/[0.035] dark:shadow-2xl dark:shadow-black/40">
          <div class="flex items-start justify-between gap-4 border-b border-neutral-200 px-5 py-4 dark:border-white/10">
            <div>
              <p class="text-[9px] font-bold uppercase tracking-[0.2em] text-neutral-500 dark:text-white/35">From the 2021–2026 previous-year library</p>
              <h2 class="mt-1 text-base font-bold" id="popular-heading">Most Popular Mock Tests</h2>
            </div>
            <a
              href="/mock-tests"
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-neutral-200 text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:border-white/10 dark:text-white/50 dark:hover:bg-white/10 dark:hover:text-white"
              aria-label="View all mock tests"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17 17 7"></path>
                <path d="M7 7h10v10"></path>
              </svg>
            </a>
          </div>

          {heroRows.length > 0 ? (
            <div>
              {heroRows.map((row) => (
                <a
                  href={row.href}
                  class="group block border-b border-neutral-200 px-5 py-3.5 transition-colors last:border-b-0 hover:bg-neutral-50 dark:border-white/[0.07] dark:hover:bg-white/[0.03]"
                >
                  <div class="flex flex-wrap items-center gap-1.5">
                    {row.tags.map((tag) => (
                      <span class:list={["rounded px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide", heroTagTone[tag.tone]]}>
                        {tag.label}
                      </span>
                    ))}
                  </div>
                  <div class="mt-1.5 flex items-start justify-between gap-3">
                    <p class="min-w-0 text-[13px] font-semibold leading-5 text-neutral-700 group-hover:text-neutral-900 dark:text-white/75 dark:group-hover:text-white">{row.title}</p>
                    <div class="shrink-0 text-right text-[10px] leading-4 text-neutral-500 dark:text-white/35">
                      <p class="font-semibold text-accent-700 dark:text-accent-300">{row.count}</p>
                      <p>{row.meta}</p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p class="px-5 py-8 text-sm leading-6 text-neutral-600 dark:text-white/45">
              The previous-year paper library is being rebuilt. Study guides remain available in the meantime.
            </p>
          )}

          <a
            href="/mock-tests"
            class="flex items-center justify-center gap-2 px-5 py-3.5 text-[11px] font-bold text-brand-700 transition-colors hover:text-brand-900 dark:text-brand-300 dark:hover:text-white"
          >
            View All Mock Tests ({libraryCount} papers)
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
        </div>

        <p class="mt-3 text-center text-[10px] font-medium uppercase tracking-[0.16em] text-neutral-500 dark:text-white/25">
          Independent practice · answers stay hidden until submit
        </p>
      </aside>
    </div>
  </section>

  <section class="relative bg-white py-14 dark:bg-ink-950 sm:py-16 lg:py-20" aria-labelledby="library-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-700 dark:text-brand-300">Explore the library</p>
          <h2 class="mt-3 max-w-xl text-3xl font-black tracking-tight sm:text-4xl" id="library-heading">
            Most Popular Mock Tests and subject-wise practice.
          </h2>
        </div>
        <p class="max-w-xl text-sm leading-7 text-neutral-600 dark:text-white/55 lg:justify-self-end">
          Every paper below is a previous-year practice paper. Fully scored papers appear first, and every row opens the matching timed test or subject practice.
        </p>
      </div>

      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        <div class="min-w-0 overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm dark:border-white/10 dark:bg-white/[0.035]">
          <div class="flex items-center justify-between gap-3 border-b border-neutral-200 px-4 py-3 dark:border-white/10">
            <div class="flex min-w-0 items-center gap-2">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.monitor} />
              </span>
              <span class="truncate text-[10px] font-bold uppercase tracking-[0.18em] text-neutral-500 dark:text-white/55">Mock test library</span>
            </div>
            <span class="shrink-0 text-[10px] font-semibold text-neutral-500 dark:text-white/55">{libraryCount} papers</span>
          </div>

          <div class="px-4 pb-1 pt-4">
            <h3 class="text-lg font-bold">Most Popular Mock Tests</h3>
            <p class="mt-1 text-xs text-neutral-500 dark:text-white/55">
              Full-length previous-year practice papers with answer keys, server timer and instant scorecards.
            </p>
          </div>

          <div class="mt-2">
            {libraryRows.length > 0 ? (
              libraryRows.map((row) => (
                <a
                  href={row.href}
                  class="group flex flex-col gap-2 border-t border-neutral-100 px-4 py-3 transition-colors hover:bg-neutral-50 dark:border-white/[0.07] dark:hover:bg-white/[0.03] sm:flex-row sm:items-center sm:justify-between"
                >
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-1.5">
                      {row.tags.map((tag) => (
                        <span class:list={["rounded px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide", libraryTagTone[tag.tone]]}>
                          {tag.label}
                        </span>
                      ))}
                    </div>
                    <p class="mt-1.5 truncate text-sm font-semibold text-neutral-800 group-hover:text-brand-700 dark:text-white/75 dark:group-hover:text-white">
                      {row.title}
                    </p>
                  </div>
                  <div class="flex shrink-0 items-center gap-4 text-[10px] text-neutral-500 dark:text-white/55 sm:justify-end">
                    <span><span class="font-bold text-accent-600 dark:text-accent-300">{row.count.split(" ")[0]}</span> {row.count.split(" ").slice(1).join(" ")}</span>
                    <span>{row.meta}</span>
                  </div>
                </a>
              ))
            ) : (
              <p class="border-t border-neutral-100 px-4 py-8 text-center text-sm text-neutral-600 dark:border-white/[0.07] dark:text-white/55">
                No previous-year paper is published yet. The library is being rebuilt paper by paper.
              </p>
            )}
          </div>

          <a href="/mock-tests" class="flex items-center justify-center gap-2 border-t border-neutral-200 px-4 py-3 text-[11px] font-bold text-brand-700 hover:bg-neutral-50 dark:border-white/10 dark:text-brand-300 dark:hover:bg-white/[0.03]">
            View All Mock Tests ({libraryCount} papers)
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
        </div>

        <div class="min-w-0 overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm dark:border-white/10 dark:bg-white/[0.035]">
          <div class="flex items-center justify-between gap-3 border-b border-neutral-200 px-4 py-3 dark:border-white/10">
            <div class="flex min-w-0 items-center gap-2">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-accent-50 text-accent-700 dark:bg-accent-500/10 dark:text-accent-300">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.layers} />
              </span>
              <span class="truncate text-[10px] font-bold uppercase tracking-[0.18em] text-neutral-500 dark:text-white/55">Practice library</span>
            </div>
            <span class="shrink-0 text-[10px] font-semibold text-neutral-500 dark:text-white/55">{subjectRows.length} subjects</span>
          </div>

          <div class="px-4 pb-1 pt-4">
            <h3 class="text-lg font-bold">Most Popular Subject Practice</h3>
            <p class="mt-1 text-xs text-neutral-500 dark:text-white/55">
              Open a subject to compare its papers across 2021–2026.
            </p>
          </div>

          <div class="mt-2">
            {subjectRows.length > 0 ? (
              subjectRows.map((subject) => (
                <div class="flex items-center justify-between gap-4 border-t border-neutral-100 px-4 py-4 dark:border-white/[0.07]">
                  <div class="min-w-0">
                    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-neutral-500 dark:text-white/55">Subject</p>
                    <p class="mt-1 truncate font-semibold text-neutral-800 dark:text-white/80">{subject.subject.name}</p>
                    <p class="mt-0.5 text-[10px] uppercase tracking-wide text-neutral-500 dark:text-white/55">
                      {subject.paperCount} paper{subject.paperCount === 1 ? "" : "s"} · latest {subject.latestYear}
                    </p>
                  </div>
                  <div class="shrink-0 text-right">
                    <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-neutral-500 dark:text-white/55">Questions / keyed</p>
                    <p class="mt-1 text-sm font-bold text-accent-600 dark:text-accent-300">{subject.questionCount} / {subject.scorableQuestionCount}</p>
                    <a class="mt-1 inline-flex text-[11px] font-semibold text-brand-700 hover:underline dark:text-brand-300" href={subject.href}>
                      Practice available →
                    </a>
                  </div>
                </div>
              ))
            ) : (
              <div class="border-t border-neutral-100 px-4 py-10 text-center text-sm text-neutral-500 dark:border-white/[0.07] dark:text-white/55">
                Subject practice opens when the first paper is published.
              </div>
            )}
          </div>

          <a href="/cuet-ug-previous-year-papers" class="flex items-center justify-center gap-2 border-t border-neutral-200 px-4 py-3 text-[11px] font-bold text-brand-700 hover:bg-neutral-50 dark:border-white/10 dark:text-brand-300 dark:hover:bg-white/[0.03]">
            View All Subjects
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-neutral-200 bg-neutral-50 dark:border-white/10 dark:bg-ink-900/60" aria-label="Library shortcuts">
    <div class="mx-auto grid max-w-6xl gap-3 px-4 py-5 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
      {featureLinks.map((feature) => (
        <a
          href={feature.href}
          class="group flex min-w-0 items-center gap-3 rounded-xl border border-neutral-200 bg-white p-3.5 transition-colors hover:border-brand-300 dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-brand-500/40"
        >
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={icons[feature.icon]} />
          </span>
          <span class="min-w-0">
            <span class="block truncate text-[13px] font-bold text-neutral-800 dark:text-white/80">{feature.title}</span>
            <span class="block truncate text-[10px] text-neutral-500 dark:text-white/55">{feature.hint}</span>
          </span>
          <svg class="ml-auto h-3.5 w-3.5 shrink-0 text-neutral-500 transition-transform group-hover:translate-x-0.5 dark:text-white/55" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
      ))}
    </div>
  </section>

  <section class="border-b border-neutral-200 bg-white py-10 dark:border-white/10 dark:bg-ink-950" aria-labelledby="local-practice-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-5 dark:border-amber-500/20 dark:bg-amber-500/[0.06] sm:p-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-amber-800 dark:text-amber-300">
              Full library · 2021–2026
            </p>
            <h2 class="mt-2 text-2xl font-black tracking-tight" id="local-practice-heading">
              Browse every previous-year paper by year
            </h2>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-neutral-700 dark:text-white/60">
              {localPapers.length} papers · {localQuestionCount.toLocaleString("en-IN")} questions · {localScorableCount.toLocaleString("en-IN")} ready to score. Results are graded on the server, saved to your account and ranked on the leaderboard.
            </p>
          </div>
          <a
            href="/mock-tests"
            class="inline-flex items-center gap-2 rounded-xl border border-amber-300 bg-white px-4 py-2.5 text-sm font-bold text-amber-900 transition-colors hover:border-amber-400 hover:bg-amber-50 dark:border-amber-500/30 dark:bg-white/[0.04] dark:text-amber-200 dark:hover:bg-white/[0.08]"
          >
            Browse mock tests
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          {localYears.map((entry) => (
            <a
              href={`/pyq/${entry.year}`}
              class="group inline-flex items-baseline gap-2 rounded-xl border border-amber-200/80 bg-white/80 px-4 py-2.5 text-sm font-bold text-neutral-800 transition-colors hover:border-amber-400 hover:text-amber-900 dark:border-white/10 dark:bg-white/[0.03] dark:text-white/75 dark:hover:border-amber-500/40 dark:hover:text-white"
            >
              {entry.year}
              <span class="text-[10px] font-semibold uppercase tracking-wide text-neutral-500 dark:text-white/45">
                {entry.paper_count} paper{entry.paper_count === 1 ? "" : "s"}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <SeoIntro html={seo?.intro_html} width="wide" />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20" aria-labelledby="rhythm-heading">
    <div class="grid gap-6 lg:grid-cols-[1fr_0.85fr] lg:items-end">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-700 dark:text-brand-300">A simple study rhythm</p>
        <h2 class="mt-3 max-w-xl text-3xl font-black tracking-tight sm:text-4xl" id="rhythm-heading">
          Small steps add up to stronger preparation.
        </h2>
      </div>
      <p class="max-w-md text-sm leading-7 text-neutral-600 dark:text-white/55 lg:justify-self-end">
        Move from learning to exam practice, then use what you learned to plan the next session.
      </p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {rhythmSteps.map((step) => (
        <article class="flex min-w-0 flex-col rounded-2xl border border-neutral-200 bg-white p-5 dark:border-white/10 dark:bg-white/[0.035]">
          <div class="flex items-center justify-between gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={icons[step.icon]} />
            </span>
            <span class="text-[10px] font-black tracking-[0.2em] text-neutral-500 dark:text-white/55">{step.number}</span>
          </div>
          <h3 class="mt-5 text-lg font-bold">{step.title}</h3>
          <p class="mt-2 text-sm leading-7 text-neutral-600 dark:text-white/55">{step.body}</p>
          <a class="mt-auto pt-5 text-xs font-bold text-brand-700 hover:underline dark:text-brand-300" href={step.href}>
            {step.cta} →
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-neutral-200 bg-neutral-50 dark:border-white/10 dark:bg-ink-900/40" aria-labelledby="focus-heading">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:py-20">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-700 dark:text-brand-300">Made for your next session</p>
        <h2 class="mt-3 max-w-sm text-3xl font-black tracking-tight sm:text-4xl">
          Less guesswork. More focused practice.
        </h2>
        <p class="mt-4 max-w-sm text-sm leading-7 text-neutral-600 dark:text-white/55">
          Find the right place to begin, take a mock when you are ready, and revisit the areas that need another look.
        </p>
        <a href="/mock-tests" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-600">
          Browse subjects and categories
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        {focusCards.map((card) => (
          <a
            href={card.href}
            class="group flex min-w-0 flex-col rounded-2xl border border-neutral-200 bg-white p-5 transition-colors hover:border-brand-300 dark:border-white/10 dark:bg-white/[0.035] dark:hover:border-brand-500/40"
          >
            <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={icons[card.icon]} />
            </span>
            <h3 class="mt-4 font-bold">{card.title}</h3>
            <p class="mt-1.5 text-xs leading-6 text-neutral-600 dark:text-white/55">{card.body}</p>
            <span class="mt-auto pt-4 text-brand-700 dark:text-brand-300" aria-hidden="true">
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-4 pt-10 sm:px-6">
    <FaqSection faqs={faqs} intro="Quick answers about accounts, timing, scoring and independence." />
  </div>

  <section class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6">
    <div class="session-glow relative overflow-hidden rounded-3xl p-8 text-center text-white shadow-[var(--shadow-brand)] sm:p-12 lg:p-14">
      <span class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full border border-white/10" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -bottom-24 -left-16 h-72 w-72 rounded-full border border-white/10" aria-hidden="true"></span>

      <div class="relative z-10 mx-auto max-w-2xl">
        <span class="mx-auto grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-white/10">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.spark} />
        </span>
        <h2 class="mt-5 text-3xl font-black tracking-tight sm:text-4xl">Start with one good session.</h2>
        <p class="mt-3 text-sm leading-7 text-white/70">
          Choose a mock test or jump into practice. Your CUET preparation can move forward one question at a time.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href="/mock-tests" class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-brand-800 transition-colors hover:bg-brand-50">
            Choose a mock test
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
          <a href="/mock-tests" class="inline-flex items-center gap-2 rounded-xl border border-white/40 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-white/10">
            Explore Mock Tests
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
