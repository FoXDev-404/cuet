{
  "name": "cuet-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/clean-build-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "seo:check": "node scripts/seo-consistency.mjs",
    "lint:copy": "node scripts/copy-lint.mjs",
    "check:env": "node scripts/check-env-separation.mjs",
  "check:env:live": "node scripts/check-env-separation.mjs --live https://cuetfreemocktest.com",
    "check:migrations-remote": "node scripts/check-migrations-remote.mjs",
    "export:content": "node scripts/export-content.mjs",
    "purge:test-data": "node scripts/purge-test-data.mjs",
    "admin:create": "node scripts/admin-create.mjs",
    "report:facts": "node scripts/report-facts.mjs",
    "report:verify": "node scripts/check-report-evidence.mjs",
    "verify:suite": "node scripts/run-verification-suite.mjs",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "perf:check": "node scripts/check-perf-budget.mjs",
    "audit:reconciliation": "node scripts/data-reconciliation.mjs",
    "og:questions": "node scripts/generate-question-og.mjs",
    "og:papers": "node scripts/generate-paper-og.mjs",
    "og:guides": "node scripts/generate-guide-og.mjs",
    "share:fonts": "node scripts/generate-share-fonts.mjs",
    "og:questions:local": "node scripts/generate-question-og.mjs --local",
    "og:questions:remote": "node scripts/generate-question-og.mjs --remote",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "preview": "astro preview",
    "deploy": "node scripts/deploy-production.mjs",
    "db:migrate:local": "wrangler d1 migrations apply cuet-blueprint-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cuet-blueprint-db --remote",
    "db:seed:local": "wrangler d1 execute cuet-blueprint-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute cuet-blueprint-db --remote --file=./migrations/0002_seed.sql",
    "db:turso:migrate": "node --env-file-if-exists=.dev.vars scripts/turso-migrate.mjs",
    "db:turso:import": "node --env-file-if-exists=.dev.vars scripts/turso-import.mjs",
    "db:turso:verify": "node --env-file-if-exists=.dev.vars scripts/turso-verify.mjs",
    "db:import:practice:local": "node scripts/import-practice-library.mjs --local",
    "db:import:practice:remote": "node scripts/import-practice-library.mjs --remote",
    "db:import:ranked-practice:local": "node scripts/import-ranked-practice.mjs --local",
    "db:import:ranked-practice:remote": "node scripts/import-ranked-practice.mjs --remote",
    "db:import:ranked-practice:turso": "node --env-file-if-exists=.dev.vars scripts/import-ranked-practice.mjs --turso",
    "pyq:compositions": "node scripts/generate-pyq-compositions.mjs",
    "db:import:cuet-json": "node scripts/import-cuet-json-output.mjs",
    "seed:e2e-mock": "node scripts/seed-e2e-mock.mjs",
    "types": "wrangler types",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "db:migrate:staging": "wrangler d1 migrations apply cuet-d1-staging --remote --env staging",
    "db:import:practice:staging": "node scripts/import-practice-library.mjs --remote --database cuet-d1-staging --env staging",
    "db:import:ranked-practice:staging": "node scripts/import-ranked-practice.mjs --remote --database cuet-d1-staging --env staging",
    "backfill:staging": "node scripts/backfill-explanation-provenance.mjs --remote --database cuet-d1-staging --env staging",
    "deploy:2026": "node scripts/deploy-2026.mjs",
    "db:migrate:2026": "wrangler d1 migrations apply cuet-2026-db --remote --env deploy2026",
    "db:import:practice:2026": "node scripts/import-practice-library.mjs --remote --database cuet-2026-db --env deploy2026",
    "db:import:ranked-practice:2026": "node scripts/import-ranked-practice.mjs --remote --database cuet-2026-db --env deploy2026",
    "backfill:2026": "node scripts/backfill-explanation-provenance.mjs --remote --database cuet-2026-db --env deploy2026"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/react": "^7.1.2",
    "@libsql/client": "^0.18.0",
    "@tursodatabase/serverless": "^1.4.1",
    "astro": "^7.4.12",
    "html-to-image": "^1.11.13",
    "jose": "^6.1.0",
    "katex": "^0.19.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "fflate": "^0.8.2"
  }
}
