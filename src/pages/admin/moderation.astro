---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { all } from "../../lib/db";
import { can } from "../../lib/auth/admin";
import { formatDateTime } from "../../lib/content";
import { renderPlainText } from "../../lib/rich-text";

const admin = Astro.locals.admin!;
if (!can(admin.role, "moderation.write")) return Astro.redirect("/forbidden", 303);

const tabs = [
  { key: "pending", label: "Pending" },
  { key: "visible", label: "Visible" },
  { key: "hidden", label: "Hidden" },
  { key: "reported", label: "Reported comments" },
  { key: "question-reports", label: "Question reports" },
] as const;

const requested = Astro.url.searchParams.get("tab") ?? "pending";
const tab = tabs.some((item) => item.key === requested) ? requested : "pending";

const discussions =
  tab === "question-reports"
    ? []
    : await all<{
        id: number;
        mock_id: number;
        question_id: number | null;
        user_id: number;
        parent_id: number | null;
        body: string;
        status: string;
        is_pinned: number;
        is_best_answer: number;
        upvotes: number;
        created_at: string;
        username: string;
        email: string;
        mock_title: string;
        mock_slug: string;
        question_text: string | null;
        report_count: number;
      }>(
        `SELECT d.id, d.mock_id, d.question_id, d.user_id, d.parent_id, d.body, d.status,
                d.is_pinned, d.is_best_answer, d.upvotes, d.created_at,
                u.username, u.email, m.title AS mock_title, m.slug AS mock_slug,
                q.text AS question_text,
                (SELECT COUNT(*) FROM discussion_reports dr WHERE dr.discussion_id = d.id) AS report_count
         FROM discussions d
         JOIN users u ON u.id = d.user_id
         JOIN mock_tests m ON m.id = d.mock_id
         LEFT JOIN questions q ON q.id = d.question_id
         WHERE ${
           tab === "reported"
             ? "EXISTS (SELECT 1 FROM discussion_reports dr WHERE dr.discussion_id = d.id)"
             : "d.status = ?"
         }
         ORDER BY ${tab === "reported" ? "report_count DESC, d.created_at DESC" : "d.is_pinned DESC, d.created_at DESC"}
         LIMIT 200`,
        ...(tab === "reported" ? [] : [tab]),
      );

const reports =
  tab === "question-reports"
    ? await all<{
        id: number;
        reason: string;
        status: string;
        created_at: string;
        question_id: number;
        question_text: string;
        username: string | null;
        email: string | null;
      }>(
        `SELECT r.id, r.reason, r.status, r.created_at, r.question_id,
                q.text AS question_text, u.username, u.email
         FROM question_reports r
         JOIN questions q ON q.id = r.question_id
         LEFT JOIN users u ON u.id = r.user_id
         WHERE r.status = 'open'
         ORDER BY r.id DESC
         LIMIT 200`,
      )
    : [];

const counts = await all<{ status: string; count: number }>(
  "SELECT status, COUNT(*) AS count FROM discussions GROUP BY status",
);
const countByStatus = Object.fromEntries(counts.map((row) => [row.status, row.count]));
const reportedCount = await all<{ count: number }>(
  "SELECT COUNT(DISTINCT discussion_id) AS count FROM discussion_reports",
);
const openReportsCount = await all<{ count: number }>(
  "SELECT COUNT(*) AS count FROM question_reports WHERE status = 'open'",
);

const badge = (key: string): number => {
  if (key === "reported") return reportedCount[0]?.count ?? 0;
  if (key === "question-reports") return openReportsCount[0]?.count ?? 0;
  return countByStatus[key] ?? 0;
};
const statusClass: Record<string, string> = {
  pending: "bg-amber-100 text-amber-900 dark:bg-amber-950/50 dark:text-amber-200",
  visible: "bg-brand-100 text-brand-900 dark:bg-brand-900/50 dark:text-brand-200",
  hidden: "bg-red-100 text-red-900 dark:bg-red-950/50 dark:text-red-200",
};
---

<AdminLayout title="Moderation" active="moderation">
  <div>
    <h1 class="text-2xl font-black tracking-tight">Moderation</h1>
    <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
      Discussions unlock only after a finished attempt. New accounts post into the pending queue; approve to publish. Every decision is audited.
    </p>
  </div>

  <nav class="mt-5 flex gap-1 overflow-x-auto border-b border-neutral-200 dark:border-neutral-800" aria-label="Moderation filters">
    {tabs.map((item) => (
      <a
        href={`/admin/moderation?tab=${item.key}`}
        class:list={[
          "whitespace-nowrap rounded-t-lg px-3 py-2 text-sm font-semibold",
          tab === item.key
            ? "border-b-2 border-brand-600 text-brand-800 dark:border-brand-400 dark:text-brand-200"
            : "text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-900",
        ]}
      >
        {item.label}
        <span class="ml-1.5 rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-bold text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
          {badge(item.key)}
        </span>
      </a>
    ))}
  </nav>

  <div class="mt-5 space-y-4" data-moderation-list>
    {tab === "question-reports" ? (
      reports.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-neutral-300 p-10 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
          No open question reports. Reported questions from the solutions page appear here.
        </div>
      ) : (
        reports.map((report) => (
          <article class="rounded-2xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900" data-report-card={report.id}>
            <header class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <span class="rounded-full bg-amber-100 px-2 py-0.5 font-semibold text-amber-900 dark:bg-amber-950/50 dark:text-amber-200">Question #{report.question_id}</span>
              <span>{report.username ?? "Guest"}{report.email ? ` · ${report.email}` : ""}</span>
              <time datetime={report.created_at}>{formatDateTime(report.created_at)}</time>
            </header>
            <p class="mt-2 text-sm font-medium">Reported problem</p>
            <p class="mt-1 rounded-lg bg-neutral-50 p-3 text-sm dark:bg-neutral-950">{report.reason}</p>
            <div class="mt-3 rounded-lg border border-neutral-200 p-3 text-sm dark:border-neutral-800">
              <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Question</p>
              <div class="mt-1 leading-6" set:html={renderPlainText(report.question_text.slice(0, 500))}></div>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              <button class="rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-brand-700" type="button" data-report-status="resolved" data-report-id={report.id}>
                Mark resolved
              </button>
              <button class="rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" type="button" data-report-status="dismissed" data-report-id={report.id}>
                Dismiss
              </button>
              <a class="rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/admin/questions/${report.question_id}`}>
                Open question
              </a>
            </div>
          </article>
        ))
      )
    ) : discussions.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-neutral-300 p-10 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
        Nothing in this queue.
      </div>
    ) : (
      discussions.map((discussion) => (
        <article class="rounded-2xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900" data-comment-card={discussion.id}>
          <header class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
            <span class:list={["rounded-full px-2 py-0.5 font-semibold", statusClass[discussion.status] ?? ""]}>{discussion.status}</span>
            <span class="font-bold text-neutral-800 dark:text-neutral-200">{discussion.username}</span>
            <span>{discussion.email}</span>
            <span aria-hidden="true">·</span>
            <a class="hover:underline" href={`/mock/${discussion.mock_slug}/discussion`}>{discussion.mock_title}</a>
            {discussion.question_id ? <span class="rounded-full bg-neutral-100 px-2 py-0.5 dark:bg-neutral-800">Question #{discussion.question_id}</span> : null}
            {discussion.parent_id ? <span class="rounded-full bg-neutral-100 px-2 py-0.5 dark:bg-neutral-800">Reply to #{discussion.parent_id}</span> : null}
            <time datetime={discussion.created_at}>{formatDateTime(discussion.created_at)}</time>
            {discussion.report_count > 0 ? (
              <span class="rounded-full bg-red-100 px-2 py-0.5 font-semibold text-red-900 dark:bg-red-950/50 dark:text-red-200">
                {discussion.report_count} report{discussion.report_count === 1 ? "" : "s"}
              </span>
            ) : null}
          </header>

          <div class="mt-2 rounded-lg bg-neutral-50 p-3 text-sm leading-6 dark:bg-neutral-950" set:html={renderPlainText(discussion.body)}></div>

          {discussion.question_text ? (
            <p class="mt-2 line-clamp-2 text-xs text-neutral-500 dark:text-neutral-400" title={discussion.question_text}>
              Q: {discussion.question_text}
            </p>
          ) : null}

          <footer class="mt-3 flex flex-wrap items-center gap-2 text-xs">
            <span class="mr-1 font-semibold text-neutral-500 dark:text-neutral-400">▲ {discussion.upvotes}</span>
            {discussion.status !== "visible" ? (
              <button class="rounded-lg bg-brand-600 px-3 py-1.5 font-bold text-white hover:bg-brand-700" type="button" data-action="approve" data-id={discussion.id}>
                Approve
              </button>
            ) : null}
            {discussion.status !== "hidden" ? (
              <button class="rounded-lg bg-red-600 px-3 py-1.5 font-bold text-white hover:bg-red-700" type="button" data-action="hide" data-id={discussion.id}>
                Hide
              </button>
            ) : null}
            <button class="rounded-lg border border-neutral-300 px-3 py-1.5 font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" type="button" data-action={discussion.is_pinned ? "unpin" : "pin"} data-id={discussion.id}>
              {discussion.is_pinned ? "Unpin" : "Pin"}
            </button>
            <button class="rounded-lg border border-neutral-300 px-3 py-1.5 font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" type="button" data-action={discussion.is_best_answer ? "unbest" : "best"} data-id={discussion.id}>
              {discussion.is_best_answer ? "Remove best answer" : "Mark best answer"}
            </button>
            <a class="rounded-lg border border-neutral-300 px-3 py-1.5 font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/mock/${discussion.mock_slug}/discussion${discussion.question_id ? `?question=${discussion.question_id}` : ""}`}>
              View in context
            </a>
            <span class="hidden text-red-700 dark:text-red-400" data-moderation-message></span>
          </footer>
        </article>
      ))
    )}
  </div>

  <script is:inline>
    async function send(url, body) {
      const response = await fetch(url, {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || "Request failed.");
      return result;
    }

    document.querySelectorAll("[data-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        button.disabled = true;
        try {
          await send(`/api/admin/discussions/${button.dataset.id}`, { action: button.dataset.action });
          location.reload();
        } catch (error) {
          alert(error instanceof Error ? error.message : "Request failed.");
          button.disabled = false;
        }
      });
    });

    document.querySelectorAll("[data-report-status]").forEach((button) => {
      button.addEventListener("click", async () => {
        button.disabled = true;
        try {
          await send(`/api/admin/reports/${button.dataset.reportId}`, { status: button.dataset.reportStatus });
          location.reload();
        } catch (error) {
          alert(error instanceof Error ? error.message : "Request failed.");
          button.disabled = false;
        }
      });
    });
  </script>
</AdminLayout>
