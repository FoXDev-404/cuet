# Copy this file to `.dev.vars` (ignored by git) for local development.
#
# Google OAuth — REQUIRED: sign-in is Google-only (email/password auth was
# retired in November 2026). Create an OAuth 2.0 Web client in Google
# Cloud Console and add this authorised redirect URI:
#   http://localhost:4321/api/auth/google/callback
# Production must use https://<your-domain>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin used for canonical links and cookie security.
SITE_URL=http://localhost:4321

# Legacy (unused by any current flow): password-reset email delivery was
# retired together with email/password auth in November 2026.
DEV_SHOW_RESET_LINK=true

# Transactional email (optional, currently unused). Provider keys belong in
# `.dev.vars` locally and `wrangler secret put` remotely, never in git.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=

# Optional public integrations. Empty or malformed values emit nothing.
CF_ANALYTICS_TOKEN=
GSC_VERIFICATION=
ADSENSE_CLIENT=
ADSENSE_SLOT_ID=
GTM_CONTAINER_ID=
