---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import QuestionForm from "../../../components/QuestionForm.astro";
import QuestionSharePanel from "../../../components/QuestionSharePanel.astro";
import RevisionHistory from "../../../components/RevisionHistory.astro";
import { all } from "../../../lib/db";
import { findQuestion } from "../../../lib/admin/questions";
import { getQuestionShareInfo } from "../../../lib/admin/share";
import { listRevisions } from "../../../lib/admin/revisions";
import { can } from "../../../lib/auth/admin";

const admin = Astro.locals.admin!;
const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/admin/questions", 303);

const question = await findQuestion(id);
if (!question || question.deleted_at) {
  return new Response("Question not found", { status: 404 });
}

const subjects = await all<{ id: number; name: string }>(
  "SELECT id, name FROM subjects WHERE is_active = 1 ORDER BY name",
);
const canPublish = can(admin.role, "questions.publish");
const canHotfix = admin.role === "super";
const canRestore = can(admin.role, "revisions.restore");
const share = canPublish ? await getQuestionShareInfo(question.id) : null;
const revisions = await listRevisions("questions", question.id, 30);
const usedIn = await all<{ id: number; title: string; slug: string; status: string }>(
  `SELECT m.id, m.title, m.slug, m.status
   FROM mock_tests m
   JOIN mock_questions_current q ON q.mock_id = m.id
   WHERE q.question_id = ? AND m.deleted_at IS NULL
   ORDER BY m.id DESC
   LIMIT 20`,
  question.id,
);
---

<AdminLayout title={`Question #${question.id}`} active="questions">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Question #{question.id}</h1>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
        {question.supersedes_id ? `Supersedes question #${question.supersedes_id}. ` : ""}
        Published edits create a new frozen version; old attempts keep the original.
      </p>
    </div>
    <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide dark:bg-neutral-800">{question.status.replace("_", " ")}</span>
  </div>
  <QuestionForm question={question} subjects={subjects} canPublish={canPublish} canHotfix={canHotfix} />

  {share ? <QuestionSharePanel share={share} /> : null}

  <section class="card mt-8 p-4" aria-labelledby="used-in-heading">
    <h2 id="used-in-heading" class="font-bold">Used in {usedIn.length} live {usedIn.length === 1 ? "mock" : "mocks"}</h2>
    {usedIn.length === 0 ? (
      <p class="mt-1 text-sm text-muted-token">This question is not attached to a published mock version.</p>
    ) : (
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {usedIn.map((mock) => (
          <li class="rounded-lg border border-token px-3 py-2 text-sm">
            <a class="font-medium text-link hover:underline" href={`/admin/mocks/${mock.id}`}>{mock.title}</a>
            <span class="ml-2 text-xs text-muted-token">{mock.status}</span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <RevisionHistory
    entityType="questions"
    entityId={question.id}
    current={question as unknown as Record<string, unknown>}
    revisions={revisions}
    canRestore={canRestore}
  />
</AdminLayout>
