---
import BaseLayout from "../layouts/BaseLayout.astro";
import { safeNext } from "../lib/http";
import { isGoogleConfigured } from "../lib/auth/oauth";

const next = safeNext(Astro.url.searchParams.get("next"), "/dashboard");
if (Astro.locals.user) return Astro.redirect(next, 303);
const googleReady = isGoogleConfigured();

const errorCode = Astro.url.searchParams.get("error") ?? "";
const errorMessages: Record<string, string> = {
  google_not_configured: "Google login is not configured yet. Use email and password.",
  google_cancelled: "Google login was cancelled.",
  google_state: "The Google login session expired. Please try again.",
  google_token: "Google login could not be completed. Please try again.",
  google_profile: "Google did not share a verified profile.",
  google_email_unverified: "Your Google email is not verified.",
  account_disabled: "This account is disabled.",
};
const message =
  errorCode in errorMessages
    ? errorMessages[errorCode]
    : Astro.url.searchParams.get("reset")
      ? "Password updated. Log in with your new password."
      : "";
---

<BaseLayout title="Log in — CUET Free Mock Test" noindex>
  <section class="mx-auto grid max-w-5xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_420px] lg:py-20">
    <div class="max-w-lg">
      <h1 class="text-3xl font-black tracking-tight sm:text-4xl">Log in to save your progress.</h1>
      <p class="mt-4 text-neutral-600 dark:text-neutral-300">
        Guest attempts still work. Log in to keep history, track weak subjects and appear on leaderboards.
      </p>
      <a class="mt-6 inline-block text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href={`/signup?next=${encodeURIComponent(next)}`}>
        New here? Create a free account →
      </a>
    </div>

    <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
      {message ? (
        <p class="mb-4 rounded-lg bg-brand-50 px-3 py-2 text-sm text-brand-900 dark:bg-brand-950/50 dark:text-brand-200">{message}</p>
      ) : null}
      <p id="form-error" class="mb-4 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/50 dark:text-red-200"></p>

      <form id="login-form" class="space-y-4">
        <label class="block text-sm font-medium">
          Email
          <input name="email" type="email" autocomplete="email" required class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200 dark:border-neutral-700 dark:bg-neutral-950 dark:focus:ring-brand-900" />
        </label>
        <label class="block text-sm font-medium">
          Password
          <input name="password" type="password" autocomplete="current-password" required class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200 dark:border-neutral-700 dark:bg-neutral-950 dark:focus:ring-brand-900" />
        </label>
        <div class="flex items-center justify-between text-sm">
          <a class="font-medium text-brand-700 hover:underline dark:text-brand-300" href="/forgot-password">Forgot password?</a>
          <a class="text-neutral-500 hover:underline dark:text-neutral-400" href={`/signup?next=${encodeURIComponent(next)}`}>Sign up</a>
        </div>
        <button class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60" type="submit">
          Log in
        </button>
      </form>

      {googleReady ? (
        <>
          <div class="my-5 flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400">
            <span class="h-px flex-1 bg-neutral-200 dark:bg-neutral-800"></span>
            or
            <span class="h-px flex-1 bg-neutral-200 dark:bg-neutral-800"></span>
          </div>

          <a
            href={`/api/auth/google?next=${encodeURIComponent(next)}`}
            class="flex w-full items-center justify-center gap-2 rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm font-semibold text-neutral-800 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100 dark:hover:bg-neutral-800"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.23 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.11a6.6 6.6 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.2 1.64l3.15-3.15A11 11 0 0 0 2.18 7.05l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z"/></svg>
            Continue with Google
          </a>
        </>
      ) : null}
    </div>
  </section>

  <script is:inline define:vars={{ next }} >
    const form = document.getElementById("login-form");
    const errorBox = document.getElementById("form-error");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector("button[type=submit]");
      button.disabled = true;
      errorBox.classList.add("hidden");
      const data = Object.fromEntries(new FormData(form).entries());
      data.next = next;
      try {
        const response = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Login failed.");
        location.href = result.redirect || "/dashboard";
      } catch (error) {
        errorBox.textContent = error.message;
        errorBox.classList.remove("hidden");
        button.disabled = false;
      }
    });
  </script>
</BaseLayout>
