---
import type { LocalPaperSummary } from "../lib/practice-normalize";

interface Props {
  papers: LocalPaperSummary[];
}

const { papers } = Astro.props;

const subjects = [...new Map(papers.map((paper) => [paper.subject.slug, paper.subject.name])).entries()]
  .map(([slug, name]) => ({ slug, name }))
  .sort((a, b) => a.name.localeCompare(b.name));
const years = [...new Set(papers.map((paper) => paper.year))].sort((a, b) => b - a);
const languages = [...new Set(papers.map((paper) => paper.language))].sort();
const types = [...new Set(papers.map((paper) => paper.paperType))].sort();

const sorted = [...papers].sort(
  (a, b) =>
    b.year - a.year ||
    (b.date ?? "").localeCompare(a.date ?? "") ||
    a.subject.name.localeCompare(b.subject.name) ||
    a.title.localeCompare(b.title),
);

const typeLabel = (type: LocalPaperSummary["paperType"]) =>
  type === "practice_set" ? "Practice set" : "Original paper";
---

<section
  class="mt-8 rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-white/[0.035]"
  aria-labelledby="pyq-filter-heading"
  data-pyq-browser
>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="text-xl font-bold tracking-tight" id="pyq-filter-heading">Find a paper</h2>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
        Filter by subject, language, year or paper type.
      </p>
    </div>
    <p class="text-xs font-semibold text-neutral-600 dark:text-neutral-400" data-pyq-filter-count aria-live="polite">
      Showing all {sorted.length} papers
    </p>
  </div>

  <form class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5" data-pyq-filter>
    <label class="text-xs font-semibold text-neutral-600 dark:text-neutral-300">
      Subject
      <select
        id="pyq-filter-subject"
        class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-2.5 py-2 text-sm font-normal text-neutral-900 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100"
        data-pyq-subject
      >
        <option value="">All subjects</option>
        {subjects.map((subject) => <option value={subject.slug}>{subject.name}</option>)}
      </select>
    </label>
    <label class="text-xs font-semibold text-neutral-600 dark:text-neutral-300">
      Language
      <select
        id="pyq-filter-language"
        class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-2.5 py-2 text-sm font-normal text-neutral-900 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100"
        data-pyq-language
      >
        <option value="">All languages</option>
        {languages.map((language) => <option value={language}>{language}</option>)}
      </select>
    </label>
    <label class="text-xs font-semibold text-neutral-600 dark:text-neutral-300">
      Year from
      <select
        id="pyq-filter-year-from"
        class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-2.5 py-2 text-sm font-normal text-neutral-900 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100"
        data-pyq-year-from
      >
        {years.map((year) => <option value={year} selected={year === years[years.length - 1]}>{year}</option>)}
      </select>
    </label>
    <label class="text-xs font-semibold text-neutral-600 dark:text-neutral-300">
      Year to
      <select
        id="pyq-filter-year-to"
        class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-2.5 py-2 text-sm font-normal text-neutral-900 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100"
        data-pyq-year-to
      >
        {years.map((year) => <option value={year} selected={year === years[0]}>{year}</option>)}
      </select>
    </label>
    <label class="text-xs font-semibold text-neutral-600 dark:text-neutral-300">
      Type
      <select
        id="pyq-filter-type"
        class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-2.5 py-2 text-sm font-normal text-neutral-900 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100"
        data-pyq-type
      >
        <option value="">All types</option>
        {types.map((type) => <option value={type}>{typeLabel(type)}</option>)}
      </select>
    </label>
  </form>

  <details class="mt-4" data-pyq-results>
    <summary class="cursor-pointer text-sm font-bold text-brand-700 dark:text-brand-300">
      Browse matching papers
    </summary>
    <div class="mt-3 max-h-[32rem] overflow-y-auto rounded-xl border border-neutral-200 dark:border-neutral-800">
      <ul class="divide-y divide-neutral-100 dark:divide-white/[0.07]">
        {sorted.map((paper) => (
          <li
            class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 transition-colors hover:bg-neutral-50 dark:hover:bg-white/[0.03]"
            data-pyq-paper
            data-subject={paper.subject.slug}
            data-language={paper.language}
            data-year={paper.year}
            data-type={paper.paperType}
          >
            <a href={paper.path} class="min-w-0 flex-1">
              <span class="block truncate text-sm font-semibold text-neutral-800 dark:text-white/80">
                {paper.title}
              </span>
              <span class="mt-0.5 block text-[11px] text-neutral-500 dark:text-white/55">
                {paper.subject.name} · {paper.dateLabel}{paper.shift ? ` · ${paper.shift}` : ""} · {paper.language}
              </span>
            </a>
            <span class="shrink-0 rounded bg-neutral-100 px-2 py-1 text-[10px] font-bold text-neutral-600 dark:bg-white/10 dark:text-white/65">
              {typeLabel(paper.paperType)}
            </span>
            <span class="shrink-0 rounded bg-brand-50 px-2 py-1 text-[10px] font-bold text-brand-700 dark:bg-brand-500/15 dark:text-brand-300">
              {paper.rankedQuestionCount ?? paper.recoveredQuestionCount} Q
            </span>
          </li>
        ))}
      </ul>
    </div>
    <p class="mt-3 hidden text-sm text-neutral-600 dark:text-neutral-400" data-pyq-empty>
      No paper matches these filters.
    </p>
  </details>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-pyq-browser]");
  if (root) {
    const subject = root.querySelector("[data-pyq-subject]") as HTMLSelectElement | null;
    const language = root.querySelector("[data-pyq-language]") as HTMLSelectElement | null;
    const yearFrom = root.querySelector("[data-pyq-year-from]") as HTMLSelectElement | null;
    const yearTo = root.querySelector("[data-pyq-year-to]") as HTMLSelectElement | null;
    const type = root.querySelector("[data-pyq-type]") as HTMLSelectElement | null;
    const count = root.querySelector("[data-pyq-filter-count]") as HTMLElement | null;
    const empty = root.querySelector("[data-pyq-empty]") as HTMLElement | null;
    const results = root.querySelector("[data-pyq-results]") as HTMLDetailsElement | null;
    const rows = [...root.querySelectorAll("[data-pyq-paper]")] as HTMLElement[];
    const cards = [...document.querySelectorAll("[data-pyq-subject-card]")] as HTMLElement[];
    const sections = [...document.querySelectorAll("[data-pyq-subject-section]")] as HTMLElement[];

    const apply = () => {
      const subjectValue = subject?.value ?? "";
      const languageValue = language?.value ?? "";
      const typeValue = type?.value ?? "";
      const from = Number(yearFrom?.value ?? 0);
      const to = Number(yearTo?.value ?? 9999);
      let shown = 0;
      for (const row of rows) {
        const rowYear = Number(row.dataset.year ?? 0);
        const visible =
          (!subjectValue || row.dataset.subject === subjectValue) &&
          (!languageValue || row.dataset.language === languageValue) &&
          (!typeValue || row.dataset.type === typeValue) &&
          rowYear >= Math.min(from, to) &&
          rowYear <= Math.max(from, to);
        row.hidden = !visible;
        if (visible) shown += 1;
      }
      if (count) {
        count.textContent =
          shown === rows.length
            ? `Showing all ${rows.length} papers`
            : `Showing ${shown} of ${rows.length} papers`;
      }
      if (empty) empty.hidden = shown > 0;
      if (subjectValue && results) results.open = true;

      for (const card of cards) {
        const visible = !subjectValue || card.dataset.subjectSlug === subjectValue;
        card.style.display = visible ? "" : "none";
      }
      for (const section of sections) {
        const visibleCards = section.querySelectorAll("[data-pyq-subject-card]:not([style*='display: none'])");
        section.style.display = visibleCards.length > 0 ? "" : "none";
      }
    };

    for (const control of [subject, language, yearFrom, yearTo, type] as (HTMLSelectElement | null)[]) {
      control?.addEventListener("change", apply);
    }
    apply();
  }
</script>
