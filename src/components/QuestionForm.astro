---
import type { QuestionRow } from "../lib/admin/questions";
import { parseOptions } from "../lib/content";

interface Props {
  question?: QuestionRow | null;
  subjects: { id: number; name: string }[];
  canPublish: boolean;
  canHotfix?: boolean;
}

const { question = null, subjects, canPublish, canHotfix = false } = Astro.props;
const parsed = parseOptions(question?.options);
const rows = Array.from({ length: 4 }, (_, index) => parsed[index] ?? { text: "", image_url: null, alt: null });
const letters = ["A", "B", "C", "D"];
const status = question?.status ?? "draft";
const imageSlot = (
  label: string,
  url: string | null,
  alt: string | null,
  prefix: string,
) => ({ label, url, alt, prefix });
const questionImage = imageSlot("Question diagram", question?.image_url ?? null, question?.image_alt ?? null, "question");
const explanationImage = imageSlot(
  "Explanation diagram",
  question?.explanation_image_url ?? null,
  question?.explanation_image_alt ?? null,
  "explanation",
);
---

<style>
  .field {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-input);
    background: var(--surface-2);
    color: var(--ink);
    padding: 0.6rem 0.75rem;
    font-size: 0.875rem;
    outline: none;
  }
  .field:focus {
    border-color: var(--focus);
    box-shadow: 0 0 0 3px var(--focus-ring);
  }
  .label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    padding: 1.25rem;
  }
  .preview :global(img) {
    max-width: 100%;
    height: auto;
  }
  .preview :global(.katex-display) {
    overflow-x: auto;
    padding: 0.25rem 0;
  }
</style>

<form
  id="question-form"
  data-id={question?.id ?? ""}
  data-can-publish={canPublish ? "true" : "false"}
  data-can-hotfix={canHotfix ? "true" : "false"}
  class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px]"
  novalidate
>
  <div class="space-y-6">
    <p id="question-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/50 dark:text-red-200"></p>

    <section class="card space-y-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="label">
          Subject
          <select class="field mt-1" data-field="subject_id" required>
            {subjects.map((subject) => (
              <option value={subject.id} selected={question?.subject_id === subject.id}>{subject.name}</option>
            ))}
          </select>
        </label>
        <label class="label">
          Status
          <select class="field mt-1" data-field="status">
            <option value="draft" selected={status === "draft"}>Draft</option>
            <option value="in_review" selected={status === "in_review"} disabled={!canPublish}>In review</option>
            <option value="published" selected={status === "published"} disabled={!canPublish}>Published</option>
          </select>
          {!canPublish ? <span class="mt-1 block text-xs font-normal text-neutral-500 dark:text-neutral-400">Contributors save drafts; an editor publishes.</span> : null}
        </label>
      </div>

      <label class="label">
        Question text <span class="font-normal text-neutral-500 dark:text-neutral-400">(plain text; use $...$ for KaTeX)</span>
        <textarea class="field mt-1 font-mono text-sm" data-field="text" rows="5" required placeholder="If $x^2 - 5x + 6 = 0$, what are the roots?">{question?.text ?? ""}</textarea>
      </label>
      <label class="label">
        Question text (Hindi, optional)
        <textarea class="field mt-1 font-mono text-sm" data-field="text_hi" rows="3" dir="auto">{question?.text_hi ?? ""}</textarea>
      </label>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="label">
          Difficulty
          <select class="field mt-1" data-field="difficulty">
            <option value="" selected={!question?.difficulty}>Not set</option>
            <option value="easy" selected={question?.difficulty === "easy"}>Easy</option>
            <option value="medium" selected={question?.difficulty === "medium"}>Medium</option>
            <option value="hard" selected={question?.difficulty === "hard"}>Hard</option>
          </select>
        </label>
        <label class="label">
          PYQ year (optional)
          <input class="field mt-1" data-field="year" type="number" min="1900" max="2100" value={question?.year ?? ""} placeholder="e.g. 2024" />
        </label>
      </div>

      <div class="rounded-xl border border-dashed border-neutral-300 p-4 dark:border-neutral-700" data-image-slot={questionImage.prefix}>
        <p class="text-sm font-semibold">Question diagram (optional)</p>
        <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">PNG, JPEG or WebP, max 500 KB. Alt text is mandatory when an image is present.</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="label">Image URL<input class="field mt-1" data-image-url type="text" value={questionImage.url ?? ""} placeholder="/api/media/..." /></label>
          <label class="label">Alt text<input class="field mt-1" data-image-alt type="text" maxlength="300" value={questionImage.alt ?? ""} placeholder="Describe the diagram" /></label>
        </div>
        <input class="mt-3 block w-full text-sm" data-image-file type="file" accept="image/png,image/jpeg,image/webp" aria-label="Question diagram file" />
        {questionImage.url ? <img class="mt-3 max-h-48 rounded-lg border border-neutral-200 object-contain dark:border-neutral-700" data-image-preview src={questionImage.url} alt={questionImage.alt ?? ""} loading="lazy" /> : <img class="mt-3 hidden max-h-48 rounded-lg border border-neutral-200 object-contain dark:border-neutral-700" data-image-preview alt="" />}
      </div>
    </section>

    <section class="card space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-bold">Options</h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">Select the correct option with the radio button.</p>
      </div>

      {rows.map((option, index) => (
        <div class="rounded-xl border border-neutral-200 p-4 dark:border-neutral-800" data-option-row>
          <div class="flex items-start gap-3">
            <label class="mt-2 flex items-center gap-2 text-sm font-bold">
              <input type="radio" name="correct_option" value={index} checked={question?.correct_option === index || (!question && index === 0)} />
              {letters[index]}
            </label>
            <div class="min-w-0 flex-1 space-y-2">
              <textarea class="field font-mono text-sm" data-option-text rows="2" placeholder={`Option ${letters[index]} text`}>{option.text}</textarea>
              <div class="grid gap-2 sm:grid-cols-[1fr_1fr]">
                <input class="field text-xs" data-option-image-url type="text" value={option.image_url ?? ""} placeholder="Option image URL (optional)" />
                <input class="field text-xs" data-option-image-alt type="text" maxlength="300" value={option.alt ?? ""} placeholder="Option image alt text" />
              </div>
              <input class="block w-full text-xs" data-option-image-file type="file" accept="image/png,image/jpeg,image/webp" aria-label={`Option ${letters[index]} diagram file`} />
              {option.image_url ? <img class="max-h-28 rounded-lg border border-neutral-200 object-contain dark:border-neutral-700" data-option-image-preview src={option.image_url} alt={option.alt ?? ""} loading="lazy" /> : <img class="hidden max-h-28 rounded-lg border border-neutral-200 object-contain dark:border-neutral-700" data-option-image-preview alt="" />}
            </div>
          </div>
        </div>
      ))}
    </section>

    <section class="card space-y-4">
      <h2 class="font-bold">Explanation</h2>
      <label class="label">
        Step-by-step solution
        <textarea class="field mt-1 font-mono text-sm" data-field="explanation" rows="6" placeholder="Show the reasoning, not just the answer. Required before publishing.">{question?.explanation ?? ""}</textarea>
      </label>
      <label class="label">
        Explanation (Hindi, optional)
        <textarea class="field mt-1 font-mono text-sm" data-field="explanation_hi" rows="3" dir="auto">{question?.explanation_hi ?? ""}</textarea>
      </label>

      <div class="rounded-xl border border-dashed border-neutral-300 p-4 dark:border-neutral-700" data-image-slot={explanationImage.prefix}>
        <p class="text-sm font-semibold">Explanation diagram (optional)</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="label">Image URL<input class="field mt-1" data-image-url type="text" value={explanationImage.url ?? ""} placeholder="/api/media/..." /></label>
          <label class="label">Alt text<input class="field mt-1" data-image-alt type="text" maxlength="300" value={explanationImage.alt ?? ""} placeholder="Describe the diagram" /></label>
        </div>
        <input class="mt-3 block w-full text-sm" data-image-file type="file" accept="image/png,image/jpeg,image/webp" aria-label="Explanation diagram file" />
        {explanationImage.url ? <img class="mt-3 max-h-48 rounded-lg border border-neutral-200 object-contain dark:border-neutral-700" data-image-preview src={explanationImage.url} alt={explanationImage.alt ?? ""} loading="lazy" /> : <img class="mt-3 hidden max-h-48 rounded-lg border border-neutral-200 object-contain dark:border-neutral-700" data-image-preview alt="" />}
      </div>
    </section>
  </div>

  <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
    <section class="card">
      <h2 class="font-bold">Live preview</h2>
      <div class="preview mt-3 space-y-3 text-sm" data-preview>
        <p class="text-muted-token">Start typing to preview KaTeX and option content.</p>
      </div>
    </section>

    {question && canHotfix && status === "published" ? (
      <section class="card space-y-3" data-hotfix-panel>
        <div>
          <h2 class="font-bold">Live-content hotfix</h2>
          <p class="mt-1 text-xs text-muted-token">
            Super Admin only. Saves this published question in place, after storing a full snapshot for restore.
          </p>
        </div>
        <label class="flex items-start gap-2 text-sm font-medium">
          <input class="mt-1 h-4 w-4" type="checkbox" data-hotfix-toggle />
          <span>Apply this edit directly to the live question</span>
        </label>
        <div class="hidden space-y-3" data-hotfix-fields>
          <label class="label">
            Reason (required, at least 10 characters)
            <textarea class="field mt-1" data-hotfix-reason rows="2" maxlength="500" placeholder="e.g. Corrected the answer key after verification against the official PDF"></textarea>
          </label>
          <label class="flex items-start gap-2 text-sm">
            <input class="mt-1 h-4 w-4" type="checkbox" data-hotfix-rescore />
            <span>Rescore affected attempts after saving when the correct answer changes</span>
          </label>
          <p class="text-xs text-muted-token">
            Published edits normally create a new draft version. A hotfix changes the live row and is recorded in the revision history below.
          </p>
        </div>
      </section>
    ) : null}

    <section class="card space-y-3">
      <button id="save-question" type="submit" class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60">
        {question ? "Save changes" : "Create question"}
      </button>
      {question ? (
        <a href={`/admin/questions/${question.id}`} class="block text-center text-xs text-muted-token hover:underline">Editing question #{question.id}</a>
      ) : null}
      <a href="/admin/questions" class="block text-center text-sm font-medium text-body-2 hover:underline">Back to question bank</a>
    </section>
  </aside>
</form>

<script>
  import { renderRichText } from "../lib/rich-text";

  const form = document.getElementById("question-form") as HTMLFormElement | null;
  if (form) {
    const errorBox = document.getElementById("question-error") as HTMLElement;
    const saveButton = document.getElementById("save-question") as HTMLButtonElement;
    const preview = form.querySelector("[data-preview]") as HTMLElement;
    const questionId = form.dataset.id || "";
    const hotfixToggle = form.querySelector("[data-hotfix-toggle]") as HTMLInputElement | null;
    const hotfixFields = form.querySelector("[data-hotfix-fields]") as HTMLElement | null;
    const hotfixReason = form.querySelector("[data-hotfix-reason]") as HTMLTextAreaElement | null;
    const hotfixRescore = form.querySelector("[data-hotfix-rescore]") as HTMLInputElement | null;
    const statusSelect = form.querySelector('[data-field="status"]') as HTMLSelectElement | null;

    hotfixToggle?.addEventListener("change", () => {
      const enabled = hotfixToggle.checked;
      hotfixFields?.classList.toggle("hidden", !enabled);
      if (statusSelect) {
        if (enabled) statusSelect.value = "published";
        statusSelect.disabled = enabled;
      }
      if (enabled) hotfixReason?.focus();
    });

    function showError(message: string) {
      errorBox.textContent = message;
      errorBox.classList.remove("hidden");
      errorBox.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function field(name: string): string {
      const element = form!.querySelector(`[data-field="${name}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
      return element?.value?.trim() ?? "";
    }

    function imageSlot(prefix: string): HTMLElement | null {
      return form!.querySelector(`[data-image-slot="${prefix}"]`);
    }

    /**
     * Downscale large diagrams in the browser before upload. Workers cannot run
     * a native image codec, so the server still validates real bytes, size and
     * dimensions; this step keeps typical screenshots under the 500 KB limit.
     */
    async function prepareImage(file: File): Promise<File> {
      if (!/^image\/(png|jpeg|webp)$/.test(file.type) || file.size <= 250 * 1024) return file;
      try {
        const bitmap = await createImageBitmap(file);
        const maxDimension = 1600;
        const scale = Math.min(1, maxDimension / Math.max(bitmap.width, bitmap.height));
        if (scale === 1 && file.type === "image/webp") {
          bitmap.close();
          return file;
        }
        const canvas = document.createElement("canvas");
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));
        const context = canvas.getContext("2d");
        if (!context) {
          bitmap.close();
          return file;
        }
        context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close();
        const blob = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob(resolve, "image/webp", 0.85),
        );
        if (!blob || blob.size >= file.size) return file;
        return new File([blob], file.name.replace(/\.[^.]+$/, "") + ".webp", {
          type: "image/webp",
          lastModified: Date.now(),
        });
      } catch {
        return file;
      }
    }

    async function uploadImage(slot: HTMLElement): Promise<{ url: string | null; alt: string | null }> {
      const urlInput = slot.querySelector("[data-image-url]") as HTMLInputElement;
      const altInput = slot.querySelector("[data-image-alt]") as HTMLInputElement;
      const fileInput = slot.querySelector("[data-image-file]") as HTMLInputElement;
      const alt = altInput.value.trim();
      const existingUrl = urlInput.value.trim();
      const file = fileInput.files?.[0];
      if (!file) return { url: existingUrl || null, alt: alt || null };
      if (!alt) throw new Error("Alt text is required before uploading an image.");

      const data = new FormData();
      data.append("file", await prepareImage(file));
      data.append("alt", alt);
      const response = await fetch("/api/admin/media", { method: "POST", body: data });
      const result = (await response.json()) as { error?: string; redirect?: string; url?: string; id?: string };
      if (!response.ok) throw new Error(result.error || "Image upload failed.");
      if (!result.url) throw new Error("The upload did not return an image URL.");
      urlInput.value = result.url;
      const preview = slot.querySelector("[data-image-preview]") as HTMLImageElement | null;
      if (preview) {
        preview.src = result.url;
        preview.alt = alt;
        preview.classList.remove("hidden");
      }
      return { url: result.url, alt };
    }

    async function uploadOptionImage(row: HTMLElement): Promise<{ url: string | null; alt: string | null }> {
      const urlInput = row.querySelector("[data-option-image-url]") as HTMLInputElement;
      const altInput = row.querySelector("[data-option-image-alt]") as HTMLInputElement;
      const fileInput = row.querySelector("[data-option-image-file]") as HTMLInputElement;
      const alt = altInput.value.trim();
      const existingUrl = urlInput.value.trim();
      const file = fileInput.files?.[0];
      if (!file) return { url: existingUrl || null, alt: alt || null };
      if (!alt) throw new Error("Alt text is required for an option image.");

      const data = new FormData();
      data.append("file", await prepareImage(file));
      data.append("alt", alt);
      const response = await fetch("/api/admin/media", { method: "POST", body: data });
      const result = (await response.json()) as { error?: string; redirect?: string; url?: string; id?: string };
      if (!response.ok) throw new Error(result.error || "Image upload failed.");
      if (!result.url) throw new Error("The upload did not return an image URL.");
      urlInput.value = result.url;
      const preview = row.querySelector("[data-option-image-preview]") as HTMLImageElement | null;
      if (preview) {
        preview.src = result.url;
        preview.alt = alt;
        preview.classList.remove("hidden");
      }
      return { url: result.url, alt };
    }

    function updatePreview() {
      const text = field("text");
      const explanation = field("explanation");
      const rows = [...form!.querySelectorAll("[data-option-row]")] as HTMLElement[];
      const options = rows.map((row, index) => {
        const value = (row.querySelector("[data-option-text]") as HTMLTextAreaElement).value;
        return `<li class="flex gap-2"><span class="font-bold">${String.fromCharCode(65 + index)}.</span><span>${renderRichText(value) || '<span class="text-neutral-600 dark:text-neutral-400">Empty</span>'}</span></li>`;
      }).join("");
      preview.innerHTML = `
        <div class="font-medium">${renderRichText(text) || '<span class="text-neutral-600 dark:text-neutral-400">Question text will appear here.</span>'}</div>
        <ol class="space-y-1 border-y border-neutral-200 py-3 dark:border-neutral-800">${options}</ol>
        ${explanation ? `<div><p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Explanation</p><div class="mt-1">${renderRichText(explanation)}</div></div>` : ""}
      `;
    }

    form.addEventListener("input", updatePreview);
    updatePreview();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox.classList.add("hidden");
      saveButton.disabled = true;
      saveButton.textContent = "Saving…";

      try {
        const hotfix = Boolean(hotfixToggle?.checked);
        const hotfixReasonText = hotfixReason?.value.trim() ?? "";
        if (hotfix) {
          if (!questionId) throw new Error("A hotfix can only be applied to an existing question.");
          if (hotfixReasonText.length < 10) {
            throw new Error("Write a reason of at least 10 characters for the hotfix.");
          }
        }

        const questionImage = await uploadImage(imageSlot("question")!);
        const explanationImage = await uploadImage(imageSlot("explanation")!);
        const rows = [...form.querySelectorAll("[data-option-row]")] as HTMLElement[];
        const options = [];
        for (const row of rows) {
          const text = (row.querySelector("[data-option-text]") as HTMLTextAreaElement).value;
          const image = await uploadOptionImage(row);
          options.push({ text, image_url: image.url, alt: image.alt });
        }
        const correct = form.querySelector('input[name="correct_option"]:checked') as HTMLInputElement | null;
        const payload: Record<string, unknown> = {
          subject_id: field("subject_id"),
          text: field("text"),
          text_hi: field("text_hi"),
          options,
          correct_option: correct?.value ?? "0",
          explanation: field("explanation"),
          explanation_hi: field("explanation_hi"),
          difficulty: field("difficulty") || null,
          year: field("year") || null,
          image_url: questionImage.url,
          image_alt: questionImage.alt,
          explanation_image_url: explanationImage.url,
          explanation_image_alt: explanationImage.alt,
          status: field("status"),
        };
        if (hotfix) {
          payload.mode = "hotfix";
          payload.reason = hotfixReasonText;
          payload.rescore = Boolean(hotfixRescore?.checked);
        }

        const response = await fetch(questionId ? `/api/admin/questions/${questionId}` : "/api/admin/questions", {
          method: questionId ? "PATCH" : "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = (await response.json()) as {
          error?: string;
          redirect?: string;
          url?: string;
          id?: string | number;
          hotfix?: boolean;
          rescoreRequested?: boolean;
          impact?: { total: number; changed: number };
        };
        if (!response.ok) throw new Error(result.error || "Could not save the question.");

        if (result.hotfix && result.rescoreRequested && result.impact && result.impact.changed > 0) {
          const started = await fetch("/api/admin/rescore", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ mode: "start", questionId: Number(questionId), reason: `Hotfix: ${hotfixReasonText}` }),
          });
          const job = (await started.json()) as { error?: string; jobId?: number };
          if (!started.ok || !job.jobId) throw new Error(job.error || "Could not start the rescore job.");

          let done = false;
          while (!done) {
            const run = await fetch(`/api/admin/rescore/${job.jobId}`, {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ batchSize: 20 }),
            });
            const progress = (await run.json()) as { error?: string; done?: boolean; processed?: number; total?: number };
            if (!run.ok) throw new Error(progress.error || "The rescore job failed.");
            saveButton.textContent = `Rescoring… ${progress.processed ?? 0}/${progress.total ?? 0}`;
            done = progress.done === true;
          }
        }

        location.href = result.redirect || "/admin/questions";
      } catch (error) {
        showError(error instanceof Error ? error.message : "Could not save the question.");
        saveButton.disabled = false;
        saveButton.textContent = questionId ? "Save changes" : "Create question";
      }
    });
  }
</script>
