---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { can } from "../../../../lib/auth/admin";
import { findMock, latestVersion } from "../../../../lib/admin/mocks";
import { attemptQuestions, parseQuestionAssets } from "../../../../lib/attempts";
import { parseMarkingScheme, parseOptions, renderRichText } from "../../../../lib/content";
import { imageDimensionsForUrls, withImageDimensions } from "../../../../lib/media-dimensions";

const admin = Astro.locals.admin!;
if (!can(admin.role, "mocks.write")) return Astro.redirect("/forbidden", 303);

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/admin/mocks", 303);

const mock = await findMock(id);
if (!mock || mock.deleted_at) return new Response("Mock not found", { status: 404 });
const version = await latestVersion(id);
if (!version) return new Response("Mock version missing", { status: 500 });

function imageFileName(url: string | null | undefined): string {
  if (!url) return "";
  const clean = url.split("?")[0].split("#")[0];
  const parts = clean.split("/");
  return parts[parts.length - 1] || "";
}

function textContainsImage(text: string | null | undefined, url: string | null | undefined): boolean {
  if (!text || !url) return false;
  if (text.includes(url)) return true;
  const f = imageFileName(url);
  return Boolean(f && text.includes(f));
}

function isPlaceholderText(text: string | null | undefined): boolean {
  if (!text) return true;
  const trimmed = text.trim();
  return /^(fig\s*[a-d1-4]|figure\s*[a-d1-4]|\(?[a-d1-4]\)?\s*fig)$/i.test(trimmed);
}

const rows = await attemptQuestions(version.id);
const dimensions = await imageDimensionsForUrls(
  rows.flatMap((question) => [
    question.image_url,
    question.passage_image_url,
    ...parseOptions(question.options).map((option) => option.image_url),
    ...parseOptions(question.options_hi).map((option) => option.image_url),
    ...parseQuestionAssets(question.assets_json).map((asset) => asset.url),
  ]),
);
const questions = rows.map((question) => {
  const rawAssets = parseQuestionAssets(question.assets_json);
  const options = parseOptions(question.options).map((option) =>
    withImageDimensions(option, dimensions),
  );
  let questionImageUrl = question.image_url;
  if (questionImageUrl && textContainsImage(question.text, questionImageUrl)) {
    questionImageUrl = null;
  }
  const filteredAssets = rawAssets.filter((asset) => {
    if (asset.kind === "options" || asset.kind === "explanation") return false;
    if (asset.url.includes("-exp-")) return false;
    if (questionImageUrl && textContainsImage(question.text, asset.url)) return false;
    if (options.some((opt) => opt.image_url && asset.url.includes(imageFileName(opt.image_url)))) return false;
    return true;
  });
  const optionAssets = rawAssets.filter((asset) => asset.kind === "options" && !asset.url.includes("-exp-"));
  return {
    ...question,
    image_url: questionImageUrl,
    image_width: questionImageUrl ? dimensions.get(questionImageUrl)?.width ?? null : null,
    image_height: questionImageUrl ? dimensions.get(questionImageUrl)?.height ?? null : null,
    passage_image_width: question.passage_image_url
      ? dimensions.get(question.passage_image_url)?.width ?? null
      : null,
    passage_image_height: question.passage_image_url
      ? dimensions.get(question.passage_image_url)?.height ?? null
      : null,
    options,
    assets: filteredAssets.map((asset) => ({
      ...asset,
      image_width: dimensions.get(asset.url)?.width ?? null,
      image_height: dimensions.get(asset.url)?.height ?? null,
    })),
    option_assets: optionAssets.map((asset) => ({
      ...asset,
      image_width: dimensions.get(asset.url)?.width ?? null,
      image_height: dimensions.get(asset.url)?.height ?? null,
    })),
  };
});
const sections = [...new Set(questions.map((question) => question.section))];
const marking = parseMarkingScheme(version.marking_scheme);
const letters = ["A", "B", "C", "D", "E", "F"];
---

<AdminLayout title={`Preview · ${mock.title}`} active="mocks">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-300">Mockbuilder preview</p>
      <h1 class="mt-1 text-2xl font-black tracking-tight">{mock.title}</h1>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
        Version {version.version_no} · {version.status.replace("_", " ")} · {questions.length} questions · {sections.length} sections
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/admin/mocks/${mock.id}`}>Back to builder</a>
      {mock.status === "published" ? <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/mock/${mock.slug}`} target="_blank" rel="noopener">Live public page</a> : null}
    </div>
  </div>

  <p class="mt-4 rounded-xl border border-sky-200 bg-sky-50 p-3 text-sm text-sky-900 dark:border-sky-900 dark:bg-sky-950/40 dark:text-sky-200">
    Preview shows the last saved version. Save the builder before previewing edits. Correct options, answer keys and explanations are intentionally hidden.
  </p>

  <section class="mt-5 rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
    <div class="grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
      <p><span class="block text-xs uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Duration</span><span class="font-bold">{version.duration_min} minutes</span></p>
      <p><span class="block text-xs uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Total marks</span><span class="font-bold">{version.total_marks}</span></p>
      <p><span class="block text-xs uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Marking</span><span class="font-bold">+{marking.correct} / {marking.wrong} / {marking.skipped}</span></p>
      <p><span class="block text-xs uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Type</span><span class="font-bold capitalize">{mock.type}</span></p>
    </div>
    {version.instructions ? (
      <div class="mt-4 rounded-xl border border-neutral-200 bg-neutral-50 p-4 text-sm leading-7 dark:border-neutral-800 dark:bg-neutral-950">
        <p class="text-xs font-bold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Instructions</p>
        <div class="mt-1 whitespace-pre-line">{version.instructions}</div>
      </div>
    ) : null}
  </section>

  {questions.length === 0 ? (
    <p class="mt-5 rounded-2xl border border-dashed border-neutral-300 p-8 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
      This version has no questions yet. Add and save questions in the mockbuilder.
    </p>
  ) : (
    <div class="mt-5 space-y-4">
      {questions.map((question, index) => {
        const showSection = index === 0 || questions[index - 1].section !== question.section;
        return (
          <>
            {showSection ? (
              <h2 class="pt-3 text-sm font-black uppercase tracking-widest text-brand-700 dark:text-brand-300">{question.section}</h2>
            ) : null}
            <article class="rounded-2xl border border-neutral-200 bg-white p-4 sm:p-5 dark:border-neutral-800 dark:bg-neutral-900">
              <div class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                <span class="font-bold">Q{index + 1}</span>
                <span class="rounded-full bg-neutral-100 px-2 py-0.5 font-semibold text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">#{question.id}</span>
              </div>
              {question.passage_body ? (
                <div class="mt-3 rounded-xl border border-neutral-200 bg-neutral-50 p-4 text-sm leading-7 dark:border-neutral-800 dark:bg-neutral-950">
                  <div set:html={renderRichText(question.passage_body)}></div>
                  {question.passage_image_url ? (
                    <img
                      class="mt-3 max-h-72 max-w-full rounded-lg border border-neutral-200 bg-white object-contain p-1 dark:border-neutral-700"
                      src={question.passage_image_url}
                      alt={question.passage_image_alt ?? ""}
                      width={question.passage_image_width ?? undefined}
                      height={question.passage_image_height ?? undefined}
                      loading="lazy"
                    />
                  ) : null}
                </div>
              ) : null}
              <div class="mt-3 text-sm leading-7" set:html={renderRichText(question.text)}></div>
              {question.image_url && !textContainsImage(question.text, question.image_url) ? (
                <img
                  class="mt-3 max-h-72 max-w-full rounded-lg border border-neutral-200 bg-white object-contain p-1 dark:border-neutral-700"
                  src={question.image_url}
                  alt={question.image_alt ?? ""}
                  width={question.image_width ?? undefined}
                  height={question.image_height ?? undefined}
                  loading="lazy"
                />
              ) : null}
              {question.assets.length > 0 ? (
                <figure class="mt-3 rounded-xl border border-neutral-200 bg-white p-3 dark:border-neutral-800 dark:bg-neutral-900">
                  <figcaption class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
                    Figure / table
                  </figcaption>
                  <div class="flex flex-wrap gap-2">
                    {question.assets.map((asset) => (
                      <img
                        class="max-h-72 max-w-full rounded-lg border border-neutral-200 bg-white object-contain p-1 dark:border-neutral-700"
                        src={asset.url}
                        alt={asset.alt}
                        width={asset.image_width ?? undefined}
                        height={asset.image_height ?? undefined}
                        loading="lazy"
                      />
                    ))}
                  </div>
                </figure>
              ) : null}
              {question.option_assets.length > 0 ? (
                <figure class="mt-3 rounded-xl border border-neutral-200 bg-white p-3 dark:border-neutral-800 dark:bg-neutral-900">
                  <figcaption class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
                    Printed answer choices
                  </figcaption>
                  <div class="flex flex-wrap gap-2">
                    {question.option_assets.map((asset) => (
                      <img
                        class="max-h-72 max-w-full rounded-lg border border-neutral-200 bg-white object-contain p-1 dark:border-neutral-700"
                        src={asset.url}
                        alt={asset.alt}
                        width={asset.image_width ?? undefined}
                        height={asset.image_height ?? undefined}
                        loading="lazy"
                      />
                    ))}
                  </div>
                </figure>
              ) : null}
              <ol class="mt-4 space-y-2">
                {question.options.map((option, optionIndex) => (
                  <li class="flex items-start gap-3 rounded-xl border border-neutral-200 px-3 py-2 text-sm dark:border-neutral-800">
                    <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full border border-current text-xs font-bold">{letters[optionIndex] ?? optionIndex + 1}</span>
                    <span class="min-w-0 flex-1">
                      {isPlaceholderText(option.text) ? null : <span set:html={renderRichText(option.text)}></span>}
                      {option.image_url ? (
                        <img
                          class="mt-2 max-h-40 max-w-full rounded-lg border border-neutral-200 bg-white object-contain p-1 dark:border-neutral-700"
                          src={option.image_url}
                          alt={option.alt ?? ""}
                          width={option.image_width ?? undefined}
                          height={option.image_height ?? undefined}
                          loading="lazy"
                        />
                      ) : (isPlaceholderText(option.text) ? (
                        <span class="text-neutral-400 dark:text-neutral-500">Option {letters[optionIndex] ?? optionIndex + 1}</span>
                      ) : null)}
                    </span>
                  </li>
                ))}
              </ol>
            </article>
          </>
        );
      })}
    </div>
  )}
</AdminLayout>
