---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="You are offline"
  description="You are offline. Reload the page when your connection returns; saved practice pages may still be available."
  noindex
>
  <div class="mx-auto max-w-2xl px-4 py-16 text-center">
    <p class="text-6xl" aria-hidden="true">☁️</p>
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight">You are offline</h1>
    <p class="mt-3 text-base leading-7 text-[var(--muted)]">
      Reload the page when your connection returns. Cached public pages may still open from this device.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <button type="button" class="rounded-lg bg-brand-600 px-4 py-2 font-semibold text-white hover:bg-brand-700" onclick="location.reload()">
        Retry
      </button>
      <a class="rounded-lg border border-neutral-300 px-4 py-2 font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-900" href="/mock-tests">
        Browse mock tests
      </a>
    </div>
  </div>
</BaseLayout>
