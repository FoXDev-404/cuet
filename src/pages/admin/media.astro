---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth/admin";

const admin = Astro.locals.admin!;
if (!can(admin.role, "media.write")) return Astro.redirect("/forbidden", 303);
---

<AdminLayout title="Media library" active="media">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Media library</h1>
      <p class="mt-1 max-w-3xl text-sm text-neutral-600 dark:text-neutral-400">
        Upload reusable PNG, JPEG or WebP images. Alt text is required; uploads are limited to 500 KB.
      </p>
    </div>
    <a
      class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800"
      href="/admin/settings"
    >
      Back to Site Builder
    </a>
  </div>

  <section class="mt-6 max-w-2xl rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
    <h2 class="text-lg font-bold">Upload image</h2>
    <form id="media-upload-form" class="mt-4 space-y-4">
      <p id="media-status" class="hidden rounded-lg px-3 py-2 text-sm" role="status"></p>
      <label class="block text-sm font-semibold">
        Image file
        <input
          class="mt-1 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-950"
          name="file"
          type="file"
          accept="image/png,image/jpeg,image/webp"
          required
        />
      </label>
      <label class="block text-sm font-semibold">
        Alternative text
        <input
          class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm font-normal dark:border-neutral-700 dark:bg-neutral-950"
          name="alt"
          type="text"
          maxlength="300"
          required
          placeholder="Describe the information conveyed by the image"
        />
        <span class="mt-1 block text-xs font-normal text-neutral-500 dark:text-neutral-400">
          Describe the image’s purpose in context; do not use the filename as alt text.
        </span>
      </label>
      <button
        id="media-upload-button"
        class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60"
        type="submit"
      >
        Upload image
      </button>
    </form>
  </section>

  <section class="mt-8" aria-labelledby="media-library-heading">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold" id="media-library-heading">Recent uploads</h2>
        <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
          The latest 100 active images. Select an image from this library in an informational page’s image block.
        </p>
      </div>
      <button
        id="media-refresh-button"
        class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800"
        type="button"
      >
        Refresh
      </button>
    </div>
    <div id="media-grid" class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-live="polite">
      <p class="text-sm text-neutral-500 dark:text-neutral-400">Loading media library…</p>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById("media-upload-form");
    const statusBox = document.getElementById("media-status");
    const uploadButton = document.getElementById("media-upload-button");
    const refreshButton = document.getElementById("media-refresh-button");
    const grid = document.getElementById("media-grid");

    function showStatus(message, ok) {
      if (!statusBox) return;
      statusBox.textContent = message;
      statusBox.className = `rounded-lg px-3 py-2 text-sm ${ok ? "bg-brand-50 text-brand-900 dark:bg-brand-950/40 dark:text-brand-200" : "bg-red-50 text-red-800 dark:bg-red-950/50 dark:text-red-200"}`;
    }

    function formatBytes(value) {
      if (value < 1024) return `${value} B`;
      return `${(value / 1024).toFixed(1)} KB`;
    }

    function renderAssets(assets) {
      grid.replaceChildren();
      if (assets.length === 0) {
        const empty = document.createElement("p");
        empty.className = "text-sm text-neutral-500 dark:text-neutral-400";
        empty.textContent = "No images uploaded yet.";
        grid.append(empty);
        return;
      }

      assets.forEach((asset) => {
        const card = document.createElement("article");
        card.className = "overflow-hidden rounded-2xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900";

        const image = document.createElement("img");
        image.className = "h-48 w-full bg-neutral-100 object-contain dark:bg-neutral-950";
        image.src = asset.url;
        image.alt = asset.alt;
        image.loading = "lazy";
        image.decoding = "async";

        const details = document.createElement("div");
        details.className = "space-y-2 p-4";
        const alt = document.createElement("p");
        alt.className = "text-sm font-semibold";
        alt.textContent = asset.alt;
        const metadata = document.createElement("p");
        metadata.className = "text-xs text-neutral-500 dark:text-neutral-400";
        metadata.textContent = `${asset.mimeType} · ${asset.width ?? "?"} × ${asset.height ?? "?"} · ${formatBytes(asset.sizeBytes)}`;
        const url = document.createElement("input");
        url.className = "w-full rounded-lg border border-neutral-300 bg-neutral-50 px-2 py-1.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-950";
        url.type = "text";
        url.readOnly = true;
        url.value = asset.url;
        url.setAttribute("aria-label", `URL for image: ${asset.alt}`);
        details.append(alt, metadata, url);
        card.append(image, details);
        grid.append(card);
      });
    }

    async function loadAssets() {
      const response = await fetch("/api/admin/media", { cache: "no-store" });
      const result = await response.json().catch(() => null);
      if (!response.ok) throw new Error(result?.error || "Could not load the media library.");
      if (!result || !Array.isArray(result.assets)) {
        throw new Error("The media library returned an invalid response.");
      }
      renderAssets(result.assets);
      return result.assets;
    }

    refreshButton?.addEventListener("click", async () => {
      refreshButton.disabled = true;
      try {
        await loadAssets();
        showStatus("Media library refreshed.", true);
      } catch (error) {
        showStatus(error instanceof Error ? error.message : "Could not load the media library.", false);
      } finally {
        refreshButton.disabled = false;
      }
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!uploadButton) return;
      uploadButton.disabled = true;
      try {
        const response = await fetch("/api/admin/media", {
          method: "POST",
          body: new FormData(form),
        });
        const result = await response.json().catch(() => null);
        if (!response.ok) throw new Error(result?.error || "Could not upload the image.");
        await loadAssets();
        form.reset();
        showStatus("Image uploaded to the media library.", true);
      } catch (error) {
        showStatus(error instanceof Error ? error.message : "Could not upload the image.", false);
      } finally {
        uploadButton.disabled = false;
      }
    });

    loadAssets().catch((error) => {
      showStatus(error instanceof Error ? error.message : "Could not load the media library.", false);
      grid.replaceChildren();
    });
  </script>
</AdminLayout>
