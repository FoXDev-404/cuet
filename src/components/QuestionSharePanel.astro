---
import type { QuestionShareInfo } from "../lib/admin/share";

interface Props {
  share: QuestionShareInfo;
}

const { share } = Astro.props;
const contextEntries = Object.entries(share.counts.byContext).sort((a, b) => b[1] - a[1]);
const channelEntries = Object.entries(share.counts.byChannel).sort((a, b) => b[1] - a[1]);
const seoBlocked = share.blockers.seoIndexable.length > 0;
const publicBlocked = share.blockers.publicReveal.length > 0;
const shareBlocked = share.blockers.shareEnabled.length > 0;
---

<section class="card mt-6 p-4" data-share-panel data-question-id={share.currentQuestionId} aria-labelledby="share-heading">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id="share-heading" class="font-bold">Sharing</h2>
      <p class="mt-1 max-w-2xl text-xs leading-5 text-muted-token">
        Public links use a random id, never the database id. The same link survives revisions and opens the latest published version.
        Shared question pages are <strong>noindex, follow</strong> unless every indexing condition below is true.
      </p>
    </div>
    <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-[11px] font-semibold text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">
      {share.flags.shareEnabled ? "Sharing on" : "Sharing off"}
    </span>
  </div>

  <div class="mt-4 rounded-xl border border-neutral-200 p-3 dark:border-neutral-800">
    <p class="text-xs font-semibold uppercase tracking-wide text-muted-token">Public link</p>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
      <input
        class="field min-w-0 flex-1"
        type="text"
        readonly
        value={share.path}
        data-share-path
        aria-label="Public question path"
      />
      <button class="min-h-11 rounded-lg border border-neutral-300 px-4 text-sm font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" type="button" data-copy-share>
        Copy link
      </button>
      <a class="inline-flex min-h-11 items-center justify-center rounded-lg border border-neutral-300 px-4 text-sm font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={share.path} target="_blank" rel="noopener">
        Open
      </a>
    </div>
    <p class="mt-2 hidden text-xs font-semibold text-emerald-700 dark:text-emerald-300" data-copy-status role="status"></p>
  </div>

  <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-4">
    <div class="rounded-xl border border-neutral-200 p-3 dark:border-neutral-800">
      <dt class="text-xs font-semibold text-muted-token">Total shares</dt>
      <dd class="mt-1 text-xl font-black">{share.counts.total.toLocaleString()}</dd>
    </div>
    <div class="rounded-xl border border-neutral-200 p-3 dark:border-neutral-800">
      <dt class="text-xs font-semibold text-muted-token">Last 30 days</dt>
      <dd class="mt-1 text-xl font-black">{share.counts.last30Days.toLocaleString()}</dd>
    </div>
    <div class="rounded-xl border border-neutral-200 p-3 dark:border-neutral-800 sm:col-span-2">
      <dt class="text-xs font-semibold text-muted-token">By context / channel</dt>
      <dd class="mt-1 text-xs leading-5 text-muted-token">
        {contextEntries.length === 0 && channelEntries.length === 0 ? "No shares recorded yet." : ""}
        {contextEntries.map(([context, count]) => <span class="mr-2 inline-block rounded-full bg-neutral-100 px-2 py-0.5 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">{context}: {count}</span>)}
        {channelEntries.map(([channel, count]) => <span class="mr-2 inline-block rounded-full bg-neutral-100 px-2 py-0.5 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">{channel}: {count}</span>)}
      </dd>
    </div>
  </dl>

  <form class="mt-4 space-y-4" data-share-form novalidate>
    <p class="hidden rounded-lg px-3 py-2 text-sm" data-share-status role="status"></p>

    <div class="grid gap-4 md:grid-cols-2">
      <label class="flex items-start gap-3 rounded-xl border border-neutral-200 p-3 dark:border-neutral-800">
        <input class="mt-1 h-4 w-4" type="checkbox" data-share-field="share_enabled" checked={share.flags.shareEnabled} disabled={!share.flags.shareEnabled && shareBlocked} />
        <span class="min-w-0">
          <span class="block text-sm font-semibold">Allow sharing</span>
          <span class="mt-0.5 block text-xs leading-5 text-muted-token">Hides the Share button when off. PYQ rows need confirmed rights first.</span>
          {share.blockers.shareEnabled.map((blocker) => <span class="mt-1 block text-xs font-semibold text-amber-700 dark:text-amber-300">{blocker}</span>)}
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-xl border border-neutral-200 p-3 dark:border-neutral-800">
        <input class="mt-1 h-4 w-4" type="checkbox" data-share-field="rights_ok" checked={share.flags.rightsOk} />
        <span class="min-w-0">
          <span class="block text-sm font-semibold">Rights confirmed</span>
          <span class="mt-0.5 block text-xs leading-5 text-muted-token">Confirm you may republish this question and its explanation. Required for PYQ sharing and indexing.</span>
        </span>
      </label>
    </div>

    <label class="block text-sm font-semibold">
      Answer reveal
      <select class="field mt-1" data-share-field="reveal_policy" disabled={share.flags.revealPolicy !== "public" && publicBlocked}>
        <option value="attempted_only" selected={share.flags.revealPolicy === "attempted_only"}>Only users who submitted an attempt with this question</option>
        <option value="public" selected={share.flags.revealPolicy === "public"}>Everyone (practice-only questions)</option>
      </select>
      <span class="mt-1 block text-xs font-normal text-muted-token">The default is attempted-only. Public reveal is blocked while the question is in a currently published ranked mock.</span>
      {share.blockers.publicReveal.map((blocker) => <span class="mt-1 block text-xs font-semibold text-amber-700 dark:text-amber-300">{blocker}</span>)}
    </label>

    <label class="flex items-start gap-3 rounded-xl border border-neutral-200 p-3 dark:border-neutral-800">
      <input class="mt-1 h-4 w-4" type="checkbox" data-share-field="seo_indexable" checked={share.flags.seoIndexable} disabled={!share.flags.seoIndexable && seoBlocked} />
      <span class="min-w-0">
        <span class="block text-sm font-semibold">Allow search indexing</span>
        <span class="mt-0.5 block text-xs leading-5 text-muted-token">Only possible when the question is published, rights are confirmed, the reveal policy is public, an original explanation exists, and it is not in a published ranked mock.</span>
        {share.blockers.seoIndexable.map((blocker) => <span class="mt-1 block text-xs font-semibold text-amber-700 dark:text-amber-300">{blocker}</span>)}
      </span>
    </label>

    <div class="flex flex-wrap items-center gap-3">
      <button class="min-h-11 rounded-lg bg-brand-600 px-4 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60" type="submit" data-share-save>
        Save sharing settings
      </button>
      <span class="text-xs text-muted-token">Changes are audit-logged. Save rights first; the dependent toggles unlock on reload.</span>
    </div>
  </form>
</section>

<script>
  const panel = document.querySelector<HTMLElement>("[data-share-panel]");
  if (panel) {
    const questionId = panel.dataset.questionId!;
    const form = panel.querySelector<HTMLFormElement>("[data-share-form]")!;
    const statusBox = panel.querySelector<HTMLElement>("[data-share-status]")!;
    const saveButton = panel.querySelector<HTMLButtonElement>("[data-share-save]")!;
    const copyButton = panel.querySelector<HTMLButtonElement>("[data-copy-share]")!;
    const copyStatus = panel.querySelector<HTMLElement>("[data-copy-status]")!;
    const pathInput = panel.querySelector<HTMLInputElement>("[data-share-path]")!;

    function showStatus(message: string, ok: boolean) {
      statusBox.textContent = message;
      statusBox.className = ok
        ? "rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200"
        : "rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/50 dark:text-red-200";
    }

    copyButton.addEventListener("click", async () => {
      const url = new URL(pathInput.value, location.origin).toString();
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        pathInput.select();
        (document as unknown as { execCommand(commandId: string): boolean }).execCommand("copy");
      }
      copyStatus.textContent = `Copied ${url}`;
      copyStatus.classList.remove("hidden");
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      saveButton.disabled = true;
      saveButton.textContent = "Saving…";
      const payload: Record<string, unknown> = {
        share_enabled: (form.querySelector('[data-share-field="share_enabled"]') as HTMLInputElement).checked,
        rights_ok: (form.querySelector('[data-share-field="rights_ok"]') as HTMLInputElement).checked,
        reveal_policy: (form.querySelector('[data-share-field="reveal_policy"]') as unknown as HTMLSelectElement).value,
        seo_indexable: (form.querySelector('[data-share-field="seo_indexable"]') as HTMLInputElement).checked,
      };
      try {
        const response = await fetch(`/api/admin/questions/${questionId}/share`, {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = (await response.json()) as {
          error?: string;
          changed?: string[];
          cleared?: string[];
        };
        if (!response.ok) throw new Error(result.error || "Could not save sharing settings.");
        const cleared = result.cleared?.length
          ? ` Indexing was cleared: ${result.cleared.join(", ")}.`
          : "";
        showStatus(`Saved.${cleared}`, true);
        setTimeout(() => location.reload(), 800);
      } catch (error) {
        showStatus(error instanceof Error ? error.message : "Could not save sharing settings.", false);
        saveButton.disabled = false;
        saveButton.textContent = "Save sharing settings";
      }
    });
  }
</script>

<style>
  .field {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-input);
    background: var(--surface-2);
    color: var(--ink);
    padding: 0.6rem 0.75rem;
    font-size: 0.875rem;
    outline: none;
  }
  .field:focus {
    border-color: var(--focus);
    box-shadow: 0 0 0 3px var(--focus-ring);
  }
</style>
