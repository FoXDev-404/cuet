---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { all } from "../../lib/db";
import { formatDateTime } from "../../lib/content";
import { dashboardNav } from "../../lib/navigation";

const user = Astro.locals.user;
if (!user) return Astro.redirect(`/login?next=${encodeURIComponent("/dashboard/discussions")}`, 303);

const comments = await all<{
  id: number;
  body: string;
  status: string;
  upvotes: number;
  created_at: string;
  mock_title: string;
  mock_slug: string;
  question_id: number | null;
}>(
  `SELECT d.id, d.body, d.status, d.upvotes, d.created_at,
          m.title AS mock_title, m.slug AS mock_slug, d.question_id
   FROM discussions d JOIN mock_tests m ON m.id = d.mock_id
   WHERE d.user_id = ?
   ORDER BY d.id DESC LIMIT 100`,
  user.id,
);

const labels: Record<string, string> = {
  visible: "Visible",
  pending: "Awaiting moderation",
  hidden: "Hidden",
};
---

<BaseLayout title="My discussions — CUET Free Mock Test" description="Your comments and their moderation status." noindex sectionLabel="Dashboard" sectionNav={dashboardNav}>
  <section class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
    <h1 class="text-2xl font-black tracking-tight">My discussions</h1>
    <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Comments start as pending until a moderator approves them. Trusted commenters can post visible comments directly.</p>

    {comments.length === 0 ? (
      <div class="mt-6 rounded-2xl border border-dashed border-neutral-300 p-10 text-center dark:border-neutral-700">
        <h2 class="font-bold">No comments yet</h2>
        <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">Finish a mock, then join the discussion from the mock or result page.</p>
        <a class="mt-4 inline-block rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" href="/cuet-ug-mock-test">Browse mock tests</a>
      </div>
    ) : (
      <ul class="mt-6 space-y-3">
        {comments.map((comment) => (
          <li class="rounded-2xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
            <div class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <span class:list={[
                "rounded-full px-2 py-0.5 font-semibold",
                comment.status === "visible"
                  ? "bg-brand-100 text-brand-900 dark:bg-brand-900/50 dark:text-brand-200"
                  : comment.status === "pending"
                    ? "bg-amber-100 text-amber-900 dark:bg-amber-950/50 dark:text-amber-200"
                    : "bg-neutral-200 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300",
              ]}>{labels[comment.status] ?? comment.status}</span>
              <span>{formatDateTime(comment.created_at)}</span>
              <span>{comment.upvotes} upvote{comment.upvotes === 1 ? "" : "s"}</span>
            </div>
            <p class="mt-2 whitespace-pre-wrap text-sm leading-6">{comment.body}</p>
            <a class="mt-3 inline-block text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href={`/mock/${comment.mock_slug}/discussion${comment.question_id ? `?question=${comment.question_id}` : ""}`}>
              Open in {comment.mock_title} →
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
