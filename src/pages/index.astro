---
import { siteUrl } from "../lib/site-url";
import BaseLayout from "../layouts/BaseLayout.astro";
import SeoIntro from "../components/SeoIntro.astro";
import FaqSection from "../components/FaqSection.astro";
import { all } from "../lib/db";
import {
  getLocalPaperYears,
  getLocalPapers,
  getLocalSubjectSummaries,
  getPopularLocalPapers,
  type LocalPaperSummary,
} from "../lib/local-papers";
import {
  getPageSeo,
  itemListJsonLd,
  parseFaq,
  type FaqItem,
} from "../lib/seo";

const PATH = "/";
const DEFAULT_TITLE = "CUET Free Mock Test — Timed Mocks, Real Results, Free Solutions";
const DEFAULT_DESCRIPTION =
  "Free CUET UG mock tests with a server timer, hidden answers, instant results and written solutions. Practise by subject, track progress and join first-attempt leaderboards.";

const DEFAULT_FAQ: FaqItem[] = [
  {
    question: "Is CUET Free Mock Test really free?",
    answer:
      "Yes. Every published paper, result, solution, dashboard feature and leaderboard is free. There is no paywall, no card requirement and no locked answer key.",
  },
  {
    question: "Do I need an account to take a mock test?",
    answer:
      "No. You can start as a guest and the attempt is linked to a cookie in this browser so it can be resumed. Create an account afterwards to keep the attempt in your history and enter the first-attempt leaderboard.",
  },
  {
    question: "How is the timer enforced?",
    answer:
      "The deadline is stored on the server when the attempt starts. The countdown you see is derived from that deadline, so refreshing the page or changing your device clock cannot add time. A small grace period is allowed for a submit already in flight.",
  },
  {
    question: "Are answers visible before I submit?",
    answer:
      "No. The attempt page and its API responses never contain the correct option or the explanation. They are revealed on the result and solutions pages only after you submit or the deadline expires.",
  },
  {
    question: "How does the leaderboard work?",
    answer:
      "Only a registered user's first submitted attempt for a paper is ranked. Retakes are scored and shown in your dashboard, but they never change your leaderboard position. Rank and percentile mean “among users of this site”, not an official NTA rank.",
  },
  {
    question: "Is this site affiliated with NTA?",
    answer:
      "No. CUET Free Mock Test is an independent practice project. CUET UG is conducted by the National Testing Agency, and official dates, patterns and marking rules must always be checked in the current NTA information bulletin.",
  },
];

type TagTone = "mint" | "violet" | "amber" | "neutral";

type PaperTag = { label: string; tone: TagTone };

type PaperRow = {
  href: string;
  title: string;
  tags: PaperTag[];
  count: string;
  meta: string;
};

let announcements: { id: number; message: string; link: string | null }[] = [];

try {
  announcements = await all<{ id: number; message: string; link: string | null }>(
    `SELECT id, message, link FROM announcements
     WHERE is_active = 1
       AND (starts_at IS NULL OR datetime(starts_at) <= datetime('now'))
       AND (ends_at IS NULL OR datetime(ends_at) >= datetime('now'))
     ORDER BY id DESC LIMIT 3`,
  );
} catch (error) {
  console.error("homepage announcements failed", error);
}

const localPapers = getLocalPapers();
const localYears = getLocalPaperYears();
const popularPapers = getPopularLocalPapers(12);
const subjectRows = getLocalSubjectSummaries().slice(0, 6);
const localQuestionCount = localPapers.reduce(
  (sum, paper) => sum + paper.recoveredQuestionCount,
  0,
);
const localScorableCount = localPapers.reduce(
  (sum, paper) => sum + paper.scorableQuestionCount,
  0,
);
const localPendingCount = localPapers.reduce(
  (sum, paper) => sum + paper.pendingReviewCount,
  0,
);

function paperRow(paper: LocalPaperSummary): PaperRow {
  const fullyKeyed = paper.pendingReviewCount === 0;
  return {
    href: paper.path,
    title: paper.title,
    tags: [
      { label: String(paper.year), tone: "violet" },
      { label: paper.subject.name, tone: "mint" },
      {
        label: fullyKeyed ? "Fully keyed" : `${paper.pendingReviewCount} pending`,
        tone: fullyKeyed ? "mint" : "amber",
      },
    ],
    count: `${paper.recoveredQuestionCount} question${paper.recoveredQuestionCount === 1 ? "" : "s"}`,
    meta: `${paper.durationMinutes} min · ${paper.attemptCount.toLocaleString("en-IN")} attempt${paper.attemptCount === 1 ? "" : "s"}`,
  };
}

function isAround50(count: number): boolean {
  return count >= 40 && count <= 60;
}

function compareHomepagePapers(a: LocalPaperSummary, b: LocalPaperSummary): number {
  // 1. Attempts count: higher attempts rank higher ("baad me to counter ke hisab se upar neeche hota rahta hai")
  const attDiff = (b.attemptCount || 0) - (a.attemptCount || 0);
  if (attDiff !== 0) return attDiff;

  // 2. When attempts are 0 (or tied), prioritize papers with ~50 questions (40-60 questions)
  const aNear50 = isAround50(a.recoveredQuestionCount) ? 1 : 0;
  const bNear50 = isAround50(b.recoveredQuestionCount) ? 1 : 0;
  if (bNear50 !== aNear50) return bNear50 - aNear50;

  // 3. Year (prefer newer year: 2026 full papers, then 2025, 2024...)
  if (b.year !== a.year) return b.year - a.year;

  // 4. Proximity to 50 questions
  const distA = Math.abs(a.recoveredQuestionCount - 50);
  const distB = Math.abs(b.recoveredQuestionCount - 50);
  if (distA !== distB) return distA - distB;

  // 5. Fully keyed (no pending review)
  const pendA = Number(a.pendingReviewCount > 0);
  const pendB = Number(b.pendingReviewCount > 0);
  if (pendA !== pendB) return pendA - pendB;

  // 6. Scorable count
  if (b.scorableQuestionCount !== a.scorableQuestionCount) {
    return b.scorableQuestionCount - a.scorableQuestionCount;
  }

  return a.title.localeCompare(b.title);
}

function getHomepageFeaturedPapers(papers: LocalPaperSummary[], limit = 6): LocalPaperSummary[] {
  if (papers.length === 0) return [];

  const sorted = [...papers].sort(compareHomepagePapers);

  const preferredSubjects = [
    "english",
    "general-test",
    "mathematics",
    "physics",
    "chemistry",
    "biology",
    "computer-science",
    "history",
    "geography",
  ];

  const selected: LocalPaperSummary[] = [];
  const seenSlugs = new Set<string>();
  const seenSubjects = new Set<string>();

  // 1. Papers with actual attempts (> 0) naturally lead the list
  for (const p of sorted) {
    if (selected.length >= limit) break;
    if ((p.attemptCount || 0) > 0) {
      selected.push(p);
      seenSlugs.add(p.slug);
      seenSubjects.add(p.subject.slug);
    }
  }

  // 2. For remaining slots, pick the highest-ranked mock for preferred core subjects
  // This ensures diverse subjects with ~50 questions (around 50 questions, latest year)
  for (const subjSlug of preferredSubjects) {
    if (selected.length >= limit) break;
    if (seenSubjects.has(subjSlug)) continue;

    const match = sorted.find((p) => p.subject.slug === subjSlug && !seenSlugs.has(p.slug));
    if (match) {
      selected.push(match);
      seenSlugs.add(match.slug);
      seenSubjects.add(subjSlug);
    }
  }

  // 3. If still space, fill with remaining highest-ranked papers
  for (const p of sorted) {
    if (selected.length >= limit) break;
    if (!seenSlugs.has(p.slug)) {
      selected.push(p);
      seenSlugs.add(p.slug);
    }
  }

  return selected.slice(0, limit);
}

const heroPapers = getHomepageFeaturedPapers(localPapers, 4);
const libraryPapers = getHomepageFeaturedPapers(localPapers, 6);

const libraryRows = libraryPapers.map(paperRow);
const heroRows = heroPapers.map(paperRow);
const libraryCount = localPapers.length;

const seo = await getPageSeo(PATH);
const title = seo?.title || DEFAULT_TITLE;
const description = seo?.description || DEFAULT_DESCRIPTION;
const customFaq = parseFaq(seo?.faq_json);
const faqs = customFaq.length > 0 ? customFaq : DEFAULT_FAQ;
const noindex = (seo?.noindex ?? 0) === 1 || localPapers.length === 0;
const site = siteUrl(Astro.url);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "CUET Free Mock Test",
    url: site.toString(),
    description,
    inLanguage: "en-IN",
    publisher: { "@type": "Organization", name: "CUET Free Mock Test", url: site.toString() },
  },
  ...(popularPapers.length > 0
    ? [
        itemListJsonLd(
          site,
          popularPapers.map((paper) => ({ name: paper.title, path: paper.path })),
        ),
      ]
    : []),
].filter((item): item is Record<string, unknown> => Boolean(item));

const heroTagTone: Record<TagTone, string> = {
  mint: "bg-accent-50 text-accent-700 ring-1 ring-accent-200 dark:bg-accent-500/10 dark:text-accent-300 dark:ring-accent-500/20",
  violet: "bg-brand-50 text-brand-700 ring-1 ring-brand-200 dark:bg-brand-500/15 dark:text-brand-300 dark:ring-brand-500/25",
  amber: "bg-amber-50 text-amber-800 ring-1 ring-amber-200 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-500/20",
  neutral: "bg-neutral-100 text-neutral-600 ring-1 ring-neutral-200 dark:bg-white/5 dark:text-white/50 dark:ring-white/10",
};

const libraryTagTone: Record<TagTone, string> = {
  mint: "bg-accent-50 text-accent-700 ring-1 ring-accent-200 dark:bg-accent-500/10 dark:text-accent-300 dark:ring-accent-500/20",
  violet: "bg-brand-50 text-brand-700 ring-1 ring-brand-200 dark:bg-brand-500/15 dark:text-brand-300 dark:ring-brand-500/25",
  amber: "bg-amber-50 text-amber-800 ring-1 ring-amber-200 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-500/20",
  neutral: "bg-neutral-100 text-neutral-600 ring-1 ring-neutral-200 dark:bg-white/5 dark:text-white/50 dark:ring-white/10",
};

const icons: Record<string, string> = {
  clock: `<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>`,
  grid: `<rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect>`,
  history: `<path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l3 2"></path>`,
  chart: `<path d="M4 19V5"></path><path d="M4 19h16"></path><path d="M8 16v-5"></path><path d="M13 16V8"></path><path d="M18 16v-3"></path>`,
  target: `<circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1"></circle>`,
  book: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path>`,
  monitor: `<rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path>`,
  spark: `<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z"></path>`,
  layers: `<path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path>`,
};

const featureLinks = [
  {
    href: "/mock-tests",
    title: "Timed mock tests",
    hint: "Full-length, server-timed",
    icon: "clock",
  },
  {
    href: "/cuet-ug-syllabus",
    title: "Topic practice",
    hint: "Syllabus-led practice",
    icon: "layers",
  },
  {
    href: "/cuet-ug-previous-year-papers",
    title: "Previous-year questions",
    hint: "Past papers and practice",
    icon: "history",
  },
  {
    href: "/dashboard",
    title: "Progress insights",
    hint: "Scores and trends",
    icon: "chart",
  },
];

const rhythmSteps = [
  {
    number: "01",
    title: "Build your base",
    body: "Work through focused questions, get comfortable with the concepts, and keep your study sessions manageable.",
    href: "/cuet-ug-syllabus",
    cta: "Start practising",
    icon: "book",
  },
  {
    number: "02",
    title: "Get exam-ready",
    body: "Settle into an exam-style flow with a timer, question review, and a clear finish to each attempt.",
    href: "/mock-tests",
    cta: "Browse mock tests",
    icon: "target",
  },
  {
    number: "03",
    title: "Learn from each try",
    body: "Review your performance, spot topics to revisit, and use what you learned to plan your next session.",
    href: "/dashboard",
    cta: "View analytics",
    icon: "chart",
  },
];

const focusCards = [
  {
    title: "Exam-style sessions",
    body: "Take a full paper with timed navigation to practise staying on pace.",
    href: "/mock-tests",
    icon: "monitor",
  },
  {
    title: "Focused question sets",
    body: "Select a subject or a topic and work through practice questions at your own pace.",
    href: "/mock-tests",
    icon: "grid",
  },
  {
    title: "Past-year review",
    body: "Bring previous-year questions into your regular revision routine.",
