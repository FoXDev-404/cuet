---
import { siteUrl } from "../lib/site-url";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqSection from "../components/FaqSection.astro";
import { allOr } from "../lib/db";
import { hasMathSource, renderRichText } from "../lib/content";
import { getLocalPaperYears, getLocalPapers } from "../lib/local-papers";
import { listPyqYears } from "../lib/pyq";
import {
  articleJsonLd,
  breadcrumbJsonLd,
  getPageSeo,
  itemListJsonLd,
  parseFaq,
  type FaqItem,
} from "../lib/seo";

const PATH = "/cuet-ug-previous-year-question-papers";
const DEFAULT_TITLE = "CUET UG Previous Year Question Papers | Practice Online";
const DEFAULT_DESCRIPTION =
  "Boost your NTA CUET UG 2027 Exam Preparation! Practice FREE CUET UG PYQs Online with Answers. Solve Previous Year Question Papers Online and Check your Speed and Accuracy.";

const DEFAULT_FAQ: FaqItem[] = [
  {
    question: "Where can I find official CUET UG previous year papers?",
    answer:
      "Check the official NTA CUET portal and the information bulletins for the relevant session. This site does not host the original PDFs; papers appear as practice only when their year, shift and source can be recorded responsibly.",
  },
  {
    question: "Are the PYQ mocks on this site actual exam papers?",
    answer:
      "They are practice versions of previous-year papers, prepared for timed online attempts. For the official paper and marking scheme, always check the NTA portal and the current bulletin.",
  },
  {
    question: "Do previous-year questions repeat in CUET UG?",
    answer:
      "Exact questions rarely repeat, but concepts, formats and difficulty patterns do. The value of a PYQ is rehearsal: you learn how the paper allocates time and how distractor options are built.",
  },
  {
    question: "Should I attempt a PYQ before finishing the syllabus?",
    answer:
      "Yes, one early paper is useful as a diagnostic even if you have not finished everything. Expect a low score; the section breakdown is the output you want, not a polished result.",
  },
  {
    question: "Can I retake a previous-year paper?",
    answer:
      "Yes. Retakes are scored and reviewed normally, but only the first submitted attempt counts on the leaderboard. Use the retake to check whether your error review actually worked.",
  },
  {
    question: "Why is a paper marked noindex or missing?",
    answer:
      "Papers stay out of search until the question set, solutions and page introduction are complete. Empty archives are deliberately not indexed.",
  },
];

const pyqs = await allOr<{
  title: string;
  slug: string;
  pyq_year: number | null;
  pyq_shift: string | null;
  subject_name: string | null;
  subject_slug: string | null;
  question_count: number;
  duration_min: number;
} >(
  `SELECT m.title, m.slug, m.pyq_year, m.pyq_shift,
          s.name AS subject_name, s.slug AS subject_slug,
          (SELECT COUNT(*) FROM mock_questions_current mq WHERE mq.mock_id = m.id) AS question_count,
          m.duration_min
   FROM mock_tests m
   LEFT JOIN subjects s ON s.id = m.subject_id
   WHERE m.type = 'pyq' AND m.status = 'published' AND m.deleted_at IS NULL
     AND m.practice_paper_slug IS NULL
   ORDER BY m.pyq_year DESC, m.pyq_shift, m.id DESC
   LIMIT 60`,
  [],
);

const localPapers = getLocalPapers();
const localYears = getLocalPaperYears();
const pyqYears = await listPyqYears();
const subjectMap = new Map<
  string,
  {
    name: string;
    paperCount: number;
    latestYear: number;
    papers: {
      title: string;
      href: string;
      year: number;
      shift: string | null;
      questionCount: number;
      durationMinutes: number;
    }[];
  }
>();
for (const paper of pyqs) {
  if (!paper.subject_slug || !paper.subject_name) continue;
  const summary = subjectMap.get(paper.subject_slug) ?? {
    name: paper.subject_name,
    paperCount: 0,
    latestYear: 0,
    papers: [],
  };
  summary.paperCount += 1;
  summary.latestYear = Math.max(summary.latestYear, paper.pyq_year ?? 0);
  summary.papers.push({
    title: paper.title,
    href: `/mock/${paper.slug}`,
    year: paper.pyq_year ?? 0,
    shift: paper.pyq_shift,
    questionCount: paper.question_count,
    durationMinutes: paper.duration_min,
  });
  subjectMap.set(paper.subject_slug, summary);
}
for (const paper of localPapers) {
  const summary = subjectMap.get(paper.subject.slug) ?? {
    name: paper.subject.name,
    paperCount: 0,
    latestYear: 0,
    papers: [],
  };
  summary.paperCount += 1;
  summary.latestYear = Math.max(summary.latestYear, paper.year);
  summary.papers.push({
    title: paper.title,
    href: paper.path,
    year: paper.year,
    shift: paper.shift,
    questionCount: paper.rankedQuestionCount ?? paper.recoveredQuestionCount,
    durationMinutes: paper.rankedDurationMinutes ?? paper.durationMinutes,
  });
  subjectMap.set(paper.subject.slug, summary);
}
const subjectCards = [...subjectMap.entries()]
  .map(([slug, summary]) => ({
    slug,
    ...summary,
    papers: summary.papers
      .sort((a, b) => b.year - a.year || (a.shift ?? "").localeCompare(b.shift ?? ""))
      .slice(0, 5),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const yearMap = new Map<number, { year: number; playable_count: number }>();
for (const row of pyqYears) yearMap.set(row.year, { ...row });
for (const row of localYears) {
  const existing = yearMap.get(row.year);
  yearMap.set(row.year, {
    year: row.year,
    playable_count: (existing?.playable_count ?? 0) + row.playable_count,
  });
}
const playableYears = [...yearMap.values()]
  .filter((row) => row.playable_count > 0)
  .sort((a, b) => b.year - a.year);

const totalPapers = pyqs.length + localPapers.length;
const seo = await getPageSeo(PATH);
const title = seo?.title || DEFAULT_TITLE;
const description = seo?.description || DEFAULT_DESCRIPTION;
const customFaq = parseFaq(seo?.faq_json);
const faqs = customFaq.length > 0 ? customFaq : DEFAULT_FAQ;
const noindex = (seo?.noindex ?? 0) === 1 || totalPapers === 0;
const site = siteUrl(Astro.url);

const structuredData = [
  breadcrumbJsonLd(site, [
    { name: "Home", path: "/" },
    { name: "Previous-year papers", path: PATH },
  ]),
  articleJsonLd({ site, title, description, path: PATH, updated: seo?.updated_at ?? null }),
  ...(totalPapers > 0
    ? [
        itemListJsonLd(site, [
          ...subjectCards.flatMap((subject) =>
            subject.papers.map((paper) => ({ name: paper.title, path: paper.href })),
          ),
        ]),
      ]
    : []),
].filter((item): item is Record<string, unknown> => Boolean(item));

const steps = [
  { title: "Take it timed first", body: "Use the instructions page and the countdown. A paper attempted without a clock tells you very little about exam readiness." },
  { title: "Mark every guess", body: "Note which answers were confident, eliminated or blind. The result page separates correct from lucky." },
  { title: "Review before scoring", body: "Read the solution for every wrong and skipped question, even the ones you got right by elimination." },
  { title: "Re-attempt after a gap", body: "Wait at least a week, then retake only the questions you missed. If the same unit fails again, it is a concept gap, not carelessness." },
];
---

<BaseLayout title={title} description={description} mathStyles={hasMathSource(seo?.intro_html)} noindex={noindex} canonical={seo?.canonical_url} structuredData={structuredData}>
  <PageHero
    eyebrow="CUET UG Previous year question papers"
    title="NTA CUET UG Previous Year Question Papers – Practice Online"
    intro="Practice FREE CUET UG Previous Year Question Papers Online with Instant Answers. Attempt authentic NTA-Pattern Questions Boost your Preparation for the CUET UG 2027 Exam."
  />

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    {seo?.intro_html ? (
      <div class="mb-8 rounded-2xl border border-brand-200 bg-brand-50 p-5 text-sm leading-7 text-brand-900 dark:border-brand-800 dark:bg-brand-950/40 dark:text-brand-100" set:html={renderRichText(seo.intro_html)}></div>
    ) : null}

    {playableYears.length > 0 ? (
      <section class="mt-8">
        <h2 class="text-lg font-bold">Browse by year</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {playableYears.map((row) => (
            <a class="rounded-full border border-neutral-300 bg-white px-3.5 py-1.5 text-sm font-semibold hover:border-brand-300 hover:bg-brand-50 dark:border-neutral-700 dark:bg-neutral-900 dark:hover:border-brand-700 dark:hover:bg-brand-950/40" href={`/pyq/${row.year}`}>
              {row.year} <span class="text-xs font-normal text-neutral-500 dark:text-neutral-400">({row.playable_count})</span>
            </a>
          ))}
        </div>
      </section>
    ) : null}

    <section class="mt-10" aria-labelledby="pyq-subjects-heading">
      {totalPapers === 0 ? (
        <div class="mt-5 rounded-2xl border border-dashed border-neutral-300 p-10 text-center dark:border-neutral-700">
          <h3 class="font-bold">No PYQ paper is published yet</h3>
          <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-neutral-500 dark:text-neutral-400">
            The archive is intentionally empty rather than filled with unverified or copied papers. In the meantime, use the original subject mocks to rehearse the same timing and review loop.
          </p>
          <div class="mt-4 flex flex-wrap justify-center gap-2">
            <a class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" href="/mock-tests">Browse mock tests</a>
            <a class="rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-900" href="/cuet-ug-exam-pattern">Read the pattern guide</a>
          </div>
        </div>
      ) : (
        <div>
          <h2 class="text-2xl font-bold tracking-tight" id="pyq-subjects-heading">Browse by subject</h2>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            Choose a subject to browse its latest previous-year papers.
          </p>
          <div class="mt-5 grid gap-5 md:grid-cols-2">
            {subjectCards.map((subject) => (
              <section
                class="flex h-full flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm dark:border-white/10 dark:bg-white/[0.035]"
                data-pyq-subject-card
                data-subject-slug={subject.slug}
                aria-labelledby={`pyq-subject-${subject.slug}`}
              >
                <div class="flex items-center justify-between gap-3 border-b border-neutral-200 px-4 py-3 dark:border-white/10">
                  <h3 class="text-lg font-bold" id={`pyq-subject-${subject.slug}`}>{subject.name}</h3>
                  <span class="shrink-0 text-[10px] font-semibold text-neutral-500 dark:text-white/55">
                    {subject.paperCount} papers
                  </span>
                </div>

                <div class="px-4 pb-1 pt-4">
                  <h4 class="text-base font-bold">CUET UG {subject.name} Previous Year Papers</h4>
                  <p class="mt-1 text-xs text-neutral-500 dark:text-white/55">
                    Recent timed practice papers for {subject.name}.
                  </p>
                </div>

                <div class="mt-2">
                  {subject.papers.map((paper) => (
                    <a
                      href={paper.href}
                      class="group flex flex-col gap-2 border-t border-neutral-100 px-4 py-3 transition-colors hover:bg-neutral-50 dark:border-white/[0.07] dark:hover:bg-white/[0.03] sm:flex-row sm:items-center sm:justify-between"
                      data-pyq-paper-row
                    >
                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-1.5">
                          <span class="rounded bg-brand-50 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-brand-700 dark:bg-brand-500/15 dark:text-brand-300">
                            CUET PYQ
                          </span>
                          <span class="rounded bg-amber-50 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">
                            {subject.name}
                          </span>
                          <span class="rounded bg-neutral-100 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-neutral-600 dark:bg-white/10 dark:text-white/65">
                            {paper.year}{paper.shift ? ` · ${paper.shift}` : ""}
                          </span>
                        </div>
                        <p class="mt-1.5 truncate text-sm font-semibold text-neutral-800 group-hover:text-brand-700 dark:text-white/75 dark:group-hover:text-white">
                          {paper.title}
                        </p>
                      </div>
                      <div class="flex shrink-0 items-center gap-4 text-[10px] text-neutral-500 dark:text-white/55 sm:justify-end">
                        <span><span class="font-bold text-accent-600 dark:text-accent-300">{paper.questionCount}</span> questions</span>
                        <span>{paper.durationMinutes} min</span>
                      </div>
                    </a>
                  ))}
                </div>

                <a
                  href={`/pyq/subject/${subject.slug}`}
                  class="mt-auto flex items-center justify-center gap-2 border-t border-neutral-200 px-4 py-3 text-[11px] font-bold text-brand-700 hover:bg-neutral-50 dark:border-white/10 dark:text-brand-300 dark:hover:bg-white/[0.03]"
                >
                  {subject.paperCount > subject.papers.length
                    ? `View more ${subject.name} papers`
                    : `View all ${subject.name} papers`} →
                </a>
              </section>
            ))}
          </div>
        </div>
      )}
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight">How to use a PYQ properly</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {steps.map((step, index) => (
          <div class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
            <p class="text-xs font-bold uppercase tracking-wide text-brand-700 dark:text-brand-300">Step {index + 1}</p>
            <h3 class="mt-2 font-bold">{step.title}</h3>
            <p class="mt-2 text-sm leading-7 text-neutral-600 dark:text-neutral-400">{step.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-2xl border border-neutral-200 bg-neutral-50 p-6 dark:border-neutral-800 dark:bg-neutral-900">
      <h2 class="text-xl font-bold">What a PYQ can and cannot tell you</h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-2 text-sm leading-7 text-neutral-600 dark:text-neutral-400">
        <div>
          <p class="font-semibold text-neutral-900 dark:text-neutral-100">It can</p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <li>show the rhythm of a full paper</li>
            <li>reveal how options are designed</li>
            <li>test whether your revision survives a clock</li>
            <li>give you a realistic section split</li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-neutral-900 dark:text-neutral-100">It cannot</p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <li>guarantee the next paper's difficulty</li>
            <li>predict chapter weightage for your session</li>
            <li>replace the current official syllabus</li>
            <li>compensate for a copied, unverified source</li>
          </ul>
        </div>
      </div>
    </section>

    <FaqSection faqs={faqs} />

    <section class="mt-12 rounded-2xl bg-brand-600 p-6 text-white sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold">Build the review habit first</h2>
          <p class="mt-2 max-w-xl text-sm leading-6 text-brand-50">Even without a PYQ archive, a timed original paper gives you the same diagnostic loop.</p>
        </div>
        <a class="rounded-lg bg-white px-4 py-2.5 text-sm font-bold text-brand-800 hover:bg-brand-50" href="/mock-tests">Practice now</a>
      </div>
    </section>
  </div>
</BaseLayout>
