---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { all } from "../../lib/db";
import { formatDate } from "../../lib/content";
import { dashboardNav } from "../../lib/navigation";

const user = Astro.locals.user;
if (!user) return Astro.redirect(`/login?next=${encodeURIComponent("/dashboard/bookmarks")}`, 303);

const bookmarks = await all<{
  question_id: number;
  note: string | null;
  created_at: string;
  text: string;
  subject_name: string;
  difficulty: string | null;
}>(
  `SELECT b.question_id, b.note, b.created_at, q.text, s.name AS subject_name, q.difficulty
   FROM bookmarks b
   JOIN questions q ON q.id = b.question_id
   JOIN subjects s ON s.id = q.subject_id
   WHERE b.user_id = ? AND q.deleted_at IS NULL
   ORDER BY b.created_at DESC`,
  user.id,
);
---

<BaseLayout title="Bookmarks — CUET Free Mock Test" description="Questions you saved for revision." noindex sectionLabel="Dashboard" sectionNav={dashboardNav}>
  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <h1 class="text-2xl font-black tracking-tight">Bookmarks</h1>
    <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Saved questions and your revision notes. Open a result or solution to add more.</p>

    {bookmarks.length === 0 ? (
      <div class="mt-6 rounded-2xl border border-dashed border-neutral-300 p-10 text-center dark:border-neutral-700">
        <h2 class="font-bold">No bookmarks yet</h2>
        <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">On a solutions page, choose “Bookmark” to keep a question here.</p>
        <a class="mt-4 inline-block rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" href="/cuet-ug-mock-test">Browse mock tests</a>
      </div>
    ) : (
      <ul class="mt-6 space-y-3">
        {bookmarks.map((bookmark) => (
          <li class="rounded-2xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900" data-bookmark={bookmark.question_id}>
            <div class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <span class="rounded-full bg-neutral-100 px-2 py-0.5 font-semibold dark:bg-neutral-800">{bookmark.subject_name}</span>
              {bookmark.difficulty ? <span class="capitalize">{bookmark.difficulty}</span> : null}
              <span>Saved {formatDate(bookmark.created_at)}</span>
            </div>
            <p class="mt-2 line-clamp-3 text-sm leading-6">{bookmark.text.replace(/\$[^$]+\$/g, "…")}</p>
            {bookmark.note ? <p class="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:bg-amber-950/30 dark:text-amber-200">{bookmark.note}</p> : null}
            <button type="button" class="mt-3 rounded-lg border border-red-200 px-2.5 py-1 text-xs font-semibold text-red-700 hover:bg-red-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950/30" data-remove-bookmark={bookmark.question_id}>Remove</button>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<script>
  document.querySelectorAll("[data-remove-bookmark]").forEach((button) => {
    button.addEventListener("click", async () => {
      const id = (button as HTMLElement).dataset.removeBookmark;
      if (!id) return;
      (button as HTMLButtonElement).disabled = true;
      const response = await fetch(`/api/bookmarks/${id}`, { method: "DELETE" });
      if (response.ok) {
        document.querySelector(`[data-bookmark="${id}"]`)?.remove();
      } else {
        (button as HTMLButtonElement).disabled = false;
      }
    });
  });
</script>
