---
import { loadMockThreadFeed } from "../lib/discussions";
import { chatTone, displayInitial, safeAvatarUrl } from "../lib/chat";
import { formatDateTime, renderRichText } from "../lib/content";
import { getSetting } from "../lib/settings";

interface Props {
  mockId: number;
  mockSlug: string;
  access: boolean;
  heading?: string;
  limit?: number;
  interactive?: boolean;
  sectionId?: string;
  lockedMessage?: string;
  lockedCtaLabel?: string;
  lockedCtaHref?: string;
  note?: string;
  fullBoardLink?: boolean;
  loginNext?: string;
  reloadOnPost?: boolean;
}

const {
  mockId,
  mockSlug,
  access,
  heading = "Discussion",
  limit = 3,
  interactive = false,
  sectionId,
  lockedMessage = "Take the paper first, then compare approaches with other students. The result page unlocks the thread automatically.",
  lockedCtaLabel = "Start this paper",
  lockedCtaHref = `/mock/${mockSlug}/instructions`,
  note,
  fullBoardLink = true,
  loginNext = `/mock/${mockSlug}/discussion`,
  reloadOnPost = true,
} = Astro.props;
const user = Astro.locals.user;
const admin = Astro.locals.admin;
const paused = !admin && (await getSetting("discussion_enabled", "true")) === "false";
const feed =
  access && !paused
    ? await loadMockThreadFeed(mockId, user?.id ?? null, { sort: "new", limit })
    : { threads: [], nextCursor: null };
const threads = feed.threads;
---

<section id={sectionId} class="mt-10 rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-xl font-bold">{heading}</h2>
      <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
        {paused
          ? "Discussions are paused right now."
          : note
            ? note
            : access
              ? "Visible only to students who finished this paper. Be useful, not dismissive."
              : "Comments can mention answers, so the thread stays locked until you finish this paper."}
      </p>
    </div>
    {access && !paused && fullBoardLink ? (
      <a class="rounded-lg border border-neutral-300 px-3 py-1.5 text-sm font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/mock/${mockSlug}/discussion`}>
        Open discussion →
      </a>
    ) : null}
  </div>

  {!access ? (
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-dashed border-neutral-300 p-4 dark:border-neutral-700">
      <p class="max-w-xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">{lockedMessage}</p>
      <a class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-bold text-white hover:bg-brand-700" href={lockedCtaHref}>{lockedCtaLabel}</a>
    </div>
  ) : paused ? (
    <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-100">
      The discussion board is closed for maintenance. Your attempt and result are unaffected.
    </p>
  ) : threads.length === 0 ? (
    <p class="mt-4 rounded-xl border border-dashed border-neutral-300 p-4 text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
      No comments yet. {user
        ? fullBoardLink
          ? "Start the conversation from the discussion page."
          : "Start the conversation below — be the first to post."
        : "Log in to post the first comment."}
    </p>
  ) : (
    <ul class="mt-4 space-y-3">
      {threads.map((thread) => {
        const tone = chatTone(thread.user_id);
        const avatar = safeAvatarUrl(thread.avatar_url);
        return (
          <li class="rounded-xl border border-neutral-200 p-4 dark:border-neutral-800">
            <div class="flex gap-3">
              {avatar ? (
                <img src={avatar} alt="" width="32" height="32" loading="lazy" referrerpolicy="no-referrer" class="h-8 w-8 shrink-0 rounded-full object-cover ring-1 ring-black/10 dark:ring-white/10" />
              ) : (
                <span class:list={["grid h-8 w-8 shrink-0 place-items-center rounded-full bg-gradient-to-br text-[11px] font-black text-white ring-1 ring-black/10 dark:ring-white/10", tone.avatar]} aria-hidden="true">
                  {displayInitial(thread.username)}
                </span>
              )}
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                  <span class:list={["font-bold", tone.name]}>{thread.username}</span>
                  <time datetime={thread.created_at}>{formatDateTime(thread.created_at)}</time>
                  <span>▲ {thread.upvotes}</span>
                  {thread.replies.length > 0 ? <span>{thread.replies.length} repl{thread.replies.length === 1 ? "y" : "ies"}</span> : null}
                </div>
                <div class="mt-1 max-h-28 overflow-hidden text-sm leading-7" set:html={renderRichText(thread.body)}></div>
                {interactive && user ? (
                  <details class="mt-2">
                    <summary class="cursor-pointer text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300">Reply</summary>
                    <form class="mt-2 space-y-2" data-inline-discussion data-parent-id={thread.id}>
                      <label class="sr-only" for={`inline-reply-${thread.id}`}>Reply to {thread.username}</label>
                      <textarea id={`inline-reply-${thread.id}`} class="w-full rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-950" name="body" rows="2" minlength="2" maxlength="2000" required placeholder={`Reply to ${thread.username}`}></textarea>
                      <div class="flex items-center justify-end gap-3">
                        <p class="mr-auto text-xs text-red-700 dark:text-red-400" data-inline-message></p>
                        <button class="rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-brand-700 disabled:opacity-60" type="submit">Send reply</button>
                      </div>
                    </form>
                  </details>
                ) : null}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  )}

  {access && !paused && fullBoardLink && threads.length > 0 ? (
    <a class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href={`/mock/${mockSlug}/discussion`}>
      Read all comments and reply →
    </a>
  ) : null}

  {interactive && access && !paused ? (
    user ? (
      <form class="mt-5 rounded-xl border border-neutral-200 bg-neutral-50 p-3 dark:border-neutral-800 dark:bg-neutral-950" data-inline-discussion>
        <label class="text-xs font-bold uppercase tracking-wide text-neutral-500 dark:text-neutral-400" for="inline-discussion-body">
          Join the discussion
        </label>
        <textarea
          id="inline-discussion-body"
          class="mt-2 w-full resize-y rounded-lg border border-neutral-200 bg-white px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-900"
          name="body"
          rows="3"
          minlength="2"
          maxlength="2000"
          required
          placeholder="Ask about a question, share an approach, or encourage someone."
        ></textarea>
        <div class="mt-2 flex flex-wrap items-center justify-end gap-3">
          <p class="mr-auto text-xs text-red-700 dark:text-red-400" data-inline-message></p>
          {fullBoardLink ? (
            <a class="text-xs font-semibold text-neutral-500 hover:underline dark:text-neutral-400" href={`/mock/${mockSlug}/discussion`}>Open full discussion</a>
          ) : null}
          <button class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60" type="submit">Post comment</button>
        </div>
      </form>
    ) : (
      <p class="mt-5 rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-4 text-sm text-neutral-600 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-300">
        <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href={`/login?next=${encodeURIComponent(loginNext)}`}>Log in</a>
        {" "}{fullBoardLink ? "or create a free account to read and reply to the paper discussion." : "or create a free account to join the live chat."}
      </p>
    )
  ) : null}

  {interactive && access && !paused ? (
    <script is:inline define:vars={{ inlineMockId: Number(mockId), inlineReloadOnPost: reloadOnPost }}>
      document.querySelectorAll("[data-inline-discussion]").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const textarea = form.querySelector("textarea[name=body]");
          const button = form.querySelector("button[type=submit]");
          const message = form.querySelector("[data-inline-message]");
          if (!textarea || !button) return;
          button.disabled = true;
          if (message) {
            message.textContent = "";
            message.style.color = "";
          }
          try {
            const response = await fetch("/api/discussions", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({
                mockId: inlineMockId,
                questionId: null,
                parentId: form.dataset.parentId ? Number(form.dataset.parentId) : null,
                body: textarea.value,
              }),
            });
            const result = await response.json();
            if (!response.ok) throw new Error(result.error || "Could not post the comment.");
            if (inlineReloadOnPost) {
              if (result.status === "pending") {
                alert(result.message || "Your comment is awaiting moderation.");
              }
              location.reload();
              return;
            }
            // While a timed attempt is running, reloading would trigger the
            // leave-page guard and reset the question view. Confirm in place.
            textarea.value = "";
            button.disabled = false;
            if (message) {
              message.textContent = result.message || "Comment posted.";
              message.style.color = "var(--success-ink)";
            }
          } catch (error) {
            if (message) {
              message.textContent = error instanceof Error ? error.message : "Could not post the comment.";
              message.style.color = "";
            } else {
              alert(error instanceof Error ? error.message : "Could not post the comment.");
            }
            button.disabled = false;
          }
        });
      });
    </script>
  ) : null}
</section>
