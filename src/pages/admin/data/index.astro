---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { TABLES, type TableDef } from "../../../lib/admin/schema";
import { can } from "../../../lib/auth/admin";
import { first } from "../../../lib/db";

const admin = Astro.locals.admin!;
if (!can(admin.role, "data.manage")) return Astro.redirect("/admin", 303);

const sections: TableDef["section"][] = ["Content", "People", "Attempts", "Community", "Site", "Operations"];
const alias = (name: string) => `t_${name.replace(/[^a-z0-9]/g, "_")}`;

let counts: Record<string, number> = {};
try {
  const select = TABLES.map((table) => `(SELECT COUNT(*) FROM "${table.name}") AS "${alias(table.name)}"`).join(", ");
  const row = await first<Record<string, number>>(`SELECT ${select}`);
  counts = Object.fromEntries(
    TABLES.map((table) => [table.name, Number(row?.[alias(table.name)] ?? 0)]),
  );
} catch {
  counts = {};
}
---

<AdminLayout title="Data manager" active="data">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Data manager</h1>
      <p class="mt-1 max-w-3xl text-sm text-neutral-600 dark:text-neutral-400">
        Every table the site uses is reachable here through an explicit allow-list. Sensitive columns
        (password hashes, session ids, reset tokens, guest tokens) are never listed or exported.
        Writes are validated, snapshot where supported, and recorded in the audit log.
      </p>
    </div>
    <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href="/admin/trash">Open trash</a>
  </div>

  <div class="mt-4 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900 dark:border-sky-900 dark:bg-sky-950/40 dark:text-sky-100">
    <p class="font-semibold">Safety model</p>
    <ul class="mt-1 list-disc space-y-1 pl-5 text-xs leading-5">
      <li>Destructive deletes move a row to Trash when the table supports soft delete. Purging needs a typed id and Super Admin.</li>
      <li>Rows with dependants are refused with a plain-language foreign-key message instead of a partial delete.</li>
      <li>Published mock versions and attempt answer rows are read-only here; use the Mock builder, Attempts and Rescore screens.</li>
    </ul>
  </div>

  {sections.map((section) => {
    const tables = TABLES.filter((table) => table.section === section);
    if (tables.length === 0) return null;
    return (
      <section class="mt-8" aria-labelledby={`section-${section}`}>
        <h2 class="text-sm font-bold uppercase tracking-wide text-neutral-500 dark:text-neutral-400" id={`section-${section}`}>{section}</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {tables.map((table) => (
            <a class="group rounded-xl border border-neutral-200 bg-white p-4 hover:border-brand-400 hover:shadow-sm dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-brand-500" href={`/admin/data/${table.name}`}>
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="font-bold group-hover:text-brand-700 dark:group-hover:text-brand-300">{table.label}</p>
                  <p class="mt-0.5 font-mono text-[11px] text-neutral-500 dark:text-neutral-400">{table.name}</p>
                </div>
                <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs font-semibold tabular-nums dark:bg-neutral-800">
                  {counts[table.name] ?? "—"}
                </span>
              </div>
              <p class="mt-2 line-clamp-2 text-xs leading-5 text-neutral-500 dark:text-neutral-400">
                {table.note ?? `${table.columns.length} columns · ${table.editable === false ? "read-only" : "editable"}${table.softDelete ? " · trash-supported" : ""}`}
              </p>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</AdminLayout>
