---
interface Props {
  showTagline?: boolean;
  class?: string;
  tone?: "auto" | "dark";
  size?: "default" | "compact";
  link?: boolean;
}

const {
  showTagline = false,
  class: className = "",
  tone = "auto",
  size = "default",
  link = true,
} = Astro.props;
const compact = size === "compact";
const wordmark = tone === "dark" ? "text-white" : "text-neutral-900 dark:text-white";
const suffix = tone === "dark" ? "text-neutral-400" : "text-neutral-500 dark:text-neutral-400";
const tagline = tone === "dark" ? "text-white/55" : "text-neutral-500 dark:text-white/55";
const accent = tone === "dark" ? "text-accent-400" : "text-accent-500 dark:text-accent-400";
---

{
  link ? (
    <a
      href="/"
      class:list={["group flex min-w-0 items-center", compact ? "gap-2" : "gap-2.5", className]}
      title="CUETFreeMockTest.com — free CUET mock tests"
    >
      <img
        src="/logo.svg"
        alt=""
        width={compact ? 28 : 36}
        height={compact ? 28 : 36}
        decoding="async"
        class:list={[
          "shrink-0 rounded-xl shadow-[var(--shadow-brand)] transition-transform group-hover:scale-105",
          compact ? "h-7 w-7" : "h-9 w-9",
        ]}
      />
      <span class="min-w-0">
        <span
          class:list={[
            "block truncate font-black leading-tight tracking-tight",
            compact ? "text-[13px] sm:text-[14px]" : "text-[15px] sm:text-[17px]",
            wordmark,
          ]}
        >
          CUET<span class={accent}>FreeMockTest</span><span class:list={["font-medium text-xs sm:text-sm ml-0.5", suffix]}>.com</span>
        </span>
        {showTagline && !compact ? (
          <span class:list={["mt-0.5 block truncate text-[8px] font-semibold uppercase tracking-[0.24em]", tagline]}>
            Practice with purpose
          </span>
        ) : null}
      </span>
    </a>
  ) : (
    <div
      class:list={["group flex min-w-0 items-center", compact ? "gap-2" : "gap-2.5", className]}
      title="CUETFreeMockTest.com"
      role="img"
      aria-label="CUETFreeMockTest.com"
    >
      <img
        src="/logo.svg"
        alt=""
        width={compact ? 28 : 36}
        height={compact ? 28 : 36}
        decoding="async"
        class:list={[
          "shrink-0 rounded-xl shadow-[var(--shadow-brand)]",
          compact ? "h-7 w-7" : "h-9 w-9",
        ]}
      />
      <span class="min-w-0" aria-hidden="true">
        <span
          class:list={[
            "block truncate font-black leading-tight tracking-tight",
            compact ? "text-[13px] sm:text-[14px]" : "text-[15px] sm:text-[17px]",
            wordmark,
          ]}
        >
          CUET<span class={accent}>FreeMockTest</span><span class:list={["font-medium text-xs sm:text-sm ml-0.5", suffix]}>.com</span>
        </span>
        {showTagline && !compact ? (
          <span class:list={["mt-0.5 block truncate text-[8px] font-semibold uppercase tracking-[0.24em]", tagline]}>
            Practice with purpose
          </span>
        ) : null}
      </span>
    </div>
  )
}
