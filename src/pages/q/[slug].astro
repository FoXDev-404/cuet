---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShareSheet from "../../components/ShareSheet.astro";
import { siteUrl } from "../../lib/site-url";
import { breadcrumbJsonLd } from "../../lib/seo";
import { parsePublicId } from "../../lib/share/public-id";
import {
  publicQuestionDescription,
  publicQuestionTitle,
  questionOgImagePath,
} from "../../lib/share/public-question";
import { resolvePublicQuestion } from "../../lib/share/public-question-store";
import { dbUnavailableResponse } from "../../lib/db-resilient";
import { renderRichText } from "../../lib/rich-text";

const segment = Astro.params.slug ?? "";
const publicId = parsePublicId(segment);
if (!publicId) return new Response("Question not found", { status: 404 });

let resolved: Awaited<ReturnType<typeof resolvePublicQuestion>> = null;
try {
  resolved = await resolvePublicQuestion(publicId, Astro.locals.user?.id ?? null);
} catch (error) {
  // D1 is unreachable (for example the daily row-read quota is spent). This is
  // an indexable page, so answer 503 rather than pretending the question is gone.
  console.error("Public question lookup failed", error);
  return dbUnavailableResponse();
}
if (!resolved) return new Response("Question not found", { status: 404 });

const canonicalSegment = resolved.path.slice("/q/".length);
if (segment !== canonicalSegment) {
  return Astro.redirect(resolved.path, 301);
}

const { view } = resolved;
const site = siteUrl(Astro.url);
const title = publicQuestionTitle({
  text: view.text,
  subjectName: view.subject.name,
  seoEligible: view.seoEligible,
});
const description = publicQuestionDescription({
  text: view.text,
  subjectName: view.subject.name,
  seoEligible: view.seoEligible,
});
const robots = view.seoEligible ? "index, follow" : "noindex, follow";

const breadcrumbTrail = [
  { name: "Home", path: "/" },
  { name: "CUET mock tests", path: "/mock-tests" },
  { name: view.subject.name, path: `/cuet-mock-test/${view.subject.slug}` },
  ...(view.topic
    ? [{ name: view.topic.name, path: `/cuet-mock-test/${view.subject.slug}/${view.topic.slug}` }]
    : []),
  { name: "Question", path: view.path },
];
const structuredData = view.seoEligible ? [breadcrumbJsonLd(site, breadcrumbTrail)] : [];

const primaryMock = view.relatedMocks[0];
const ctaHref = primaryMock ? `/mock/${primaryMock.slug}/instructions` : "/mock-tests";
const ctaLabel = primaryMock ? "Attempt this full mock" : "Browse CUET mock tests";
const hasHindi =
  Boolean(view.textHi?.trim()) ||
  Boolean(view.optionsHi?.some((option) => option.text.trim() || option.imageUrl));
const shareAnswer = view.canCheck
  ? {
      correctOption: resolved.question.correctOption,
      explanation: resolved.question.explanation,
      explanationHi: resolved.question.explanationHi,
      explanationImageUrl: resolved.question.explanationImageUrl,
      explanationImageAlt: resolved.question.explanationImageAlt,
    }
  : null;
const shareUrl = new URL(view.path, site).toString();

function imageFileName(url: string | null | undefined): string {
  if (!url) return "";
  const clean = url.split("?")[0].split("#")[0];
  const parts = clean.split("/");
  return parts[parts.length - 1] || "";
}

function textContainsImage(text: string | null | undefined, url: string | null | undefined): boolean {
  if (!text || !url) return false;
  if (text.includes(url)) return true;
  const f = imageFileName(url);
  return Boolean(f && text.includes(f));
}

function isPlaceholderText(text: string | null | undefined): boolean {
  if (!text) return true;
  const trimmed = text.trim();
  return /^(fig\s*[a-d1-4]|figure\s*[a-d1-4]|\(?[a-d1-4]\)?\s*fig)$/i.test(trimmed);
}
---

<BaseLayout
  title={title}
  description={description}
  robots={robots}
  structuredData={structuredData}
  image={view.seoEligible ? questionOgImagePath(view.publicId) : null}
>
  <article class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    <nav class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-neutral-500 dark:text-neutral-400" aria-label="Breadcrumb">
      {breadcrumbTrail.map((item, index) => (
        <>
          {index > 0 ? <span aria-hidden="true">/</span> : null}
          {index === breadcrumbTrail.length - 1 ? (
            <span aria-current="page">{item.name}</span>
          ) : (
            <a class="hover:underline" href={item.path}>{item.name}</a>
          )}
        </>
      ))}
    </nav>

    <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full bg-brand-100 px-2.5 py-1 font-semibold text-brand-900 dark:bg-brand-900/50 dark:text-brand-200">
        CUET {view.subject.name}
      </span>
      {view.topic ? (
        <span class="rounded-full bg-neutral-100 px-2.5 py-1 font-semibold text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">
          {view.topic.name}
        </span>
      ) : null}
      {view.year ? (
        <span class="rounded-full bg-amber-100 px-2.5 py-1 font-semibold text-amber-900 dark:bg-amber-950/50 dark:text-amber-200">
          PYQ {view.year}
        </span>
      ) : null}
      {view.difficulty ? (
        <span class="rounded-full bg-neutral-100 px-2.5 py-1 font-semibold capitalize text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">
          {view.difficulty}
        </span>
      ) : null}
    </div>

    {hasHindi ? (
      <div class="mt-4 flex items-center gap-2" role="group" aria-label="Question language">
        <button type="button" data-lang-button="en" aria-pressed="true" class="min-h-11 rounded-lg border border-neutral-300 px-3 text-sm font-semibold dark:border-neutral-700">English</button>
        <button type="button" data-lang-button="hi" aria-pressed="false" class="min-h-11 rounded-lg border border-neutral-300 px-3 text-sm font-semibold dark:border-neutral-700">हिंदी</button>
      </div>
    ) : null}

    {view.passage ? (
      <section class="mt-6 rounded-2xl border border-neutral-200 bg-neutral-50 p-4 text-sm leading-7 dark:border-neutral-800 dark:bg-neutral-900/50" aria-label="Reading passage">
        <div data-lang-text="en">{renderRichText(view.passage.body) ? <div set:html={renderRichText(view.passage.body)} /> : <p>Read the passage and answer the question below.</p>}</div>
        {view.passage.bodyHi ? <div data-lang-text="hi" hidden set:html={renderRichText(view.passage.bodyHi)} /> : null}
        {view.passage.imageUrl ? (
          <img class="mt-3 max-h-96 w-auto rounded-lg" src={view.passage.imageUrl} alt={view.passage.imageAlt ?? "Reading passage"} loading="lazy" />
        ) : null}
      </section>
    ) : null}

    <h1 class="mt-6 text-xl font-bold leading-8 tracking-tight sm:text-2xl">
      <span data-lang-text="en" set:html={renderRichText(view.text)} />
      {view.textHi ? <span data-lang-text="hi" hidden set:html={renderRichText(view.textHi)} /> : null}
    </h1>

    {view.imageUrl && !textContainsImage(view.text, view.imageUrl) ? (
      <img class="mt-4 max-h-[32rem] w-auto rounded-xl border border-neutral-200 dark:border-neutral-800" src={view.imageUrl} alt={view.imageAlt ?? "Question image"} loading="lazy" />
    ) : null}

    <form class="mt-6" data-check-form>
      <fieldset>
        <legend class="text-sm font-semibold">Choose one option</legend>
        <div class="mt-3 space-y-2">
          {view.options.map((option, index) => {
            const hindi = view.optionsHi?.[index];
            const hindiText = hindi?.text?.trim() ? hindi.text : option.text;
            return (
              <label
                class="flex cursor-pointer items-start gap-3 rounded-xl border border-neutral-200 bg-white p-3 transition-colors hover:border-brand-300 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-brand-700"
                data-option-row={index}
              >
                <input class="mt-1 h-4 w-4 shrink-0" type="radio" name="option" value={index} />
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-neutral-100 text-xs font-black text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200" aria-hidden="true">
                  {option.letter}
                </span>
                <span class="min-w-0 flex-1 text-sm leading-6">
                  {isPlaceholderText(option.text) ? null : <span data-lang-text="en" set:html={renderRichText(option.text)} />}
                  {hasHindi && !isPlaceholderText(hindiText) ? <span data-lang-text="hi" hidden set:html={renderRichText(hindiText)} /> : null}
                  {option.imageUrl ? (
                    <img class="mt-2 max-h-48 w-auto rounded-lg" src={option.imageUrl} alt={option.alt ?? `Option ${option.letter}`} loading="lazy" />
                  ) : (isPlaceholderText(option.text) ? <span class="text-neutral-500 dark:text-neutral-400">Option {option.letter}</span> : null)}
                </span>
              </label>
            );
          })}
        </div>
      </fieldset>

      <p class="mt-4 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/50 dark:text-red-200" data-check-error role="alert"></p>

      {view.canCheck ? (
        <button type="submit" class="mt-4 min-h-11 rounded-lg bg-brand-600 px-4 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60" data-check-button>
          Check answer
        </button>
      ) : (
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm dark:border-amber-900 dark:bg-amber-950/30">
          <p class="font-semibold text-amber-900 dark:text-amber-100">Attempt the full mock to see the solution</p>
          <p class="mt-1 text-amber-800 dark:text-amber-200">The answer and explanation unlock after you submit an attempt containing this question.</p>
          <a class="mt-3 inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-4 text-sm font-bold text-white hover:bg-brand-700" href={ctaHref}>
            {ctaLabel}
          </a>
        </div>
      )}
    </form>

    <section class="mt-6 hidden rounded-2xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-900 dark:bg-emerald-950/30" data-check-result aria-live="polite">
      <p class="text-sm font-bold text-emerald-900 dark:text-emerald-100" data-result-verdict></p>
      <p class="mt-1 text-sm text-emerald-900 dark:text-emerald-100" data-result-answer></p>
      <div class="mt-3 text-sm leading-7 text-emerald-950 dark:text-emerald-50">
        <div data-result-explanation-en></div>
        <div data-result-explanation-hi hidden></div>
      </div>
      <img class="mt-3 hidden max-h-64 w-auto rounded-lg" data-result-image alt="" />
    </section>

    <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-neutral-200 pt-5 dark:border-neutral-800">
      <ShareSheet view={view} answer={shareAnswer} shareUrl={shareUrl} />
      <button type="button" class="min-h-11 rounded-lg border border-neutral-300 px-4 text-sm font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" data-copy-link>
        Copy link
      </button>
      <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-300" data-copy-status role="status"></span>
    </div>

    {view.relatedMocks.length > 0 ? (
      <section class="mt-8" aria-labelledby="related-mocks-heading">
        <h2 id="related-mocks-heading" class="text-lg font-bold">Practise this topic in a full mock</h2>
        <ul class="mt-3 space-y-2">
          {view.relatedMocks.map((mock) => (
            <li>
              <a class="block rounded-xl border border-neutral-200 bg-white p-4 text-sm font-semibold hover:border-brand-300 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-brand-700" href={`/mock/${mock.slug}`}>
                {mock.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    <p class="mt-8 text-xs leading-5 text-neutral-500 dark:text-neutral-400">
      Shared from CUET Free Mock Test. Answers are checked on the server. This is an independent practice resource and is not affiliated with NTA.
    </p>
  </article>

  <span id="public-question-data" data-public-id={view.publicId} data-path={view.path} hidden></span>

  <script>
    import { recordShareEvent } from "../../lib/share/record-share-event";

    const dataNode = document.getElementById("public-question-data") as HTMLElement | null;
    const publicId = dataNode?.dataset.publicId ?? "";
    const canonicalPath = dataNode?.dataset.path ?? location.pathname;

    document.querySelectorAll<HTMLButtonElement>("[data-lang-button]").forEach((button) => {
      button.addEventListener("click", () => {
        const language = button.dataset.langButton ?? "en";
        document.querySelectorAll<HTMLElement>("[data-lang-text]").forEach((node) => {
          node.hidden = node.dataset.langText !== language;
        });
        document.querySelectorAll<HTMLButtonElement>("[data-lang-button]").forEach((candidate) => {
          candidate.setAttribute(
            "aria-pressed",
            String(candidate.dataset.langButton === language),
          );
        });
        document.dispatchEvent(
          new CustomEvent("share:language", { detail: language }),
        );
      });
    });

    const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-link]");
    const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
    copyButton?.addEventListener("click", async () => {
      const url = new URL(canonicalPath, location.origin).toString();
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const input = document.createElement("input");
        input.value = url;
        document.body.appendChild(input);
        input.select();
        (document as unknown as { execCommand(commandId: string): boolean }).execCommand("copy");
        input.remove();
      }
      if (copyStatus) copyStatus.textContent = "Link copied";
      recordShareEvent({ publicId, context: "public_page", channel: "copy" });
    });

    const form = document.querySelector<HTMLFormElement>("[data-check-form]");
    const checkButton = document.querySelector<HTMLButtonElement>("[data-check-button]");
    const errorBox = document.querySelector<HTMLElement>("[data-check-error]");
    const resultPanel = document.querySelector<HTMLElement>("[data-check-result]");
    const verdict = document.querySelector<HTMLElement>("[data-result-verdict]");
    const answer = document.querySelector<HTMLElement>("[data-result-answer]");
    const explanationEn = document.querySelector<HTMLElement>("[data-result-explanation-en]");
    const explanationHi = document.querySelector<HTMLElement>("[data-result-explanation-hi]");
    const resultImage = document.querySelector<HTMLImageElement>("[data-result-image]");

    function showError(message: string) {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.classList.remove("hidden");
    }

    function clearError() {
      errorBox?.classList.add("hidden");
    }

    function addCta(container: HTMLElement, cta: { href: string; label: string }) {
      const link = document.createElement("a");
      link.className =
        "mt-3 inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-4 text-sm font-bold text-white hover:bg-brand-700";
      link.href = cta.href;
      link.textContent = cta.label;
      container.appendChild(link);
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearError();

      const selected = form.querySelector<HTMLInputElement>('input[name="option"]:checked');
      if (!selected) {
        showError("Choose one option before checking the answer.");
        return;
      }
      if (checkButton) {
        checkButton.disabled = true;
        checkButton.textContent = "Checking…";
      }

      try {
        const response = await fetch(
          `/api/public-questions/${encodeURIComponent(publicId)}/check`,
          {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ option: Number(selected.value) }),
          },
        );
        const body = (await response.json()) as {
          ok?: boolean;
          error?: string;
          cta?: { href: string; label: string } | null;
          correct?: boolean;
          correctOption?: number;
          explanationHtml?: string;
          explanationHiHtml?: string;
          explanationImageUrl?: string | null;
          explanationImageAlt?: string | null;
        };
        if (!response.ok || !body.ok) {
          showError(body.error || "Could not check this answer.");
          if (body.cta) addCta(errorBox!, body.cta);
          if (checkButton) {
            checkButton.disabled = false;
            checkButton.textContent = "Check answer";
          }
          return;
        }

        const chosen = Number(selected.value);
        const correctOption = Number(body.correctOption ?? 0);
        document.querySelectorAll<HTMLElement>("[data-option-row]").forEach((row) => {
          const index = Number(row.dataset.optionRow);
          row.classList.remove(
            "border-emerald-500",
            "bg-emerald-50",
            "dark:bg-emerald-950/30",
            "border-red-500",
            "bg-red-50",
            "dark:bg-red-950/30",
          );
          if (index === correctOption) {
            row.classList.add("border-emerald-500", "bg-emerald-50", "dark:bg-emerald-950/30");
          } else if (index === chosen && !body.correct) {
            row.classList.add("border-red-500", "bg-red-50", "dark:bg-red-950/30");
          }
        });
        form
          .querySelectorAll<HTMLInputElement>('input[name="option"]')
          .forEach((input) => {
            input.disabled = true;
          });

        if (verdict) {
          verdict.textContent = body.correct
            ? "Correct — well done."
            : "Not quite. Review the answer below.";
        }
        if (answer) {
          answer.textContent = `Correct answer: ${String.fromCharCode(65 + correctOption)}`;
        }
        if (explanationEn) {
          explanationEn.innerHTML =
            body.explanationHtml || "<p>No written explanation was provided for this question.</p>";
        }
        if (explanationHi) {
          explanationHi.innerHTML = body.explanationHiHtml || "";
          explanationHi.hidden = !body.explanationHiHtml;
        }
        if (resultImage) {
          if (body.explanationImageUrl) {
            resultImage.src = body.explanationImageUrl;
            resultImage.alt = body.explanationImageAlt || "Explanation image";
            resultImage.classList.remove("hidden");
          } else {
            resultImage.classList.add("hidden");
          }
        }
        if (resultPanel) resultPanel.classList.remove("hidden");
        if (checkButton) checkButton.textContent = "Answer checked";
      } catch {
        showError("Could not check this answer. Check your connection and try again.");
        if (checkButton) {
          checkButton.disabled = false;
          checkButton.textContent = "Check answer";
        }
      }
    });
  </script>
</BaseLayout>
