    "passages": [
      {
        "id": "p334095676a7e",
        "title": "Reading passage",
        "contentEn": "निम्नलिखित गद्यांश को पढ़कर उस पर आधारित अगले चार प्रश्नों के उत्तर दीजिये -\n\nजीवन में सफलता प्राप्त करने के लिए शिक्षा बहुत महत्वपूर्ण उपकरण है। यह जीवन के कितनस समय में चुनौतियों का सामना करने का मार्ग प्रशस्त करती है। शिक्षण प्रक्रिया के दौरान प्राप्त किया गया जान प्रत्येक व्यक्ति को आत्मनिर्भर बनाता है। शिक्षा जीवन में बेहतर संभावनाओं को प्राप्त करने के अवसरों के लिए विभिन्न दरवाले खोलती है। ग्रामीण क्षत्रिय शिक्षा को बढ़ावा देने के लिए सरकार द्वारा बहुत से जागरकता अभिमान चलाये जा रहे हैं, जिससे सभी व्यक्तियों में समानता की भावना लाईं जा सके तथा देश को विकास के पथ पर आगे ले जाया जा सके। आज के वैशानिक एवं तकनीकी युग में शिक्षा की अहम भूमिका है। आजकल शिक्षा के सत्र को आगे बढ़ाने के लिए बहुत तरीक अपनाए जा रहे हैं। शिक्षा का पूरा तंत्र अब बदल गया है। आज १२वीं कक्षा के बाद दूरस्थ शिक्षा कार्यक्रम के माध्यम से नौकरी करते हुए कोई भी पढ़ाई कर सकता है। दूरस्थ शिक्षा के माध्यम से हम आसानी से किसी भी बड़े और प्रसिद्ध विश्वविद्यालय में बहुत कम शुल्क पर प्रवेश ले सकते हैं। इसके अलावा अनेक छोटे-छोटे संस्थान भी विभिन्न कौशलों को विकसित करने वाले लघु अवधिये केशलपरक पाठयकम चला रहे हैं। इन कौशलों में दक्षता प्राप्त कर व्यक्ति कम समय में ही अपने पैरों पर खड़ा हो सकता है।"
      },
      {
        "id": "p2adada4a3d83",
        "title": "Reading passage",
        "contentEn": "निम्नलिखित गद्यांश को पढ़कर उस पर आधारित अगले चार प्रश्नों के उत्तर दीजिये -\n\nनाटक की तरह एकाकी में चित्र अधिक नहीं होते। यहाँ पांच-छह से अधिक चित्र नहीं होते। चित्रों में भी केवल नायक की प्रधानता रहती है, अन्य चित्र उसके व्यक्तव्य को अग्रसर करते हैं। यहाँ प्रतिनायक की कल्पना सामान्यतः नहीं रहती। नायक स्वयं अपने उत्पान पतन के लिए उत्तरदायी है। एकाकी में विदूषक की कल्पना नहीं की जाती, क्योंकि एकाकी की कथावस्तु में इसके लिए स्थान ही नहीं होता। हास्य, व्यवम और विनोद का काम उसके चित्रों के संवादों से ही चल जाता है। एकाकी के चित्र को सजीव, व्यक्तिवादी और प्रभावशाली होना चाहिए। यहाँ चित्र एक ऐसा बिंदु है, जो अपने चारों ओर वृत या घेरा बनाता जाता है। अतएव, घटनाओं के उत्पान-पतन की कोई आवश्यकता नहीं पड़ती। चित्र का निर्माण उसके संस्कार, मनोविज्ञान और वातावरण के अनुसार होता है। प्राचीन नाटकों की तरह यहाँ\n\nनायक या पात्रों का कोई बना बनाया साँचा नहीं होता। नायक के लिए सर्वगुणसंपत्र होना भी आवश्यक नहीं। वह तो एक साधारण व्यक्ति है, जो साधारण लोगों की तरह सुख-दुःख के बीच जीवन बिताता है। अधिकतर एकानिकियों में चिन्ह की मानसिक स्थिति द्वंद्रसमक होती है। उसे अंतर्दृन्द और बाहद्रद्र से संघर्ष करता हुआ दिखायी जाता है।"
      },
      {
        "id": "p37fb6e10775d",
        "title": "Reading passage",
        "contentEn": "निम्नलिखित पदार्श को पढ़कर उस पर आधारित अगले चार प्रश्नों के उत्तर दीजिये -\n\nबार-बार आती है मुझको मधुर याद बचपन तेरी\n\nगया ले गया तू जीवन की सबसे मस्त खुशी मेरी।\n\nचिंता रहित खेलना खाना वह फिरना निभ्य स्वच्छद।\n\nकैसे भूला जा सकता है बचपन का अतुलित आन्द ?\n\nऊँच-नीच का जान नहीं था छुआ छूत किसने जानी ?\n\nबनी हुई थी वहां पड़ी और चीड़ों में रानी।\n\nरोना और मचल जाना भी क्या आनंद दिखाते थे।\n\nबड़े-बड़े मोती से ऑसू जयमाला पहनाते थे।\n\nवह सुख का साम्राज्य छोड़कर मैंसतवाली बड़ी हुई।\n\nलुटी हुई, कुछ ठगी हुई-सी दौड़ द्वार पर खड़ी हुई।"
      }
    ],
