---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { env } from "cloudflare:workers";
import BrandLogo from "../components/BrandLogo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { siteUrl } from "../lib/site-url";
import { getSetting } from "../lib/settings";
import {
  adsenseClient,
  adSlotAllowed,
  analyticsToken,
  googleSiteVerification,
} from "../lib/integrations";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Full robots value, for pages such as shared questions that use noindex, follow. */
  robots?: string;
  canonical?: string | null;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  sectionLabel?: string;
  sectionNav?: { href: string; label: string }[];
  /** Explicit opt-in for manual AdSense units on substantial content pages. */
  ads?: boolean;
  /** Social preview image URL; falls back to the brand logo. */
  image?: string | null;
}

const {
  title,
  description = "Free CUET UG mock tests, previous-year papers, syllabus and exam-pattern guides.",
  noindex = false,
  robots: robotsOverride = "",
  canonical: canonicalOverride = null,
  structuredData = [],
  sectionLabel = "",
  sectionNav = [],
  ads = false,
  image: imageOverride = null,
} = Astro.props;

const robots = robotsOverride || (noindex ? "noindex, nofollow" : "");

const structuredDataList = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

const site = siteUrl(Astro.url);
const socialImage = new URL(imageOverride || "/logo.png", site).toString();
let canonical = new URL(Astro.url.pathname, site);
if (canonicalOverride) {
  try {
    const override = new URL(canonicalOverride);
    if (override.protocol === "http:" || override.protocol === "https:") canonical = override;
  } catch {
    // An invalid stored value must never break rendering; keep the self URL.
  }
}
const siteName = await getSetting("site_name", "CUET Free Mock Test");
const user = Astro.locals.user;
const isAdmin = Boolean(Astro.locals.admin);
const path = Astro.url.pathname;

// Optional integrations emit nothing unless a valid value is configured.
// Ads are double-gated: the page must opt in and the path must not be private.
const analytics = analyticsToken(env);
const gscVerification = googleSiteVerification(env);
const adClient = ads && adSlotAllowed(path) ? adsenseClient(env) : "";

const desktopNav = [
  { href: "/", label: "Home", isHome: true, match: ["/"] },
  { href: "/mock-tests", label: "Mock Tests", match: ["/mock-tests", "/cuet-ug-mock-test", "/mock"] },
  ...(user ? [{ href: "/dashboard", label: "Dashboard", match: ["/dashboard"] }] : []),
  { href: "/cuet-ug-previous-year-papers", label: "PYQs", match: ["/cuet-ug-previous-year-papers"] },
  { href: "/leaderboard", label: "Leaderboard", match: ["/leaderboard"] },
];

const isPathActive = (hrefs: string[]) =>
  hrefs.some((href) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`)));

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: site.toString(),
  description,
  logo: new URL("/logo.png", site).toString(),
  image: new URL("/logo.png", site).toString(),
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {robots ? <meta name="robots" content={robots} /> : null}
    {gscVerification ? <meta name="google-site-verification" content={gscVerification} /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {structuredDataList.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
    {adClient ? (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`}
        crossorigin="anonymous"
      ></script>
    ) : null}
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="sticky top-0 z-40 border-b border-neutral-200 bg-white/90 text-neutral-900 backdrop-blur-xl dark:border-white/10 dark:bg-ink-950/90 dark:text-white">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
        <BrandLogo />

        <!-- Desktop Navigation Bar (>= 1024px) -->
        <nav class="hidden items-center gap-1.5 lg:flex" aria-label="Primary">
          {desktopNav.map((item) => {
            const active = isPathActive(item.match);
            if (item.isHome) {
              return (
                <a
                  href="/"
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-1.5 rounded-lg px-3.5 py-1.5 text-[13px] transition-colors",
                    active
                      ? "border border-brand-500/30 bg-brand-500/10 font-semibold text-brand-600 dark:border-brand-500/30 dark:bg-brand-500/20 dark:text-brand-400"
                      : "font-medium text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 dark:text-white/70 dark:hover:bg-white/5 dark:hover:text-white",
                  ]}
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                  </svg>
                  <span>Home</span>
                </a>
              );
            }
            return (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3.5 py-1.5 text-[13px] transition-colors",
                  active
                    ? "bg-brand-500/10 font-semibold text-brand-600 dark:bg-white/10 dark:text-white"
                    : "font-medium text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 dark:text-white/70 dark:hover:bg-white/5 dark:hover:text-white",
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- Desktop Right Side Controls (Theme, Discussion Bell, Profile Dropdown) -->
        <div class="hidden items-center gap-2 lg:flex">
          <ThemeToggle />

          {user ? (
            <>
              <a
                href="/dashboard/discussions"
                class="grid h-9 w-9 place-items-center rounded-lg border border-neutral-200 text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:border-white/10 dark:text-white/70 dark:hover:bg-white/10 dark:hover:text-white"
                aria-label="Discussions and notifications"
                title="Discussions and notifications"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                  <path d="M10.3 21a2 2 0 0 0 3.4 0"></path>
                </svg>
              </a>

              <details class="user-menu-details relative">
                <summary
                  class="flex cursor-pointer list-none items-center gap-1.5 rounded-full p-0.5 text-neutral-700 transition-opacity hover:opacity-90 dark:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 select-none"
                  aria-label="User account menu"
                >
                  <span class="grid h-8 w-8 place-items-center rounded-full bg-brand-600 text-xs font-bold text-white shadow-sm" aria-hidden="true">
                    {user.username.slice(0, 1).toUpperCase()}
                  </span>
                  <svg class="h-3.5 w-3.5 text-neutral-400 transition-transform group-open:rotate-180 dark:text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </summary>

                <div
                  class="absolute right-0 top-full mt-2 w-72 rounded-2xl border border-neutral-200 bg-white p-3 shadow-xl shadow-neutral-950/10 backdrop-blur-md dark:border-white/10 dark:bg-ink-950 dark:shadow-black/70 z-50 animate-in fade-in zoom-in-95 duration-100"
                >
                  <div class="px-3 py-2">
                    <p class="truncate text-sm font-semibold text-neutral-900 dark:text-white">
                      {user.username}
                    </p>
                    <p class="truncate text-xs text-neutral-500 dark:text-white/60">
                      {user.email}
                    </p>
                  </div>

                  <div class="my-1.5 border-t border-neutral-100 dark:border-white/10"></div>

                  <div class="space-y-0.5">
                    <a
                      href="/dashboard/settings"
                      class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-medium text-neutral-700 transition-colors hover:bg-neutral-100 dark:text-neutral-200 dark:hover:bg-white/5"
                    >
                      <svg class="h-4 w-4 shrink-0 text-neutral-500 dark:text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                      <span>Settings</span>
                    </a>

                    {isAdmin ? (
                      <a
                        href="/admin"
                        class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-medium text-neutral-700 transition-colors hover:bg-neutral-100 dark:text-neutral-200 dark:hover:bg-white/5"
                      >
                        <svg class="h-4 w-4 shrink-0 text-neutral-500 dark:text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        <span>Admin panel</span>
                        <span class="ml-auto rounded-full bg-accent-100 px-2 py-0.5 text-[10px] font-bold text-accent-800 dark:bg-accent-950 dark:text-accent-300">
                          Admin
                        </span>
                      </a>
                    ) : null}
                  </div>

                  <div class="my-1.5 border-t border-neutral-100 dark:border-white/10"></div>

                  <button
                    type="button"
                    data-logout
                    class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-medium text-red-600 transition-colors hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/30"
                  >
                    <svg class="h-4 w-4 shrink-0 text-red-500 dark:text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                      <polyline points="16 17 21 12 16 7"></polyline>
                      <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Log out</span>
                  </button>
                </div>
              </details>
            </>
          ) : (
            <>
              <a href="/login" class="rounded-lg px-3 py-1.5 text-xs font-semibold text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 dark:text-white/70 dark:hover:bg-white/5 dark:hover:text-white">
                Log in
              </a>
              <a href="/signup" class="rounded-lg bg-brand-500 px-3 py-1.5 text-xs font-semibold text-white shadow-[var(--shadow-brand)] transition-colors hover:bg-brand-600">
                Start free
              </a>
            </>
          )}
        </div>

        <!-- Mobile Top Bar Controls (< 1024px) -->
        <div class="flex items-center gap-2 lg:hidden">
          <ThemeToggle />
          {user ? (
            <a
              href="/dashboard"
              class="grid h-8 w-8 place-items-center rounded-full bg-brand-600 text-xs font-bold text-white shadow-sm"
              aria-label={`Profile: ${user.username}`}
            >
              {user.username.slice(0, 1).toUpperCase()}
            </a>
          ) : (
            <a
              href="/login"
              class="rounded-lg border border-neutral-300 px-2.5 py-1 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 dark:border-white/15 dark:text-white/80 dark:hover:bg-white/10"
            >
              Log in
            </a>
          )}
        </div>
      </div>
    </header>

    {sectionNav.length > 0 ? (
      <div class="border-b border-neutral-200 bg-neutral-50/90 dark:border-white/10 dark:bg-ink-900/80">
        <nav class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-4 py-2 sm:px-6" aria-label={sectionLabel || "Section"}>
          {sectionNav.map((item) => {
            const active = path === item.href || path === `${item.href}/`;
            return (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "whitespace-nowrap rounded-lg px-3 py-1.5 text-sm font-semibold",
                  active
                    ? "bg-brand-100 text-brand-800 dark:bg-white/10 dark:text-white"
                    : "text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 dark:text-white/55 dark:hover:bg-white/5 dark:hover:text-white",
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
    ) : null}

    <main id="main-content" class="flex-1 pb-20 lg:pb-0">
      <slot />
    </main>

    <!-- Mobile Fixed Bottom Navigation Bar (< 1024px) -->
    <nav
      class="fixed bottom-0 inset-x-0 z-40 flex h-16 items-center justify-around border-t border-neutral-200 bg-white/95 px-2 pb-[env(safe-area-inset-bottom)] backdrop-blur-lg dark:border-white/10 dark:bg-ink-950/95 lg:hidden"
      aria-label="Mobile Navigation"
    >
      <!-- Home -->
      <a
        href="/"
        class:list={[
          "flex flex-1 flex-col items-center justify-center gap-1 py-1 text-center transition-colors",
          path === "/"
            ? "text-brand-600 dark:text-brand-400 font-semibold"
            : "text-neutral-600 hover:text-neutral-900 dark:text-white/60 dark:hover:text-white font-normal",
        ]}
        aria-current={path === "/" ? "page" : undefined}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span class="text-[10px] leading-tight">Home</span>
      </a>

      <!-- Mock tests -->
      <a
        href="/mock-tests"
        class:list={[
          "flex flex-1 flex-col items-center justify-center gap-1 py-1 text-center transition-colors",
          path.startsWith("/mock-tests") || path.startsWith("/mock") || path.startsWith("/cuet-ug-mock-test")
            ? "text-brand-600 dark:text-brand-400 font-semibold"
            : "text-neutral-600 hover:text-neutral-900 dark:text-white/60 dark:hover:text-white font-normal",
        ]}
        aria-current={path.startsWith("/mock-tests") || path.startsWith("/mock") || path.startsWith("/cuet-ug-mock-test") ? "page" : undefined}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
          <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          <path d="m9 14 2 2 4-4"></path>
        </svg>
        <span class="text-[10px] leading-tight">Mock Tests</span>
      </a>

      {user ? (
        <a
          href="/dashboard"
          class:list={[
            "flex flex-1 flex-col items-center justify-center gap-1 py-1 text-center transition-colors",
            path.startsWith("/dashboard")
              ? "text-brand-600 dark:text-brand-400 font-semibold"
              : "text-neutral-600 hover:text-neutral-900 dark:text-white/60 dark:hover:text-white font-normal",
          ]}
          aria-current={path.startsWith("/dashboard") ? "page" : undefined}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect width="7" height="7" x="3" y="3" rx="1"></rect>
            <rect width="7" height="7" x="14" y="3" rx="1"></rect>
            <rect width="7" height="7" x="14" y="14" rx="1"></rect>
            <rect width="7" height="7" x="3" y="14" rx="1"></rect>
          </svg>
          <span class="text-[10px] leading-tight">Dashboard</span>
        </a>
      ) : null}

      <!-- PYQs -->
      <a
        href="/cuet-ug-previous-year-papers"
        class:list={[
          "flex flex-1 flex-col items-center justify-center gap-1 py-1 text-center transition-colors",
          path.startsWith("/cuet-ug-previous-year-papers") || path.startsWith("/pyq")
            ? "text-brand-600 dark:text-brand-400 font-semibold"
            : "text-neutral-600 hover:text-neutral-900 dark:text-white/60 dark:hover:text-white font-normal",
        ]}
        aria-current={path.startsWith("/cuet-ug-previous-year-papers") || path.startsWith("/pyq") ? "page" : undefined}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        <span class="text-[10px] leading-tight">PYQs</span>
      </a>

      <!-- More -->
      <button
        type="button"
        id="mobile-more-btn"
        class="flex flex-1 flex-col items-center justify-center gap-1 py-1 text-center text-neutral-600 transition-colors hover:text-neutral-900 dark:text-white/60 dark:hover:text-white font-normal cursor-pointer"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-more-sheet"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="1.5"></circle>
          <circle cx="19" cy="12" r="1.5"></circle>
          <circle cx="5" cy="12" r="1.5"></circle>
        </svg>
        <span class="text-[10px] leading-tight">More</span>
      </button>
    </nav>

    <!-- Mobile More Drawer Sheet (< 1024px) -->
    <div
      id="mobile-more-sheet"
      class="fixed inset-0 z-50 hidden lg:hidden"
      role="dialog"
      aria-modal="true"
      aria-label="More navigation options"
    >
      <!-- Backdrop -->
      <div id="mobile-more-backdrop" class="fixed inset-0 bg-neutral-950/60 backdrop-blur-sm transition-opacity"></div>

      <!-- Drawer Panel -->
      <div
        class="fixed inset-x-0 bottom-0 max-h-[85vh] overflow-y-auto rounded-t-3xl border-t border-neutral-200 bg-white p-5 shadow-2xl dark:border-white/10 dark:bg-ink-950 transition-transform"
      >
        <div class="flex items-center justify-between pb-3 border-b border-neutral-100 dark:border-white/10">
          {user ? (
            <div class="min-w-0 pr-3">
              <p class="truncate text-sm font-bold text-neutral-900 dark:text-white">{user.username}</p>
              <p class="truncate text-xs text-neutral-500 dark:text-white/60">{user.email}</p>
            </div>
          ) : (
            <div>
              <p class="text-sm font-bold text-neutral-900 dark:text-white">CUETFreeMockTest.com</p>
              <p class="text-xs text-neutral-500 dark:text-white/60">Practice with purpose</p>
            </div>
          )}
          <button
            type="button"
            id="mobile-more-close"
            class="grid h-8 w-8 place-items-center rounded-full bg-neutral-100 text-neutral-500 hover:bg-neutral-200 dark:bg-white/10 dark:text-white/70 dark:hover:bg-white/20"
            aria-label="Close menu"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <div class="py-3 grid gap-1">
          <a
            href="/leaderboard"
            class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-neutral-700 hover:bg-neutral-100 dark:text-neutral-200 dark:hover:bg-white/5"
          >
            <svg class="h-4 w-4 text-neutral-500 dark:text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
              <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
              <path d="M4 22h16"></path>
              <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
              <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
              <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
            </svg>
            <span>Leaderboard</span>
          </a>

          {user ? (
            <>
              <a
                href="/dashboard/settings"
                class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-neutral-700 hover:bg-neutral-100 dark:text-neutral-200 dark:hover:bg-white/5"
              >
