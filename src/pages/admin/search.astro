---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { adminSearch } from "../../lib/admin/search";

const admin = Astro.locals.admin!;
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 100);
const groups = q.length >= 2 ? await adminSearch(admin.role, q) : [];
const total = groups.reduce((sum, group) => sum + group.hits.length, 0);
---

<AdminLayout title="Search" active="search">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Search everything</h1>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
        One query across questions, mocks, users, attempts, passages, guides and announcements. Results are filtered by your role.
      </p>
    </div>
  </div>

  <form method="get" class="mt-6 flex flex-wrap gap-2" role="search">
    <label class="sr-only" for="search-q">Search</label>
    <input id="search-q" class="h-11 min-w-0 flex-1 rounded-xl border border-neutral-300 bg-white px-4 text-sm dark:border-neutral-700 dark:bg-neutral-950" type="search" name="q" value={q} placeholder="Question text, mock title, student email, attempt id…" autofocus />
    <button class="h-11 rounded-xl bg-brand-600 px-5 text-sm font-bold text-white hover:bg-brand-700" type="submit">Search</button>
  </form>

  {q.length >= 2 ? (
    <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">{total} result{total === 1 ? "" : "s"} for “{q}”. Each group is capped at 8 rows; use the section screens for deeper filters.</p>
  ) : q.length === 1 ? (
    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">Type at least two characters.</p>
  ) : (
    <div class="mt-8 rounded-2xl border border-dashed border-neutral-300 bg-white px-6 py-14 text-center dark:border-neutral-700 dark:bg-neutral-900">
      <p class="font-bold">Search across the whole admin</p>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">Try a question phrase, a mock title, a student email or an attempt number.</p>
      <div class="mt-4 flex flex-wrap justify-center gap-2 text-xs">
        {["photosynthesis", "CUET UG", "submitted", "passage"].map((term) => (
          <a class="rounded-full border border-neutral-300 px-3 py-1 font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/admin/search?q=${encodeURIComponent(term)}`}>{term}</a>
        ))}
      </div>
    </div>
  )}

  {q.length >= 2 && total === 0 ? (
    <div class="mt-6 rounded-2xl border border-neutral-200 bg-white px-6 py-12 text-center dark:border-neutral-800 dark:bg-neutral-900">
      <p class="font-bold">No matches</p>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">Check the spelling, or try the table-specific filters in the data manager.</p>
      <a class="mt-3 inline-block text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/admin/data">Open data manager</a>
    </div>
  ) : null}

  {groups.map((group) => (
    <section class="mt-8" aria-labelledby={`group-${group.key}`}>
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-sm font-bold uppercase tracking-wide text-neutral-500 dark:text-neutral-400" id={`group-${group.key}`}>{group.label}</h2>
        <span class="text-xs text-neutral-500 dark:text-neutral-400">{group.hits.length}</span>
      </div>
      <ul class="mt-2 divide-y divide-neutral-100 overflow-hidden rounded-2xl border border-neutral-200 bg-white dark:divide-neutral-800 dark:border-neutral-800 dark:bg-neutral-900">
        {group.hits.map((hit) => (
          <li>
            <a class="flex items-start justify-between gap-4 px-4 py-3 hover:bg-neutral-50 dark:hover:bg-neutral-800/60" href={hit.href}>
              <span class="min-w-0">
                <span class="block truncate font-medium">{hit.title}</span>
                <span class="mt-0.5 block text-xs text-neutral-500 dark:text-neutral-400">{hit.detail}</span>
              </span>
              <span class="shrink-0 text-xs font-semibold text-brand-700 dark:text-brand-300">Open →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</AdminLayout>
