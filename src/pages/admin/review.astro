---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth/admin";
import { all } from "../../lib/db";

const admin = Astro.locals.admin!;
if (!can(admin.role, "questions.write") && !can(admin.role, "mocks.write")) {
  return Astro.redirect("/forbidden", 303);
}

// Real database explanation provenance counts
const explanationCounts = await all<{
  explanation_source: string;
  explanation_status: string;
  count: number;
}>(
  `SELECT explanation_source, explanation_status, COUNT(*) AS count
   FROM practice_questions
   WHERE deleted_at IS NULL
   GROUP BY explanation_source, explanation_status`,
);

const unreviewedAiCount = explanationCounts
  .filter((r) => r.explanation_source === "ai_draft" && r.explanation_status === "unreviewed")
  .reduce((sum, r) => sum + r.count, 0);

const bannerCount = explanationCounts
  .filter((r) => r.explanation_source === "banner")
  .reduce((sum, r) => sum + r.count, 0);

const humanReviewedCount = explanationCounts
  .filter((r) => r.explanation_status === "reviewed")
  .reduce((sum, r) => sum + r.count, 0);

const flaggedCount = explanationCounts
  .filter((r) => r.explanation_status === "flagged")
  .reduce((sum, r) => sum + r.count, 0);

const unkeyedCount = (
  await all<{ count: number }>(
    `SELECT COUNT(*) AS count FROM practice_questions WHERE correct_option IS NULL AND deleted_at IS NULL`,
  )
)[0]?.count ?? 0;

// Filters
const filterStatus = Astro.url.searchParams.get("status") || "all";
const filterSource = Astro.url.searchParams.get("source") || "all";
const filterKeyed = Astro.url.searchParams.get("keyed") || "all";

let query = `
  SELECT q.id, q.paper_slug, q.source_question_no, q.stem, q.correct_option,
         q.explanation, q.explanation_source, q.explanation_status, q.reviewed_by, q.reviewed_at,
         p.title AS paper_title
  FROM practice_questions q
  JOIN practice_papers p ON p.slug = q.paper_slug
  WHERE q.deleted_at IS NULL
`;
const params: any[] = [];
if (filterStatus !== "all") {
  query += ` AND q.explanation_status = ?`;
  params.push(filterStatus);
}
if (filterSource !== "all") {
  query += ` AND q.explanation_source = ?`;
  params.push(filterSource);
}
if (filterKeyed === "keyed") {
  query += ` AND q.correct_option IS NOT NULL`;
} else if (filterKeyed === "unkeyed") {
  query += ` AND q.correct_option IS NULL`;
}
query += ` ORDER BY q.id ASC LIMIT 50`;

const queueQuestions = await all<{
  id: number;
  paper_slug: string;
  source_question_no: number | null;
  stem: string;
  correct_option: number | null;
  explanation: string | null;
  explanation_source: string;
  explanation_status: string;
  reviewed_by: string | null;
  reviewed_at: string | null;
  paper_title: string;
}>(query, ...params);
---

<AdminLayout title="Explanation Editorial Review Queue" active="review">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Explanation Editorial Review Queue</h1>
      <p class="mt-1 max-w-3xl text-sm text-neutral-600 dark:text-neutral-400">
        Transparent editorial management of question explanations. Questions with AI-generated or unverified explanations remain explicitly labelled as <strong>Unreviewed</strong> until approved by an editor. Unkeyed questions cannot be marked reviewed.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="rounded-lg bg-emerald-600 px-3 py-2 text-sm font-bold text-white hover:bg-emerald-700" href="/api/admin/review/sample.csv" download>
        Download 100-Question Sample (CSV)
      </a>
      <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href="/practice" target="_blank" rel="noopener">
        View Public Practice
      </a>
    </div>
  </div>

  <!-- Honest Explanation Metrics Dashboard -->
  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-5">
    <div class="rounded-2xl border border-amber-300 bg-amber-50/50 p-4 shadow-sm dark:border-amber-800 dark:bg-amber-950/20">
      <p class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300">Unreviewed AI Drafts</p>
      <p class="mt-2 text-3xl font-black text-amber-900 dark:text-amber-100">{unreviewedAiCount}</p>
      <p class="mt-1 text-xs text-amber-700 dark:text-amber-300">Labelled unreviewed in UI</p>
    </div>
    <div class="rounded-2xl border border-neutral-300 bg-neutral-50 p-4 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
      <p class="text-xs font-bold uppercase tracking-wider text-neutral-500">Placeholder Banners</p>
      <p class="mt-2 text-3xl font-black">{bannerCount}</p>
      <p class="mt-1 text-xs text-neutral-400">Review pending notices</p>
    </div>
    <div class="rounded-2xl border border-emerald-300 bg-emerald-50/50 p-4 shadow-sm dark:border-emerald-800 dark:bg-emerald-950/20">
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">Human Reviewed</p>
      <p class="mt-2 text-3xl font-black text-emerald-900 dark:text-emerald-100">{humanReviewedCount}</p>
      <p class="mt-1 text-xs text-emerald-700 dark:text-emerald-300">Signed-off explanations</p>
    </div>
    <div class="rounded-2xl border border-rose-300 bg-rose-50/50 p-4 shadow-sm dark:border-rose-800 dark:bg-rose-950/20">
      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 dark:text-rose-300">Flagged For Revision</p>
      <p class="mt-2 text-3xl font-black text-rose-900 dark:text-rose-100">{flaggedCount}</p>
      <p class="mt-1 text-xs text-rose-700 dark:text-rose-300">Reported or disputed</p>
    </div>
    <div class="rounded-2xl border border-indigo-300 bg-indigo-50/50 p-4 shadow-sm dark:border-indigo-800 dark:bg-indigo-950/20">
      <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-300">Unkeyed Rows</p>
      <p class="mt-2 text-3xl font-black text-indigo-900 dark:text-indigo-100">{unkeyedCount}</p>
      <p class="mt-1 text-xs text-indigo-700 dark:text-indigo-300">Isolated from scoring</p>
    </div>
  </div>

  <!-- Filters -->
  <div class="mt-6 rounded-2xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
    <form method="get" class="flex flex-wrap items-center gap-4 text-xs font-semibold">
      <label>
        Status:
        <select name="status" class="ml-1 rounded border border-neutral-300 bg-transparent px-2 py-1 text-xs dark:border-neutral-700" onchange="this.form.submit()">
          <option value="all" selected={filterStatus === "all"}>All Statuses</option>
          <option value="unreviewed" selected={filterStatus === "unreviewed"}>Unreviewed</option>
          <option value="reviewed" selected={filterStatus === "reviewed"}>Reviewed</option>
          <option value="flagged" selected={filterStatus === "flagged"}>Flagged</option>
        </select>
      </label>
      <label>
        Source:
        <select name="source" class="ml-1 rounded border border-neutral-300 bg-transparent px-2 py-1 text-xs dark:border-neutral-700" onchange="this.form.submit()">
          <option value="all" selected={filterSource === "all"}>All Sources</option>
          <option value="ai_draft" selected={filterSource === "ai_draft"}>AI Draft</option>
          <option value="banner" selected={filterSource === "banner"}>Banner</option>
          <option value="human" selected={filterSource === "human"}>Human</option>
          <option value="official" selected={filterSource === "official"}>Official</option>
        </select>
      </label>
      <label>
        Answer Key:
        <select name="keyed" class="ml-1 rounded border border-neutral-300 bg-transparent px-2 py-1 text-xs dark:border-neutral-700" onchange="this.form.submit()">
          <option value="all" selected={filterKeyed === "all"}>All Questions</option>
          <option value="keyed" selected={filterKeyed === "keyed"}>Keyed Questions Only</option>
          <option value="unkeyed" selected={filterKeyed === "unkeyed"}>Unkeyed Questions Only</option>
        </select>
      </label>
      <span class="ml-auto text-neutral-400 font-normal">Showing first 50 items</span>
    </form>
  </div>

  <!-- Queue List -->
  <div class="mt-6 space-y-4">
    {queueQuestions.map((q) => (
      <article class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-neutral-900" data-id={q.id}>
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-neutral-100 pb-3 text-xs dark:border-neutral-800">
          <div class="flex items-center gap-2">
            <span class="font-bold text-neutral-500">ID #{q.id}</span>
            <span class="rounded bg-neutral-100 px-2 py-0.5 font-semibold text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
              {q.paper_title} (Q{q.source_question_no ?? q.id})
            </span>
            <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
              Source: {q.explanation_source}
            </span>
            <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-neutral-100 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
              Status: {q.explanation_status}
            </span>
          </div>
          <div class="text-neutral-400">
            {q.correct_option !== null ? (
              <span class="text-emerald-700 font-bold dark:text-emerald-400">Keyed: Option {q.correct_option + 1}</span>
            ) : (
              <span class="text-rose-600 font-bold dark:text-rose-400">⚠️ Unkeyed (Review Pending)</span>
            )}
          </div>
        </div>

        <div class="mt-3 text-sm font-medium">
          <p class="text-xs uppercase tracking-wider text-neutral-400">Question Stem</p>
          <div class="mt-1 leading-6">{q.stem}</div>
        </div>

        <div class="mt-3 rounded-xl border border-neutral-200 bg-neutral-50 p-4 text-xs dark:border-neutral-800 dark:bg-neutral-950">
          <p class="font-bold text-neutral-500 uppercase tracking-wider">Current Explanation</p>
          <p class="mt-1 text-neutral-700 dark:text-neutral-300 leading-5">{q.explanation || "No explanation entered."}</p>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 pt-2">
          <div class="text-xs text-neutral-400">
            {q.reviewed_by ? `Last reviewed by ${q.reviewed_by} on ${q.reviewed_at?.slice(0, 10)}` : "Not yet reviewed"}
          </div>
          <div class="flex items-center gap-2">
            <button
              class="btn-approve rounded bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-emerald-700 disabled:opacity-40"
              data-id={q.id}
              disabled={q.correct_option === null}
              title={q.correct_option === null ? "Cannot approve explanation for an unkeyed question" : "Approve as reviewed"}
            >
              Approve
            </button>
            <button
              class="btn-flag rounded bg-rose-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-rose-700"
              data-id={q.id}
            >
              Flag
            </button>
            <button
              class="btn-edit rounded border border-neutral-300 px-3 py-1.5 text-xs font-bold hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-800"
              data-id={q.id}
              data-current={q.explanation || ""}
            >
              Edit
            </button>
          </div>
        </div>
      </article>
    ))}
  </div>
</AdminLayout>

<script>
  async function performAction(questionId: number, action: "approve" | "flag" | "edit", explanation?: string) {
    try {
      const res = await fetch("/api/admin/review/action", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          table: "practice_questions",
          questionId,
          action,
          explanation,
        }),
      });

      if (!res.ok) {
        const err = (await res.json()) as { error?: string };
        alert(err.error || "Action failed.");
        return;
      }

      window.location.reload();
    } catch (e: any) {
      alert(e.message || "Network error.");
    }
  }

  document.querySelectorAll(".btn-approve").forEach((b) => {
    b.addEventListener("click", () => {
      const id = Number(b.getAttribute("data-id"));
      if (confirm(`Approve explanation for question #${id} as reviewed?`)) {
        performAction(id, "approve");
      }
    });
  });

  document.querySelectorAll(".btn-flag").forEach((b) => {
    b.addEventListener("click", () => {
      const id = Number(b.getAttribute("data-id"));
      if (confirm(`Flag question #${id} for editorial revision?`)) {
        performAction(id, "flag");
      }
    });
  });

  document.querySelectorAll(".btn-edit").forEach((b) => {
    b.addEventListener("click", () => {
      const id = Number(b.getAttribute("data-id"));
      const current = b.getAttribute("data-current") || "";
      const updated = prompt("Enter revised explanation text:", current);
      if (updated !== null && updated.trim()) {
        performAction(id, "edit", updated.trim());
      }
    });
  });
</script>
