---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth/admin";
import { formatDate, formatDateTime } from "../../lib/content";
import { listUsers } from "../../lib/admin/users";

const admin = Astro.locals.admin!;
if (!can(admin.role, "moderation.write")) return Astro.redirect("/forbidden", 303);

const query = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);
const includeDeleted = Astro.url.searchParams.get("deleted") === "1";
const users = await listUsers(query, includeDeleted);
const canDelete = can(admin.role, "admins.manage");
const now = new Date().toISOString();

function statusFor(user: { deleted_at: string | null; banned_at: string | null; muted_until: string | null }): { label: string; tone: string } {
  if (user.deleted_at) return { label: "Deleted", tone: "bg-neutral-200 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300" };
  if (user.banned_at) return { label: "Banned", tone: "bg-red-100 text-red-900 dark:bg-red-950/50 dark:text-red-200" };
  if (user.muted_until && user.muted_until > now) return { label: "Muted", tone: "bg-amber-100 text-amber-900 dark:bg-amber-950/50 dark:text-amber-200" };
  return { label: "Active", tone: "bg-brand-100 text-brand-900 dark:bg-brand-900/50 dark:text-brand-200" };
}
---

<AdminLayout title="Users" active="users">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Users</h1>
      <p class="mt-1 max-w-3xl text-sm text-neutral-600 dark:text-neutral-400">
        Search accounts, inspect attempt counts, mute or ban abusive users, and review soft-deleted accounts. Email addresses stay private on the public site.
      </p>
    </div>
    <form class="flex flex-wrap items-end gap-2" action="/admin/users" method="get" role="search">
      <label class="block text-xs font-semibold text-neutral-500 dark:text-neutral-400">Search
        <input class="mt-1 rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-950" name="q" type="search" value={query} placeholder="username or email" />
      </label>
      <label class="flex items-center gap-2 pb-2 text-xs font-semibold">
        <input type="checkbox" name="deleted" value="1" checked={includeDeleted} /> Include deleted
      </label>
      <button class="rounded-lg bg-neutral-900 px-3 py-2 text-sm font-bold text-white hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200" type="submit">Filter</button>
    </form>
  </div>

  <div class="mt-5 flex flex-wrap items-end gap-3 rounded-2xl border border-neutral-200 bg-white p-4 text-sm dark:border-neutral-800 dark:bg-neutral-900">
    <label class="block text-xs font-semibold text-neutral-500 dark:text-neutral-400">Mute expiry for the next action
      <input class="mt-1 rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-950" id="mute-until" type="date" />
    </label>
    <p class="max-w-xl text-xs text-neutral-500 dark:text-neutral-400">Muting blocks new comments until the chosen date. Banning also signs the user out of every session and blocks login until unbanned.</p>
  </div>

  <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">
    {users.length} account{users.length === 1 ? "" : "s"} shown{query ? ` for “${query}”` : ""}{includeDeleted ? " (including deleted)" : ""}.
  </p>

  <div class="mt-3 overflow-hidden rounded-2xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
    <div class="overflow-x-auto" role="region" aria-label="User accounts" tabindex="0">
      <table class="w-full min-w-[980px] text-left text-sm">
        <thead class="border-b border-neutral-200 bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-400">
          <tr>
            <th class="px-4 py-3">User</th>
            <th class="px-4 py-3">Joined</th>
            <th class="px-4 py-3 text-right">Attempts</th>
            <th class="px-4 py-3 text-right">Comments</th>
            <th class="px-4 py-3">Last attempt</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
          {users.map((user) => {
            const status = statusFor(user);
            return (
              <tr data-user-row={user.id}>
                <td class="max-w-xs px-4 py-3">
                  <span class="block font-semibold">{user.username}</span>
                  <span class="block truncate text-xs text-neutral-500 dark:text-neutral-400">{user.email}</span>
                  <span class="text-[11px] text-neutral-500 dark:text-neutral-400">#{user.id}</span>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-xs text-neutral-500 dark:text-neutral-400">{formatDate(user.created_at)}</td>
                <td class="px-4 py-3 text-right font-semibold">{user.attempt_count}</td>
                <td class="px-4 py-3 text-right">{user.comment_count}</td>
                <td class="whitespace-nowrap px-4 py-3 text-xs text-neutral-500 dark:text-neutral-400">{user.last_attempt_at ? formatDateTime(user.last_attempt_at) : "—"}</td>
                <td class="px-4 py-3">
                  <span class:list={["rounded-full px-2 py-0.5 text-xs font-semibold", status.tone]}>{status.label}</span>
                  {user.muted_until && user.muted_until > now ? <span class="mt-1 block text-[11px] text-neutral-500 dark:text-neutral-400">until {formatDate(user.muted_until)}</span> : null}
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap justify-end gap-1.5">
                    {!user.deleted_at ? (
                      <>
                        {user.muted_until && user.muted_until > now ? (
                          <button class="rounded-lg border border-neutral-300 px-2 py-1 text-xs font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" type="button" data-user-action="unmute" data-user-id={user.id} data-user-name={user.username}>Unmute</button>
                        ) : (
                          <button class="rounded-lg border border-amber-300 px-2 py-1 text-xs font-semibold text-amber-900 hover:bg-amber-50 dark:border-amber-800 dark:text-amber-200 dark:hover:bg-amber-950/30" type="button" data-user-action="mute" data-user-id={user.id} data-user-name={user.username}>Mute</button>
                        )}
                        {user.banned_at ? (
                          <button class="rounded-lg border border-neutral-300 px-2 py-1 text-xs font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" type="button" data-user-action="unban" data-user-id={user.id} data-user-name={user.username}>Unban</button>
                        ) : (
                          <button class="rounded-lg border border-red-300 px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-50 dark:border-red-800 dark:text-red-300 dark:hover:bg-red-950/30" type="button" data-user-action="ban" data-user-id={user.id} data-user-name={user.username}>Ban</button>
                        )}
                        {canDelete ? (
                          <button class="rounded-lg border border-red-300 px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-50 dark:border-red-800 dark:text-red-300 dark:hover:bg-red-950/30" type="button" data-user-action="delete" data-user-id={user.id} data-user-name={user.username}>Delete</button>
                        ) : null}
                      </>
                    ) : (
                      <span class="text-xs text-neutral-500 dark:text-neutral-400">Soft-deleted · attempts retained</span>
                    )}
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {users.length === 0 ? <p class="px-4 py-12 text-center text-sm text-neutral-500 dark:text-neutral-400">No accounts match this filter.</p> : null}
  </div>

  <p class="mt-3 text-xs leading-5 text-neutral-500 dark:text-neutral-400">
    Banning and deleting are destructive. Banning keeps the account and historical attempts but blocks every session. Deleting anonymises the profile, keeps submitted attempts for leaderboard integrity, and removes bookmarks and votes.
  </p>

  <script is:inline>
    document.querySelectorAll("[data-user-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        const action = button.dataset.userAction;
        const id = button.dataset.userId;
        const name = button.dataset.userName || "this user";
        if (!action || !id) return;

        let until = "";
        if (action === "mute") {
          until = document.getElementById("mute-until")?.value || "";
          if (!until) {
            alert("Choose a mute expiry date first.");
            return;
          }
          if (!confirm(`Mute ${name} until ${until}?`)) return;
        } else if (action === "ban" && !confirm(`Ban ${name}? They will be signed out and blocked from logging in.`)) {
          return;
        } else if (action === "delete" && !confirm(`Delete ${name}? The profile is anonymised and this cannot be undone from the site.`)) {
          return;
        }

        button.disabled = true;
        const response = await fetch(`/api/admin/users/${id}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ action, until }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          alert(result.error || "Could not update the account.");
          button.disabled = false;
          return;
        }
        location.reload();
      });
    });
  </script>
</AdminLayout>
