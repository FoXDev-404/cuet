---
import BaseLayout from "../layouts/BaseLayout.astro";
import { searchSite, searchTotal, type SearchResults } from "../lib/search";

const query = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);
let results: SearchResults = { query, mocks: [], subjects: [], topics: [], pyq: [], posts: [] };
if (query.length >= 2) {
  results = await searchSite(query);
}
const total = searchTotal(results);
const groups = [
  { key: "mocks", label: "Mock tests", items: results.mocks },
  { key: "subjects", label: "Subjects", items: results.subjects },
  { key: "topics", label: "Topics", items: results.topics },
  { key: "pyq", label: "Previous-year papers", items: results.pyq },
  { key: "posts", label: "Guides", items: results.posts },
].filter((group) => group.items.length > 0);

function hrefFor(group: string, item: Record<string, unknown>): string {
  if (group === "mocks") return `/mock/${item.slug}`;
  if (group === "subjects") return `/cuet-ug-syllabus/${item.slug}`;
  if (group === "topics") return `/cuet-mock-test/${item.subject_slug}/${item.slug}`;
  if (group === "pyq") return item.mock_slug ? `/mock/${item.mock_slug}` : `/pyq/${item.year}`;
  return `/blog/${item.slug}`;
}

function titleFor(group: string, item: Record<string, unknown>): string {
  if (group === "subjects") return `${item.name} syllabus`;
  if (group === "topics") return `${item.name} · ${item.subject_name}`;
  if (group === "pyq") return `${item.title} (${item.year}${item.shift ? `, ${item.shift}` : ""})`;
  return String(item.title ?? item.name ?? "Result");
}

function detailFor(group: string, item: Record<string, unknown>): string {
  if (group === "mocks") return `${item.type}${item.subject_name ? ` · ${item.subject_name}` : ""}`;
  if (group === "subjects") return "Syllabus and topic map";
  if (group === "topics") return "Topic practice page";
  if (group === "pyq") return item.mock_slug ? "Timed paper available" : "Paper page";
  return String(item.description ?? "");
}
---

<BaseLayout
  title="Search — CUET Free Mock Test"
  description="Search CUET mock tests, subjects, topics, previous-year papers and guides."
  noindex
>
  <section class="border-b border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900/40">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
      <p class="text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-300">Search</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">Find a paper, subject or guide</h1>
      <form class="mt-6 flex flex-col gap-2 sm:flex-row" action="/search" method="get" role="search">
        <label class="sr-only" for="search-query">Search CUET practice content</label>
        <input
          class="min-w-0 flex-1 rounded-lg border border-neutral-300 bg-white px-4 py-3 text-base dark:border-neutral-700 dark:bg-neutral-950"
          id="search-query"
          name="q"
          type="search"
          value={query}
          minlength="2"
          maxlength="80"
          placeholder="e.g. English reading, Physics, 2022"
          autocomplete="off"
        />
        <button class="rounded-lg bg-brand-600 px-5 py-3 text-sm font-bold text-white hover:bg-brand-700" type="submit">Search</button>
      </form>
      <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">Search is limited to published mocks, active subjects and topics, published PYQ entries and guides. Answer keys are never indexed.</p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
    {query.length < 2 ? (
      <p class="rounded-2xl border border-dashed border-neutral-300 p-8 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
        Type at least two characters to search.
      </p>
    ) : total === 0 ? (
      <div class="rounded-2xl border border-dashed border-neutral-300 p-10 text-center dark:border-neutral-700">
        <h2 class="font-bold">No results for “{query}”</h2>
        <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-neutral-500 dark:text-neutral-400">
          Try a subject name, a topic, “PYQ”, a year, or a phrase from a guide title. Only published content is searchable.
        </p>
        <div class="mt-4 flex flex-wrap justify-center gap-2">
          <a class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" href="/cuet-ug-mock-test">Browse mock tests</a>
          <a class="rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-900" href="/cuet-ug-syllabus">Open the syllabus</a>
        </div>
      </div>
    ) : (
      <>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">{total} result{total === 1 ? "" : "s"} for “{query}”.</p>
        <div class="mt-5 space-y-8">
          {groups.map((group) => (
            <section>
              <h2 class="text-lg font-bold">{group.label} <span class="text-sm font-normal text-neutral-500 dark:text-neutral-400">({group.items.length})</span></h2>
              <ul class="mt-3 divide-y divide-neutral-100 rounded-2xl border border-neutral-200 bg-white dark:divide-neutral-800 dark:border-neutral-800 dark:bg-neutral-900">
                {group.items.map((item) => {
                  const record = item as Record<string, unknown>;
                  return (
                    <li>
                      <a class="block px-4 py-3 transition-colors hover:bg-neutral-50 dark:hover:bg-neutral-950" href={hrefFor(group.key, record)}>
                        <span class="font-semibold">{titleFor(group.key, record)}</span>
                        <span class="mt-0.5 block text-xs text-neutral-500 dark:text-neutral-400">{detailFor(group.key, record)}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>
