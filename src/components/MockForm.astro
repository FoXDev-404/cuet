---
import { parseMarkingScheme, renderRichText } from "../lib/content";

interface MockFormModel {
  id: number;
  title: string;
  slug: string;
  type: string;
  subject_id: number | null;
  duration_min: number;
  total_marks: number;
  marking_scheme: string;
  instructions: string | null;
  intro_html: string | null;
  pyq_year: number | null;
  pyq_shift: string | null;
  status: string;
  version_no: number;
  version_id: number;
  locked: boolean;
}

interface Props {
  mock?: MockFormModel | null;
  subjects: { id: number; name: string }[];
  questions: {
    id: number;
    text: string;
    subject_name: string;
    status: string;
    explanation: string | null;
  }[];
  selected: Record<number, string>;
  positions?: Record<number, number>;
  sectionOrder?: string;
  canPublish: boolean;
}

const {
  mock = null,
  subjects,
  questions,
  selected,
  positions = {},
  sectionOrder = "",
  canPublish,
} = Astro.props;
const marking = parseMarkingScheme(mock?.marking_scheme ?? "");
const locked = mock?.locked ?? false;
const status = mock?.status ?? "draft";
---

<style>
  .field {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-input);
    background: var(--surface-2);
    color: var(--ink);
    padding: 0.6rem 0.75rem;
    font-size: 0.875rem;
    outline: none;
  }
  .field:focus { border-color: var(--focus); box-shadow: 0 0 0 3px var(--focus-ring); }
  .label { display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.35rem; }
  .card { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 1.25rem; min-width: 0; max-width: 100%; box-sizing: border-box; }
</style>

<div id="mock-lock" data-locked={locked ? "true" : "false"} class={locked ? "mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200" : "hidden"}>
  This version is published and frozen. Create a new version to make corrections; existing attempts keep their original paper and scores.
</div>

<form id="mock-form" data-id={mock?.id ?? ""} data-version-id={mock?.version_id ?? ""} class="grid w-full min-w-0 max-w-full gap-6 lg:grid-cols-[minmax(0,1fr)_380px]" novalidate>
  <div class="min-w-0 max-w-full space-y-6">
    <p id="mock-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/50 dark:text-red-200"></p>

    <section class="card space-y-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="label sm:col-span-2">
          Title
          <input class="field mt-1" data-field="title" type="text" required maxlength="180" value={mock?.title ?? ""} placeholder="CUET UG English Full Mock 1" />
        </label>
        <label class="label">
          URL slug
          <input class="field mt-1 font-mono text-xs" data-field="slug" type="text" maxlength="120" value={mock?.slug ?? ""} placeholder="cuet-ug-english-mock-1" />
        </label>
        <label class="label">
          Type
          <select class="field mt-1" data-field="type">
            {["full", "subject", "chapter", "pyq"].map((item) => (<option value={item} selected={mock?.type === item}>{item}</option>))}
          </select>
        </label>
        <label class="label">
          Subject <span class="font-normal text-neutral-500 dark:text-neutral-400">(optional for full mocks)</span>
          <select class="field mt-1" data-field="subject_id">
            <option value="">Full / multi-subject</option>
            {subjects.map((subject) => (<option value={subject.id} selected={mock?.subject_id === subject.id}>{subject.name}</option>))}
          </select>
        </label>
        <label class="label">
          Duration (minutes)
          <input class="field mt-1" data-field="duration_min" type="number" min="1" max="600" required value={mock?.duration_min ?? 60} />
          <p id="duration-rate-note" class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
            Standard: 1.2 min/q (72s) for Domain/Language, 1.0 min/q (60s) for General Test.
          </p>
        </label>
        <label class="label">
          Total marks
          <input class="field mt-1" data-field="total_marks" type="number" min="1" step="0.5" required value={mock?.total_marks ?? 100} />
        </label>
        <label class="label">
          Status
          <select class="field mt-1" data-field="status" disabled={locked}>
            <option value="draft" selected={status === "draft"}>Draft</option>
            <option value="in_review" selected={status === "in_review"} disabled={!canPublish}>In review</option>
            <option value="published" selected={status === "published"} disabled={!canPublish}>Published</option>
          </select>
          {!canPublish ? <span class="mt-1 block text-xs font-normal text-neutral-500 dark:text-neutral-400">Only editors publish mocks.</span> : null}
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <label class="label">Correct marks<input class="field mt-1" data-field="correct" type="number" min="0" step="0.5" value={marking.correct} /></label>
        <label class="label">Wrong marks<input class="field mt-1" data-field="wrong" type="number" max="0" step="0.5" value={marking.wrong} /></label>
        <label class="label">Skipped marks<input class="field mt-1" data-field="skipped" type="number" step="0.5" value={marking.skipped} /></label>
      </div>
      <p class="text-xs text-neutral-500 dark:text-neutral-400">Marking values are stored per mock. Verify CUET marking from the official NTA bulletin before publishing.</p>

      <label class="label">
        Instructions shown before the timer
        <textarea class="field mt-1" data-field="instructions" rows="5" placeholder="One instruction per line.">{mock?.instructions ?? ""}</textarea>
      </label>
      <label class="label">
        Unique SEO intro <span class="font-normal text-neutral-500 dark:text-neutral-400">(plain text, shown on the mock detail page)</span>
        <textarea class="field mt-1" data-field="intro_html" rows="5">{mock?.intro_html ?? ""}</textarea>
      </label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="label">PYQ year<input class="field mt-1" data-field="pyq_year" type="number" min="1900" max="2100" value={mock?.pyq_year ?? ""} /></label>
        <label class="label">PYQ shift<input class="field mt-1" data-field="pyq_shift" type="text" maxlength="60" value={mock?.pyq_shift ?? ""} /></label>
      </div>
    </section>

    <section class="card">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-bold">Questions</h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">Browse and select questions from the entire database across all subjects.</p>
        </div>
        <p class="text-sm font-semibold"><span data-selected-count>0</span> selected</p>
      </div>

      <label class="label mt-4">
        Section order
        <textarea class="field mt-1 font-mono text-xs" id="section-order" rows="2" placeholder="Language, Domain, General Test" disabled={locked}>{sectionOrder}</textarea>
        <span class="mt-1 block text-xs font-normal text-neutral-500 dark:text-neutral-400">One section per line or comma-separated. Sections render in this order; unknown sections follow afterwards.</span>
      </label>

      <!-- Question search & database browser -->
      <div class="mt-4 grid gap-2 sm:grid-cols-[1fr_180px_auto]">
        <input class="field text-sm" id="question-filter" type="search" placeholder="Search by text or ID (e.g. 1234)…" />
        <select class="field text-sm" id="subject-bank-filter" aria-label="Filter question bank by subject">
          <option value="">All subjects</option>
          {subjects.map((s) => (
            <option value={s.id} selected={mock?.subject_id === s.id}>{s.name}</option>
          ))}
        </select>
        <button
          type="button"
          id="search-db-btn"
          class="rounded-lg border border-neutral-300 px-3 py-2 text-xs font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800"
        >
          Search DB
        </button>
      </div>

      <!-- Quick filters: All vs Selected Only -->
      <div class="mt-3 flex items-center justify-between border-b border-neutral-200 pb-2 text-xs dark:border-neutral-800">
        <div class="flex items-center gap-3">
          <button type="button" id="tab-all" class="font-semibold text-brand-600 dark:text-brand-400 underline cursor-pointer">All loaded</button>
          <span>·</span>
          <button type="button" id="tab-selected" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white cursor-pointer">Selected only (<span data-selected-tab-count>0</span>)</button>
        </div>
        <span id="search-status" class="text-xs text-neutral-500 dark:text-neutral-400"></span>
      </div>

      <div id="question-list-container" class="mt-4 max-h-[32rem] min-w-0 max-w-full space-y-2 overflow-y-auto pr-1" tabindex="0" role="region" aria-label="Question list">
        {questions.map((question) => {
          const isSelected = Object.prototype.hasOwnProperty.call(selected, question.id);
          return (
            <label class="flex max-w-full min-w-0 cursor-pointer items-start gap-3 overflow-hidden rounded-xl border border-neutral-200 p-3 hover:bg-neutral-50 dark:border-neutral-800 dark:hover:bg-neutral-950" data-question-row data-search={`${question.text} ${question.subject_name}`.toLowerCase()}>
              <input class="mt-1 shrink-0" type="checkbox" data-question-checkbox value={question.id} data-subject={question.subject_name} checked={isSelected} disabled={locked} />
              <span class="min-w-0 flex-1 overflow-hidden">
                <span class="block text-sm font-medium"><span class="line-clamp-2 break-words" set:html={renderRichText(question.text)}></span></span>
                <span class="mt-1 flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                  <span>{question.subject_name}</span>
                  <span>·</span>
                  <span>#{question.id}</span>
                  {!question.explanation ? <span class="rounded-full bg-amber-100 px-2 py-0.5 font-semibold text-amber-900 dark:bg-amber-950/50 dark:text-amber-200">No explanation</span> : null}
                </span>
                <span class="mt-2 grid gap-2 sm:grid-cols-[minmax(0,1fr)_7rem]">
                  <span>
                    <span class="sr-only">Section for question {question.id}</span>
                    <input class="field text-xs" type="text" maxlength="100" data-section value={selected[question.id] ?? question.subject_name} placeholder="Section" disabled={locked} />
                  </span>
                  <span>
                    <span class="sr-only">Order for question {question.id}</span>
                    <input class="field text-xs" type="number" min="1" max="500" step="1" data-order value={positions[question.id] ?? ""} placeholder="Order" disabled={locked} />
                  </span>
                </span>
              </span>
            </label>
          );
        })}
      </div>
      {questions.length === 0 ? (
        <p class="mt-4 rounded-xl border border-dashed border-neutral-300 p-6 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
          No questions loaded yet. Use the subject filter or search box above to fetch questions from the database.
        </p>
      ) : null}
    </section>
  </div>

  <aside class="min-w-0 max-w-full space-y-4 lg:sticky lg:top-24 lg:self-start">
    <section class="card space-y-3">
      <button id="save-mock" type="submit" disabled={locked} class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-50">
        {mock ? "Save mock" : "Create mock"}
      </button>
      {mock ? <a class="block text-center text-xs text-neutral-500 hover:underline dark:text-neutral-400" href={`/admin/mocks/${mock.id}`}>Editing mock #{mock.id} · version {mock.version_no}</a> : null}
      {mock ? <a class="block rounded-lg border border-neutral-300 px-3 py-2 text-center text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/admin/mocks/${mock.id}/preview`}>Preview saved draft</a> : null}
      <a class="block text-center text-sm font-medium text-neutral-600 hover:underline dark:text-neutral-300" href="/admin/mocks">Back to mock list</a>
    </section>
    <section class="card text-sm">
      <h2 class="font-bold">Publishing checklist</h2>
      <ul class="mt-2 space-y-1.5 text-neutral-600 dark:text-neutral-400">
        <li>• Every question is published with an explanation.</li>
        <li>• Every image has meaningful alt text.</li>
        <li>• Marking scheme is verified against NTA.</li>
        <li>• Duration and total marks match the paper.</li>
      </ul>
    </section>
  </aside>
</form>

<script>
  const form = document.getElementById("mock-form") as HTMLFormElement | null;
  if (form) {
    const errorBox = document.getElementById("mock-error") as HTMLElement;
    const saveButton = document.getElementById("save-mock") as HTMLButtonElement;
    const mockId = form.dataset.id || "";
    const selectedCount = form.querySelector("[data-selected-count]") as HTMLElement;
    const tabSelectedCount = form.querySelector("[data-selected-tab-count]") as HTMLElement;
    const titleInput = form.querySelector('[data-field="title"]') as HTMLInputElement;
    const slugInput = form.querySelector('[data-field="slug"]') as HTMLInputElement;
    const filterInput = document.getElementById("question-filter") as HTMLInputElement;
    const subjectBankFilter = document.getElementById("subject-bank-filter") as HTMLSelectElement | null;
    const searchDbBtn = document.getElementById("search-db-btn") as HTMLButtonElement | null;
    const searchStatus = document.getElementById("search-status") as HTMLElement | null;
    const container = document.getElementById("question-list-container") as HTMLElement | null;
    const tabAll = document.getElementById("tab-all") as HTMLButtonElement | null;
    const tabSelected = document.getElementById("tab-selected") as HTMLButtonElement | null;
    const sectionOrderInput = document.getElementById("section-order") as HTMLTextAreaElement | null;
    const durationInput = form.querySelector('[data-field="duration_min"]') as HTMLInputElement | null;
    const subjectSelect = form.querySelector('[data-field="subject_id"]') as HTMLSelectElement | null;
    const durationRateNote = document.getElementById("duration-rate-note") as HTMLElement | null;

    let isSearching = false;
    let currentTab: "all" | "selected" = "all";
    let durationUserOverridden = false;

    durationInput?.addEventListener("input", () => {
      durationUserOverridden = true;
    });

    function syncDuration(force = false) {
      if (!durationInput) return;
      const checks = getAllChecks();
      const count = checks.filter((check) => check.checked).length;
      const subjectName = subjectSelect?.selectedOptions[0]?.textContent?.trim() || "";
      const isGeneral = subjectName.toLowerCase().includes("general");
      const rateSeconds = isGeneral ? 60 : 72;
      const rateLabel = isGeneral ? "1.0 min/q (60s)" : "1.2 min/q (72s)";

      if (count > 0) {
        const calculatedMinutes = Math.max(1, Math.round((count * rateSeconds) / 60));
        if (!durationUserOverridden || force) {
          durationInput.value = String(calculatedMinutes);
        }
        if (durationRateNote) {
          durationRateNote.textContent = `${count} questions × ${rateLabel} = ${calculatedMinutes} mins total duration.`;
        }
      } else {
        if (durationRateNote) {
          durationRateNote.textContent = `Standard rate: ${rateLabel}. Select questions to auto-calculate.`;
        }
      }
    }

    function field(name: string): string {
      const element = form!.querySelector(`[data-field="${name}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
      return element.value.trim();
    }

    function getAllChecks(): HTMLInputElement[] {
      return [...form!.querySelectorAll("[data-question-checkbox]")] as HTMLInputElement[];
    }

    function getAllRows(): HTMLElement[] {
      return [...form!.querySelectorAll("[data-question-row]")] as HTMLElement[];
    }

    function updateCount() {
      const checks = getAllChecks();
      const count = checks.filter((check) => check.checked).length;
      if (selectedCount) selectedCount.textContent = String(count);
      if (tabSelectedCount) tabSelectedCount.textContent = String(count);
      if (currentTab === "selected") applyTabFilter();
      syncDuration();
    }

    // Attach listener to all existing checkboxes
    getAllChecks().forEach((check) => check.addEventListener("change", updateCount));
    subjectSelect?.addEventListener("change", () => syncDuration(true));
    updateCount();

    function escapeHtml(str: string): string {
      const div = document.createElement("div");
      div.textContent = str || "";
      return div.innerHTML;
    }

    function escapeAttr(str: string): string {
      return (str || "").replace(/"/g, "&quot;");
    }

    function applyTabFilter() {
      const rows = getAllRows();
      if (currentTab === "selected") {
        tabAll?.classList.remove("font-semibold", "text-brand-600", "dark:text-brand-400", "underline");
        tabAll?.classList.add("text-neutral-500", "dark:text-neutral-400");
        tabSelected?.classList.add("font-semibold", "text-brand-600", "dark:text-brand-400", "underline");
        tabSelected?.classList.remove("text-neutral-500", "dark:text-neutral-400");
        rows.forEach((row) => {
          const chk = row.querySelector("[data-question-checkbox]") as HTMLInputElement | null;
          row.classList.toggle("hidden", !chk?.checked);
        });
      } else {
        tabSelected?.classList.remove("font-semibold", "text-brand-600", "dark:text-brand-400", "underline");
        tabSelected?.classList.add("text-neutral-500", "dark:text-neutral-400");
        tabAll?.classList.add("font-semibold", "text-brand-600", "dark:text-brand-400", "underline");
        tabAll?.classList.remove("text-neutral-500", "dark:text-neutral-400");
        const term = filterInput?.value.trim().toLowerCase() || "";
        rows.forEach((row) => {
          row.classList.toggle("hidden", Boolean(term) && !row.dataset.search?.includes(term));
        });
      }
    }

    tabAll?.addEventListener("click", () => {
      currentTab = "all";
      applyTabFilter();
    });

    tabSelected?.addEventListener("click", () => {
      currentTab = "selected";
      applyTabFilter();
    });

    // Client-side quick filter on current rows
    filterInput?.addEventListener("input", () => {
      if (currentTab === "all") {
        const term = filterInput.value.trim().toLowerCase();
        getAllRows().forEach((row) => {
          row.classList.toggle("hidden", Boolean(term) && !row.dataset.search?.includes(term));
        });
      }
    });

    // Database search across ALL questions in the entire database
    async function searchDatabase() {
      if (isSearching) return;
      isSearching = true;
      if (searchStatus) searchStatus.textContent = "Searching DB…";

      const term = filterInput?.value.trim() || "";
      const subjectId = subjectBankFilter?.value || "";
      const params = new URLSearchParams({
        status: "published",
        limit: "50",
      });
      if (term) params.set("q", term);
      if (subjectId) params.set("subject", subjectId);

      try {
        const response = await fetch(`/api/admin/questions?${params.toString()}`);
        if (!response.ok) throw new Error("Database query failed");
        const data = (await response.json()) as {
          ok: boolean;
          count: number;
          questions: Array<{
            id: number;
            text: string;
            subject: { id: number; name: string };
            status: string;
            explanation: string | null;
          }>;
        };

        let newCount = 0;
        if (data.questions && container) {
          data.questions.forEach((q) => {
            const existing = container.querySelector(`[data-question-checkbox][value="${q.id}"]`);
            if (existing) {
              const row = existing.closest("[data-question-row]") as HTMLElement | null;
              if (row && currentTab === "all") row.classList.remove("hidden");
            } else {
              newCount++;
              const label = document.createElement("label");
              label.className = "flex max-w-full min-w-0 cursor-pointer items-start gap-3 overflow-hidden rounded-xl border border-neutral-200 p-3 hover:bg-neutral-50 dark:border-neutral-800 dark:hover:bg-neutral-950";
              label.setAttribute("data-question-row", "");
              label.setAttribute("data-search", `${q.text} ${q.subject.name}`.toLowerCase());
              label.innerHTML = `
                <input class="mt-1 shrink-0" type="checkbox" data-question-checkbox value="${q.id}" data-subject="${escapeAttr(q.subject.name)}" />
                <span class="min-w-0 flex-1 overflow-hidden">
                  <span class="block text-sm font-medium"><span class="line-clamp-2 break-words">${escapeHtml(q.text)}</span></span>
                  <span class="mt-1 flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                    <span>${escapeHtml(q.subject.name)}</span>
                    <span>·</span>
                    <span>#${q.id}</span>
                    ${!q.explanation ? '<span class="rounded-full bg-amber-100 px-2 py-0.5 font-semibold text-amber-900 dark:bg-amber-950/50 dark:text-amber-200">No explanation</span>' : ''}
                  </span>
                  <span class="mt-2 grid gap-2 sm:grid-cols-[minmax(0,1fr)_7rem]">
                    <span>
                      <span class="sr-only">Section for question ${q.id}</span>
                      <input class="field text-xs" type="text" maxlength="100" data-section value="${escapeAttr(q.subject.name)}" placeholder="Section" />
                    </span>
                    <span>
                      <span class="sr-only">Order for question ${q.id}</span>
                      <input class="field text-xs" type="number" min="1" max="500" step="1" data-order value="" placeholder="Order" />
                    </span>
                  </span>
                </span>
              `;
              const chk = label.querySelector("[data-question-checkbox]") as HTMLInputElement | null;
              chk?.addEventListener("change", updateCount);
              container.appendChild(label);
            }
          });
        }

        if (searchStatus) {
          searchStatus.textContent = `Found ${data.count} in DB (${newCount} new added)`;
        }
        updateCount();
      } catch (err) {
        if (searchStatus) searchStatus.textContent = "Error querying DB";
      } finally {
        isSearching = false;
      }
    }

    searchDbBtn?.addEventListener("click", searchDatabase);
    subjectBankFilter?.addEventListener("change", searchDatabase);
    filterInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        searchDatabase();
      }
    });

    let slugTouched = Boolean(slugInput.value);
    slugInput.addEventListener("input", () => { slugTouched = Boolean(slugInput.value.trim()); });
    titleInput.addEventListener("input", () => {
      if (slugTouched) return;
      slugInput.value = titleInput.value.toLowerCase().trim().replace(/['"]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 90);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (saveButton.disabled) return;
      errorBox.classList.add("hidden");
      saveButton.disabled = true;
      saveButton.textContent = "Saving…";

      try {
        const sectionOrder = (sectionOrderInput?.value ?? "")
          .split(/[\n,]/)
          .map((section) => section.trim())
          .filter(Boolean)
          .filter((section, index, all) => all.indexOf(section) === index);
        const sectionRank = new Map<string, number>();
        for (const section of sectionOrder) {
          if (!sectionRank.has(section)) sectionRank.set(section, sectionRank.size);
        }
        const checks = getAllChecks();
        const questions = checks
          .filter((check) => check.checked)
          .map((check, index) => {
            const row = check.closest("[data-question-row]") as HTMLElement;
            const section = (row.querySelector("[data-section]") as HTMLInputElement).value.trim();
            const orderValue = Number((row.querySelector("[data-order]") as HTMLInputElement).value);
            return {
              index,
              order: Number.isFinite(orderValue) && orderValue > 0 ? orderValue : null,
              question_id: Number(check.value),
              section: section || check.dataset.subject || "General",
            };
          })
          .sort((left, right) => {
            const leftRank = sectionRank.get(left.section) ?? sectionRank.size;
            const rightRank = sectionRank.get(right.section) ?? sectionRank.size;
            return (
              leftRank - rightRank ||
              (left.order ?? Number.MAX_SAFE_INTEGER) - (right.order ?? Number.MAX_SAFE_INTEGER) ||
              left.index - right.index
            );
          })
          .map(({ question_id, section }) => ({ question_id, section }));
        if (questions.length === 0) throw new Error("Select at least one question.");

        const payload = {
          title: field("title"),
          slug: field("slug"),
          subject_id: field("subject_id") || null,
          type: field("type"),
          duration_min: field("duration_min"),
          total_marks: field("total_marks"),
          marking: {
            correct: field("correct"),
            wrong: field("wrong"),
            skipped: field("skipped"),
          },
          instructions: field("instructions"),
          intro_html: field("intro_html"),
          pyq_year: field("pyq_year") || null,
          pyq_shift: field("pyq_shift"),
          status: field("status"),
          section_order: sectionOrder,
          questions,
        };

        const response = await fetch(mockId ? `/api/admin/mocks/${mockId}` : "/api/admin/mocks", {
          method: mockId ? "PATCH" : "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = (await response.json()) as { error?: string; redirect?: string; url?: string; id?: string };
        if (!response.ok) throw new Error(result.error || "Could not save the mock.");
        location.href = result.redirect || "/admin/mocks";
      } catch (error) {
        errorBox.textContent = error instanceof Error ? error.message : "Could not save the mock.";
        errorBox.classList.remove("hidden");
        errorBox.scrollIntoView({ behavior: "smooth", block: "center" });
        saveButton.disabled = false;
        saveButton.textContent = mockId ? "Save mock" : "Create mock";
      }
    });
  }
</script>
