# Copy this file to `.dev.vars` (ignored by git) for local development.
#
# Google OAuth — REQUIRED: sign-in is Google-only (email/password auth was
# retired in November 2026). Create an OAuth 2.0 Web client in Google
# Cloud Console and add this authorised redirect URI:
#   http://localhost:4321/api/auth/google/callback
# Production must use https://<your-domain>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin used for canonical links and cookie security.
SITE_URL=http://localhost:4321

# Optional local preview parity. Set to the loopback origin this dev server
# serves (for example http://localhost:4321) to make canonical-host and
# trailing-slash redirects behave as they do in production. Leave blank for
# normal development; never set this in production.
PREVIEW_CANONICAL_ORIGIN=

# Turso Cloud (optional). The engine is selected at runtime: astro dev always
# uses the local D1 binding unless USE_TURSO_LOCAL=1 (which makes a local
# server talk to Turso over HTTP, so be sure your credentials are the right
# database). Built previews and production use Turso whenever TURSO_DATABASE_URL
# is set, unless USE_LOCAL_D1=1 forces the local binding. Leave both flags blank
# for normal development; never commit them to wrangler.jsonc (check:env rejects
# them) and never point them at production data from a local machine.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
USE_LOCAL_D1=
USE_TURSO_LOCAL=

# Legacy (unused by any current flow): password-reset email delivery was
# retired together with email/password auth in November 2026.
DEV_SHOW_RESET_LINK=true

# Transactional email (optional, currently unused). Provider keys belong in
# `.dev.vars` locally and `wrangler secret put` remotely, never in git.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=

# Optional public integrations. Empty or malformed values emit nothing.
CF_ANALYTICS_TOKEN=
GSC_VERIFICATION=
ADSENSE_CLIENT=
ADSENSE_SLOT_ID=
# Set to 1 only after a Google-certified CMP is live; ads stay off otherwise.
ADSENSE_CMP_ACTIVE=
GTM_CONTAINER_ID=
# Google Analytics 4 (optional). GA4 loads only after a visitor allows it.
GA4_MEASUREMENT_ID=
