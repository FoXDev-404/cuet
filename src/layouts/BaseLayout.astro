    <script is:inline>
      (() => {
        // Log out handler
        document.querySelectorAll("[data-logout]").forEach((item) => {
          item.addEventListener("click", async () => {
            await fetch("/api/auth/logout", { method: "POST" });
            location.href = "/";
          });
        });

        // Mobile More sheet toggle
        const moreBtn = document.getElementById("mobile-more-btn");
        const moreSheet = document.getElementById("mobile-more-sheet");
        const moreBackdrop = document.getElementById("mobile-more-backdrop");
        const moreClose = document.getElementById("mobile-more-close");

        function openMoreSheet() {
          if (!moreSheet) return;
          moreSheet.classList.remove("hidden");
          document.body.classList.add("overflow-hidden");
          if (moreBtn) moreBtn.setAttribute("aria-expanded", "true");
        }

        function closeMoreSheet() {
          if (!moreSheet) return;
          moreSheet.classList.add("hidden");
          document.body.classList.remove("overflow-hidden");
          if (moreBtn) moreBtn.setAttribute("aria-expanded", "false");
        }

        moreBtn?.addEventListener("click", openMoreSheet);
        moreBackdrop?.addEventListener("click", closeMoreSheet);
        moreClose?.addEventListener("click", closeMoreSheet);

        // Close user dropdown on click outside
        document.addEventListener("click", (e) => {
          document.querySelectorAll("details.user-menu-details[open]").forEach((details) => {
            if (!details.contains(e.target)) {
              details.removeAttribute("open");
            }
          });
        });

        // Close dropdown or sheet on Escape
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            document.querySelectorAll("details.user-menu-details[open]").forEach((d) => d.removeAttribute("open"));
            closeMoreSheet();
          }
        });
      })();
    </script>
