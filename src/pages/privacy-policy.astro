---
import { siteUrl } from "../lib/site-url";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SeoIntro from "../components/SeoIntro.astro";
import { breadcrumbJsonLd, getPageSeo } from "../lib/seo";

const PATH = "/privacy-policy";
const DEFAULT_TITLE = "Privacy Policy — CUET Free Mock Test";
const DEFAULT_DESCRIPTION =
  "What data this CUET mock test site collects, why it is needed, how long it is kept, and how to access or delete your account data.";

const seo = await getPageSeo(PATH);
const title = seo?.title || DEFAULT_TITLE;
const description = seo?.description || DEFAULT_DESCRIPTION;
const site = siteUrl(Astro.url);
const structuredData = [
  breadcrumbJsonLd(site, [
    { name: "Home", path: "/" },
    { name: "Privacy policy", path: PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: new URL(PATH, site).toString(),
    dateModified: "2026-11-17",
  },
];
---

<BaseLayout title={title} description={description} noindex={(seo?.noindex ?? 0) === 1} canonical={seo?.canonical_url} structuredData={structuredData}>
  <PageHero
    eyebrow="Privacy"
    title="Privacy policy"
    intro="This page explains what the site stores, why it stores it, and what you can ask us to change or delete. It also describes cookieless Cloudflare analytics, optional Google Analytics 4 that loads only after you allow it, and advertising that is not currently enabled."
    updated="17 November 2026"
  />

  <SeoIntro html={seo?.intro_html} />

  <article class="mx-auto max-w-3xl space-y-8 px-4 py-10 text-sm leading-7 text-neutral-600 sm:px-6 lg:py-14 dark:text-neutral-300">
    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">1. Who we are</h2>
      <p class="mt-2">
        CUET Free Mock Test is an independent practice website. References to "we", "us" and "the site" mean this project. References to "you" mean a visitor, guest candidate or registered user. The site is not affiliated with the National Testing Agency or any university.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">2. Data we collect</h2>
      <p class="mt-2">We collect only what the product needs to run:</p>
      <ul class="mt-2 list-disc space-y-2 pl-5">
        <li><strong class="text-neutral-900 dark:text-neutral-100">Account data:</strong> username, email address, and the Google account identifier and avatar URL returned when you sign in with Google. Sign-in is Google-only; we do not receive or store your Google password.</li>
        <li><strong class="text-neutral-900 dark:text-neutral-100">Attempt data:</strong> which paper you started, your selected options, marked-for-review state, per-question time, start and deadline timestamps, score, correct/wrong/skipped counts, and whether the attempt is your first for that paper.</li>
        <li><strong class="text-neutral-900 dark:text-neutral-100">Discussion data:</strong> comments, replies, votes, reports and moderation status. Comments are stored as plain text.</li>
        <li><strong class="text-neutral-900 dark:text-neutral-100">Share data:</strong> when you share a question or mock, we store an aggregate event with the shared question's public id or the mock id, the surface, the channel and, if you are signed in, your user id. We do not store an IP address, attempt id, score or recipient in this event.</li>
        <li><strong class="text-neutral-900 dark:text-neutral-100">Technical data:</strong> the IP address and request metadata processed by our hosting provider for security, rate limiting and abuse prevention. We do not build advertising profiles.</li>
        <li><strong class="text-neutral-900 dark:text-neutral-100">Optional analytics data:</strong> if you allow analytics, Google Analytics 4 receives the page you viewed, an approximate location derived from your IP address, device and browser information, and a random client identifier. It does not receive your name, email address, answers or scores.</li>
        <li><strong class="text-neutral-900 dark:text-neutral-100">Contact data:</strong> whatever you include when you email us about a correction, account or privacy request.</li>
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">3. Guests, cookies and local storage</h2>
      <p class="mt-2">
        You can take a mock test without creating an account. Guest attempts are linked to a random token in a cookie so the same browser can resume and later claim the attempt. We use a small number of essential cookies:
      </p>
      <div class="mt-3 overflow-x-auto rounded-xl border border-neutral-200 dark:border-neutral-800" role="region" aria-label="Cookies used by CUET Free Mock Test" tabindex="0">
        <table class="w-full min-w-[520px] text-left text-xs">
          <thead class="bg-neutral-50 uppercase tracking-wide text-neutral-500 dark:bg-neutral-900 dark:text-neutral-400">
            <tr>
              <th class="px-3 py-2">Name</th>
              <th class="px-3 py-2">Purpose</th>
              <th class="px-3 py-2">Lifetime</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
            <tr>
              <td class="px-3 py-2 font-mono">__Host-cuet_session</td>
              <td class="px-3 py-2">Keeps a registered user signed in. HttpOnly, Secure and SameSite protected.</td>
              <td class="px-3 py-2">30 days</td>
            </tr>
            <tr>
              <td class="px-3 py-2 font-mono">__Host-cuet_guest</td>
              <td class="px-3 py-2">Links a guest attempt to this browser so it can be resumed or claimed after signup.</td>
              <td class="px-3 py-2">Session or up to 30 days</td>
            </tr>
            <tr>
              <td class="px-3 py-2 font-mono">_ga</td>
              <td class="px-3 py-2">Distinguishes browsers for Google Analytics 4. Set only after you allow analytics.</td>
              <td class="px-3 py-2">Up to 2 years</td>
            </tr>
            <tr>
              <td class="px-3 py-2 font-mono">_ga_*</td>
              <td class="px-3 py-2">Keeps Google Analytics 4 session state for this site. Set only after you allow analytics.</td>
              <td class="px-3 py-2">Up to 2 years</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-2">
        The light/dark preference is stored in your browser's <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs dark:bg-neutral-800">localStorage</code>, not sent to the server. The <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs dark:bg-neutral-800">cuet_consent_v1</code> entry stores your analytics choice in this browser and is not sent to the server. Our hosting provider may set strictly necessary security cookies at the edge. Advertising is not currently enabled. If it is enabled later, Google may set advertising or measurement cookies as described in section 11; the active test screen never loads the advertising script.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">4. Why we use the data</h2>
      <ul class="mt-2 list-disc space-y-2 pl-5">
        <li>To create and secure your Google-linked account and sign you in.</li>
        <li>To run an attempt: hide answers before submit, autosave progress, enforce the deadline and calculate the score on the server.</li>
        <li>To show your dashboard, attempt history, solutions and site-relative rank.</li>
        <li>To operate discussions, moderation, reports and abuse controls.</li>
        <li>To measure aggregate usage if you allow analytics, so content and practice papers can be improved.</li>
        <li>To investigate errors, protect the service and comply with legal obligations.</li>
      </ul>
      <p class="mt-2">
        We do not sell personal data. We do not use your email to send marketing at launch. If an announcement or email feature is added, it will be described here before it is used.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">5. Legal bases</h2>
      <p class="mt-2">
        Where data-protection law requires a legal basis, we rely on the performance of the service you asked for (running an attempt or account), your consent (creating an account, posting a comment), our legitimate interest in keeping the service secure and preventing abuse, and compliance with legal obligations. For optional Google Analytics 4 we rely on your consent, which you can give, refuse or withdraw at any time. Refusing or withdrawing does not limit any practice feature; only optional analytics stops. You can withdraw consent for optional features without losing access to the core practice tools.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">6. Sharing and processors</h2>
      <p class="mt-2">
        The site runs on Cloudflare infrastructure. Cloudflare processes requests and stores the database and media objects on our behalf. If you choose Google sign-in, Google authenticates you and shares the basic profile data needed to create the account. If you allow analytics, Google processes Google Analytics 4 measurement data on our behalf as described in section 11. We do not share your email or attempt history with advertisers.
      </p>
      <p class="mt-2">
        We may disclose data if required by law, to respond to a valid legal request, or to protect the rights and safety of users. If the project is transferred, data may move to the successor entity under the same commitments.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">7. Retention</h2>
      <ul class="mt-2 list-disc space-y-2 pl-5">
        <li>Account records are kept while the account exists. A deletion request removes or anonymises the profile and associated identifiers, subject to the attempt-integrity note below.</li>
        <li>Attempts and scores may be retained in an anonymised or pseudonymised form because leaderboard and historical-paper integrity depend on them.</li>
        <li>Session tokens expire automatically. Signing out or deleting your account revokes the session.</li>
        <li>Technical logs are kept only as long as needed for security and troubleshooting.</li>
        <li>Google Analytics 4 event data is retained for up to 14 months, after which it is deleted or aggregated according to the configured retention setting.</li>
        <li>Your analytics choice stays in this browser until you change it or clear site data.</li>
        <li>Moderation records may be retained to enforce community rules and document decisions.</li>
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">8. Security</h2>
      <p class="mt-2">
        Sign-in is handled by Google, so we never receive or store your Google password. Session tokens are random, stored in HttpOnly cookies and kept as hashes in the database. Accounts created before the move to Google-only sign-in may still have an unused password hash from the retired email/password flow; it cannot be used to sign in and is removed when the account is deleted. Admin actions require an authorised account and are written to an audit log. No system is perfectly secure, so protect access to your Google account and tell us promptly if you suspect unauthorised access.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">9. Your choices and rights</h2>
      <p class="mt-2">
        Depending on where you live, you may have the right to access, correct, delete or restrict the processing of your personal data, to object to certain processing, or to receive a portable copy. To make a request, email
        {" "}<a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="mailto:privacy@cuetfreemocktest.com">privacy@cuetfreemocktest.com</a>
        {" "}from the address on your account. We may need to verify that the account belongs to you before acting. You can also complain to your local data-protection authority.
      </p>
      <p class="mt-2">
        To change or withdraw your analytics choice, use the <strong class="text-neutral-900 dark:text-neutral-100">Cookie settings</strong> control in the footer or the <strong class="text-neutral-900 dark:text-neutral-100">Manage cookie settings</strong> button in section 11. Withdrawing after analytics has loaded removes the Google Analytics cookies and reloads the page.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">10. Children</h2>
      <p class="mt-2">
        The site is intended for candidates preparing for undergraduate admissions and is not directed at children under 13. If you believe a child under 13 has created an account, contact us and we will review and delete the account.
      </p>
    </section>

    <section id="advertising-and-analytics" class="scroll-mt-24">
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">11. Advertising and analytics</h2>

      <h3 class="mt-4 text-base font-bold text-neutral-900 dark:text-neutral-100">Cloudflare Web Analytics</h3>
      <p class="mt-2">
        The site uses Cloudflare Web Analytics to count page views and measure performance. It is cookieless, does not fingerprint visitors and does not build cross-site profiles. It runs on every page, including private pages, and is not affected by the analytics choice below.
      </p>

      <h3 class="mt-4 text-base font-bold text-neutral-900 dark:text-neutral-100">Google Analytics 4 (optional)</h3>
      <p class="mt-2">
        If you choose <strong class="text-neutral-900 dark:text-neutral-100">Accept</strong>, the site loads Google Analytics 4 with measurement ID <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs dark:bg-neutral-800">G-Y1JPT7SNQJ</code>. Google receives the page you viewed, an approximate location derived from your IP address, device and browser information, and a random client identifier stored in the <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs dark:bg-neutral-800">_ga</code> and <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs dark:bg-neutral-800">_ga_*</code> cookies for up to 2 years. It does not receive your name, email address, answers or scores. Event data is retained for up to 14 months. Google processes this data on our behalf and may process it outside your state or country under its contractual safeguards.
      </p>
      <p class="mt-2">
        The legal basis is your consent. You can refuse or withdraw it at any time, and refusing keeps every feature available. Google Analytics 4 is never loaded on the active test screen, results, dashboard, admin, sign-in or search pages. Withdrawing after it has loaded clears the Google Analytics cookies and reloads the page. You can also install the
        <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="https://tools.google.com/dlpage/gaoptout" rel="noopener noreferrer" target="_blank">Google Analytics opt-out browser add-on</a>
        and read
        <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="https://policies.google.com/privacy" rel="noopener noreferrer" target="_blank">Google's privacy policy</a>.
      </p>

      <h3 class="mt-4 text-base font-bold text-neutral-900 dark:text-neutral-100">Advertising</h3>
      <p class="mt-2">
        Advertising is not currently enabled. If it is enabled later, Google AdSense may run only on selected public content pages and only after a Google-certified consent management platform is live. Google and its partners may then use cookies or similar identifiers to serve and measure ads, including personalised ads where consent and local law allow it. Analytics consent is not advertising consent. You can review Google's advertising controls at
        <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="https://myadcenter.google.com/" rel="noopener noreferrer" target="_blank">My Ad Center</a>.
      </p>
      <p class="mt-2">
        Ads are never placed on the active test screen, an in-progress result, a dashboard or any page with little publisher content. If Google Analytics is not configured, the site loads no Google Analytics script.
      </p>
      <button
        type="button"
        data-open-consent
        aria-controls="consent-banner"
        aria-expanded="false"
        hidden
        class="mt-4 cursor-pointer rounded-lg border border-neutral-300 px-3 py-2 text-sm font-semibold text-neutral-800 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-100 dark:hover:bg-neutral-800"
      >
        Manage cookie settings
      </button>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">12. International processing</h2>
      <p class="mt-2">
        Cloudflare and Google operate globally, so data may be processed outside your state or country. Where required, transfers rely on the providers' contractual safeguards. The practice content itself is served from Cloudflare's edge network.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">13. Changes to this policy</h2>
      <p class="mt-2">
        If the way we handle data changes, this page will be updated and the review date at the top will change. Material changes that affect your rights will be communicated on the site before they take effect.
      </p>
    </section>

    <section class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 dark:border-neutral-800 dark:bg-neutral-900">
      <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">14. Contact</h2>
      <p class="mt-2">
        Privacy questions and requests: <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="mailto:privacy@cuetfreemocktest.com">privacy@cuetfreemocktest.com</a>. General support: <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="mailto:support@cuetfreemocktest.com">support@cuetfreemocktest.com</a>. See also the <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/terms">terms</a> and <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/disclaimer">disclaimer</a>.
      </p>
    </section>
  </article>
</BaseLayout>
