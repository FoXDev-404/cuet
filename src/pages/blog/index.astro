---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { allOr } from "../../lib/db";
import { formatDate } from "../../lib/content";
import { getPageSeo, parseFaq } from "../../lib/seo";
import { estimateReadingMinutes } from "../../lib/blog";

const posts = await allOr<{
  id: number;
  slug: string;
  title: string;
  description: string;
  published_at: string | null;
  updated_at: string | null;
  body: string;
}>(
  `SELECT id, slug, title, description, published_at, updated_at, body
   FROM blog_posts
   WHERE status = 'published' AND published_at IS NOT NULL AND deleted_at IS NULL
     AND length(body) >= 400
   ORDER BY published_at DESC, id DESC
   LIMIT 60`, [],
);

const seo = await getPageSeo("/blog");
const title = seo?.title || "CUET UG Guides — Preparation, Strategy and Exam Literacy";
const description =
  seo?.description ||
  "Original CUET UG guides on preparation strategy, error review, timed practice and reading the official NTA bulletin. Written for practice, not copied from coaching material.";
const noindex = (seo?.noindex ?? 0) === 1 || posts.length === 0;
const faqs = parseFaq(seo?.faq_json);
---

<BaseLayout title={title} description={description} noindex={noindex} canonical={seo?.canonical_url}>
  <PageHero
    eyebrow="Guides"
    title="CUET UG guides that change what you do next"
    intro="Long-form, original guides on preparation strategy and exam literacy. Every guide is written for this site and avoids invented dates, weightage charts or copied material."
  />

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    {seo?.intro_html ? (
      <div class="mb-8 rounded-2xl border border-brand-200 bg-brand-50 p-5 text-sm leading-7 text-brand-900 dark:border-brand-800 dark:bg-brand-950/40 dark:text-brand-100">
        {seo.intro_html}
      </div>
    ) : null}

    {posts.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-neutral-300 p-10 text-center dark:border-neutral-700">
        <h1 class="text-xl font-black tracking-tight">Guides are being edited</h1>
        <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-neutral-500 dark:text-neutral-400">
          No guide is published yet. Rather than filling the blog with thin posts, this page stays out of search until an editor publishes a complete article.
        </p>
        <div class="mt-4 flex flex-wrap justify-center gap-2">
          <a class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" href="/cuet-ug-mock-test">Browse mock tests</a>
          <a class="rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-900" href="/cuet-ug-syllabus">Read the syllabus guide</a>
        </div>
      </div>
    ) : (
      <div class="grid gap-4 md:grid-cols-2">
        {posts.map((post) => (
          <article class="flex flex-col rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-300">
              {formatDate(post.published_at)} · {estimateReadingMinutes(post.body)} min read
            </p>
            <h2 class="mt-2 text-xl font-bold leading-snug">
              <a class="hover:text-brand-700 dark:hover:text-brand-300" href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>
            <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{post.description}</p>
            <a class="mt-auto pt-4 text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" href={`/blog/${post.slug}`}>Read the guide →</a>
          </article>
        ))}
      </div>
    )}

    {faqs.length > 0 ? (
      <section class="mt-10 space-y-4">
        {faqs.map((faq) => (
          <details class="rounded-2xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
            <summary class="cursor-pointer font-bold">{faq.question}</summary>
            <p class="mt-2 text-sm leading-7 text-neutral-600 dark:text-neutral-400">{faq.answer}</p>
          </details>
        ))}
      </section>
    ) : null}
  </div>
</BaseLayout>
