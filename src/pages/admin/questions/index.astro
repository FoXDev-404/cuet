---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { all, first } from "../../../lib/db";
import { formatDateTime, renderRichText } from "../../../lib/content";
import { can } from "../../../lib/auth/admin";

const admin = Astro.locals.admin!;
const canPublish = can(admin.role, "questions.publish");

const subjects = await all<{ id: number; name: string }>(
  "SELECT id, name FROM subjects WHERE is_active = 1 ORDER BY name",
);
const years = await all<{ year: number }>(
  `SELECT DISTINCT year FROM questions
   WHERE deleted_at IS NULL AND year IS NOT NULL
   ORDER BY year DESC`,
);
const requestedStatus = Astro.url.searchParams.get("status") ?? "";
const allowedStatuses = ["draft", "in_review", "published"];
const status = allowedStatuses.includes(requestedStatus) ? requestedStatus : "";
const subjectId = Number(Astro.url.searchParams.get("subject") ?? "0");
const requestedYear = Number(Astro.url.searchParams.get("year") ?? "0");
const year =
  Number.isInteger(requestedYear) && requestedYear >= 2000 && requestedYear <= 2100
    ? requestedYear
    : 0;
const search = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 100);
const page = Math.max(Number(Astro.url.searchParams.get("page") ?? 1) || 1, 1);
const per = Math.min(Math.max(Number(Astro.url.searchParams.get("per") ?? 25) || 25, 10), 100);

const where = ["q.deleted_at IS NULL"];
const params: (string | number)[] = [];
if (status) {
  where.push("q.status = ?");
  params.push(status);
}
if (Number.isInteger(subjectId) && subjectId > 0) {
  where.push("q.subject_id = ?");
  params.push(subjectId);
}
if (year > 0) {
  where.push("q.year = ?");
  params.push(year);
}
if (search) {
  where.push("q.text LIKE ?");
  params.push(`%${search}%`);
}
const whereSql = where.join(" AND ");

const [totalRow, questions] = await Promise.all([
  first<{ count: number }>(`SELECT COUNT(*) AS count FROM questions q WHERE ${whereSql}`, ...params),
  all<{
    id: number;
    text: string;
    status: string;
    difficulty: string | null;
    year: number | null;
    updated_at: string | null;
    created_at: string;
    subject_name: string;
  }>(
    `SELECT q.id, q.text, q.status, q.difficulty, q.year, q.updated_at, q.created_at, s.name AS subject_name
     FROM questions q JOIN subjects s ON s.id = q.subject_id
     WHERE ${whereSql}
     ORDER BY q.id DESC LIMIT ? OFFSET ?`,
    ...params,
    per,
    (page - 1) * per,
  ),
]);

const total = totalRow?.count ?? 0;
const totalPages = Math.max(Math.ceil(total / per), 1);

const statusClass: Record<string, string> = {
  draft: "bg-neutral-100 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300",
  in_review: "bg-amber-100 text-amber-900 dark:bg-amber-950/50 dark:text-amber-200",
  published: "bg-brand-100 text-brand-900 dark:bg-brand-900/50 dark:text-brand-200",
};

const exportParams = new URLSearchParams();
if (status) exportParams.set("status", status);
if (subjectId > 0) exportParams.set("subject", String(subjectId));
if (year > 0) exportParams.set("year", String(year));
if (search) exportParams.set("q", search);
const exportQuery = exportParams.toString() ? `&${exportParams.toString()}` : "";

function pageHref(target: number): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.set("page", String(target));
  next.set("per", String(per));
  return `?${next.toString()}`;
}
---

<AdminLayout title="Questions" active="questions">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Question bank</h1>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
        {total.toLocaleString()} matching question{total === 1 ? "" : "s"} · original content with KaTeX, images and explanations.
        Published edits create a frozen superseding version; Super Admins can hotfix live rows with a written reason.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/api/admin/questions/export?format=csv${exportQuery}`} download>Export CSV</a>
      <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/api/admin/questions/export?format=json${exportQuery}`} download>Export JSON</a>
      <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href="/admin/questions/import">Bulk import</a>
      <a class="rounded-lg bg-brand-600 px-3 py-2 text-sm font-bold text-white hover:bg-brand-700" href="/admin/questions/new">New question</a>
    </div>
  </div>

  <form method="get" class="mt-6 grid gap-3 rounded-2xl border border-neutral-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-[1fr_150px_130px_150px_110px_auto] dark:border-neutral-800 dark:bg-neutral-900">
    <input class="h-10 rounded-lg border border-neutral-300 bg-white px-3 text-sm dark:border-neutral-700 dark:bg-neutral-950" type="search" name="q" value={search} placeholder="Search question text…" />
    <select class="h-10 rounded-lg border border-neutral-300 bg-white px-3 text-sm dark:border-neutral-700 dark:bg-neutral-950" name="subject" aria-label="Filter by subject">
      <option value="">All subjects</option>
      {subjects.map((subject) => (<option value={subject.id} selected={subject.id === subjectId}>{subject.name}</option>))}
    </select>
    <select class="h-10 rounded-lg border border-neutral-300 bg-white px-3 text-sm dark:border-neutral-700 dark:bg-neutral-950" name="year" aria-label="Filter by year">
      <option value="">All years</option>
      {years.map((item) => (<option value={item.year} selected={item.year === year}>{item.year}</option>))}
    </select>
    <select class="h-10 rounded-lg border border-neutral-300 bg-white px-3 text-sm dark:border-neutral-700 dark:bg-neutral-950" name="status" aria-label="Filter by status">
      <option value="">All statuses</option>
      {allowedStatuses.map((item) => (<option value={item} selected={item === status}>{item.replace("_", " ")}</option>))}
    </select>
    <select class="h-10 rounded-lg border border-neutral-300 bg-white px-3 text-sm dark:border-neutral-700 dark:bg-neutral-950" name="per" aria-label="Rows per page">
      {[25, 50, 100].map((value) => (<option value={value} selected={value === per}>{value} rows</option>))}
    </select>
    <button class="h-10 rounded-lg bg-neutral-900 px-4 text-sm font-bold text-white dark:bg-white dark:text-neutral-900" type="submit">Filter</button>
  </form>

  <p id="list-error" class="mt-4 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/50 dark:text-red-200"></p>
  <p id="list-success" class="mt-4 hidden rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-200"></p>

  <div id="bulk-toolbar" class="mt-4 hidden flex-wrap items-center gap-2 rounded-xl border border-brand-200 bg-brand-50 p-3 text-sm dark:border-brand-900 dark:bg-brand-950/30">
    <span class="font-semibold"><span id="bulk-count">0</span> selected</span>
    <select id="bulk-action" class="h-9 rounded-lg border border-neutral-300 bg-white px-2 text-xs dark:border-neutral-700 dark:bg-neutral-950" aria-label="Bulk action">
      <option value="">Choose action…</option>
      <option value="status:published">Publish</option>
      <option value="status:in_review">Mark in review</option>
      <option value="status:draft">Move to draft</option>
      <option value="difficulty:easy">Set easy</option>
      <option value="difficulty:medium">Set medium</option>
      <option value="difficulty:hard">Set hard</option>
      {canPublish ? (
        <optgroup label="Sharing">
          <option value="share_enabled:1">Enable sharing</option>
          <option value="share_enabled:0">Disable sharing</option>
          <option value="reveal_policy:attempted_only">Reveal to attempted users only</option>
          <option value="reveal_policy:public">Reveal to everyone (practice-only)</option>
          <option value="rights_ok:1">Mark rights confirmed</option>
          <option value="rights_ok:0">Mark rights not confirmed</option>
          <option value="seo_indexable:1">Allow search indexing</option>
          <option value="seo_indexable:0">Block search indexing</option>
        </optgroup>
      ) : null}
      <option value="delete">Soft delete</option>
    </select>
    <button id="bulk-apply" class="h-9 rounded-lg bg-brand-600 px-3 text-xs font-bold text-white hover:bg-brand-700" type="button">Apply</button>
    <button id="bulk-clear" class="h-9 rounded-lg border border-neutral-300 px-3 text-xs font-semibold dark:border-neutral-700" type="button">Clear</button>
    <span class="text-xs text-neutral-600 dark:text-neutral-300">Bulk writes are audited once with all affected ids.</span>
  </div>

  <div class="mt-4 overflow-hidden rounded-2xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[900px] text-left text-sm">
        <thead class="border-b border-neutral-200 bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-400">
          <tr>
            <th class="w-10 px-3 py-3"><input id="select-all" type="checkbox" aria-label="Select all questions on this page" /></th>
            <th class="px-3 py-3">Question</th>
            <th class="px-3 py-3">Subject</th>
            <th class="px-3 py-3">Status</th>
            <th class="px-3 py-3">Difficulty</th>
            <th class="px-3 py-3">Updated</th>
            <th class="px-3 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
          {questions.map((question) => (
            <tr data-question-row>
              <td class="px-3 py-3 align-top"><input type="checkbox" data-select-question={question.id} aria-label={`Select question ${question.id}`} /></td>
              <td class="max-w-md px-3 py-3">
                <a class="font-medium hover:text-brand-700 dark:hover:text-brand-300" href={`/admin/questions/${question.id}`}>
                  <span class="line-clamp-2" set:html={renderRichText(question.text)}></span>
                </a>
                <span class="mt-1 block text-xs text-neutral-500 dark:text-neutral-400">#{question.id}{question.year ? ` · PYQ ${question.year}` : ""}</span>
              </td>
              <td class="px-3 py-3">{question.subject_name}</td>
              <td class="px-3 py-3"><span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${statusClass[question.status] ?? ""}`}>{question.status.replace("_", " ")}</span></td>
              <td class="px-3 py-3 capitalize">{question.difficulty ?? "—"}</td>
              <td class="px-3 py-3 text-xs text-neutral-500 dark:text-neutral-400">{formatDateTime(question.updated_at ?? question.created_at)}</td>
              <td class="whitespace-nowrap px-3 py-3 text-right">
                <a class="rounded-lg border border-neutral-300 px-2 py-1 text-xs font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/admin/questions/${question.id}`}>Edit</a>
                <a class="ml-1 rounded-lg border border-neutral-300 px-2 py-1 text-xs font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/admin/questions/${question.id}/preview`}>Preview</a>
                <button class="ml-1 rounded-lg border border-neutral-300 px-2 py-1 text-xs font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" type="button" data-duplicate-question={question.id}>Duplicate</button>
                <a class="ml-1 rounded-lg border border-neutral-300 px-2 py-1 text-xs font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={`/admin/questions/${question.id}#history`}>History</a>
                <button class="ml-1 rounded-lg border border-red-200 px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950/40" type="button" data-delete-question={question.id}>Delete</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {questions.length === 0 ? (
      <div class="px-4 py-12 text-center text-sm text-neutral-500 dark:text-neutral-400">
        No questions match these filters. <a class="font-semibold text-brand-700 hover:underline dark:text-brand-300" href="/admin/questions/new">Create the first one</a>.
      </div>
    ) : null}
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
    <p class="text-xs text-neutral-500 dark:text-neutral-400">Page {page} of {totalPages} · {questions.length} shown of {total.toLocaleString()}</p>
    <div class="flex gap-2">
      {page > 1 ? <a class="rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={pageHref(page - 1)}>Previous</a> : null}
      {page < totalPages ? <a class="rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={pageHref(page + 1)}>Next</a> : null}
    </div>
  </div>

  <script>
    const errorBox = document.getElementById("list-error") as HTMLElement;
    const successBox = document.getElementById("list-success") as HTMLElement;
    const toolbar = document.getElementById("bulk-toolbar") as HTMLElement;
    const countLabel = document.getElementById("bulk-count") as HTMLElement;
    const selectAll = document.getElementById("select-all") as HTMLInputElement;

    function checkboxes(): HTMLInputElement[] {
      return [...document.querySelectorAll<HTMLInputElement>("[data-select-question]")];
    }

    function selectedIds(): string[] {
      return checkboxes().filter((box) => box.checked).map((box) => box.dataset.selectQuestion!);
    }

    function refreshToolbar() {
      const ids = selectedIds();
      countLabel.textContent = String(ids.length);
      toolbar.classList.toggle("hidden", ids.length === 0);
      toolbar.classList.toggle("flex", ids.length > 0);
      if (selectAll) {
        selectAll.checked = ids.length > 0 && ids.length === checkboxes().length;
        selectAll.indeterminate = ids.length > 0 && ids.length < checkboxes().length;
      }
    }

    function message(box: HTMLElement, text: string) {
      box.textContent = text;
      box.classList.remove("hidden");
    }

    document.querySelectorAll<HTMLInputElement>("[data-select-question]").forEach((box) => {
      box.addEventListener("change", refreshToolbar);
    });
    selectAll?.addEventListener("change", () => {
      checkboxes().forEach((box) => { box.checked = selectAll.checked; });
      refreshToolbar();
    });
    document.getElementById("bulk-clear")?.addEventListener("click", () => {
      checkboxes().forEach((box) => { box.checked = false; });
      refreshToolbar();
    });

    document.getElementById("bulk-apply")?.addEventListener("click", async () => {
      const ids = selectedIds();
      if (ids.length === 0) return;
      const value = (document.getElementById("bulk-action") as unknown as HTMLSelectElement).value;
      if (!value) {
        message(errorBox, "Choose a bulk action first.");
        return;
      }
      if (value === "delete" && !confirm(`Soft-delete ${ids.length} question(s)? They move to Trash and can be restored.`)) return;
      if (value.startsWith("status:published") && !confirm(`Publish ${ids.length} question(s)? Each must already have four options and an explanation.`)) return;
      if (value === "seo_indexable:1" && !confirm(`Allow search indexing for ${ids.length} question(s)? Questions that do not meet every condition will be skipped.`)) return;

      const payload = value === "delete"
        ? { action: "delete", ids }
        : { action: value.split(":")[0], value: value.split(":")[1], ids };
      const response = await fetch("/api/admin/questions/bulk", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = (await response.json()) as {
        error?: string;
        changes?: number;
        skipped?: Array<{ id: number; error: string }>;
      };
      if (!response.ok) {
        message(errorBox, result.error || "Bulk action failed.");
        return;
      }
      const skipped = result.skipped?.length ?? 0;
      if (skipped > 0) {
        message(
          successBox,
          `${result.changes ?? 0} question(s) updated; ${skipped} skipped. ${result.skipped?.[0]?.error ?? ""} Reloading…`,
        );
      } else {
        message(successBox, `${result.changes ?? 0} question(s) updated. Reloading…`);
      }
      setTimeout(() => location.reload(), 900);
    });

    document.querySelectorAll<HTMLElement>("[data-duplicate-question]").forEach((button) => {
      button.addEventListener("click", async () => {
        const id = button.dataset.duplicateQuestion;
        const response = await fetch(`/api/admin/questions/${id}/duplicate`, { method: "POST" });
        const result = (await response.json()) as { error?: string; redirect?: string };
        if (!response.ok) {
          message(errorBox, result.error || "Duplicate failed.");
          return;
        }
        location.href = result.redirect || "/admin/questions";
      });
    });

    document.querySelectorAll<HTMLElement>("[data-delete-question]").forEach((button) => {
      button.addEventListener("click", async () => {
        const id = button.dataset.deleteQuestion;
        if (!id || !confirm(`Soft-delete question #${id}? Past attempts keep their copy, and Trash can restore it.`)) return;
        const response = await fetch(`/api/admin/questions/${id}`, { method: "DELETE" });
        const result = (await response.json()) as { error?: string };
        if (!response.ok) {
          message(errorBox, result.error || "Delete failed.");
          return;
        }
        button.closest("tr")?.remove();
        if (selectedIds().length === 0) toolbar.classList.add("hidden");
      });
    });
  </script>
</AdminLayout>
