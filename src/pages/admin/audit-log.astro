---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { all } from "../../lib/db";
import { can } from "../../lib/auth/admin";
import { formatDateTime } from "../../lib/content";

const admin = Astro.locals.admin!;
if (!can(admin.role, "audit.view")) {
  return Astro.redirect("/forbidden", 303);
}

const entries = await all<{
  id: number;
  action: string;
  entity_type: string;
  entity_id: number | null;
  diff_json: string | null;
  created_at: string;
  email: string;
  role: string;
}>(
  `SELECT l.id, l.action, l.entity_type, l.entity_id, l.diff_json, l.created_at,
          a.email, a.role
   FROM audit_log l JOIN admins a ON a.id = l.admin_id
   ORDER BY l.id DESC LIMIT 200`,
);
---

<AdminLayout title="Audit log" active="audit">
  <div>
    <h1 class="text-2xl font-black tracking-tight">Audit log</h1>
    <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">Every admin write, newest first. This view is restricted to super admins.</p>
  </div>

  <div class="mt-6 overflow-hidden rounded-2xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
    <div class="overflow-x-auto" role="region" aria-label="Admin audit log" tabindex="0">
      <table class="w-full min-w-[820px] text-left text-sm">
        <thead class="border-b border-neutral-200 bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-400">
          <tr>
            <th class="px-4 py-3">When</th>
            <th class="px-4 py-3">Actor</th>
            <th class="px-4 py-3">Action</th>
            <th class="px-4 py-3">Entity</th>
            <th class="px-4 py-3">Diff</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
          {entries.map((entry) => (
            <tr class="align-top">
              <td class="whitespace-nowrap px-4 py-3 text-xs text-neutral-500 dark:text-neutral-400">{formatDateTime(entry.created_at)}</td>
              <td class="px-4 py-3"><span class="block">{entry.email}</span><span class="text-xs uppercase text-neutral-500 dark:text-neutral-400">{entry.role}</span></td>
              <td class="px-4 py-3 font-medium">{entry.action}</td>
              <td class="px-4 py-3">{entry.entity_type}<span class="block text-xs text-neutral-500 dark:text-neutral-400">#{entry.entity_id ?? "—"}</span></td>
              <td class="max-w-md px-4 py-3"><code class="line-clamp-3 break-all text-xs text-neutral-500 dark:text-neutral-400">{entry.diff_json ?? "—"}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {entries.length === 0 ? <p class="px-4 py-12 text-center text-sm text-neutral-500 dark:text-neutral-400">No admin writes yet.</p> : null}
  </div>
  <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">Showing the latest 200 entries.</p>
</AdminLayout>
