---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { all } from "../../lib/db";
import { can } from "../../lib/auth/admin";
import {
  SEO_PATHS,
  getPageSeo,
  parseFaq,
} from "../../lib/seo";
import { formatDateTime } from "../../lib/content";

const admin = Astro.locals.admin!;
if (!can(admin.role, "seo.write")) return Astro.redirect("/forbidden", 303);

const rows = await all<{
  path: string;
  title: string | null;
  description: string | null;
  canonical_url: string | null;
  noindex: number;
  updated_at: string | null;
}>("SELECT path, title, description, canonical_url, noindex, updated_at FROM page_seo ORDER BY path");
const rowByPath = new Map(rows.map((row) => [row.path, row]));

const requested = Astro.url.searchParams.get("path") ?? SEO_PATHS[0];
const selectedPath = (SEO_PATHS as readonly string[]).includes(requested) ? requested : SEO_PATHS[0];
const record = await getPageSeo(selectedPath);
const faqs = parseFaq(record?.faq_json);
const faqText = faqs.length > 0 ? JSON.stringify(faqs, null, 2) : "";

const coveredPaths = new Set(rows.map((row) => row.path));
---

<AdminLayout title="SEO editor" active="seo">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">SEO editor</h1>
      <p class="mt-1 max-w-3xl text-sm text-neutral-600 dark:text-neutral-400">
        Override the title, meta description, canonical URL, intro block and FAQ for a public page. Empty fields fall back to the page's built-in defaults.
      </p>
    </div>
    <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href="/sitemap.xml" target="_blank" rel="noopener">View sitemap</a>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[300px_1fr]">
    <section class="rounded-2xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
      <h2 class="border-b border-neutral-200 px-4 py-3 text-sm font-bold dark:border-neutral-800">Pages</h2>
      <ul class="max-h-[32rem] divide-y divide-neutral-100 overflow-y-auto dark:divide-neutral-800">
        {SEO_PATHS.map((path) => {
          const row = rowByPath.get(path);
          return (
            <li>
              <a
                href={`/admin/seo?path=${encodeURIComponent(path)}`}
                class:list={[
                  "flex items-center justify-between gap-3 px-4 py-2.5 text-sm",
                  selectedPath === path
                    ? "bg-brand-50 font-semibold text-brand-900 dark:bg-brand-950/40 dark:text-brand-200"
                    : "hover:bg-neutral-50 dark:hover:bg-neutral-950",
                ]}
              >
                <span class="truncate font-mono text-xs">{path}</span>
                <span class:list={[
                  "shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide",
                  row?.noindex
                    ? "bg-red-100 text-red-800 dark:bg-red-950/50 dark:text-red-200"
                    : row
                      ? "bg-brand-100 text-brand-800 dark:bg-brand-900/50 dark:text-brand-200"
                      : "bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400",
                ]}>
                  {row?.noindex ? "noindex" : row ? "set" : "default"}
                </span>
              </a>
            </li>
          );
        })}
        {rows.filter((row) => !coveredPaths.has(row.path)).length > 0 ? (
          <li class="px-4 py-2.5 text-[11px] text-neutral-500 dark:text-neutral-400">
            {rows.filter((row) => !coveredPaths.has(row.path)).length} record(s) exist for pages not listed above.
          </li>
        ) : null}
      </ul>
    </section>

    <section class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Editing</p>
          <h2 class="font-mono text-sm font-bold">{selectedPath}</h2>
        </div>
        {record?.updated_at ? (
          <p class="text-xs text-neutral-500 dark:text-neutral-400">Updated {formatDateTime(record.updated_at)}</p>
        ) : (
          <p class="text-xs text-neutral-500 dark:text-neutral-400">Using built-in defaults</p>
        )}
      </div>

      <form id="seo-form" class="mt-5 space-y-4" data-path={selectedPath}>
        <div>
          <label class="block text-sm font-semibold" for="seo-title">Title tag</label>
          <input class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-950" id="seo-title" name="title" maxlength="120" value={record?.title ?? ""} placeholder="Leave empty for the page default" />
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Aim for 50–60 characters. Maximum 120.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold" for="seo-description">Meta description</label>
          <textarea class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-950" id="seo-description" name="description" rows="3" maxlength="300" placeholder="Leave empty for the page default">{record?.description ?? ""}</textarea>
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Aim for 140–160 characters. Maximum 300.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold" for="seo-canonical">Canonical URL</label>
          <input class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-950" id="seo-canonical" name="canonical_url" type="url" maxlength="500" value={record?.canonical_url ?? ""} placeholder={`https://example.com${selectedPath === "/" ? "" : selectedPath}`} />
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Optional absolute http(s) URL. Leave empty for the automatic self-referencing canonical.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold" for="seo-intro">Intro text</label>
          <textarea class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-950" id="seo-intro" name="intro_html" rows="5" placeholder="Optional. Rendered above the page content; KaTeX works, raw HTML is escaped.">{record?.intro_html ?? ""}</textarea>
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Optional editor note rendered near the top of the page. Line breaks are preserved and KaTeX is supported; HTML is escaped for safety.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold" for="seo-faq">FAQ JSON</label>
          <textarea class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-950" id="seo-faq" name="faq_json" rows="8" spellcheck="false" placeholder={'[{"question":"...","answer":"..."}]'}>{faqText}</textarea>
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Array of objects with <code>question</code> and <code>answer</code>. Empty means use the page defaults.</p>
        </div>

        <label class="flex items-start gap-3 rounded-lg border border-neutral-200 p-3 text-sm dark:border-neutral-800">
          <input class="mt-1" id="seo-noindex" name="noindex" type="checkbox" checked={Boolean(record?.noindex)} />
          <span>
            <span class="font-semibold">Exclude from search engines</span>
            <span class="mt-0.5 block text-xs text-neutral-500 dark:text-neutral-400">Adds <code>noindex</code> and removes the page from the sitemap where supported. Use for thin or draft pages.</span>
          </span>
        </label>

        <p id="seo-message" class="hidden rounded-lg px-3 py-2 text-sm" role="status"></p>

        <div class="flex flex-wrap gap-2">
          <button class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60" type="submit">Save SEO record</button>
          <a class="rounded-lg border border-neutral-300 px-4 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href={selectedPath} target="_blank" rel="noopener">Preview page</a>
        </div>
      </form>
    </section>
  </div>

  <section class="mt-6 overflow-hidden rounded-2xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
    <h2 class="border-b border-neutral-200 px-4 py-3 text-sm font-bold dark:border-neutral-800">Saved records</h2>
    {rows.length === 0 ? (
      <p class="px-4 py-6 text-sm text-neutral-500 dark:text-neutral-400">No overrides saved yet. Every page is using its built-in SEO defaults.</p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead class="border-b border-neutral-200 bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-400">
            <tr>
              <th class="px-4 py-3">Path</th>
              <th class="px-4 py-3">Title</th>
              <th class="px-4 py-3">Canonical</th>
              <th class="px-4 py-3">Indexing</th>
              <th class="px-4 py-3">Updated</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
            {rows.map((row) => (
              <tr>
                <td class="px-4 py-3 font-mono text-xs">{row.path}</td>
                <td class="max-w-[24rem] truncate px-4 py-3 text-neutral-600 dark:text-neutral-300">{row.title || <span class="italic text-neutral-600 dark:text-neutral-400">default</span>}</td>
                <td class="max-w-[20rem] truncate px-4 py-3 font-mono text-[11px] text-neutral-600 dark:text-neutral-300">{row.canonical_url || <span class="italic text-neutral-600 dark:text-neutral-400">self</span>}</td>
                <td class="px-4 py-3">
                  <span class:list={[
                    "rounded-full px-2 py-0.5 text-[11px] font-bold uppercase",
                    row.noindex
                      ? "bg-red-100 text-red-800 dark:bg-red-950/50 dark:text-red-200"
                      : "bg-brand-100 text-brand-800 dark:bg-brand-900/50 dark:text-brand-200",
                  ]}>
                    {row.noindex ? "noindex" : "index"}
                  </span>
                </td>
                <td class="px-4 py-3 text-xs text-neutral-500 dark:text-neutral-400">{row.updated_at ? formatDateTime(row.updated_at) : "—"}</td>
                <td class="px-4 py-3 text-right">
                  <a class="text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" href={`/admin/seo?path=${encodeURIComponent(row.path)}`}>Edit</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <script is:inline>
    const form = document.getElementById("seo-form");
    const message = document.getElementById("seo-message");

    function show(text, ok) {
      message.textContent = text;
      message.className = `rounded-lg px-3 py-2 text-sm ${ok ? "bg-brand-50 text-brand-900 dark:bg-brand-950/50 dark:text-brand-200" : "bg-red-50 text-red-800 dark:bg-red-950/50 dark:text-red-200"}`;
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      message.className = "hidden";
      try {
        const data = new FormData(form);
        const response = await fetch("/api/admin/seo", {
          method: "PUT",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            path: form.dataset.path,
            title: String(data.get("title") || "").trim(),
            description: String(data.get("description") || "").trim(),
            intro_html: String(data.get("intro_html") || "").trim(),
            faq_json: String(data.get("faq_json") || "").trim(),
            canonical_url: String(data.get("canonical_url") || "").trim(),
            noindex: data.get("noindex") === "on",
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || "Could not save the SEO record.");
        show("Saved. Public pages pick this up on the next request.", true);
      } catch (error) {
        show(error instanceof Error ? error.message : "Could not save the SEO record.", false);
      } finally {
        button.disabled = false;
      }
    });
  </script>
</AdminLayout>
