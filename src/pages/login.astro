---
import BaseLayout from "../layouts/BaseLayout.astro";
import { safeNext } from "../lib/http";
import { isGoogleConfigured } from "../lib/auth/oauth";
import { getLocalPapers } from "../lib/local-papers";

const next = safeNext(Astro.url.searchParams.get("next"), "/dashboard");
if (Astro.locals.user) return Astro.redirect(next, 303);
const googleReady = isGoogleConfigured();

const papers = getLocalPapers();
const paperCount = papers.length.toLocaleString("en-IN");
const questionCount = papers
  .reduce((total, paper) => total + paper.totalQuestions, 0)
  .toLocaleString("en-IN");

const errorCode = Astro.url.searchParams.get("error") ?? "";
const errorMessages: Record<string, string> = {
  google_not_configured: "Google login is not configured yet. Please try again later.",
  google_cancelled: "Google login was cancelled.",
  google_state: "The Google login session expired. Please try again.",
  google_token: "Google login could not be completed. Please try again.",
  google_profile: "Google did not share a verified profile.",
  google_email_unverified: "Your Google email is not verified.",
  google_database:
    "Sign-in is temporarily unavailable — the site has hit a temporary database limit. Please try again in a few minutes (limits reset nightly).",
  account_disabled: "This account is disabled.",
};
const message = errorCode in errorMessages ? errorMessages[errorCode] : "";

// Illustrative dashboard values: shown only as a preview of what an account
// unlocks. Real numbers come from the signed-in dashboard after an attempt.
const previewStats = [
  { label: "Rank", value: "#1,284" },
  { label: "Accuracy", value: "74%" },
  { label: "Streak", value: "6 days" },
];

const previewSubjects = [
  { name: "Chemistry", score: 82 },
  { name: "Physics", score: 71 },
  { name: "Biology", score: 68 },
  { name: "General Test", score: 77 },
];
---

<BaseLayout title="Log in — CUET Free Mock Test" noindex>
  <section class="hero-grid relative overflow-hidden">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-6 sm:px-6 sm:py-10 lg:grid-cols-[1.08fr_0.92fr] lg:gap-x-14 lg:gap-y-8 lg:py-16"
    >
      <!-- Brand pitch -->
      <section class="lg:col-start-1 lg:row-start-1" aria-labelledby="login-heading">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface-2)] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--ink-2)]"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500" aria-hidden="true"></span>
          CUET UG 2026 · 100% free
        </p>
        <h1
          id="login-heading"
          class="mt-6 max-w-2xl text-[2rem] font-black leading-[1.03] tracking-[-0.04em] text-[var(--ink)] sm:text-5xl"
        >
          One sign-in.<br />
          <span class="text-[var(--primary)]">Every attempt counted.</span>
        </h1>
        <p class="mt-4 max-w-xl text-sm leading-6 text-[var(--muted)] sm:text-base sm:leading-7">
          Sign in with Google to keep your scores, timings and solutions in one place — then see
          exactly which subjects are holding your rank back.
        </p>
      </section>

      <!-- Sign-in card (appears directly after the headline on mobile) -->
      <section
        class="relative self-start rounded-3xl border border-[var(--border)] bg-[var(--surface-2)] p-6 shadow-xl shadow-neutral-900/5 sm:p-8 lg:col-start-2 lg:row-span-2 lg:row-start-1"
        aria-labelledby="login-card-heading"
      >
        <span
          class="pointer-events-none absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-brand-400 to-transparent"
          aria-hidden="true"
        ></span>

        <span
          class="grid h-11 w-11 place-items-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300"
          aria-hidden="true"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <path d="m10 17 5-5-5-5"></path>
            <path d="M15 12H3"></path>
          </svg>
        </span>

        <h2
          id="login-card-heading"
          class="mt-5 text-2xl font-black tracking-tight text-[var(--ink)]"
        >
          Sign in
        </h2>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
          Save every attempt, track weak subjects and see your rank. New here? Your account is
          created automatically on your first sign-in.
        </p>

        {
          message ? (
            <div
              class="mt-5 flex gap-2.5 rounded-xl border border-[var(--danger-border)] bg-[var(--danger-bg)] px-3.5 py-3 text-sm leading-5 text-[var(--danger-ink)]"
              role="alert"
            >
              <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 8v4"></path>
                <path d="M12 16h.01"></path>
              </svg>
              <p>{message}</p>
            </div>
          ) : null
        }

        {
          googleReady ? (
            <>
              <a
                href={`/api/auth/google?next=${encodeURIComponent(next)}`}
                class="mt-6 flex w-full items-center justify-center gap-3 rounded-xl border border-neutral-200 bg-white px-4 py-3.5 text-[15px] font-bold text-neutral-800 shadow-sm transition-colors hover:border-neutral-300 hover:bg-neutral-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--focus)] dark:border-white/15 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-100"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.23 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.11a6.6 6.6 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.2 1.64l3.15-3.15A11 11 0 0 0 2.18 7.05l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z"/></svg>
                Continue with Google
              </a>
              <p class="mt-3 flex items-center justify-center gap-1.5 text-center text-xs text-[var(--muted)]">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                No password stored — Google handles authentication.
              </p>
            </>
          ) : (
            <p class="mt-6 rounded-xl border border-[var(--warning-border)] bg-[var(--warning-bg)] px-3.5 py-3 text-sm leading-6 text-[var(--warning-ink)]">
              Google login is not configured on this deployment yet. Ask the site owner to set the
              Google OAuth credentials (GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET).
            </p>
          )
        }

        <div class="mt-6 border-t border-[var(--border)] pt-5">
          <a
            href="/mock-tests"
            class="flex w-full items-center justify-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-sm font-bold text-[var(--ink)] transition-colors hover:border-brand-300 hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--focus)] dark:hover:border-brand-500/40"
          >
            Continue as guest
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
          <p class="mt-2.5 text-center text-xs leading-5 text-[var(--muted)]">
            No account needed — guest attempts still work.
          </p>
        </div>

        <p class="mt-5 text-[11px] leading-5 text-[var(--muted)]">
          By continuing you agree to our{" "}
          <a class="font-semibold text-[var(--primary)] hover:underline" href="/terms">Terms</a> and{" "}
          <a class="font-semibold text-[var(--primary)] hover:underline" href="/privacy-policy">
            Privacy Policy
          </a>. Only your name, verified email and profile picture are used.
        </p>
      </section>

      <!-- Dashboard preview -->
      <section class="lg:col-start-1 lg:row-start-2" aria-labelledby="login-preview-heading">
        <h2
          id="login-preview-heading"
          class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]"
        >
          Your progress, at a glance
        </h2>

        <div
          class="mt-3 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface-2)] shadow-[var(--shadow)]"
        >
          <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] px-4 py-3">
            <span class="flex items-center gap-2 text-xs font-bold text-[var(--ink)]">
              <span
                class="grid h-6 w-6 place-items-center rounded-lg bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300"
                aria-hidden="true"
              >
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v18h18"></path>
                  <path d="m7 15 4-4 3 3 5-6"></path>
                </svg>
              </span>
              Chemistry · Shift 1
            </span>
            <span
              class="rounded-full bg-[var(--success-bg)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[var(--success-ink)]"
            >
              Completed
            </span>
          </div>

          <dl class="grid grid-cols-3 divide-x divide-[var(--border)] border-b border-[var(--border)]">
            {
              previewStats.map((stat) => (
                <div class="px-4 py-3">
                  <dt class="text-[10px] font-semibold uppercase tracking-wide text-[var(--muted)]">
                    {stat.label}
                  </dt>
                  <dd class="mt-0.5 text-lg font-black tracking-tight text-[var(--ink)]">
                    {stat.value}
                  </dd>
                </div>
              ))
            }
          </dl>

          <div class="space-y-3 px-4 py-4">
            {
              previewSubjects.map((subject) => (
                <div>
                  <div class="flex items-baseline justify-between gap-3 text-xs">
                    <span class="font-semibold text-[var(--ink-2)]">{subject.name}</span>
                    <span class="font-bold tabular-nums text-[var(--ink)]">{subject.score}%</span>
                  </div>
                  <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-neutral-100 dark:bg-white/10">
                    <div
                      class="h-full rounded-full bg-brand-500"
                      style={`width: ${subject.score}%`}
                      aria-hidden="true"
                    />
                  </div>
                </div>
              ))
            }
          </div>

          <p class="border-t border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-[11px] leading-5 text-[var(--muted)]">
            Illustrative dashboard — your real numbers start after your first attempt.
          </p>
        </div>

        <p class="mt-4 text-xs leading-5 text-[var(--muted)]">
          <span class="font-bold text-[var(--ink)]">{paperCount}</span> previous-year papers ·{" "}
          <span class="font-bold text-[var(--ink)]">{questionCount}</span> questions ·{" "}
          <span class="font-bold text-[var(--ink)]">₹0</span> forever
        </p>
      </section>
    </div>
  </section>
</BaseLayout>
