---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { all } from "../../../lib/db";
import { can } from "../../../lib/auth/admin";

const admin = Astro.locals.admin!;
if (!can(admin.role, "questions.write")) return Astro.redirect("/admin", 303);

const subjects = await all<{ id: number; name: string; slug: string }>(
  "SELECT id, name, slug FROM subjects WHERE is_active = 1 ORDER BY name",
);
const canPublish = can(admin.role, "questions.publish");

const sampleJson = `[
  {
    "subject_slug": "english",
    "text": "Choose the word closest in meaning to \\"ubiquitous\\".",
    "options": [
      { "text": "Rare" },
      { "text": "Everywhere" },
      { "text": "Hidden" },
      { "text": "Temporary" }
    ],
    "correct_option": 1,
    "explanation": "\\"Ubiquitous\\" means present everywhere.",
    "difficulty": "easy",
    "status": "draft"
  }
]`;

const sampleCsv = `subject_slug,text,option_a,option_b,option_c,option_d,correct_option,explanation,difficulty,status
english,"Choose the synonym of ""ubiquitous"".",Rare,Everywhere,Hidden,Temporary,B,"Ubiquitous means present everywhere.",easy,draft`;
---

<AdminLayout title="Bulk import" active="questions">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Bulk import questions</h1>
      <p class="mt-1 max-w-3xl text-sm text-neutral-600 dark:text-neutral-400">
        Upload or paste CSV/JSON, validate every row, then import. The preview checks the same schema, image alt text, topic/subject rules and duplicates as the single-question editor.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href="/admin/questions">Back to question bank</a>
      <a class="rounded-lg bg-brand-600 px-3 py-2 text-sm font-bold text-white hover:bg-brand-700" href="/admin/questions/new">New question</a>
    </div>
  </div>

  <div class="mt-5 grid gap-3 rounded-2xl border border-neutral-200 bg-white p-4 text-sm dark:border-neutral-800 dark:bg-neutral-900 md:grid-cols-3">
    <p><span class="font-semibold">Up to 100 rows</span><br /><span class="text-neutral-600 dark:text-neutral-400">Files are limited to 1 MB.</span></p>
    <p><span class="font-semibold">All-or-nothing</span><br /><span class="text-neutral-600 dark:text-neutral-400">Invalid or duplicate rows block the whole import.</span></p>
    <p><span class="font-semibold">{canPublish ? "Any status" : "Drafts only"}</span><br /><span class="text-neutral-600 dark:text-neutral-400">{canPublish ? "Editors may import draft, in-review or published rows." : "Contributors can import draft rows only."}</span></p>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">
    <section class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold">1. Choose data</h2>
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">The file is read in your browser; validation and storage happen on the server.</p>
        </div>
        <label class="text-sm font-semibold">
          Format
          <select id="import-format" class="ml-2 rounded-lg border border-neutral-300 bg-white px-2 py-1.5 text-sm dark:border-neutral-700 dark:bg-neutral-950">
            <option value="auto">Auto-detect</option>
            <option value="csv">CSV</option>
            <option value="json">JSON</option>
          </select>
        </label>
      </div>

      <label class="mt-5 block text-sm font-semibold" for="import-file">Upload CSV or JSON</label>
      <input id="import-file" class="mt-2 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-neutral-900 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-white dark:border-neutral-700 dark:bg-neutral-950 dark:file:bg-white dark:file:text-neutral-900" type="file" accept=".csv,.json,text/csv,application/json" />

      <label class="mt-5 block text-sm font-semibold" for="import-content">Or paste data</label>
      <textarea id="import-content" class="mt-2 w-full rounded-xl border border-neutral-300 bg-white p-3 font-mono text-xs leading-5 dark:border-neutral-700 dark:bg-neutral-950" rows="14" spellcheck="false" placeholder={sampleCsv}></textarea>

      <div class="mt-4 flex flex-wrap gap-2">
        <button id="validate-import" class="rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-neutral-700 disabled:opacity-60 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200" type="button">Validate preview</button>
        <button id="run-import" class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60" type="button" disabled>Import questions</button>
      </div>
      <p id="import-status" class="mt-4 hidden rounded-lg px-3 py-2 text-sm" role="status" aria-live="polite"></p>
    </section>

    <aside class="space-y-4">
      <section class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
        <h2 class="text-lg font-bold">Subject references</h2>
        <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Use an ID or slug in the file. Subject names are also accepted.</p>
        <div class="mt-3 max-h-72 overflow-auto rounded-lg border border-neutral-200 dark:border-neutral-800" role="region" aria-label="Active subjects" tabindex="0">
          <table class="w-full text-left text-xs">
            <thead class="sticky top-0 bg-neutral-50 text-neutral-500 dark:bg-neutral-950 dark:text-neutral-400">
              <tr><th class="px-2 py-1.5">ID</th><th class="px-2 py-1.5">Slug</th><th class="px-2 py-1.5">Name</th></tr>
            </thead>
            <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
              {subjects.map((subject) => (
                <tr><td class="px-2 py-1.5 font-mono">{subject.id}</td><td class="px-2 py-1.5 font-mono">{subject.slug}</td><td class="px-2 py-1.5">{subject.name}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-5 text-sm leading-6 dark:border-neutral-800 dark:bg-neutral-900">
        <h2 class="text-lg font-bold">Fields</h2>
        <p class="mt-2"><strong>Required:</strong> a subject reference, <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">text</code>, at least two options and <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">correct_option</code>.</p>
        <p class="mt-2"><strong>Correct option:</strong> letters A-F or a zero-based index (0 = A).</p>
        <p class="mt-2"><strong>CSV options:</strong> <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">option_a</code> through <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">option_f</code>. Each can also have <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">_image_url</code> and <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">_image_alt</code>.</p>
        <p class="mt-2"><strong>JSON:</strong> either the native question shape with an <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">options</code> array or the same flat fields as CSV.</p>
        <p class="mt-2"><strong>Other fields:</strong> <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">text_hi</code>, <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">explanation</code>, <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">explanation_hi</code>, <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">difficulty</code>, <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">year</code>, <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">image_url</code>, <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">image_alt</code>, <code class="rounded bg-neutral-100 px-1 dark:bg-neutral-800">status</code> and topic/passage IDs.</p>
        <p class="mt-2"><strong>Duplicates:</strong> same subject and normalised question text (case and whitespace ignored) blocks the import.</p>
      </section>
    </aside>
  </div>

  <section id="preview-section" class="mt-8 hidden rounded-2xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-200 px-4 py-3 dark:border-neutral-800">
      <div>
        <h2 class="text-lg font-bold">2. Validation preview</h2>
        <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Nothing is saved during validation.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <div id="preview-counts" class="flex flex-wrap gap-2 text-xs font-semibold"></div>
        <button id="download-rejected" class="rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-bold hover:bg-neutral-50 disabled:opacity-50 dark:border-neutral-700 dark:hover:bg-neutral-800" type="button" disabled>Download rejected rows</button>
      </div>
    </div>
    <div class="overflow-x-auto" role="region" aria-label="Question import preview" tabindex="0">
      <table class="w-full min-w-[760px] text-left text-sm">
        <thead class="bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500 dark:bg-neutral-950 dark:text-neutral-400">
          <tr>
            <th class="px-4 py-3">Row</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Question</th>
            <th class="px-4 py-3">Subject</th>
            <th class="px-4 py-3">Details</th>
          </tr>
        </thead>
        <tbody id="preview-body" class="divide-y divide-neutral-100 dark:divide-neutral-800"></tbody>
      </table>
    </div>
  </section>

  <div class="mt-8 grid gap-4 lg:grid-cols-2">
    <details class="rounded-2xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
      <summary class="cursor-pointer font-bold">JSON example</summary>
      <pre class="mt-3 overflow-x-auto rounded-xl bg-neutral-950 p-4 text-xs leading-5 text-neutral-100">{sampleJson}</pre>
    </details>
    <details class="rounded-2xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
      <summary class="cursor-pointer font-bold">CSV example</summary>
      <pre class="mt-3 overflow-x-auto rounded-xl bg-neutral-950 p-4 text-xs leading-5 text-neutral-100">{sampleCsv}</pre>
    </details>
  </div>

  <script>
    const content = document.getElementById("import-content") as HTMLTextAreaElement | null;
    const fileInput = document.getElementById("import-file") as HTMLInputElement | null;
    const format = document.getElementById("import-format") as HTMLSelectElement | null;
    const validateButton = document.getElementById("validate-import") as HTMLButtonElement | null;
    const importButton = document.getElementById("run-import") as HTMLButtonElement | null;
    const statusBox = document.getElementById("import-status") as HTMLElement | null;
    const previewSection = document.getElementById("preview-section") as HTMLElement | null;
    const previewBody = document.getElementById("preview-body") as HTMLElement | null;
    const previewCounts = document.getElementById("preview-counts") as HTMLElement | null;
    const downloadRejected = document.getElementById("download-rejected") as HTMLButtonElement | null;
    let validatedKey = "";
    let lastSummary: Summary | null = null;
    let lastRows: PreviewRow[] = [];

    type PreviewRow = {
      row: number;
      status: "valid" | "invalid" | "duplicate";
      errors: string[];
      text: string;
      subject_id: number | null;
      source: Record<string, unknown>;
    };
    type Summary = { total: number; valid: number; invalid: number; duplicate: number };
    type ImportResult = {
      error?: string;
      ok?: boolean;
      dry_run?: boolean;
      imported?: number;
      redirect?: string;
      rows?: PreviewRow[];
      summary?: Summary;
    };

    function showStatus(message: string, kind: "error" | "success" | "info") {
      if (!statusBox) return;
      statusBox.textContent = message;
      statusBox.className = `mt-4 rounded-lg px-3 py-2 text-sm ${
        kind === "error"
          ? "bg-red-50 text-red-800 dark:bg-red-950/50 dark:text-red-200"
          : kind === "success"
            ? "bg-brand-50 text-brand-900 dark:bg-brand-950/50 dark:text-brand-200"
            : "bg-sky-50 text-sky-900 dark:bg-sky-950/40 dark:text-sky-200"
      }`;
    }

    function resetPreview() {
      validatedKey = "";
      lastSummary = null;
      lastRows = [];
      if (importButton) {
        importButton.disabled = true;
        importButton.textContent = "Import questions";
      }
      if (downloadRejected) downloadRejected.disabled = true;
      if (previewSection) previewSection.classList.add("hidden");
      if (statusBox) {
        statusBox.textContent = "";
        statusBox.classList.add("hidden");
      }
    }

    function currentKey(): string {
      return `${format?.value ?? "auto"}\u0000${content?.value ?? ""}`;
    }

    function renderRows(rows: PreviewRow[], summary: Summary) {
      if (!previewBody || !previewCounts || !previewSection) return;
      lastSummary = summary;
      lastRows = rows;
      if (downloadRejected) downloadRejected.disabled = summary.invalid + summary.duplicate === 0;
      previewBody.replaceChildren();
      const counts = [
        ["Valid", summary.valid, "bg-brand-100 text-brand-900 dark:bg-brand-900/50 dark:text-brand-200"],
        ["Invalid", summary.invalid, "bg-red-100 text-red-800 dark:bg-red-950/50 dark:text-red-200"],
        ["Duplicate", summary.duplicate, "bg-amber-100 text-amber-900 dark:bg-amber-950/50 dark:text-amber-200"],
      ] as const;
      previewCounts.replaceChildren();
      for (const [label, count, className] of counts) {
        const badge = document.createElement("span");
        badge.className = `rounded-full px-2.5 py-1 ${className}`;
        badge.textContent = `${label}: ${count}`;
        previewCounts.appendChild(badge);
      }

      for (const row of rows) {
        const tr = document.createElement("tr");
        const cells = [
          String(row.row),
          row.status === "valid" ? "Ready" : row.status === "duplicate" ? "Duplicate" : "Error",
          row.text || "(empty question)",
          row.subject_id === null ? "—" : `#${row.subject_id}`,
          row.errors.length > 0 ? row.errors.join(" ") : "Ready to import",
        ];
        cells.forEach((value, index) => {
          const td = document.createElement("td");
          td.className = "px-4 py-3 align-top";
          if (index === 1) {
            const badge = document.createElement("span");
            badge.className = `rounded-full px-2 py-0.5 text-xs font-semibold ${
              row.status === "valid"
                ? "bg-brand-100 text-brand-900 dark:bg-brand-900/50 dark:text-brand-200"
                : row.status === "duplicate"
                  ? "bg-amber-100 text-amber-900 dark:bg-amber-950/50 dark:text-amber-200"
                  : "bg-red-100 text-red-800 dark:bg-red-950/50 dark:text-red-200"
            }`;
            badge.textContent = value;
            td.appendChild(badge);
          } else {
            td.textContent = value;
            if (index === 2) td.className += " max-w-md";
            if (index === 4) td.className += " text-xs text-neutral-600 dark:text-neutral-400";
          }
          tr.appendChild(td);
        });
        previewBody.appendChild(tr);
      }
      previewSection.classList.remove("hidden");
    }

    async function sendImport(dryRun: boolean) {
      if (!content || !format) return;
      if (!content.value.trim()) {
        showStatus("Paste or upload question data first.", "error");
        return;
      }
      const buttons = [validateButton, importButton].filter(Boolean) as HTMLButtonElement[];
      buttons.forEach((button) => (button.disabled = true));
      if (validateButton) validateButton.textContent = "Checking…";
      if (importButton && !dryRun) importButton.textContent = "Importing…";
      showStatus(dryRun ? "Validating every row…" : "Importing validated rows…", "info");

      try {
        const response = await fetch("/api/admin/questions/import", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            format: format.value,
            content: content.value,
            dry_run: dryRun,
          }),
        });
        let result: ImportResult;
        try {
          result = (await response.json()) as ImportResult;
        } catch {
          throw new Error(`Import request failed (${response.status}).`);
        }

        if (result.rows && result.summary) renderRows(result.rows, result.summary);
        if (!response.ok || result.ok === false) {
          throw new Error(result.error || "Could not validate the import.");
        }

        if (dryRun) {
          const summary = result.summary;
          if (!summary) throw new Error("The preview did not return a summary.");
          validatedKey = currentKey();
          const allValid = summary.total > 0 && summary.valid === summary.total;
          if (importButton) {
            importButton.disabled = !allValid;
            importButton.textContent = allValid ? `Import ${summary.valid} question${summary.valid === 1 ? "" : "s"}` : "Fix rows to import";
          }
          showStatus(
            allValid
              ? `${summary.valid} row${summary.valid === 1 ? "" : "s"} ready. Review the preview, then import.`
              : `${summary.invalid} invalid and ${summary.duplicate} duplicate row${summary.invalid + summary.duplicate === 1 ? "" : "s"}. Fix them before importing; nothing has been saved.`,
            allValid ? "success" : "error",
          );
        } else {
          validatedKey = "";
          lastSummary = null;
          if (content) content.value = "";
          if (fileInput) fileInput.value = "";
          if (importButton) importButton.disabled = true;
          showStatus(
            `Imported ${result.imported ?? 0} question${result.imported === 1 ? "" : "s"}. They are now in the question bank.`,
            "success",
          );
        }
      } catch (error) {
        showStatus(error instanceof Error ? error.message : "Import failed.", "error");
      } finally {
        buttons.forEach((button) => (button.disabled = false));
        if (validateButton) validateButton.textContent = "Validate preview";
        if (importButton) {
          const ready =
            Boolean(validatedKey) &&
            validatedKey === currentKey() &&
            lastSummary !== null &&
            lastSummary.total > 0 &&
            lastSummary.valid === lastSummary.total;
          importButton.disabled = !ready;
          importButton.textContent = ready && lastSummary
            ? `Import ${lastSummary.valid} question${lastSummary.valid === 1 ? "" : "s"}`
            : validatedKey
              ? "Fix rows to import"
              : "Import questions";
        }
      }
    }

    validateButton?.addEventListener("click", () => void sendImport(true));
    importButton?.addEventListener("click", () => {
      if (!validatedKey || validatedKey !== currentKey()) {
        showStatus("Validate the current data again before importing.", "error");
        return;
      }
      void sendImport(false);
    });
    downloadRejected?.addEventListener("click", () => {
      const rejected = lastRows.filter((row) => row.status !== "valid").map((row) => row.source);
      if (rejected.length === 0) return;
      const blob = new Blob([JSON.stringify(rejected, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `rejected-question-rows-${new Date().toISOString().slice(0, 10)}.json`;
      link.click();
      URL.revokeObjectURL(url);
    });

    content?.addEventListener("input", resetPreview);
    format?.addEventListener("change", resetPreview);
    fileInput?.addEventListener("change", async () => {
      const file = fileInput.files?.[0];
      if (!file || !content) return;
      resetPreview();
      if (file.size > 1_000_000) {
        showStatus("The import file is larger than 1 MB.", "error");
        fileInput.value = "";
        return;
      }
      content.value = await file.text();
      if (format) {
        const lower = file.name.toLowerCase();
        format.value = lower.endsWith(".json") ? "json" : lower.endsWith(".csv") ? "csv" : "auto";
      }
      showStatus(`Loaded ${file.name}. Validate when ready.`, "info");
    });
  </script>
</AdminLayout>
