---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth/admin";
import {
  hasDraftSettings,
  loadDraftSettings,
  loadSettingsRevisions,
  SETTING_FIELDS,
} from "../../lib/admin/settings";

const admin = Astro.locals.admin!;
if (!can(admin.role, "settings.write")) return Astro.redirect("/forbidden", 303);

const settings = await loadDraftSettings();
const hasDraft = await hasDraftSettings();
const revisions = await loadSettingsRevisions();
const sections = [
  {
    key: "global",
    title: "Site identity, navigation & global notice",
    description: "These settings apply across the public website.",
  },
  {
    key: "homepage",
    title: "Homepage copy",
    description: "Edit the homepage hero and library headings. Text is escaped and never treated as HTML.",
  },
  {
    key: "homepage-sections",
    title: "Homepage components",
    description: "Show or hide optional homepage sections without changing their underlying content.",
  },
  {
    key: "content-pages",
    title: "Informational page blocks",
    description: "Edit selected About and Contact content with approved blocks. Legal pages and contact addresses are not editable here.",
  },
  {
    key: "features",
    title: "Feature switches",
    description: "Control registration, discussions, maintenance and question sharing.",
  },
].map((section) => ({
  ...section,
  fields: SETTING_FIELDS.filter((field) => field.group === section.key),
}));
---

<AdminLayout title="Site builder & settings" active="settings">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black tracking-tight">Site builder & settings</h1>
      <p class="mt-1 max-w-3xl text-sm text-neutral-600 dark:text-neutral-400">
        Edit a draft, preview it privately, then publish when ready. Changes are validated and recorded in the activity log.
      </p>
    </div>
    <a class="rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800" href="/?sitePreview=1" target="_blank" rel="noopener">Preview draft</a>
  </div>

  <div class:list={["mt-5 rounded-2xl border p-4 text-sm leading-6", hasDraft ? "border-blue-200 bg-blue-50 text-blue-900 dark:border-blue-900 dark:bg-blue-950/30 dark:text-blue-100" : "border-neutral-200 bg-neutral-50 text-neutral-700 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300"]}>
    <p class="font-bold">{hasDraft ? "Unpublished draft saved" : "No unpublished draft"}</p>
    <p class="mt-1">{hasDraft ? "The public site is unchanged until you publish. Draft preview is visible only to admins with site-settings permission." : "Saving creates a draft; it does not change the public site. Publish explicitly when the preview is ready."}</p>
  </div>

  <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-900 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-100">
    <p class="font-bold">Maintenance mode rewrites public pages</p>
    <p class="mt-1">Admin pages and APIs stay reachable while maintenance is on, so you can switch it back off. Test the public site in a private window before scheduling maintenance around an exam.</p>
  </div>

  <form id="settings-form" class="mt-6 max-w-4xl space-y-6">
    <p id="settings-status" class="hidden rounded-lg px-3 py-2 text-sm" role="status"></p>

    {sections.map((section) => (
      <section class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
        <div class="border-b border-neutral-100 pb-4 dark:border-neutral-800">
          <h2 class="text-lg font-bold">{section.title}</h2>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{section.description}</p>
        </div>
        <div class="mt-4 space-y-4">
          {section.fields.map((field) => {
            const value = settings[field.key];
            if (field.type === "blocks" && field.pageId) {
              return (
                <div
                  class="rounded-xl border border-neutral-200 p-4 dark:border-neutral-800"
                  data-page-block-editor={field.pageId}
                >
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h3 class="text-sm font-bold">{field.label}</h3>
                      <p class="mt-1 max-w-2xl text-xs leading-5 text-neutral-500 dark:text-neutral-400">{field.description}</p>
                    </div>
                    <div class="flex gap-3">
                      <a
                        class="text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300"
                        href="/admin/media"
                        target="_blank"
                        rel="noopener"
                      >
                        Media library
                      </a>
                      <a
                        class="text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300"
                        href={`/${field.pageId}?sitePreview=1`}
                        target="_blank"
                        rel="noopener"
                      >
                        Preview draft
                      </a>
                    </div>
                  </div>
                  <input
                    type="hidden"
                    name={field.key}
                    value={value}
                    data-page-block-json
                  />
                  <div class="mt-4 space-y-3" data-page-block-list></div>
                  <button
                    class="mt-3 rounded-lg border border-neutral-300 px-3 py-2 text-xs font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800"
                    type="button"
                    data-add-page-block
                  >
                    Add paragraph
                  </button>
                  <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
                    Text is escaped. HTML, scripts, external links and unapproved block types are rejected.
                  </p>
                  <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                    Image blocks use uploaded assets and require alternative text.
                  </p>
                </div>
              );
            }
            if (field.type === "boolean") {
              const enabled = value === "true";
              return (
                <label class="flex items-start gap-3 rounded-xl border border-neutral-200 p-3 dark:border-neutral-800">
                  <input class="mt-1" name={field.key} type="checkbox" value="true" checked={enabled} />
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold">{field.label}</span>
                    <span class="mt-0.5 block text-xs leading-5 text-neutral-500 dark:text-neutral-400">{field.description}</span>
                    <span class:list={["mt-1 inline-block rounded-full px-2 py-0.5 text-[11px] font-semibold", enabled ? "bg-brand-100 text-brand-900 dark:bg-brand-900/50 dark:text-brand-200" : "bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300"]}>
                      {enabled ? "On" : "Off"}
                    </span>
                  </span>
                </label>
              );
            }

            return (
              <label class="block text-sm font-semibold">
                {field.label}
                {field.type === "textarea" || field.type === "links" || field.type === "order" ? (
                  <textarea
                    class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm font-normal dark:border-neutral-700 dark:bg-neutral-950"
                    name={field.key}
                    rows={field.rows ?? 3}
                    maxlength={field.maxLength ?? 80}
                    required={!field.allowEmpty}
                  >{value}</textarea>
                ) : (
                  <input
                    class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm font-normal dark:border-neutral-700 dark:bg-neutral-950"
                    name={field.key}
                    type="text"
                    inputmode={field.type === "path" ? "url" : undefined}
                    value={value}
                    maxlength={field.maxLength ?? 80}
                    required={!field.allowEmpty}
                    placeholder={field.type === "path" ? "/mock-tests" : undefined}
                  />
                )}
                <span class="mt-1 block text-xs font-normal text-neutral-500 dark:text-neutral-400">{field.description}</span>
              </label>
            );
          })}
        </div>
      </section>
    ))}

    <div class="flex flex-wrap items-center gap-3">
      <button class="rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-bold hover:bg-neutral-50 disabled:opacity-60 dark:border-neutral-700 dark:hover:bg-neutral-800" type="submit">Save draft</button>
      <button id="publish-settings" class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700 disabled:opacity-60" type="button">Publish changes</button>
      <a class="text-sm font-semibold text-neutral-600 hover:underline dark:text-neutral-300" href="/admin">Back to dashboard</a>
    </div>
  </form>

  <section class="mt-8 max-w-4xl rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900" aria-labelledby="settings-revisions-heading">
    <div class="border-b border-neutral-100 pb-4 dark:border-neutral-800">
      <h2 class="text-lg font-bold" id="settings-revisions-heading">Published revisions</h2>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">Restore a prior version as a draft. It will not go live until you preview and publish it.</p>
    </div>
    {revisions.length > 0 ? (
      <ul class="mt-4 space-y-3">
        {revisions.map((revision) => (
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-neutral-200 p-3 dark:border-neutral-800">
            <div>
              <p class="text-sm font-semibold">{new Date(revision.createdAt).toLocaleString()}</p>
              <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">Snapshot captured by admin #{revision.adminId}</p>
            </div>
            <button
              class="rounded-lg border border-neutral-300 px-3 py-2 text-xs font-bold hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-800"
              type="button"
              data-restore-revision={revision.id}
            >
              Restore as draft
            </button>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">No published revisions yet. A snapshot is created each time a draft is published.</p>
    )}
  </section>

  <script is:inline>
    const form = document.getElementById("settings-form");
    const statusBox = document.getElementById("settings-status");
    const publishButton = document.getElementById("publish-settings");

    function showStatus(message, ok) {
      if (!statusBox) return;
      statusBox.textContent = message;
      statusBox.className = `rounded-lg px-3 py-2 text-sm ${ok ? "bg-brand-50 text-brand-900 dark:bg-brand-950/40 dark:text-brand-200" : "bg-red-50 text-red-800 dark:bg-red-950/50 dark:text-red-200"}`;
    }

    const pageBlockTypes = {
      about: ["heading", "paragraph", "list", "callout", "image", "internal_link"],
      contact: ["heading", "paragraph", "list", "callout", "image"],
    };

    let mediaAssets = [];

    function defaultPageBlock(type) {
      if (type === "heading") return { type, level: "h2", text: "" };
      if (type === "list") return { type, items: [""] };
      if (type === "callout") return { type, tone: "neutral", title: "", text: "" };
      if (type === "image") {
        const asset = mediaAssets[0];
        return { type, assetId: asset?.id || "", alt: asset?.alt || "" };
      }
      if (type === "internal_link") return { type, label: "", href: "/" };
      return { type: "paragraph", text: "" };
    }

    function textControl(labelText, value, onInput, multiline = false, maxLength = 1000, rows = 3) {
      const label = document.createElement("label");
      label.className = "block text-xs font-semibold";
      const caption = document.createElement("span");
      caption.textContent = labelText;
      const control = document.createElement(multiline ? "textarea" : "input");
      control.className = "mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm font-normal dark:border-neutral-700 dark:bg-neutral-950";
      if (multiline) control.rows = rows;
      control.maxLength = maxLength;
      control.value = value || "";
      control.addEventListener("input", () => onInput(control.value));
      label.append(caption, control);
      return label;
    }

    function mediaAssetControl(labelText, selectedId, onChange) {
      const label = document.createElement("label");
      label.className = "block text-xs font-semibold";
      const caption = document.createElement("span");
      caption.textContent = labelText;
      const control = document.createElement("select");
      control.className = "mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm font-normal dark:border-neutral-700 dark:bg-neutral-950";

      if (selectedId && !mediaAssets.some((asset) => asset.id === selectedId)) {
        const missing = document.createElement("option");
        missing.value = selectedId;
        missing.textContent = "Missing asset — choose a replacement";
        missing.selected = true;
        control.append(missing);
      } else {
        const placeholder = document.createElement("option");
        placeholder.value = "";
        placeholder.textContent = mediaAssets.length ? "Choose an image" : "No uploaded images";
        placeholder.selected = !selectedId;
        control.append(placeholder);
      }

      mediaAssets.forEach((asset) => {
        const option = document.createElement("option");
        option.value = asset.id;
        option.textContent = `${asset.alt} (${asset.width ?? "?"} × ${asset.height ?? "?"})`;
        option.selected = asset.id === selectedId;
        control.append(option);
      });
      control.addEventListener("change", () => onChange(control.value));
      label.append(caption, control);
      return label;
    }

    function selectControl(labelText, value, choices, onChange) {
      const label = document.createElement("label");
      label.className = "block text-xs font-semibold";
      const caption = document.createElement("span");
      caption.textContent = labelText;
      const control = document.createElement("select");
      control.className = "mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm font-normal dark:border-neutral-700 dark:bg-neutral-950";
      choices.forEach((choice) => {
        const option = document.createElement("option");
        option.value = choice;
        option.textContent = choice.replaceAll("_", " ");
        option.selected = choice === value;
        control.append(option);
      });
      control.addEventListener("change", () => onChange(control.value));
      label.append(caption, control);
      return label;
    }

    function actionButton(label, disabled, onClick) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "rounded-lg border border-neutral-300 px-2.5 py-1.5 text-xs font-semibold hover:bg-neutral-50 disabled:opacity-40 dark:border-neutral-700 dark:hover:bg-neutral-800";
      button.textContent = label;
      button.disabled = disabled;
      button.addEventListener("click", onClick);
      return button;
    }

    function renderPageBlockEditors() {
      document.querySelectorAll("[data-page-block-editor]").forEach((editor) => {
        const page = editor.dataset.pageBlockEditor;
        const allowedTypes = pageBlockTypes[page];
        const valueInput = editor.querySelector("[data-page-block-json]");
        const blockList = editor.querySelector("[data-page-block-list]");
        const addButton = editor.querySelector("[data-add-page-block]");
        if (!allowedTypes || !valueInput || !blockList || !addButton) return;

        let blocks;
        try {
          blocks = JSON.parse(valueInput.value);
        } catch {
          showStatus(`Could not load ${page} page blocks. Reload the page before editing.`, false);
          addButton.disabled = true;
          return;
        }

        const syncValue = () => {
          valueInput.value = JSON.stringify(blocks);
          addButton.disabled = blocks.length >= 20;
        };

        const render = () => {
          blockList.replaceChildren();
          blocks.forEach((block, index) => {
            const card = document.createElement("fieldset");
            card.className = "rounded-lg border border-neutral-200 p-3 dark:border-neutral-800";
            const legend = document.createElement("legend");
            legend.className = "px-1 text-xs font-bold";
            legend.textContent = `Block ${index + 1}`;
            card.append(legend);

            const fields = document.createElement("div");
            fields.className = "grid gap-3 sm:grid-cols-2";
            const blockTypes = mediaAssets.length
              ? allowedTypes
              : allowedTypes.filter((type) => type !== "image");
            if (block.type === "image" && !blockTypes.includes("image")) {
              blockTypes.push("image");
            }
            fields.append(
              selectControl("Block type", block.type, blockTypes, (type) => {
                blocks[index] = defaultPageBlock(type);
                syncValue();
                render();
              }),
            );

            if (block.type === "heading") {
              fields.append(
                selectControl("Heading level", block.level, ["h2", "h3"], (level) => {
                  block.level = level;
                  syncValue();
                }),
                textControl("Heading text", block.text, (text) => {
                  block.text = text;
                  syncValue();
                }, false, 100),
              );
            } else if (block.type === "paragraph") {
              fields.append(
                textControl("Paragraph text", block.text, (text) => {
                  block.text = text;
                  syncValue();
                }, true, 1500, 4),
              );
            } else if (block.type === "list") {
              fields.append(
                textControl("List items (one per line)", block.items.join("\n"), (text) => {
                  block.items = text.split(/\r?\n/).map((item) => item.trim()).filter(Boolean);
                  syncValue();
                }, true, 6000, Math.max(3, Math.min(8, block.items.length + 1))),
              );
            } else if (block.type === "callout") {
              fields.append(
                selectControl("Callout style", block.tone, ["neutral", "warning"], (tone) => {
                  block.tone = tone;
                  syncValue();
                }),
                textControl("Callout title", block.title, (text) => {
                  block.title = text;
                  syncValue();
                }, false, 100),
                textControl("Callout text", block.text, (text) => {
                  block.text = text;
                  syncValue();
                }, true, 1000, 3),
              );
            } else if (block.type === "internal_link") {
              fields.append(
                textControl("Link label", block.label, (text) => {
                  block.label = text;
                  syncValue();
                }, false, 80),
                textControl("Same-site path", block.href, (href) => {
                  block.href = href;
                  syncValue();
                }, false, 300),
              );
            } else if (block.type === "image") {
              fields.append(
                mediaAssetControl("Uploaded image", block.assetId, (assetId) => {
                  const asset = mediaAssets.find((item) => item.id === assetId);
                  block.assetId = assetId;
                  block.alt = asset?.alt || "";
                  syncValue();
                  render();
                }),
                textControl("Alternative text", block.alt, (alt) => {
                  block.alt = alt;
                  syncValue();
                }, false, 300),
              );
            }

            card.append(fields);
            const actions = document.createElement("div");
            actions.className = "mt-3 flex flex-wrap gap-2";
            actions.append(
              actionButton("Move up", index === 0, () => {
                [blocks[index - 1], blocks[index]] = [blocks[index], blocks[index - 1]];
                syncValue();
                render();
              }),
              actionButton("Move down", index === blocks.length - 1, () => {
                [blocks[index], blocks[index + 1]] = [blocks[index + 1], blocks[index]];
                syncValue();
                render();
              }),
              actionButton("Remove block", blocks.length === 1, () => {
                blocks.splice(index, 1);
                syncValue();
                render();
              }),
            );
            card.append(actions);
            blockList.append(card);
          });
          syncValue();
        };

        addButton.addEventListener("click", () => {
          if (blocks.length >= 20) return;
          blocks.push(defaultPageBlock("paragraph"));
          syncValue();
          render();
        });
        render();
      });
    }

    function settingsPayload() {
      const payload = Object.fromEntries(new FormData(form).entries());
      form.querySelectorAll("input[type=checkbox]").forEach((checkbox) => {
        payload[checkbox.name] = checkbox.checked ? "true" : "false";
      });
      return payload;
    }

    async function loadPageBlockMediaAssets() {
      try {
        const response = await fetch("/api/admin/media", { cache: "no-store" });
        const result = await response.json().catch(() => null);
        if (!response.ok) throw new Error(result?.error || "Could not load uploaded images.");
        if (!result || !Array.isArray(result.assets)) {
          throw new Error("The media library returned an invalid response.");
        }
        mediaAssets = result.assets;
      } catch (error) {
        showStatus(error instanceof Error ? error.message : "Could not load uploaded images.", false);
      }
      renderPageBlockEditors();
    }

    loadPageBlockMediaAssets();

    async function saveDraft() {
      const response = await fetch("/api/admin/settings", {
        method: "PUT",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(settingsPayload()),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || "Could not save the draft.");
      return result;
    }

    async function runSettingsAction(action, revisionId) {
      const response = await fetch("/api/admin/settings", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ action, revisionId }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || "Could not complete the settings action.");
      return result;
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector("button[type=submit]");
      if (!button) return;
      button.disabled = true;

      try {
        const result = await saveDraft();
        showStatus(result.hasDraft ? "Draft saved. The public site is unchanged." : "Draft matches the published settings.", true);
        setTimeout(() => location.reload(), 600);
      } catch (error) {
        showStatus(error instanceof Error ? error.message : "Could not save the draft.", false);
        button.disabled = false;
      }
    });

    publishButton?.addEventListener("click", async () => {
      if (!window.confirm("Publish these site settings? This will make them visible to everyone.")) return;
      publishButton.disabled = true;
      try {
        const saved = await saveDraft();
        if (!saved.hasDraft) {
          showStatus("There are no unpublished changes to publish.", true);
          setTimeout(() => location.reload(), 600);
          return;
        }
        await runSettingsAction("publish");
        showStatus("Site settings published.", true);
        setTimeout(() => location.reload(), 600);
      } catch (error) {
        showStatus(error instanceof Error ? error.message : "Could not publish the settings.", false);
        publishButton.disabled = false;
      }
    });

    document.querySelectorAll("[data-restore-revision]").forEach((button) => {
      button.addEventListener("click", async () => {
        if (!window.confirm("Load this published revision as a draft? It will not go live until you publish.")) return;
        button.disabled = true;
        try {
          await runSettingsAction("restore", button.dataset.restoreRevision);
          showStatus("Revision restored as a draft.", true);
          setTimeout(() => location.reload(), 600);
        } catch (error) {
          showStatus(error instanceof Error ? error.message : "Could not restore the revision.", false);
          button.disabled = false;
        }
      });
    });
  </script>
</AdminLayout>
