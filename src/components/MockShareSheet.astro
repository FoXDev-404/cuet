---
interface Props {
  shareUrl: string;
  mockId: number;
  triggerClass?: string;
}

const {
  shareUrl,
  mockId,
  triggerClass = "inline-flex h-9 items-center gap-1.5 rounded border border-[var(--border)] bg-[var(--surface-2)] px-2 text-[10px] font-bold text-[var(--ink)] hover:opacity-90 sm:h-11 sm:px-2.5 sm:text-xs",
} = Astro.props;

const dialogId = `mock-share-dialog-${mockId}`;
const titleId = `mock-share-title-${mockId}`;
---

<div
  data-mock-share-sheet
  data-share-url={shareUrl}
  data-share-mock-id={mockId}
  data-share-context="attempt"
>
  <button
    type="button"
    class={triggerClass}
    data-mock-share-trigger
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls={dialogId}
    aria-label="Share mock test"
  >
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <path d="m8.6 10.7 6.8-3.4M8.6 13.3l6.8 3.4"></path>
    </svg>
    <span class="hidden sm:inline">Share mock</span>
  </button>

  <div id={dialogId} class="fixed inset-0 z-[60] hidden" data-mock-share-dialog aria-hidden="true">
    <div class="absolute inset-0 bg-neutral-950/60" data-mock-share-backdrop aria-hidden="true"></div>
    <div
      class="absolute inset-x-0 bottom-0 max-h-[92dvh] overflow-y-auto rounded-t-2xl border border-[var(--border)] bg-[var(--surface-2)] p-4 text-[var(--ink)] shadow-2xl sm:bottom-auto sm:left-1/2 sm:top-1/2 sm:w-[min(26rem,calc(100vw-2rem))] sm:-translate-x-1/2 sm:-translate-y-1/2 sm:rounded-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby={titleId}
    >
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 id={titleId} class="text-lg font-bold">Share this mock</h2>
          <p class="mt-1 text-xs leading-5 opacity-70">
            Only the mock link is shared. Question text, options, images and answers stay out of the live attempt.
          </p>
        </div>
        <button
          type="button"
          class="-mr-1 -mt-1 grid h-11 w-11 shrink-0 place-items-center rounded-lg text-xl font-semibold opacity-70 hover:bg-neutral-100 dark:hover:bg-neutral-800"
          data-mock-share-close
          aria-label="Close share options"
        >
          ×
        </button>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-2">
        <button
          type="button"
          class="col-span-2 inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-600 px-4 text-sm font-bold text-white hover:bg-brand-700"
          data-mock-share-native
          hidden
        >
          Share…
        </button>
        <a
          class="inline-flex min-h-11 items-center justify-center rounded-lg border border-[var(--border)] px-3 text-sm font-semibold hover:bg-neutral-100 dark:hover:bg-neutral-800"
          data-mock-share-whatsapp
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </a>
        <a
          class="inline-flex min-h-11 items-center justify-center rounded-lg border border-[var(--border)] px-3 text-sm font-semibold hover:bg-neutral-100 dark:hover:bg-neutral-800"
          data-mock-share-telegram
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          Telegram
        </a>
        <button
          type="button"
          class="col-span-2 inline-flex min-h-11 items-center justify-center rounded-lg border border-[var(--border)] px-3 text-sm font-semibold hover:bg-neutral-100 dark:hover:bg-neutral-800"
          data-mock-share-copy
        >
          Copy mock link
        </button>
      </div>

      <p class="mt-3 hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-800 dark:bg-red-950/50 dark:text-red-200" data-mock-share-error role="alert"></p>
      <p class="mt-2 min-h-5 text-xs font-semibold text-emerald-700 dark:text-emerald-300" data-mock-share-status role="status" aria-live="polite"></p>
    </div>
  </div>
</div>

<script>
  import { initMockShareSheets } from "../lib/share/mock-share";

  initMockShareSheets();
</script>
