---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import { can, type Permission } from "../lib/auth/admin";

interface Props {
  title: string;
  active?: string;
  description?: string;
}

const { title, active = "", description = "" } = Astro.props;
const admin = Astro.locals.admin;
const user = Astro.locals.user;

type NavItem = { href: string; label: string; key: string; permission?: Permission };

const allLinks: NavItem[] = [
  { href: "/admin", label: "Dashboard", key: "dashboard" },
  { href: "/admin/questions", label: "Questions", key: "questions", permission: "questions.write" },
  { href: "/admin/passages", label: "Passages", key: "passages", permission: "taxonomy.write" },
  { href: "/admin/mocks", label: "Mock builder", key: "mocks", permission: "mocks.write" },
  { href: "/admin/pyq", label: "PYQ papers", key: "pyq", permission: "mocks.write" },
  { href: "/admin/review", label: "Review queue", key: "review", permission: "questions.write" },
  { href: "/admin/attempts", label: "Attempts", key: "attempts", permission: "attempts.view" },
  { href: "/admin/users", label: "Users", key: "users", permission: "users.view" },
  { href: "/admin/moderation", label: "Moderation", key: "moderation", permission: "moderation.write" },
  { href: "/admin/leaderboard", label: "Leaderboard", key: "leaderboard", permission: "leaderboards.write" },
  { href: "/admin/announcements", label: "Announcements", key: "announcements", permission: "announcements.write" },
  { href: "/admin/blog", label: "Guides", key: "blog", permission: "seo.write" },
  { href: "/admin/seo", label: "SEO", key: "seo", permission: "seo.write" },
  { href: "/admin/exam-info", label: "Exam info", key: "exam-info", permission: "exam_info.write" },
  { href: "/admin/admins", label: "Admins", key: "admins", permission: "admins.manage" },
  { href: "/admin/data", label: "Data manager", key: "data", permission: "data.manage" },
  { href: "/admin/trash", label: "Trash", key: "trash", permission: "trash.manage" },
  { href: "/admin/settings", label: "Settings", key: "settings", permission: "settings.write" },
  { href: "/admin/audit-log", label: "Audit log", key: "audit", permission: "audit.view" },
];

const links = allLinks.filter((link) => !link.permission || (admin && can(admin.role, link.permission)));
const canSeeAudit = Boolean(admin && (can(admin.role, "audit.view") || can(admin.role, "audit.own")));
if (admin && canSeeAudit && !links.some((link) => link.key === "audit")) {
  links.push({ href: "/admin/audit-log", label: "Audit log", key: "audit" });
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {}
      })();
    </script>
    <title>{title} · Admin · CUET Free Mock Test</title>
    <meta name="description" content={description || "Admin area"} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
    <a href="#admin-main" class="skip-link">Skip to admin content</a>
    <header class="admin-band sticky top-0 z-40 border-b border-white/10 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6">
        <a href="/admin" class="flex items-center gap-2 font-bold tracking-tight" aria-label="Admin dashboard">
          <img src="/logo.svg" alt="" width="36" height="36" decoding="async" class="h-9 w-9 rounded-full ring-1 ring-white/20" />
          <span class="hidden sm:inline" aria-hidden="true">Admin</span>
        </a>
        <span class="admin-band-muted hidden rounded-full border border-white/15 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide sm:inline">
          {admin?.role}
        </span>

        <form class="ml-auto hidden items-center gap-2 sm:flex" action="/admin/search" method="get" role="search">
          <label for="admin-search" class="sr-only">Search questions, mocks, users and attempts</label>
          <input
            id="admin-search"
            type="search"
            name="q"
            placeholder="Search everything…"
            class="h-10 w-44 rounded-lg border px-3 text-sm outline-none focus-visible:ring-2 focus-visible:ring-white/70 lg:w-64"
          />
        </form>

        <div class="ml-auto flex items-center gap-3 text-sm sm:ml-0">
          <span class="admin-band-muted hidden text-xs xl:inline">{user?.email}</span>
          <a href="/" class="hidden rounded-lg px-2 py-1.5 font-medium sm:inline">View site</a>
          <ThemeToggle />
          <button id="logout-button" class="h-10 rounded-lg bg-accent-500 px-3 font-semibold text-neutral-900 hover:bg-accent-400">Log out</button>
        </div>
      </div>
      <nav class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-4 pb-2 sm:px-6" aria-label="Admin sections">
        <a href="/admin/search" class="whitespace-nowrap rounded-lg bg-white/10 px-3 py-1.5 text-sm font-medium sm:hidden">Search</a>
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={active === link.key ? "page" : undefined}
            class="whitespace-nowrap rounded-lg px-3 py-1.5 text-sm font-medium"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="admin-main" class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <slot />
    </main>

    <script is:inline>
      document.getElementById("logout-button")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        location.href = "/";
      });
    </script>
  </body>
</html>
