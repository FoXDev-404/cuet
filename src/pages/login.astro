---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import { safeNext } from "../lib/http";
import { isGoogleConfigured } from "../lib/auth/oauth";

const next = safeNext(Astro.url.searchParams.get("next"), "/dashboard");
if (Astro.locals.user) return Astro.redirect(next, 303);
const googleReady = isGoogleConfigured();

const errorCode = Astro.url.searchParams.get("error") ?? "";
const errorMessages: Record<string, string> = {
  google_not_configured: "Google login is not configured yet. Please try again later.",
  google_cancelled: "Google login was cancelled.",
  google_state: "The Google login session expired. Please try again.",
  google_token: "Google login could not be completed. Please try again.",
  google_profile: "Google did not share a verified profile.",
  google_email_unverified: "Your Google email is not verified.",
  google_database:
    "Sign-in is temporarily unavailable — the site has hit a temporary database limit. Please try again in a few minutes (limits reset nightly).",
  account_disabled: "This account is disabled.",
};
const message = errorCode in errorMessages ? errorMessages[errorCode] : "";

const benefits = [
  {
    title: "Ranked leaderboards",
    body: "Every first attempt is scored and ranked against real competitors — score, speed, accuracy.",
    icon: '<path d="M8 21h8m-4-4v4M7 4h10M5 8h14l-1.5 4a4 4 0 0 1-4 2.8h-3a4 4 0 0 1-4-2.8L5 8Zm2 14h10M6.5 8H3.5a0 0 0 0 0 0 0c0 2.5 1.5 4 3 4.4M17.5 8h3c0 2.5-1.5 4-3 4.4"/>',
  },
  {
    title: "Weak-subject tracking",
    body: "Attempts feed per-subject accuracy stats, so your next session targets exactly what costs you marks.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/><path d="M3 3v4h4"/>',
  },
  {
    title: "Bookmarks & resume",
    body: "Bookmark tricky questions, resume interrupted papers and revisit every solved question with explanations.",
    icon: '<path d="M6 3h12v18l-6-4-6 4V3Z"/>',
  },
];

const stats = [
  { value: "245", label: "previous-year papers" },
  { value: "12,000+", label: "scored questions" },
  { value: "₹0", label: "free forever" },
];
---

<BaseLayout title="Log in — CUET Free Mock Test" noindex>
  <main class="mx-auto grid min-h-[70dvh] max-w-6xl items-center gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[1.15fr_1fr] lg:py-16">
    <!-- Brand pitch -->
    <section aria-labelledby="login-pitch-heading">
      <BrandLogo size="compact" />
      <h1
        id="login-pitch-heading"
        class="mt-8 text-4xl font-black tracking-tight text-[var(--ink)] sm:text-5xl"
      >
        Practice smarter.<br />
        <span class="text-[var(--primary)]">Rank higher.</span>
      </h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-[var(--muted)]">
        Sign in to turn your attempts into measurable progress — ranked against real
        competitors, tracked subject by subject, reviewed question by question.
      </p>

      <ul class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          benefits.map((benefit) => (
            <li class="flex gap-3.5">
              <span
                class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-[var(--border)] bg-[var(--surface-2)] text-[var(--primary)]"
                aria-hidden="true"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={benefit.icon} />
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-bold text-[var(--ink)]">{benefit.title}</span>
                <span class="mt-1 block text-sm leading-6 text-[var(--muted)]">{benefit.body}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <dl class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-[var(--border)] pt-6">
        {
          stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="block text-xl font-black text-[var(--ink)]">{stat.value}</span>
                <span class="block text-xs text-[var(--muted)]">{stat.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Sign-in card -->
    <section
      aria-labelledby="login-card-heading"
      class="rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-7 shadow-[var(--shadow)] sm:p-9"
    >
      <h2 id="login-card-heading" class="text-2xl font-black tracking-tight text-[var(--ink)]">Sign in</h2>
      <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
        One click through Google — no passwords are ever stored on this site, and your
        account is created automatically on your first sign-in.
      </p>

      {message ? (
        <p class="mt-5 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/50 dark:text-red-200" role="alert">{message}</p>
      ) : null}
      <p id="form-error" class="mt-5 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800 dark:bg-red-950/50 dark:text-red-200"></p>

      {
        googleReady ? (
          <a
            href={`/api/auth/google?next=${encodeURIComponent(next)}`}
            class="mt-6 flex w-full items-center justify-center gap-3 rounded-xl border border-[var(--border)] bg-white px-4 py-3.5 text-sm font-semibold text-neutral-800 shadow-sm transition-colors hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100 dark:hover:bg-neutral-900"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.23 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.11a6.6 6.6 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.2 1.64l3.15-3.15A11 11 0 0 0 2.18 7.05l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z"/></svg>
            Continue with Google
          </a>
        ) : (
          <p class="mt-6 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900 dark:bg-amber-950/50 dark:text-amber-200">
            Google login is not configured on this deployment yet. Ask the site owner to set the
            Google OAuth credentials (GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET).
          </p>
        )
      }

      <p class="mt-5 text-xs leading-5 text-[var(--muted)]">
        By continuing you agree to our{" "}
        <a class="font-semibold text-[var(--primary)] hover:underline" href="/terms">Terms</a> and{" "}
        <a class="font-semibold text-[var(--primary)] hover:underline" href="/privacy-policy">Privacy Policy</a>.
        Only your verified email, username and profile picture are used.
      </p>

      <div class="mt-6 border-t border-[var(--border)] pt-5">
        <a
          href={next}
          class="flex items-center justify-center gap-2 text-sm font-semibold text-[var(--muted)] transition-colors hover:text-[var(--primary)]"
        >
          Keep practicing as a guest →
        </a>
        <p class="mt-1.5 text-center text-xs text-[var(--muted)]">Guest attempts still work — sign in whenever you want to be ranked.</p>
      </div>
    </section>
  </main>
</BaseLayout>
