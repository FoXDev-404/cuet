---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import { can, type Permission } from "../lib/auth/admin";

interface Props {
  title: string;
  active?: string;
  description?: string;
}

const { title, active = "", description = "" } = Astro.props;
const admin = Astro.locals.admin;
const user = Astro.locals.user;

type NavItem = {
  href: string;
  label: string;
  key: string;
  icon: string;
  permission?: Permission;
};
type NavGroup = { label: string; items: NavItem[] };

const groups: NavGroup[] = [
  {
    label: "Workspace",
    items: [
      { href: "/admin", label: "Dashboard", key: "dashboard", icon: "M3 3h7v7H3z M14 3h7v5h-7z M14 12h7v9h-7z M3 14h7v7H3z" },
      { href: "/admin/search", label: "Search", key: "search", icon: "m21 21-4.3-4.3 M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z" },
    ],
  },
  {
    label: "Content",
    items: [
      { href: "/admin/content", label: "Content workspace", key: "content", icon: "M4 5a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z M8 11h8 M8 15h5", permission: "questions.write" },
      { href: "/admin/questions", label: "Questions", key: "questions", icon: "M7 3h10l4 4v14H7z M17 3v5h5 M10 13h8 M10 17h8", permission: "questions.write" },
      { href: "/admin/passages", label: "Passages", key: "passages", icon: "M4 5h16 M4 10h16 M4 15h10 M4 20h8", permission: "taxonomy.write" },
      { href: "/admin/mocks", label: "Mock tests", key: "mocks", icon: "M4 5h16v14H4z M8 3v4 M16 3v4 M8 11h3 M8 15h8", permission: "mocks.write" },
      { href: "/admin/pyq", label: "PYQ library", key: "pyq", icon: "M6 3h12v18H6z M9 8h6 M9 12h6 M9 16h4", permission: "mocks.write" },
      { href: "/admin/review", label: "Review queue", key: "review", icon: "M9 11l2 2 4-4 M5 4h14v16H5z M8 2v4 M16 2v4", permission: "questions.write" },
      { href: "/admin/blog", label: "Guides & blog", key: "blog", icon: "M4 4h16v16H4z M8 8h8 M8 12h8 M8 16h5", permission: "seo.write" },
      { href: "/admin/announcements", label: "Announcements", key: "announcements", icon: "M4 10v4h3l9 5V5l-9 5H4z M7 14l2 6h4l-2-4 M19 9a4 4 0 0 1 0 6", permission: "announcements.write" },
    ],
  },
  {
    label: "Community",
    items: [
      { href: "/admin/attempts", label: "Attempts", key: "attempts", icon: "M4 19V5 M4 19h17 M8 15l4-5 3 2 5-7", permission: "attempts.view" },
      { href: "/admin/users", label: "Users", key: "users", icon: "M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M20 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75", permission: "users.view" },
      { href: "/admin/moderation", label: "Moderation", key: "moderation", icon: "M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z M9 12l2 2 4-4", permission: "moderation.write" },
      { href: "/admin/leaderboard", label: "Leaderboard", key: "leaderboard", icon: "M8 21h8 M12 17v4 M7 4h10v4a5 5 0 0 1-10 0V4z M7 6H4v2a4 4 0 0 0 4 4 M17 6h3v2a4 4 0 0 1-4 4", permission: "leaderboards.write" },
    ],
  },
  {
    label: "Site",
    items: [
      { href: "/admin/media", label: "Media library", key: "media", icon: "M4 5h16v14H4z M8 5l4 5 3-3 5 7 M8 14l2-2", permission: "media.write" },
      { href: "/admin/seo", label: "SEO & pages", key: "seo", icon: "M4 4h16v16H4z M8 8h8 M8 12h5 M8 16h8", permission: "seo.write" },
      { href: "/admin/exam-info", label: "Exam information", key: "exam-info", icon: "M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z M12 11v5 M12 8h.01", permission: "exam_info.write" },
      { href: "/admin/settings", label: "Site builder & settings", key: "settings", icon: "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-1.6 2.77-.08-.02a1.7 1.7 0 0 0-1.74.55l-.05.07h-3.2l-.04-.07a1.7 1.7 0 0 0-1.74-.55l-.08.02-1.6-2.77.06-.06A1.7 1.7 0 0 0 10.1 15l-.08-.04v-3.2l.08-.04a1.7 1.7 0 0 0-.34-1.88l-.06-.06 1.6-2.77.08.02a1.7 1.7 0 0 0 1.74-.55l.05-.07h3.2l.04.07a1.7 1.7 0 0 0 1.74.55l.08-.02 1.6 2.77-.06.06a1.7 1.7 0 0 0-.34 1.88l.08.04v3.2z", permission: "settings.write" },
    ],
  },
  {
    label: "Administration",
    items: [
      { href: "/admin/admins", label: "Admin accounts", key: "admins", icon: "M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M19 8v6 M22 11h-6", permission: "admins.manage" },
      { href: "/admin/data", label: "Data manager", key: "data", icon: "M4 5c0-1.1 3.6-2 8-2s8 .9 8 2-3.6 2-8 2-8-.9-8-2z M4 5v14c0 1.1 3.6 2 8 2s8-.9 8-2V5 M4 12c0 1.1 3.6 2 8 2s8-.9 8-2", permission: "data.manage" },
      { href: "/admin/trash", label: "Trash", key: "trash", icon: "M3 6h18 M8 6V4h8v2 M19 6l-1 14H6L5 6 M10 11v5 M14 11v5", permission: "trash.manage" },
      { href: "/admin/audit-log", label: "Activity log", key: "audit", icon: "M4 19V5 M4 19h17 M8 15l4-5 3 2 5-7", permission: "audit.view" },
    ],
  },
];

const visibleGroups = groups
  .map((group) => ({
    ...group,
    items: group.items.filter(
      (item) => !item.permission || (admin && can(admin.role, item.permission)),
    ),
  }))
  .filter((group) => group.items.length > 0);

const canSeeAudit = Boolean(
  admin && (can(admin.role, "audit.view") || can(admin.role, "audit.own")),
);
if (admin && canSeeAudit && !can(admin.role, "audit.view")) {
  const activityGroup = visibleGroups.find(
    (group) => group.label === "Administration" || group.label === "Activity",
  );
  const auditLink = {
    href: "/admin/audit-log",
    label: "My activity",
    key: "audit",
    icon: "M4 19V5 M4 19h17 M8 15l4-5 3 2 5-7",
  };
  if (activityGroup) activityGroup.items.push(auditLink);
  else visibleGroups.push({ label: "Activity", items: [auditLink] });
}

const initials = (user?.email ?? "A")
  .split("@")[0]
  .split(/[._-]/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join("");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Mark JS as available before the sidebar paints. Without this the
      // mobile fallback renders the sidebar in normal flow for one frame and
      // the main column then jumps by ~270px (Lighthouse CLS 0.33).
      document.documentElement.dataset.adminJs = "true";
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
          if (localStorage.getItem("admin-sidebar-collapsed") === "true") {
            document.documentElement.setAttribute("data-admin-sidebar-collapsed", "true");
          }
        } catch (e) {}
      })();
    </script>
    <title>{title} · Admin · CUET Free Mock Test</title>
    <meta name="description" content={description || "Admin area"} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
  </head>
  <body class="admin-app min-h-screen antialiased">
    <a href="#admin-main" class="skip-link">Skip to admin content</a>
    <aside id="admin-sidebar" class="admin-sidebar" aria-label="Admin navigation">
      <a href="/admin" class="admin-brand">
        <img src="/logo.svg" alt="" width="36" height="36" decoding="async" />
        <span>
          <strong>CUET Admin</strong>
          <small>Content workspace</small>
        </span>
      </a>

      <a href="/" class="admin-site-link" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M14 3h7v7 M10 14 21 3 M19 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6" />
        </svg>
        View live website
      </a>

      <nav class="admin-nav" aria-label="Admin sections">
        {visibleGroups.map((group) => (
          <section class="admin-nav-group" aria-label={group.label}>
            <h2>{group.label}</h2>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={active === item.key ? "page" : undefined}
                    class="admin-nav-link"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={item.icon} />
                    </svg>
                    <span>{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>

      <div class="admin-sidebar-account">
        <span class="admin-avatar" aria-hidden="true">{initials || "A"}</span>
        <span class="admin-account-copy">
          <strong>{user?.email || "Administrator"}</strong>
          <small>{admin?.role || "Admin"}</small>
        </span>
      </div>
    </aside>

    <button id="admin-scrim" class="admin-scrim" type="button" aria-label="Close admin navigation" tabindex="-1"></button>

    <div class="admin-main-column">
      <header class="admin-topbar">
        <div class="admin-topbar-leading">
          <button
            id="admin-menu-toggle"
            class="admin-icon-button admin-sidebar-toggle"
            type="button"
            aria-label="Hide admin navigation"
            aria-controls="admin-sidebar"
            aria-expanded="true"
            title="Hide sidebar"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <div>
            <p class="admin-breadcrumb">Admin <span aria-hidden="true">/</span> {title}</p>
            <p class="admin-page-title">{title}</p>
          </div>
        </div>

        <div class="admin-topbar-actions">
          <form class="admin-search" action="/admin/search" method="get" role="search">
            <label for="admin-search" class="sr-only">Search questions, mocks, users and attempts</label>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-4-4" />
            </svg>
            <input id="admin-search" type="search" name="q" placeholder="Search..." />
            <kbd>↵</kbd>
          </form>

          {admin && can(admin.role, "questions.write") ? (
            <a class="admin-create-button" href="/admin/questions/new" title="Create a question">
              <span aria-hidden="true">+</span>
              <span class="admin-create-label">New question</span>
            </a>
          ) : null}
          <ThemeToggle />
          <button id="logout-button" class="admin-logout-button" type="button">Log out</button>
        </div>
      </header>

      <main id="admin-main" class="admin-content">
        <slot />
      </main>
      <footer class="admin-footer">
        <span>CUET Free Mock Test</span>
        <span>Changes are role-protected and recorded in the activity log.</span>
      </footer>
    </div>

    <script is:inline>
      document.documentElement.dataset.adminJs = "true";

      const sidebar = document.getElementById("admin-sidebar");
      const menuToggle = document.getElementById("admin-menu-toggle");
      const scrim = document.getElementById("admin-scrim");
      const mobileViewport = window.matchMedia("(max-width: 1023px)");

      function sidebarIsVisible() {
        return mobileViewport.matches
          ? document.body.classList.contains("admin-sidebar-open")
          : document.documentElement.dataset.adminSidebarCollapsed !== "true";
      }

      function syncSidebarState() {
        const visible = sidebarIsVisible();
        const label = mobileViewport.matches
          ? visible ? "Close admin navigation" : "Open admin navigation"
          : visible ? "Hide admin navigation" : "Show admin navigation";
        menuToggle?.setAttribute("aria-expanded", String(visible));
        menuToggle?.setAttribute("aria-label", label);
        menuToggle?.setAttribute("title", label.replace(" admin navigation", " sidebar"));
        scrim?.setAttribute("tabindex", mobileViewport.matches && visible ? "0" : "-1");
        if (sidebar) {
          sidebar.inert = !visible;
          sidebar.setAttribute("aria-hidden", String(!visible));
        }
      }

      if (mobileViewport.matches) {
        document.body.classList.remove("admin-sidebar-open");
      }
      syncSidebarState();

      menuToggle?.addEventListener("click", () => {
        if (mobileViewport.matches) {
          document.body.classList.toggle("admin-sidebar-open", !sidebarIsVisible());
        } else {
          const collapsed = document.documentElement.dataset.adminSidebarCollapsed !== "true";
          document.documentElement.dataset.adminSidebarCollapsed = String(collapsed);
          try {
            localStorage.setItem("admin-sidebar-collapsed", String(collapsed));
          } catch {}
        }
        syncSidebarState();
      });
      scrim?.addEventListener("click", () => {
        document.body.classList.remove("admin-sidebar-open");
        syncSidebarState();
        menuToggle?.focus();
      });
      sidebar?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          if (mobileViewport.matches) {
            document.body.classList.remove("admin-sidebar-open");
            syncSidebarState();
          }
        });
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && mobileViewport.matches && sidebarIsVisible()) {
          document.body.classList.remove("admin-sidebar-open");
          syncSidebarState();
          menuToggle?.focus();
        }
      });
      mobileViewport.addEventListener("change", () => {
        document.body.classList.remove("admin-sidebar-open");
        syncSidebarState();
      });

      document.getElementById("logout-button")?.addEventListener("click", async (event) => {
        const button = event.currentTarget;
        if (!(button instanceof HTMLButtonElement)) return;
        button.disabled = true;
        button.textContent = "Logging out…";
        try {
          const response = await fetch("/api/auth/logout", { method: "POST" });
          if (!response.ok) throw new Error("Could not log out. Please try again.");
          location.href = "/";
        } catch (error) {
          button.disabled = false;
          button.textContent = "Log out";
          window.alert(error instanceof Error ? error.message : "Could not log out. Please try again.");
        }
      });
    </script>
  </body>
</html>

<style is:global>
  body.admin-app {
    min-width: 320px;
    background: var(--admin-canvas);
    color: var(--admin-ink);
  }

  .admin-sidebar {
    position: fixed;
    z-index: 60;
    inset: 0 auto 0 0;
    display: flex;
    width: 272px;
    flex-direction: column;
    overflow-y: auto;
    background: var(--admin-sidebar);
    color: var(--admin-brand-ink);
    transform: translateX(-100%);
    box-shadow: var(--admin-sidebar-shadow);
    transition: transform 220ms cubic-bezier(.2,.8,.2,1);
    scrollbar-color: var(--admin-scrollbar-thumb) transparent;
  }

  .admin-brand {
    display: flex;
    min-height: 82px;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--admin-topbar-border);
    color: var(--admin-on-dark);
    text-decoration: none;
  }

  .admin-brand img { width: 40px; height: 40px; border: 2px solid var(--admin-brand-outline); border-radius: 13px; }
  .admin-brand strong, .admin-brand small { display: block; }
  .admin-brand strong { font-size: 14px; letter-spacing: -.01em; }
  .admin-brand small { margin-top: 3px; color: var(--admin-sidebar-muted); font-size: 11px; }

  .admin-site-link {
    display: flex;
    min-height: 42px;
    align-items: center;
    gap: 10px;
    margin: 14px 14px 4px;
    padding: 0 12px;
    border: 1px solid var(--admin-site-outline);
    border-radius: 10px;
    color: var(--admin-site-ink);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .admin-site-link:hover { border-color: var(--admin-site-hover-outline); background: var(--admin-sidebar-hover); color: var(--admin-on-dark); }
  .admin-site-link svg { width: 16px; height: 16px; }
  .admin-nav { flex: 1; padding: 5px 0 20px; }
  .admin-nav-group { margin-top: 20px; }
  .admin-nav-group h2 {
    margin: 0 0 7px;
    padding: 0 22px;
    color: var(--admin-group-label);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .admin-nav-group ul { margin: 0; padding: 0; list-style: none; }
  .admin-nav-link {
    position: relative;
    display: flex;
    min-height: 40px;
    align-items: center;
    gap: 11px;
    margin: 2px 12px;
    padding: 0 12px;
    border-radius: 9px;
    color: var(--admin-nav-ink);
    font-size: 12px;
    font-weight: 550;
    text-decoration: none;
    transition: background 140ms ease, color 140ms ease, transform 140ms ease;
  }
  .admin-nav-link:hover { background: var(--admin-sidebar-hover); color: var(--admin-on-dark); transform: translateX(2px); }
  .admin-nav-link[aria-current="page"] { background: linear-gradient(105deg, var(--admin-active-from), var(--admin-active-to)); color: var(--admin-on-dark); font-weight: 650; box-shadow: var(--admin-active-shadow); }
  .admin-nav-link[aria-current="page"]::after {
    position: absolute;
    top: 9px;
    right: 8px;
    bottom: 9px;
    width: 3px;
    border-radius: 4px;
    background: var(--admin-active-indicator);
    content: "";
  }
  .admin-nav-link svg { width: 17px; height: 17px; flex: 0 0 17px; opacity: .92; }

  .admin-sidebar-account {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 72px;
    padding: 13px 18px;
    border-top: 1px solid var(--admin-account-border);
    background: var(--admin-account-bg);
  }
  .admin-avatar {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border: 1px solid var(--admin-avatar-border);
    border-radius: 12px;
    background: linear-gradient(145deg, var(--admin-avatar-from), var(--admin-avatar-to));
    color: var(--admin-avatar-ink);
    font-size: 12px;
    font-weight: 800;
  }
  .admin-account-copy { min-width: 0; }
  .admin-account-copy strong, .admin-account-copy small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .admin-account-copy strong { color: var(--admin-brand-ink); font-size: 11px; }
  .admin-account-copy small { margin-top: 2px; color: var(--admin-sidebar-muted); font-size: 10px; text-transform: capitalize; }

  .admin-scrim { display: none; }
  .admin-main-column { min-width: 0; min-height: 100vh; transition: margin-left 220ms cubic-bezier(.2,.8,.2,1); }
  .admin-topbar {
    position: sticky;
    z-index: 30;
    top: 0;
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 12px 22px;
    border-bottom: 1px solid color-mix(in srgb, var(--admin-border) 78%, transparent);
    background: color-mix(in srgb, var(--admin-surface) 94%, transparent);
    backdrop-filter: blur(16px);
  }
  .admin-topbar-leading, .admin-topbar-actions { display: flex; min-width: 0; align-items: center; gap: 13px; }
  .admin-page-title { margin: 3px 0 0; color: var(--admin-ink); font-size: 16px; font-weight: 750; line-height: 1.25; }
  .admin-breadcrumb { margin: 0; color: var(--admin-muted); font-size: 10px; font-weight: 600; line-height: 1.3; }
  .admin-breadcrumb span { padding: 0 4px; color: var(--admin-muted); }
  .admin-topbar-actions { flex: 0 0 auto; }
  .admin-search {
    display: none;
    height: 39px;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    border: 1px solid var(--admin-border);
    border-radius: 11px;
    background: var(--admin-canvas);
  }
  .admin-search svg { width: 15px; height: 15px; color: var(--admin-muted); }
  .admin-search input { width: 140px; border: 0; outline: 0; background: transparent; color: var(--admin-ink); font-size: 12px; }
  .admin-search input::placeholder { color: var(--admin-muted); }
  .admin-search kbd { border: 1px solid var(--admin-border); border-radius: 3px; padding: 0 4px; color: var(--admin-muted); font-size: 10px; }
  .admin-icon-button {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--admin-border);
    border-radius: 11px;
    background: var(--admin-surface);
    color: var(--admin-ink);
  }
  .admin-icon-button svg { width: 19px; height: 19px; }
  .admin-sidebar-toggle { flex: 0 0 40px; }
  .admin-create-button, .admin-logout-button {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0 13px;
    border: 1px solid var(--admin-accent);
    border-radius: 11px;
    background: var(--admin-accent);
    color: white;
    font-size: 12px;
    font-weight: 650;
    text-decoration: none;
  }
  .admin-create-button:hover { border-color: var(--admin-accent-hover); background: var(--admin-accent-hover); color: white; }
  .admin-create-button > span:first-child { font-size: 17px; line-height: 1; }
